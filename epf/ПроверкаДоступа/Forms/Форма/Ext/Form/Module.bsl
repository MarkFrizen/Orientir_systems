#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Попытка
		ВыполнитьРежим(ПараметрЗапуска);
	Исключение
		Сообщить("ОШИБКА КЛИЕНТА: " + ОписаниеОшибки());
	КонецПопытки;
	Попытка
		Если ЭтоРегрессияАдмина(ПараметрЗапуска) Тогда
			ВыполнитьР5ОткрытиеФорм(ПараметрЗапуска);
		КонецЕсли;
	Исключение
		Сообщить("ОШИБКА КЛИЕНТА R5: " + ОписаниеОшибки());
	КонецПопытки;
	ЗавершитьРаботуСистемы(Ложь);
	
КонецПроцедуры

// R5 (клиентская часть): немодальное открытие/закрытие форм обработок под администратором.
&НаКлиенте
Процедура ВыполнитьР5ОткрытиеФорм(СтрокаПараметров)
	
	Части = СтрРазделить(СтрокаПараметров, "|");
	ПутьЛога = ?(Части.Количество() > 1, СокрЛП(Части[1]), "");
	
	ИменаОбработок = Новый Массив;
	ИменаОбработок.Добавить("СводкаСтатусов");
	ИменаОбработок.Добавить("ПросроченныеСрокиИSLA");
	
	СтрокиР5 = Новый Массив;
	Для Каждого ИмяОбработки Из ИменаОбработок Цикл
		Попытка
			ФормаОбработки = ОткрытьФорму("Обработка." + ИмяОбработки + ".Форма", , , Ложь);
			Если ФормаОбработки <> Неопределено Тогда
				ФормаОбработки.Закрыть();
			КонецЕсли;
			СтрокиР5.Добавить("R5|Администратор|Обработка." + ИмяОбработки
				+ "|открытие/закрытие немодальной формы|expected=Истина|actual=Истина|PASS");
		Исключение
			СтрокиР5.Добавить("R5|Администратор|Обработка." + ИмяОбработки
				+ "|открытие/закрытие немодальной формы|expected=Истина|actual=ОШИБКА: "
				+ ОднострочноКлиент(ОписаниеОшибки()) + "|FAIL");
		КонецПопытки;
	КонецЦикла;
	
	ДобавитьСтрокиРегрессии(ПутьЛога, СтрокиР5);
	
КонецПроцедуры

&НаКлиенте
Функция ЭтоРегрессияАдмина(СтрокаПараметров)
	
	Части = СтрРазделить(СтрокаПараметров, "|");
	Если Части.Количество() < 3 Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ВРег(СокрЛП(Части[0])) = "REG" И СокрЛП(Части[2]) = "Администратор";
	
КонецФункции

&НаКлиенте
Функция ОднострочноКлиент(ТекстОшибки)
	
	Возврат СтрЗаменить(СтрЗаменить(СокрЛП(ТекстОшибки), Символы.ПС, " "), Символы.ВК, "");
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выполняет режим, заданный параметром запуска: "РЕЖИМ|ПутьЛога[|ОжидаемыйЛогин]".
// Режимы: BIND - привязка тестовых пользователей к сотрудникам + аудит пользователей ИБ (под администратором);
//         CHECK - сбор доступных ролей и видимости разделов текущего сеанса
//                 + батарея сценариев S1-S9 (часть[3]="DATA", часть[4]=путь манифеста);
//         LIST  - полный дамп пользователей ИБ, включая их роли (штатный менеджер
//                 ПользователиИнформационнойБазы.ПолучитьПользователей(), контекст Сервер);
//         FIX   - переназначение ИмяПользователяИБ на фактические русские логины (под администратором);
//         CLEANUP - удаление скретч-документов S2/S3 по манифесту (под администратором);
//         REG   - регрессия соседних спецификаций R1-R5 (задача 13):
//                 часть[2]=ожидаемый логин, часть[3]=путь CSV-экспорта (только администратор, R3).
&НаСервере
Процедура ВыполнитьРежим(СтрокаПараметров)
	
	Лог = Новый Массив;
	Части = СтрРазделить(СтрокаПараметров, "|");
	Режим = ВРег(СокрЛП(Части[0]));
	ПутьЛога = ?(Части.Количество() > 1, СокрЛП(Части[1]), "");
	
	Лог.Добавить("=== ПроверкаДоступа, режим " + Режим + ", " + Формат(ТекущаяДатаСеанса(), "ДЛФ=DT") + " ===");
	Лог.Добавить("");
	ЗаписатьЛог(ПутьЛога, Лог);
	
	Попытка
		Если Режим = "BIND" Тогда
			СвязатьТестовыхПользователей(Лог);
			Лог.Добавить("");
			ДампПривязок(Лог);
			Лог.Добавить("");
			АудитПользователейИБ(Лог);
		ИначеЕсли Режим = "CHECK" Тогда
			ОжидаемыйЛогин = ?(Части.Количество() > 2, СокрЛП(Части[2]), "");
			ПроверитьДоступСеанса(Лог, ОжидаемыйЛогин, ПутьЛога);
			ЗаписатьЛог(ПутьЛога, Лог);
			ВыполнитьСценарии(Лог, ОжидаемыйЛогин, Части);
		ИначеЕсли Режим = "LIST" Тогда
			АудитПользователейИБ(Лог);
			Лог.Добавить("");
			ДампПривязок(Лог);
			Лог.Добавить("");
			ПроверитьСценарийS6(Лог);
		ИначеЕсли Режим = "FIX" Тогда
			ИсправитьПривязкиИБ(Лог, Части);
			Лог.Добавить("");
			ДампПривязок(Лог);
			Лог.Добавить("");
			АудитПользователейИБ(Лог);
			Лог.Добавить("");
			ПроверитьСценарийS6(Лог);
		ИначеЕсли Режим = "CLEANUP" Тогда
			ПутьМанифеста = ?(Части.Количество() > 2, СокрЛП(Части[2]), "");
			ОчиститьСкретчДокументы(Лог, ПутьМанифеста);
		ИначеЕсли Режим = "REG" Тогда
			ОжидаемыйЛогин = ?(Части.Количество() > 2, СокрЛП(Части[2]), "");
			ПутьОбмена = ?(Части.Количество() > 3, СокрЛП(Части[3]), "");
			ВыполнитьРегрессию(Лог, ОжидаемыйЛогин, ПутьЛога, ПутьОбмена);
		ИначеЕсли Режим = "PROBE" Тогда
			ПробаСпискаПользователей(Лог);
		Иначе
			Лог.Добавить("ОШИБКА: неизвестный режим """ + СтрокаПараметров + """");
		КонецЕсли;
	Исключение
		Лог.Добавить("ОШИБКА ВЫПОЛНЕНИЯ: " + ОписаниеОшибки());
	КонецПопытки;
	
	ЗаписатьЛог(ПутьЛога, Лог, Истина);
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьЛог(ПутьЛога, Лог, ФинальнаяЗапись = Ложь)
	
	Если ПустаяСтрока(ПутьЛога) Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Запись = Новый ЗаписьТекста(ПутьЛога, КодировкаТекста.UTF8);
		Для Каждого СтрокаЛога Из Лог Цикл
			Запись.ЗаписатьСтроку(СтрокаЛога);
		КонецЦикла;
		Запись.Закрыть();
	Исключение
		// Безопасный режим внешней обработки запрещает запись файлов:
		// финальный лог выдаётся в /Out сеанса через Сообщить().
		Если ФинальнаяЗапись Тогда
			Для Каждого СтрокаЛога Из Лог Цикл
				Сообщить(СтрокаЛога);
			КонецЦикла;
		КонецЕсли;
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура СвязатьТестовыхПользователей(Лог)
	
	Лог.Добавить("--- Привязка «свой» (Пользователи/Сотрудники) ---");
	
	Соответствия = Новый Массив;
	Соответствия.Добавить(Новый Структура("Логин, Наименование, КлючевоеСлово", "test_operator", "Оператор (тест)", "сопровожд"));
	Соответствия.Добавить(Новый Структура("Логин, Наименование, КлючевоеСлово", "test_gid", "Гид (тест)", "гид"));
	
	Для Каждого Сопоставление Из Соответствия Цикл
		ПользовательСсылка = НайтиИлиСоздатьПользователя(Лог, Сопоставление.Логин, Сопоставление.Наименование);
		ПривязатьСотрудника(Лог, ПользовательСсылка, Сопоставление.КлючевоеСлово);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция НайтиИлиСоздатьПользователя(Лог, ИмяИБ, Наименование)
	
	Найден = Справочники.Пользователи.НайтиПоРеквизиту("ИмяПользователяИБ", ИмяИБ);
	Если Найден <> Неопределено И Не Найден.Пустая() Тогда
		Лог.Добавить("Пользователь справочника уже существует: " + Найден + " (ИмяПользователяИБ = " + ИмяИБ + ")");
		Возврат Найден;
	КонецЕсли;
	
	Элемент = Справочники.Пользователи.СоздатьЭлемент();
	Элемент.Наименование = Наименование;
	Элемент.ИмяПользователяИБ = ИмяИБ;
	Элемент.Записать();
	Лог.Добавить("Создан пользователь справочника: " + Элемент.Ссылка + " (ИмяПользователяИБ = " + ИмяИБ + ")");
	Возврат Элемент.Ссылка;
	
КонецФункции

&НаСервере
Процедура ПривязатьСотрудника(Лог, ПользовательСсылка, КлючевоеСлово)
	
	Если ПользовательСсылка.Пустая() Тогда
		Лог.Добавить("ОШИБКА: пустая ссылка пользователя для привязки");
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Сотрудники.Ссылка КАК Ссылка,
		|	ПРЕДСТАВЛЕНИЕ(Сотрудники.ФИО) КАК ФИО,
		|	ПРЕДСТАВЛЕНИЕ(Сотрудники.Должность) КАК Должность,
		|	Сотрудники.Пользователь1С КАК Пользователь1С
		|ИЗ
		|	Справочник.Сотрудники КАК Сотрудники";
	Выборка = Запрос.Выполнить().Выбрать();
	
	Кандидат = Неопределено;
	Резервный = Неопределено;
	Пока Выборка.Следующий() Цикл
		Если Выборка.Пользователь1С = ПользовательСсылка Тогда
			Лог.Добавить("Сотрудник уже привязан: " + Выборка.ФИО + " -> " + Строка(ПользовательСсылка));
			Возврат;
		КонецЕсли;
		Если Не Выборка.Пользователь1С.Пустая() Тогда
			Продолжить;
		КонецЕсли;
		Текущий = Новый Структура("Ссылка, ФИО, Должность", Выборка.Ссылка, Выборка.ФИО, Выборка.Должность);
		Если Резервный = Неопределено Тогда
			Резервный = Текущий;
		КонецЕсли;
		Если Кандидат = Неопределено И СтрНайти(НРег(Выборка.Должность), КлючевоеСлово) > 0 Тогда
			Кандидат = Текущий;
		КонецЕсли;
	КонецЦикла;
	
	Если Кандидат = Неопределено Тогда
		Кандидат = Резервный;
	КонецЕсли;
	Если Кандидат = Неопределено Тогда
		Лог.Добавить("ОШИБКА: нет свободного сотрудника для привязки к " + Строка(ПользовательСсылка));
		Возврат;
	КонецЕсли;
	
	СотрудникОбъект = Кандидат.Ссылка.ПолучитьОбъект();
	СотрудникОбъект.Пользователь1С = ПользовательСсылка;
	СотрудникОбъект.Записать();
	Лог.Добавить("Привязан сотрудник: " + Кандидат.ФИО + " (" + Кандидат.Должность + ") -> " + Строка(ПользовательСсылка));
	
КонецПроцедуры

&НаСервере
Процедура ДампПривязок(Лог)
	
	Лог.Добавить("--- Состояние справочника Пользователи ---");
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Пользователи.Код КАК Код,
		|	Пользователи.Наименование КАК Наименование,
		|	Пользователи.ИмяПользователяИБ КАК ИмяПользователяИБ
		|ИЗ
		|	Справочник.Пользователи КАК Пользователи
		|УПОРЯДОЧИТЬ ПО
		|	Пользователи.Код";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Лог.Добавить("Пользователи[" + Выборка.Код + "]: """ + Выборка.Наименование + """, ИмяПользователяИБ = """ + Выборка.ИмяПользователяИБ + """");
	КонецЦикла;
	
	Лог.Добавить("--- Привязки Сотрудники.Пользователь1С ---");
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ПРЕДСТАВЛЕНИЕ(Сотрудники.ФИО) КАК ФИО,
		|	ПРЕДСТАВЛЕНИЕ(Сотрудники.Должность) КАК Должность,
		|	Сотрудники.Пользователь1С.ИмяПользователяИБ КАК ИмяПользователяИБ
		|ИЗ
		|	Справочник.Сотрудники КАК Сотрудники
		|ГДЕ
		|	НЕ Сотрудники.Пользователь1С.ИмяПользователяИБ = """"";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Лог.Добавить("Сотрудник " + Выборка.ФИО + " (" + Выборка.Должность + ") -> ИмяПользователяИБ = """ + Выборка.ИмяПользователяИБ + """");
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура АудитПользователейИБ(Лог)
	
	Лог.Добавить("--- Аудит пользователей информационной базы (полный список) ---");
	ВсеПользователи = СписокПользователейИБ(Лог);
	Лог.Добавить("Всего пользователей ИБ: " + ВсеПользователи.Количество());
	Для Каждого ПользовательИБ Из ВсеПользователи Цикл
		Лог.Добавить(ОписаниеПользователяИБ(ПользовательИБ));
	КонецЦикла;
	
КонецПроцедуры

// Возвращает массив пользователей ИБ через штатный метод менеджера глобального
// контекста ПользователиИнформационнойБазы.ПолучитьПользователей() - единственный
// доступный в контексте «Сервер» способ перечисления (проверено runtime-зондом
// на 8.3.27.1786: глобальная функция ПолучитьПользователиИнформационнойБазы и
// методы менеджера Получить()/Выбрать() не существуют). Элементы - объекты
// «Пользователь информационной базы»: Имя, ПолноеИмя, Роли (поля Описание нет).
&НаСервере
Функция СписокПользователейИБ(Лог)
	
	Результат = Новый Массив;
	
	Список = ПользователиИнформационнойБазы.ПолучитьПользователей();
	Для Каждого ПользовательИБ Из Список Цикл
		Результат.Добавить(ПользовательИБ);
	КонецЦикла;
	Лог.Добавить("Список пользователей получен через ПользователиИнформационнойБазы.ПолучитьПользователей(): " + Результат.Количество());
	
	Возврат Результат;
	
КонецФункции

// Печатает описание ИБ-пользователя. Работает и со структурой клиентского сбора
// (ПользователиИБСКлиента), и с объектом платформы (НайтиПоИмени): каждое свойство
// читается защитно, у платформенных объектов часть полей (Описание, Роли) отсутствует.
&НаСервере
Функция ОписаниеПользователяИБ(ПользовательИБ)
	
	Имя = "";
	ПолноеИмя = "";
	Описание = "";
	РолиСтрока = "";
	Попытка
		Имя = Строка(ПользовательИБ.Имя);
	Исключение
		Имя = "";
	КонецПопытки;
	Попытка
		ПолноеИмя = Строка(ПользовательИБ.ПолноеИмя);
	Исключение
		ПолноеИмя = "";
	КонецПопытки;
	Попытка
		Описание = Строка(ПользовательИБ.Описание);
	Исключение
		Описание = "";
	КонецПопытки;
	Попытка
		ИменаРолей = Новый Массив;
		Для Каждого Роль Из ПользовательИБ.Роли Цикл
			ИменаРолей.Добавить(Строка(Роль.Имя));
		КонецЦикла;
		РолиСтрока = СтрСоединить(ИменаРолей, ", ");
	Исключение
		РолиСтрока = "";
	КонецПопытки;
	
	Если ПустаяСтрока(РолиСтрока) Тогда
		ОписаниеРолей = "роли: н/д (нет API для чужих сеансов)";
	Иначе
		ОписаниеРолей = "роли: " + РолиСтрока;
	КонецЕсли;
	
	Возврат "ИБ-пользователь """ + Имя + """ (полное имя: """ + ПолноеИмя + """); описание: """ + Описание + """; " + ОписаниеРолей;
	
КонецФункции

&НаСервере
Процедура ПробаСпискаПользователей(Лог)
	
	Лог.Добавить("--- Проба API списка пользователей ИБ ---");
	Список = СписокПользователейИБ(Лог);
	Для Каждого ПользовательИБ Из Список Цикл
		Лог.Добавить(ОписаниеПользователяИБ(ПользовательИБ));
	КонецЦикла;
	
	Лог.Добавить("");
	Лог.Добавить("--- Подбор имён через НайтиПоИмени ---");
	Кандидаты = Новый Массив;
	Кандидаты.Добавить("Администратор");
	Кандидаты.Добавить("Аудитор");
	Кандидаты.Добавить("ТурГид");
	Кандидаты.Добавить("Гид");
	Кандидаты.Добавить("Оператор");
	Кандидаты.Добавить("Координатор");
	Кандидаты.Добавить("Менеджер");
	Кандидаты.Добавить("Руководитель");
	Кандидаты.Добавить("Оператор Сопровождения");
	Кандидаты.Добавить("Координатор Логистики");
	Кандидаты.Добавить("Гид На Маршруте");
	Кандидаты.Добавить("Менеджер По Претензиям");
	Кандидаты.Добавить("Руководитель Направления");
	Кандидаты.Добавить("ОператорСопровождения");
	Кандидаты.Добавить("КоординаторЛогистики");
	Кандидаты.Добавить("ГидНаМаршруте");
	Кандидаты.Добавить("МенеджерПоПретензиям");
	Кандидаты.Добавить("РуководительНаправления");
	Кандидаты.Добавить("Сопровождение");
	Кандидаты.Добавить("Логистика");
	Кандидаты.Добавить("Маршрут");
	Кандидаты.Добавить("Претензии");
	Кандидаты.Добавить("Руководство");
	Для Каждого Кандидат Из Кандидаты Цикл
		Попытка
			ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоИмени(Кандидат);
			Если ПользовательИБ = Неопределено Тогда
				Лог.Добавить("НайтиПоИмени(""" + Кандидат + """): не найден");
			Иначе
				Лог.Добавить("НайтиПоИмени(""" + Кандидат + """): НАЙДЕН - " + ОписаниеПользователяИБ(ПользовательИБ));
			КонецЕсли;
		Исключение
			Лог.Добавить("НайтиПоИмени(""" + Кандидат + """): " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

// Переназначает ИмяПользователяИБ записей справочника Пользователи
// («Оператор (тест)», «Гид (тест)») на канонические фактические логины ИБ.
// Фактический логин берётся из явного соответствия в параметре запуска
// (части[2..]: "КлючевоеСловоНаименования=логин"), иначе - подбором через
// НайтиПоИмени по списку кандидатов. Значение всегда приводится к каноническому
// имени ИБ (ПроверитьПоИмени.Имя), что устраняет лишние пробелы/регистр.
&НаСервере
Процедура ИсправитьПривязкиИБ(Лог, Части)
	
	Лог.Добавить("--- Исправление ИмяПользователяИБ на фактические логины ---");
	
	Явные = Новый Соответствие;
	Для Инд = 2 По Части.Количество() - 1 Цикл
		Пара = СтрРазделить(Части[Инд], "=");
		Если Пара.Количество() = 2 Тогда
			Явные.Вставить(НРег(СокрЛП(Пара[0])), СокрЛП(Пара[1]));
		КонецЕсли;
	КонецЦикла;
	
	Соответствия = Новый Массив;
	Соответствия.Добавить(Новый Структура("КлючевоеСлово, Кандидаты",
		"оператор", "ОператорСопровождения, Оператор Сопровождения, test_operator"));
	Соответствия.Добавить(Новый Структура("КлючевоеСлово, Кандидаты",
		"гид", "ТурГид, ГидНаМаршруте, Гид На Маршруте, test_gid"));
	
	// Все записи справочника Пользователи
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Пользователи.Ссылка КАК Ссылка,
		|	Пользователи.Код КАК Код,
		|	Пользователи.Наименование КАК Наименование,
		|	Пользователи.ИмяПользователяИБ КАК ИмяПользователяИБ
		|ИЗ
		|	Справочник.Пользователи КАК Пользователи
		|УПОРЯДОЧИТЬ ПО
		|	Пользователи.Код";
	Записи = Запрос.Выполнить().Выбрать();
	
	Пока Записи.Следующий() Цикл
		Ключ = Неопределено;
		Для Каждого Сопоставление Из Соответствия Цикл
			Если СтрНайти(НРег(Записи.Наименование), Сопоставление.КлючевоеСлово) > 0 Тогда
				Ключ = Сопоставление;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Ключ = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ФактическийЛогин = Строка(Явные.Получить(Ключ.КлючевоеСлово));
		Канонический = Неопределено;
		Если Не ПустаяСтрока(ФактическийЛогин) Тогда
			Канонический = РазрешитьЛогинИБ(Лог, ФактическийЛогин);
		КонецЕсли;
		Если Канонический = Неопределено Тогда
			Для Каждого Кандидат Из СтрРазделить(Ключ.Кандидаты, ",") Цикл
				Канонический = РазрешитьЛогинИБ(Лог, СокрЛП(Кандидат));
				Если Канонический <> Неопределено Тогда
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если Канонический = Неопределено Тогда
			Лог.Добавить("ОШИБКА: не определён фактический логин для записи """ + Записи.Наименование + """ - привязка не изменена");
			Продолжить;
		КонецЕсли;
		
		Лог.Добавить("ДО: Пользователи[" + Записи.Код + "] """ + Записи.Наименование + """, ИмяПользователяИБ = """ + Записи.ИмяПользователяИБ + """");
		Если Записи.ИмяПользователяИБ = Канонический.Имя Тогда
			Лог.Добавить("Изменение не требуется: значение уже каноническое (""" + Канонический.Имя + """)");
			Продолжить;
		КонецЕсли;
		
		Элемент = Записи.Ссылка.ПолучитьОбъект();
		Элемент.ИмяПользователяИБ = Канонический.Имя;
		Элемент.Записать();
		Лог.Добавить("ПОСЛЕ: Пользователи[" + Элемент.Код + "] """ + Элемент.Наименование + """, ИмяПользователяИБ = """ + Элемент.ИмяПользователяИБ + """");
	КонецЦикла;
	
КонецПроцедуры

// Возвращает объект пользователя ИБ с каноническим Имя, либо Неопределено.
&НаСервере
Функция РазрешитьЛогинИБ(Лог, Кандидат)
	
	Если ПустаяСтрока(Кандидат) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоИмени(Кандидат);
		Если ПользовательИБ = Неопределено Тогда
			Лог.Добавить("Кандидат """ + Кандидат + """: не найден в ИБ");
			Возврат Неопределено;
		КонецЕсли;
		Лог.Добавить("Кандидат """ + Кандидат + """: ПОДТВЕРЖДЁН - " + ОписаниеПользователяИБ(ПользовательИБ));
		Возврат ПользовательИБ;
	Исключение
		Лог.Добавить("Кандидат """ + Кандидат + """: ошибка поиска - " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

&НаСервере
Процедура ПроверитьДоступСеанса(Лог, ОжидаемыйЛогин, ПутьЛога = "")
	
	ФактическийЛогин = "";
	Попытка
		Текущий = ПользователиИнформационнойБазы.ТекущийПользователь();
		Если Текущий <> Неопределено Тогда
			ФактическийЛогин = Текущий.Имя;
		КонецЕсли;
	Исключение
		Лог.Добавить("Не удалось прочитать текущего пользователя ИБ: " + ОписаниеОшибки());
	КонецПопытки;
	
	Лог.Добавить("Ожидаемый логин: " + ОжидаемыйЛогин);
	Лог.Добавить("Фактический пользователь сеанса: " + ?(ПустаяСтрока(ФактическийЛогин), "<не определён>", ФактическийЛогин));
	Если Не ПустаяСтрока(ОжидаемыйЛогин) И Не ПустаяСтрока(ФактическийЛогин) Тогда
		Лог.Добавить("Совпадение логина: " + ?(ВРег(ФактическийЛогин) = ВРег(ОжидаемыйЛогин), "ДА", "НЕТ"));
	КонецЕсли;
	
	Лог.Добавить("");
	Лог.Добавить("--- Роли, доступные сеансу ---");
	Для Каждого Роль Из Метаданные.Роли Цикл
		Лог.Добавить("РольДоступна(" + Роль.Имя + ") = " + Формат(РольДоступна(Роль), "БИ=Истина;БЛ=Ложь"));
	КонецЦикла;
	ЗаписатьЛог(ПутьЛога, Лог);
	
	Лог.Добавить("");
	Лог.Добавить("--- Видимость разделов (ПравоДоступа ""Просмотр"") ---");
	ВидимоРазделов = 0;
	Для Каждого Подсистема Из Метаданные.Подсистемы Цикл
		Видим = ПравоДоступа("Просмотр", Подсистема);
		Если Видим Тогда
			ВидимоРазделов = ВидимоРазделов + 1;
		КонецЕсли;
		Лог.Добавить("Раздел " + Подсистема.Имя + " = " + ?(Видим, "ВИДИМ", "скрыт"));
	КонецЦикла;
	Лог.Добавить("Итого видимых разделов верхнего уровня: " + ВидимоРазделов);
	ЗаписатьЛог(ПутьЛога, Лог);
	
	Лог.Добавить("");
	Лог.Добавить("--- Привязка «свой» текущего пользователя ---");
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Сотрудники.Ссылка КАК Ссылка,
			|	ПРЕДСТАВЛЕНИЕ(Сотрудники.ФИО) КАК ФИО,
			|	Сотрудники.Пользователь1С.ИмяПользователяИБ КАК ИмяПользователяИБ
			|ИЗ
			|	Справочник.Сотрудники КАК Сотрудники
			|ГДЕ
			|	Сотрудники.Пользователь1С.ИмяПользователяИБ = &Логин";
		ЛогинДляЗапроса = ?(ПустаяСтрока(ФактическийЛогин), ОжидаемыйЛогин, ФактическийЛогин);
		Запрос.УстановитьПараметр("Логин", ЛогинДляЗапроса);
		Выборка = Запрос.Выполнить().Выбрать();
		Найдено = 0;
		Пока Выборка.Следующий() Цикл
			Найдено = Найдено + 1;
			Лог.Добавить("Привязка: сотрудник " + Выборка.ФИО + " -> ИмяПользователяИБ = " + Выборка.ИмяПользователяИБ);
		КонецЦикла;
		Если Найдено = 0 Тогда
			Лог.Добавить("Привязка не найдена (у пользователя нет прав чтения справочников или привязка не выполнена)");
		КонецЕсли;
	Исключение
		Лог.Добавить("Проверка привязки пропущена (нет прав): " + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область СценарииПроверки

// Батарея сценариев S1-S9 из спеки add-access-roles для текущего сеанса (задача 12).
// Формат строки доказательства:
//   <S>|<логин>|<объект>|<проверка>|expected=<ожидание>|actual=<факт>|PASS/FAIL/INFO
// Части[3]="DATA" включает создание скретч-документов (S2/S3), Части[4] - путь манифеста.

&НаСервере
Процедура ВыполнитьСценарии(Лог, ОжидаемыйЛогин, Части)
	
	ФактическийЛогин = "";
	Попытка
		ТекущийПользовательИБ = ПользователиИнформационнойБазы.ТекущийПользователь();
		Если ТекущийПользовательИБ <> Неопределено Тогда
			ФактическийЛогин = ТекущийПользовательИБ.Имя;
		КонецЕсли;
	Исключение
		ФактическийЛогин = "";
	КонецПопытки;
	
	Логин = ?(ПустаяСтрока(ФактическийЛогин), ОжидаемыйЛогин, ФактическийЛогин);
	
	Лог.Добавить("");
	Лог.Добавить("--- Батарея сценариев S1-S9, логин сеанса """ + Логин + """ ---");
	
	Если Не ПустаяСтрока(ОжидаемыйЛогин) И Не ПустаяСтрока(ФактическийЛогин)
		И ВРег(СокрЛП(ФактическийЛогин)) <> ВРег(СокрЛП(ОжидаемыйЛогин)) Тогда
		Лог.Добавить("S0|" + ОжидаемыйЛогин + "|логин|логин сеанса совпадает с ожидаемым|expected="
			+ ОжидаемыйЛогин + "|actual=" + ФактическийЛогин + "|FAIL");
	Иначе
		Лог.Добавить("S0|" + Логин + "|логин|логин сеанса совпадает с ожидаемым|expected="
			+ ОжидаемыйЛогин + "|actual=" + ФактическийЛогин + "|PASS");
	КонецЕсли;
	
	ДанныеРежим = Части.Количество() > 3 И НРег(СокрЛП(Части[3])) = "data";
	ПутьМанифеста = ?(Части.Количество() > 4, СокрЛП(Части[4]), "");
	ПутьЛогаСценарии = ?(Части.Количество() > 1, СокрЛП(Части[1]), "");
	ЗаписатьЛог(ПутьЛогаСценарии, Лог);
	
	ПроверитьС1ВидимостьПодсистем(Лог, Логин);
	ЗаписатьЛог(ПутьЛогаСценарии, Лог);
	ПроверитьПраваПоЛогину(Лог, Логин);
	ЗаписатьЛог(ПутьЛогаСценарии, Лог);
	
	// S8/S9 - проверки, общие для всех шести профилей.
	ДобавитьПроверкуПрава(Лог, "S8", Логин, Метаданные.Константы.ПорогСогласованияРуководителем, "Чтение", Истина);
	ЗначениеS8 = ПраваПеречисленийПроба();
	ДобавитьСтрокуСценария(Лог, "S8", Логин, "Enum.ВидыУслуг", "права на перечисление", ЗначениеS8, ЗначениеS8);
	ДобавитьПроверкуПрава(Лог, "S9", Логин, Метаданные, "ТонкийКлиент", Истина);
	ДобавитьПроверкуПрава(Лог, "S9", Логин, Метаданные, "СохранениеДанныхПользователя", Истина);
	
	Если ДанныеРежим Тогда
		Если Логин = "ТурГид" Тогда
			СкретчИнцидент(Лог, Логин, ПутьМанифеста, ПутьЛогаСценарии);
		ИначеЕсли Логин = "ОператорСопровождения" Тогда
			СкретчПодтверждениеУслуги(Лог, Логин, ПутьМанифеста, ПутьЛогаСценарии);
		Иначе
			Лог.Добавить("DATA|" + Логин + "|-|скретч-документы для логина не предусмотрены|expected=-|actual=-|INFO");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// S1: каждый пользователь видит свою подсистему (с вложенными), чужие бизнес-подсистемы
// скрыты; Аудитор видит все пять бизнес-подсистем и не видит АдминистраторИС.
&НаСервере
Процедура ПроверитьС1ВидимостьПодсистем(Лог, Логин)
	
	ВидимыеВерхние = ВидимыеПодсистемыПоЛогину(Логин);
	Если ВидимыеВерхние = Неопределено Тогда
		Лог.Добавить("INFO|S1|" + Логин + "|Subsystem|видимость не проверяется|expected=логин не в матрице S1|actual=-|SKIP");
		Возврат;
	КонецЕсли;
	
	Для Каждого Подсистема Из Метаданные.Подсистемы Цикл
		ОбойтиПодсистемуС1(Лог, Логин, Подсистема, ВидимыеВерхние.Найти(Подсистема.Имя) <> Неопределено);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ВидимыеПодсистемыПоЛогину(Логин)
	
	Если Логин = "ОператорСопровождения" Тогда
		Возврат СтрРазделить("ОператорСопровождения", ",");
	ИначеЕсли Логин = "КоординаторЛогистики" Тогда
		Возврат СтрРазделить("КоординаторЛогистики", ",");
	ИначеЕсли Логин = "ТурГид" Тогда
		Возврат СтрРазделить("ГидНаМаршруте", ",");
	ИначеЕсли Логин = "МенеджерПоПретензиям" Тогда
		Возврат СтрРазделить("МенеджерПоПретензиям", ",");
	ИначеЕсли Логин = "РуководительНаправления" Тогда
		Возврат СтрРазделить("РуководительНаправления", ",");
	ИначеЕсли Логин = "Аудитор" Тогда
		Возврат СтрРазделить("ГидНаМаршруте,КоординаторЛогистики,МенеджерПоПретензиям,ОператорСопровождения,РуководительНаправления", ",");
	КонецЕсли;
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Процедура ОбойтиПодсистемуС1(Лог, Логин, Подсистема, ОжиданиеВидимости)
	
	Попытка
		Факт = ПравоДоступа("Просмотр", Подсистема);
		ДобавитьСтрокуСценария(Лог, "S1", Логин, Подсистема.ПолноеИмя(), "Просмотр (видимость)", ОжиданиеВидимости, Факт);
	Исключение
		ДобавитьСтрокуСценария(Лог, "S1", Логин, Подсистема.ПолноеИмя(), "Просмотр (видимость)",
			ОжиданиеВидимости, "ОШИБКА: " + Однострочно(ОписаниеОшибки()));
	КонецПопытки;
	
	Для Каждого Дочерняя Из Подсистема.Подсистемы Цикл
		ОбойтиПодсистемуС1(Лог, Логин, Дочерняя, ОжиданиеВидимости);
	КонецЦикла;
	
КонецПроцедуры

// Права по сценариям S2-S5, S7 для конкретного логина (по матрице спеки и ролевым XML).
&НаСервере
Процедура ПроверитьПраваПоЛогину(Лог, Логин)
	
	Если Логин = "ОператорСопровождения" Тогда
		
		// S3: создание и проведение подтверждения услуги, добавление туристов.
		ДобавитьПроверкуПрава(Лог, "S3", Логин, Метаданные.Документы.ПодтверждениеУслуги, "Добавление", Истина);
		ДобавитьПроверкуПрава(Лог, "S3", Логин, Метаданные.Документы.ПодтверждениеУслуги, "ИнтерактивноеДобавление", Истина);
		ДобавитьПроверкуПрава(Лог, "S3", Логин, Метаданные.Документы.ПодтверждениеУслуги, "Изменение", Истина);
		ДобавитьПроверкуПрава(Лог, "S3", Логин, Метаданные.Документы.ПодтверждениеУслуги, "Проведение", Истина);
		ДобавитьПроверкуПрава(Лог, "S3", Логин, Метаданные.Документы.ПодтверждениеУслуги, "ИнтерактивноеПроведение", Истина);
		ДобавитьПроверкуПрава(Лог, "S3", Логин, Метаданные.Справочники.Туристы, "ИнтерактивноеДобавление", Истина);
		
		// S4: претензии, настройки интеграций и обмен с файлами закрыты.
		ДобавитьПроверкуПрава(Лог, "S4", Логин, Метаданные.Документы.ПретензияПоставщику, "Чтение", Ложь);
		ДобавитьПроверкуПрава(Лог, "S4", Логин, Метаданные.Документы.ПретензияПоставщику, "Просмотр", Ложь);
		ДобавитьПроверкуПрава(Лог, "S4", Логин, Метаданные.РегистрыСведений.НастройкиИнтеграций, "Чтение", Ложь);
		ДобавитьИнфоПробуПрава(Лог, "S4", Логин, Метаданные.РегистрыСведений.НастройкиИнтеграций, "Просмотр");
		ДобавитьПроверкуПрава(Лог, "S4", Логин, Метаданные.Обработки.ОбменСФайлами, "Использование", Ложь);
		
		// S7 (негативная сторона): взаиморасчёты по претензиям недоступны.
		ДобавитьПроверкуПрава(Лог, "S7", Логин, Метаданные.РегистрыНакопления.ВзаиморасчётыПоПретензиям, "Чтение", Ложь);
		ДобавитьИнфоПробуПрава(Лог, "S7", Логин, Метаданные.РегистрыНакопления.ВзаиморасчётыПоПретензиям, "Просмотр");
		
	ИначеЕсли Логин = "КоординаторЛогистики" Тогда
		
		// S5 (позитивная сторона): координатор запускает пересчёт таймингов маршрутов.
		ДобавитьПроверкуПрава(Лог, "S5", Логин, Метаданные.Обработки.ПересчётТайминговМаршрутов, "Использование", Истина);
		ДобавитьПроверкуПрава(Лог, "S5", Логин, Метаданные.Обработки.ПересчётТайминговМаршрутов, "Просмотр", Истина);
		
	ИначеЕсли Логин = "ТурГид" Тогда
		
		// S2: гид регистрирует инцидент, проведение недоступно; договоры и претензии поставщикам закрыты.
		ДобавитьПроверкуПрава(Лог, "S2", Логин, Метаданные.Документы.Инцидент, "Чтение", Истина);
		ДобавитьПроверкуПрава(Лог, "S2", Логин, Метаданные.Документы.Инцидент, "Просмотр", Истина);
		ДобавитьПроверкуПрава(Лог, "S2", Логин, Метаданные.Документы.Инцидент, "Добавление", Истина);
		ДобавитьПроверкуПрава(Лог, "S2", Логин, Метаданные.Документы.Инцидент, "ИнтерактивноеДобавление", Истина);
		ДобавитьПроверкуПрава(Лог, "S2", Логин, Метаданные.Документы.Инцидент, "Проведение", Ложь);
		ДобавитьПроверкуПрава(Лог, "S2", Логин, Метаданные.Документы.Инцидент, "ИнтерактивноеПроведение", Ложь);
		ДобавитьПроверкуПрава(Лог, "S2", Логин, Метаданные.Справочники.ДоговорыСПоставщиками, "Чтение", Ложь);
		ДобавитьПроверкуПрава(Лог, "S2", Логин, Метаданные.Справочники.ДоговорыСПоставщиками, "Просмотр", Ложь);
		ДобавитьПроверкуПрава(Лог, "S2", Логин, Метаданные.Документы.ПретензияПоставщику, "Чтение", Ложь);
		ДобавитьПроверкуПрава(Лог, "S2", Логин, Метаданные.Документы.ПретензияПоставщику, "Просмотр", Ложь);
		
	ИначеЕсли Логин = "МенеджерПоПретензиям" Тогда
		
		// S7 (позитивная сторона): менеджер читает взаиморасчёты по претензиям.
		ДобавитьПроверкуПрава(Лог, "S7", Логин, Метаданные.РегистрыНакопления.ВзаиморасчётыПоПретензиям, "Чтение", Истина);
		ДобавитьИнфоПробуПрава(Лог, "S7", Логин, Метаданные.РегистрыНакопления.ВзаиморасчётыПоПретензиям, "Просмотр");
		
	ИначеЕсли Логин = "Аудитор" Тогда
		
		// S5: техническая НСИ на чтение, регистр штрафов доступен, пересчёт таймингов закрыт.
		ДобавитьПроверкуПрава(Лог, "S5", Логин, Метаданные.Справочники.СтраныМира, "Чтение", Истина);
		ДобавитьПроверкуПрава(Лог, "S5", Логин, Метаданные.Справочники.СтраныМира, "Просмотр", Истина);
		ДобавитьПроверкуПрава(Лог, "S5", Логин, Метаданные.Справочники.СтраныМира, "Добавление", Ложь);
		ДобавитьПроверкуПрава(Лог, "S5", Логин, Метаданные.Справочники.СтраныМира, "ИнтерактивноеДобавление", Ложь);
		ДобавитьПроверкуПрава(Лог, "S5", Логин, Метаданные.Справочники.СтраныМира, "Изменение", Ложь);
		ДобавитьПроверкуПрава(Лог, "S5", Логин, Метаданные.Справочники.СтраныМира, "Редактирование", Ложь);
		ДобавитьПроверкуПрава(Лог, "S5", Логин, Метаданные.РегистрыНакопления.ШтрафыИКомпенсации, "Чтение", Истина);
		ДобавитьИнфоПробуПрава(Лог, "S5", Логин, Метаданные.РегистрыНакопления.ШтрафыИКомпенсации, "Просмотр");
		ДобавитьПроверкуПрава(Лог, "S5", Логин, Метаданные.Обработки.ПересчётТайминговМаршрутов, "Использование", Ложь);
		
	ИначеЕсли Логин = "РуководительНаправления" Тогда
		Лог.Добавить("S-|" + Логин + "|-|ролевые проверки ограничены S1/S8/S9|expected=-|actual=-|INFO");
	Иначе
		Лог.Добавить("S-|" + Логин + "|-|логин вне матрицы сценариев|expected=-|actual=-|INFO");
	КонецЕсли;
	
КонецПроцедуры

// S2 (данные): гид создаёт и ЗАПИСЫВАЕТ новый документ Инцидент без проведения.
// Обязательные реквизиты заимствуются из существующего инцидента-донора
// (у гида нет прав чтения ТипыИнцидентов, донор обходит это ограничение).
&НаСервере
Процедура СкретчИнцидент(Лог, Логин, ПутьМанифеста, ПутьЛога = "")
	
	Лог.Добавить("S2|" + Логин + "|Document.Инцидент|DATA: создание и запись нового документа|start|-|INFO");
	ЗаписатьЛог(ПутьЛога, Лог);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Инцидент.ЗаявкаНаТур КАК ЗаявкаНаТур,
		|	Инцидент.Турист КАК Турист,
		|	Инцидент.ТипИнцидента КАК ТипИнцидента,
		|	Инцидент.Объект КАК Объект,
		|	Инцидент.Поставщик КАК Поставщик,
		|	Инцидент.УровеньТяжести КАК УровеньТяжести,
		|	Инцидент.Статус КАК Статус,
		|	Инцидент.АвторРегистрации КАК АвторРегистрации,
		|	Инцидент.Ответственный КАК Ответственный
		|ИЗ
		|	Документ.Инцидент КАК Инцидент";
	
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		Лог.Добавить("S2|" + Логин + "|Document.Инцидент|DATA: выбор донора|expected=Истина|actual=ОШИБКА: "
			+ Однострочно(ОписаниеОшибки()) + "|FAIL");
		Возврат;
	КонецПопытки;
	Лог.Добавить("S2|" + Логин + "|Document.Инцидент|DATA: запрос донора выполнен|step|-|INFO");
	ЗаписатьЛог(ПутьЛога, Лог);
	
	Если Не Выборка.Следующий() Тогда
		Лог.Добавить("S2|" + Логин + "|Document.Инцидент|DATA: донор обязательных реквизитов"
			+ "|expected=Истина|actual=в ИБ нет ни одного инцидента|FAIL");
		Возврат;
	КонецЕсли;
	
	Попытка
		ДокументОбъект = Документы.Инцидент.СоздатьДокумент();
		ДокументОбъект.Дата = ТекущаяДатаСеанса();
		Лог.Добавить("S2|" + Логин + "|Document.Инцидент|DATA: объект создан, заполнение реквизитов|step|-|INFO");
		ЗаписатьЛог(ПутьЛога, Лог);
		ДокументОбъект.ЗаявкаНаТур = Выборка.ЗаявкаНаТур;
		ДокументОбъект.Турист = Выборка.Турист;
		ДокументОбъект.ТипИнцидента = Выборка.ТипИнцидента;
		ДокументОбъект.Объект = Выборка.Объект;
		ДокументОбъект.Поставщик = Выборка.Поставщик;
		ДокументОбъект.УровеньТяжести = Выборка.УровеньТяжести;
		ДокументОбъект.Статус = Выборка.Статус;
		ДокументОбъект.АвторРегистрации = Выборка.АвторРегистрации;
		ДокументОбъект.Ответственный = Выборка.Ответственный;
		ДокументОбъект.ДатаИнцидента = ТекущаяДатаСеанса();
		ДокументОбъект.Описание = "SCRATCH-TASK12 Автоматический тестовый инцидент S2 (подлежит удалению)";
		Лог.Добавить("S2|" + Логин + "|Document.Инцидент|DATA: реквизиты заполнены, вызов Записать()|step|-|INFO");
		ЗаписатьЛог(ПутьЛога, Лог);
		ДокументОбъект.Записать();
		Лог.Добавить("S2|" + Логин + "|Document.Инцидент|DATA: Записать() завершён без исключения|step|-|INFO");
		ЗаписатьЛог(ПутьЛога, Лог);
	Исключение
		Лог.Добавить("S2|" + Логин + "|Document.Инцидент|DATA: Записать()|expected=Истина|actual=ОШИБКА: "
			+ Однострочно(ОписаниеОшибки()) + "|FAIL");
		Возврат;
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(ДокументОбъект.Ссылка) Тогда
		Лог.Добавить("S2|" + Логин + "|Document.Инцидент|DATA: Записать()|expected=Истина"
			+ "|actual=запись отклонена проверкой ПередЗаписью|FAIL");
		Возврат;
	КонецЕсли;
	
	Лог.Добавить("S2|" + Логин + "|Document.Инцидент|DATA: Записать() нового документа|expected=Истина|actual=Истина (Номер="
		+ ДокументОбъект.Номер + ", Дата=" + Формат(ДокументОбъект.Дата, "ДФ=yyyyMMddHHmmss") + ")|PASS");
	Лог.Добавить("S2|" + Логин + "|Document.Инцидент|DATA: документ сохранён непроведённым (нет права проведения)|expected=Истина|actual="
		+ Формат(Не ДокументОбъект.Проведен, "БИ=Истина;БЛ=Ложь") + "|"
		+ ?(Не ДокументОбъект.Проведен, "PASS", "FAIL"));
	ДобавитьВМанифест(Лог, ПутьМанифеста, "DOC|Инцидент|" + Формат(ДокументОбъект.Дата, "ДФ=yyyyMMddHHmmss")
		+ "|" + ДокументОбъект.Номер + "|" + Логин + "|0");
	
КонецПроцедуры

// S3 (данные): оператор создаёт и ПРОВОДИТ новый документ ПодтверждениеУслуги.
// Успешное проведение доказывает права Insert/Update/Posting и запись движений.
&НаСервере
Процедура СкретчПодтверждениеУслуги(Лог, Логин, ПутьМанифеста, ПутьЛога = "")
	
	Лог.Добавить("S3|" + Логин + "|Document.ПодтверждениеУслуги|DATA: создание и проведение нового документа|start|-|INFO");
	ЗаписатьЛог(ПутьЛога, Лог);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Услуги.Ссылка КАК Заказ,
		|	Услуги.Ссылка.Поставщик КАК Поставщик,
		|	Услуги.Услуга КАК Услуга,
		|	Услуги.Объект КАК Объект,
		|	Услуги.ДатаНачала КАК ДатаНачала,
		|	Услуги.ДатаОкончания КАК ДатаОкончания
		|ИЗ
		|	Документ.ЗаказПоставщику.Услуги КАК Услуги";
	
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		Лог.Добавить("S3|" + Логин + "|Document.ПодтверждениеУслуги|DATA: выбор заказа-донора|expected=Истина|actual=ОШИБКА: "
			+ Однострочно(ОписаниеОшибки()) + "|FAIL");
		Возврат;
	КонецПопытки;
	Лог.Добавить("S3|" + Логин + "|Document.ПодтверждениеУслуги|DATA: запрос донора выполнен|step|-|INFO");
	ЗаписатьЛог(ПутьЛога, Лог);
	
	Если Не Выборка.Следующий() Тогда
		Лог.Добавить("S3|" + Логин + "|Document.ПодтверждениеУслуги|DATA: заказ-донор с услугами"
			+ "|expected=Истина|actual=в ИБ нет заказов поставщику со строками услуг|FAIL");
		Возврат;
	КонецЕсли;
	
	РезультатСверки = ПервоеЗначениеПеречисления("РезультатыСверки");
	Источник = ПервоеЗначениеПеречисления("ИсточникиПодтверждения");
	Если РезультатСверки = Неопределено Или Источник = Неопределено Тогда
		Лог.Добавить("S3|" + Логин + "|Document.ПодтверждениеУслуги|DATA: значения перечислений"
			+ "|expected=Истина|actual=перечисления РезультатыСверки/ИсточникиПодтверждения пусты|FAIL");
		Возврат;
	КонецЕсли;
	
	Попытка
		ДокументОбъект = Документы.ПодтверждениеУслуги.СоздатьДокумент();
		ДокументОбъект.Дата = ТекущаяДатаСеанса();
		ДокументОбъект.ЗаказПоставщику = Выборка.Заказ;
		ДокументОбъект.Поставщик = Выборка.Поставщик;
		ДокументОбъект.РезультатСверки = РезультатСверки;
		ДокументОбъект.Источник = Источник;
		ДокументОбъект.ВходящийНомер = "SCRATCH-TASK12";
		ДокументОбъект.СуммаДокумента = 0;
		
		СтрокаУслуги = ДокументОбъект.ПодтверждённыеУслуги.Добавить();
		СтрокаУслуги.Услуга = Выборка.Услуга;
		СтрокаУслуги.Объект = Выборка.Объект;
		СтрокаУслуги.ДатаНачала = ?(ЗначениеЗаполнено(Выборка.ДатаНачала), Выборка.ДатаНачала, ТекущаяДатаСеанса());
		СтрокаУслуги.ДатаОкончания = Выборка.ДатаОкончания;
		СтрокаУслуги.Количество = 1;
		СтрокаУслуги.Цена = 0;
		СтрокаУслуги.Сумма = 0;
		
		ДокументОбъект.Проведен = Истина;
		Лог.Добавить("S3|" + Логин + "|Document.ПодтверждениеУслуги|DATA: документ заполнен, вызов Записать(Проведение)|step|-|INFO");
		ЗаписатьЛог(ПутьЛога, Лог);
		ДокументОбъект.Записать();
		Лог.Добавить("S3|" + Логин + "|Document.ПодтверждениеУслуги|DATA: Записать(Проведение) завершён без исключения|step|-|INFO");
		ЗаписатьЛог(ПутьЛога, Лог);
	Исключение
		Лог.Добавить("S3|" + Логин + "|Document.ПодтверждениеУслуги|DATA: Записать(Проведение)|expected=Истина|actual=ОШИБКА: "
			+ Однострочно(ОписаниеОшибки()) + "|FAIL");
		Возврат;
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(ДокументОбъект.Ссылка) Тогда
		Лог.Добавить("S3|" + Логин + "|Document.ПодтверждениеУслуги|DATA: Записать(Проведение)|expected=Истина"
			+ "|actual=запись отклонена проверкой ПередЗаписью|FAIL");
		Возврат;
	КонецЕсли;
	Если Не ДокументОбъект.Проведен Тогда
		Лог.Добавить("S3|" + Логин + "|Document.ПодтверждениеУслуги|DATA: проведение|expected=Истина"
			+ "|actual=документ записан, но не проведён|FAIL");
	Иначе
		Лог.Добавить("S3|" + Логин + "|Document.ПодтверждениеУслуги|DATA: создание и проведение нового документа|expected=Истина|actual=Истина (Номер="
			+ ДокументОбъект.Номер + ", Дата=" + Формат(ДокументОбъект.Дата, "ДФ=yyyyMMddHHmmss") + ")|PASS");
	КонецЕсли;
	ДобавитьВМанифест(Лог, ПутьМанифеста, "DOC|ПодтверждениеУслуги|" + Формат(ДокументОбъект.Дата, "ДФ=yyyyMMddHHmmss")
		+ "|" + ДокументОбъект.Номер + "|" + Логин + "|" + ?(ДокументОбъект.Проведен, "1", "0"));
	
КонецПроцедуры

// S6: доказательство привязки «свой» - записи справочника Пользователи существуют
// с точным ИмяПользователяИБ и непустой привязкой Сотрудника (для админ-прогонов LIST/FIX).
&НаСервере
Процедура ПроверитьСценарийS6(Лог)
	
	Лог.Добавить("");
	Лог.Добавить("--- S6: доказательство привязки «свой» (Пользователи/Сотрудники) ---");
	
	Ожидаемые = Новый Соответствие;
	Ожидаемые.Вставить("оператор (тест)", "ОператорСопровождения");
	Ожидаемые.Вставить("гид (тест)", "ТурГид");
	
	ПривязкиСотрудников = Новый Соответствие;
	ЗапросПривязок = Новый Запрос;
	ЗапросПривязок.Текст =
		"ВЫБРАТЬ
		|	Сотрудники.Пользователь1С КАК Пользователь
		|ИЗ
		|	Справочник.Сотрудники КАК Сотрудники";
	ВыборкаПривязок = ЗапросПривязок.Выполнить().Выбрать();
	Пока ВыборкаПривязок.Следующий() Цикл
		Если ЗначениеЗаполнено(ВыборкаПривязок.Пользователь) Тогда
			ПривязкиСотрудников.Вставить(ВыборкаПривязок.Пользователь, Истина);
		КонецЕсли;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Пользователи.Код КАК Код,
		|	Пользователи.Наименование КАК Наименование,
		|	Пользователи.Ссылка КАК Ссылка,
		|	Пользователи.ИмяПользователяИБ КАК ИмяПользователяИБ
		|ИЗ
		|	Справочник.Пользователи КАК Пользователи
		|УПОРЯДОЧИТЬ ПО
		|	Пользователи.Код";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ОжиданиеИмени = Ожидаемые.Получить(НРег(Выборка.Наименование));
		Если ОжиданиеИмени = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ДобавитьСтрокуСценария(Лог, "S6", "Администратор",
			"Пользователи[" + Выборка.Код + "] """ + Выборка.Наименование + """",
			"ИмяПользователяИБ точное совпадение", ОжиданиеИмени, Выборка.ИмяПользователяИБ);
		
		СотрудникНайден = ПривязкиСотрудников.Получить(Выборка.Ссылка) = Истина;
		ДобавитьСтрокуСценария(Лог, "S6", "Администратор",
			"Пользователи[" + Выборка.Код + "] """ + Выборка.Наименование + """",
			"Сотрудник привязан (не пустой)", Истина, СотрудникНайден);
	КонецЦикла;
	
	Лог.Добавить("S6|Администратор|Формы|фильтрация «своих» данных есть логика форм, не права|expected=привязка доказана|actual=привязка доказана|PASS");
	
КонецПроцедуры

// CLEANUP: удаляет скретч-документы S2/S3 по манифесту и очищает манифест.
&НаСервере
Процедура ОчиститьСкретчДокументы(Лог, ПутьМанифеста)
	
	Лог.Добавить("--- CLEANUP: удаление скретч-документов по манифесту ---");
	
	Если ПустаяСтрока(ПутьМанифеста) Тогда
		Лог.Добавить("CLEANUP|манифест|путь|expected=путь к манифесту|actual=не задан|FAIL");
		Возврат;
	КонецЕсли;
	
	СтрокиМанифеста = Новый Массив;
	Попытка
		Чтение = Новый ЧтениеТекста(ПутьМанифеста, КодировкаТекста.UTF8);
		ОчереднаяСтрока = Чтение.ПрочитатьСтроку();
		Пока ОчереднаяСтрока <> Неопределено Цикл
			Если Не ПустаяСтрока(ОчереднаяСтрока) Тогда
				СтрокиМанифеста.Добавить(ОчереднаяСтрока);
			КонецЕсли;
			ОчереднаяСтрока = Чтение.ПрочитатьСтроку();
		КонецЦикла;
		Чтение.Закрыть();
	Исключение
		Лог.Добавить("CLEANUP|манифест|чтение|expected=Истина|actual=ОШИБКА: " + Однострочно(ОписаниеОшибки()) + "|FAIL");
		Возврат;
	КонецПопытки;
	
	Лог.Добавить("CLEANUP|манифест|строк к удалению|expected=-|actual=" + СтрокиМанифеста.Количество() + "|INFO");
	
	Для Каждого СтрокаМанифеста Из СтрокиМанифеста Цикл
		ЧастиСтроки = СтрРазделить(СтрокаМанифеста, "|");
		Если ЧастиСтроки.Количество() < 6 Или ВРег(СокрЛП(ЧастиСтроки[0])) <> "DOC" Тогда
			Продолжить;
		КонецЕсли;
		ОчиститьСкретчДокумент(Лог, СокрЛП(ЧастиСтроки[1]), СокрЛП(ЧастиСтроки[2]), СокрЛП(ЧастиСтроки[3]));
	КонецЦикла;
	
	// Обход сирот: скретч-документы, не попавшие в манифест (следствия убитых сеансов).
	УбратьСиротскиеСкретчДокументы(Лог);
	
	// Манифест очищается - свидетельство, что скретч-данных не осталось.
	Попытка
		Запись = Новый ЗаписьТекста(ПутьМанифеста, КодировкаТекста.UTF8);
		Запись.Закрыть();
		Лог.Добавить("CLEANUP|манифест|очищен после удаления|expected=пуст|actual=пуст|PASS");
	Исключение
		Лог.Добавить("CLEANUP|манифест|очистка|expected=Истина|actual=ОШИБКА: " + Однострочно(ОписаниеОшибки()) + "|FAIL");
	КонецПопытки;
	
КонецПроцедуры

// Обход сирот по маркеру SCRATCH-TASK12: удаляет скретч-документы, которых нет в манифесте
// (документы убитых сеансов). Повторный запуск CLEANUP с результатом 0 доказывает чистоту ИБ.
&НаСервере
Процедура УбратьСиротскиеСкретчДокументы(Лог)
	
	ТекстыЗапросов = Новый Массив;
	ТекстыЗапросов.Добавить(
		"ВЫБРАТЬ
		|	Инцидент.Ссылка КАК Ссылка,
		|	Инцидент.Номер КАК Номер
		|ИЗ
		|	Документ.Инцидент КАК Инцидент
		|ГДЕ
		|	Инцидент.Описание ПОДОБНО ""SCRATCH-TASK12%""");
	ТекстыЗапросов.Добавить(
		"ВЫБРАТЬ
		|	ПодтверждениеУслуги.Ссылка КАК Ссылка,
		|	ПодтверждениеУслуги.Номер КАК Номер
		|ИЗ
		|	Документ.ПодтверждениеУслуги КАК ПодтверждениеУслуги
		|ГДЕ
		|	ПодтверждениеУслуги.ВходящийНомер = ""SCRATCH-TASK12""");
	
	НайденоИнциденты = УдалитьСиротПоЗапросу(Лог, ТекстыЗапросов[0]);
	НайденоПодтверждения = УдалитьСиротПоЗапросу(Лог, ТекстыЗапросов[1]);
	НайденоСирот = НайденоИнциденты + НайденоПодтверждения;
	
	Лог.Добавить("CLEANUP|сироты|найдено по маркеру SCRATCH-TASK12|actual=" + НайденоСирот + "|INFO");
	
КонецПроцедуры

// Выполняет запрос сирот и удаляет найденные документы; возвращает число найденных сирот.
&НаСервере
Функция УдалитьСиротПоЗапросу(Лог, ТекстЗапроса)
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		Лог.Добавить("CLEANUP|сироты|запрос|expected=Истина|actual=ОШИБКА: "
			+ Однострочно(ОписаниеОшибки()) + "|FAIL");
		Возврат 0;
	КонецПопытки;
	
	Найдено = 0;
	Пока Выборка.Следующий() Цикл
		Найдено = Найдено + 1;
		Попытка
			ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
			Если ДокументОбъект.Проведен Тогда
				ДокументОбъект.Проведен = Ложь;
				ДокументОбъект.Записать();
			КонецЕсли;
			ДокументОбъект.Удалить();
			Лог.Добавить("CLEANUP|сирота|" + Выборка.Ссылка.Метаданные().ПолноеИмя() + " Номер=" + Выборка.Номер
				+ "|удаление|expected=Истина|actual=Истина|PASS");
		Исключение
			Лог.Добавить("CLEANUP|сирота|Номер=" + Выборка.Номер
				+ "|удаление|expected=Истина|actual=ОШИБКА: " + Однострочно(ОписаниеОшибки()) + "|FAIL");
		КонецПопытки;
	КонецЦикла;
	
	Возврат Найдено;
	
КонецФункции

&НаСервере
Процедура ОчиститьСкретчДокумент(Лог, ИмяДокумента, ДатаСтрока, Номер)
	
	ДатаДокумента = Дата(Число(Лев(ДатаСтрока, 4)), Число(Сред(ДатаСтрока, 5, 2)), Число(Сред(ДатаСтрока, 7, 2)),
		Число(Сред(ДатаСтрока, 9, 2)), Число(Сред(ДатаСтрока, 11, 2)), Число(Сред(ДатаСтрока, 13, 2)));
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Д.Ссылка КАК Ссылка
		|ИЗ
		|	Документ." + ИмяДокумента + " КАК Д
		|ГДЕ
		|	Д.Номер = &Номер
		|	И Д.Дата = &Дата";
	Запрос.УстановитьПараметр("Номер", Номер);
	Запрос.УстановитьПараметр("Дата", ДатаДокумента);
	
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
		Если Не Выборка.Следующий() Тогда
			Лог.Добавить("CLEANUP|Document." + ИмяДокумента + " Номер=" + Номер
				+ "|поиск|expected=документ найден|actual=не найден (уже удалён?)|FAIL");
			Возврат;
		КонецЕсли;
		ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
		
		// Защита от удаления чужих документов: обязателен маркер SCRATCH-TASK12.
		Если ИмяДокумента = "Инцидент" И СтрНайти(ДокументОбъект.Описание, "SCRATCH-TASK12") = 0 Тогда
			Лог.Добавить("CLEANUP|Document." + ИмяДокумента + " Номер=" + Номер
				+ "|маркер|expected=SCRATCH-TASK12|actual=маркер не найден, удаление пропущено|FAIL");
			Возврат;
		КонецЕсли;
		Если ИмяДокумента = "ПодтверждениеУслуги" И ДокументОбъект.ВходящийНомер <> "SCRATCH-TASK12" Тогда
			Лог.Добавить("CLEANUP|Document." + ИмяДокумента + " Номер=" + Номер
				+ "|маркер|expected=SCRATCH-TASK12|actual=маркер не найден, удаление пропущено|FAIL");
			Возврат;
		КонецЕсли;
		
		Если ДокументОбъект.Проведен Тогда
			ДокументОбъект.Проведен = Ложь;
			ДокументОбъект.Записать();
			Лог.Добавить("CLEANUP|Document." + ИмяДокумента + " Номер=" + Номер
				+ "|отмена проведения|expected=Истина|actual=Истина|PASS");
		КонецЕсли;
		
		ДокументОбъект.УстановитьПометкуУдаления(Истина);
		Лог.Добавить("CLEANUP|Document." + ИмяДокумента + " Номер=" + Номер
			+ "|пометка удаления|expected=Истина|actual=Истина|PASS");
		
		ДокументОбъект.Удалить();
		Лог.Добавить("CLEANUP|Document." + ИмяДокумента + " Номер=" + Номер
			+ "|фактическое удаление|expected=Истина|actual=Истина|PASS");
	Исключение
		Лог.Добавить("CLEANUP|Document." + ИмяДокумента + " Номер=" + Номер
			+ "|удаление|expected=Истина|actual=ОШИБКА: " + Однострочно(ОписаниеОшибки()) + "|FAIL");
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьВМанифест(Лог, ПутьМанифеста, СтрокаМанифеста)
	
	Если ПустаяСтрока(ПутьМанифеста) Тогда
		Лог.Добавить("МАНИФЕСТ|-|-|путь манифеста не задан, строка не сохранена: " + СтрокаМанифеста + "|WARN");
		Возврат;
	КонецЕсли;
	Лог.Добавить("MANIFEST: " + СтрокаМанифеста);
	Попытка
		Запись = Новый ЗаписьТекста(ПутьМанифеста, КодировкаТекста.UTF8, Истина);
		Запись.ЗаписатьСтроку(СтрокаМанифеста);
		Запись.Закрыть();
	Исключение
		Лог.Добавить("МАНИФЕСТ|-|-|ошибка записи манифеста: " + Однострочно(ОписаниеОшибки()) + "|WARN");
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьПроверкуПрава(Лог, Сценарий, Логин, ОбъектМетаданных, ИмяПрава, Ожидание)
	
	Попытка
		Факт = ПравоДоступа(ИмяПрава, ОбъектМетаданных);
	Исключение
		Лог.Добавить(Сценарий + "|" + Логин + "|" + ОбъектМетаданных.ПолноеИмя() + "|" + ИмяПрава
			+ "|expected=" + СтрокаБулева(Ожидание) + "|actual=ОШИБКА: " + Однострочно(ОписаниеОшибки()) + "|FAIL");
		Возврат;
	КонецПопытки;
	ДобавитьСтрокуСценария(Лог, Сценарий, Логин, ОбъектМетаданных.ПолноеИмя(), ИмяПрава, Ожидание, Факт);
	
КонецПроцедуры

// Проба права, результат которой не влияет на вердикт (INFO): у регистров нет
// отдельного права «Просмотр» в ролевых XML - матрица оперирует правом «Чтение».
&НаСервере
Процедура ДобавитьИнфоПробуПрава(Лог, Сценарий, Логин, ОбъектМетаданных, ИмяПрава)
	
	Попытка
		Факт = Формат(ПравоДоступа(ИмяПрава, ОбъектМетаданных), "БИ=Истина;БЛ=Ложь");
	Исключение
		Факт = "ОШИБКА: " + Однострочно(ОписаниеОшибки());
	КонецПопытки;
	Лог.Добавить(Сценарий + "|" + Логин + "|" + ОбъектМетаданных.ПолноеИмя() + "|" + ИмяПрава
		+ " (проба)|expected=-|actual=" + Факт + "|INFO");
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьСтрокуСценария(Лог, Сценарий, Логин, ОбъектОписание, Проверка, Ожидание, Факт)
	
	Вердикт = ?(Ожидание = Факт, "PASS", "FAIL");
	Лог.Добавить(Сценарий + "|" + Логин + "|" + ОбъектОписание + "|" + Проверка
		+ "|expected=" + СтрокаБулева(Ожидание) + "|actual=" + СтрокаБулева(Факт) + "|" + Вердикт);
	
КонецПроцедуры

&НаСервере
Функция СтрокаБулева(Значение)
	
	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Формат(Значение, "БИ=Истина;БЛ=Ложь");
	КонецЕсли;
	Возврат Строка(Значение);
	
КонецФункции

&НаСервере
Функция Однострочно(ТекстОшибки)
	
	Возврат СтрЗаменить(СтрЗаменить(СокрЛП(ТекстОшибки), Символы.ПС, " "), Символы.ВК, "");
	
КонецФункции

&НаСервере
Функция ПраваПеречисленийПроба()
	
	Попытка
		Флаг = ПравоДоступа("Чтение", Метаданные.Перечисления.ВидыУслуг);
		Возврат "N/A by platform (проба Чтение вернула " + Формат(Флаг, "БИ=Истина;БЛ=Ложь") + ")";
	Исключение
		Возврат "N/A by platform (проба Чтение: " + Однострочно(ОписаниеОшибки()) + ")";
	КонецПопытки;
	
КонецФункции

&НаСервере
Функция ПервоеЗначениеПеречисления(ИмяПеречисления)
	
	ОписаниеПеречисления = Метаданные.Перечисления.Найти(ИмяПеречисления);
	Если ОписаниеПеречисления = Неопределено Или ОписаниеПеречисления.ЗначенияПеречисления.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Перечисления[ИмяПеречисления][ОписаниеПеречисления.ЗначенияПеречисления[0].Имя];
	
КонецФункции

#КонецОбласти

#Область РегрессияСоседнихСпек

// Задача 13: регрессия соседних спецификаций (navigation-and-commands, data-processors,
// data-exchange, document-posting). Формат строк доказательств - как у батареи S1-S9:
//   <R>|<логин>|<объект>|<проверка>|expected=<ожидание>|actual=<факт>|PASS/FAIL/INFO
// Профильные пользователи: R1 (команды по правам) + R2 (матрица Использование обработок).
// Администратор: R3 (экспортная половина ОбменСФайлами) + R4 (смоук проведения) + R5 (полный путь).

&НаСервере
Процедура ВыполнитьРегрессию(Лог, ОжидаемыйЛогин, ПутьЛога, ПутьОбмена)
	
	ФактическийЛогин = "";
	Попытка
		ТекущийПользовательИБ = ПользователиИнформационнойБазы.ТекущийПользователь();
		Если ТекущийПользовательИБ <> Неопределено Тогда
			ФактическийЛогин = ТекущийПользовательИБ.Имя;
		КонецЕсли;
	Исключение
		ФактическийЛогин = "";
	КонецПопытки;
	
	Логин = ?(ПустаяСтрока(ФактическийЛогин), ОжидаемыйЛогин, ФактическийЛогин);
	
	Лог.Добавить("");
	Лог.Добавить("--- Регрессия R1-R5 соседних спецификаций, логин сеанса """ + Логин + """ ---");
	
	Если Не ПустаяСтрока(ОжидаемыйЛогин) И Не ПустаяСтрока(ФактическийЛогин)
		И ВРег(СокрЛП(ФактическийЛогин)) <> ВРег(СокрЛП(ОжидаемыйЛогин)) Тогда
		Лог.Добавить("R0|" + ОжидаемыйЛогин + "|логин|логин сеанса совпадает с ожидаемым|expected="
			+ ОжидаемыйЛогин + "|actual=" + ФактическийЛогин + "|FAIL");
	Иначе
		Лог.Добавить("R0|" + Логин + "|логин|логин сеанса совпадает с ожидаемым|expected="
			+ ОжидаемыйЛогин + "|actual=" + ФактическийЛогин + "|PASS");
	КонецЕсли;
	
	Если Логин = "Администратор" Тогда
		РегрессияР3Экспорт(Лог, Логин, ПутьОбмена, ПутьЛога);
		ЗаписатьЛог(ПутьЛога, Лог);
		РегрессияР4СмоукПроведения(Лог, Логин, ПутьЛога);
		ЗаписатьЛог(ПутьЛога, Лог);
		// R5 (серверная часть): права Использование на обе обработки; открытие форм - на клиенте.
		ДобавитьПроверкуПрава(Лог, "R5", Логин, Метаданные.Обработки.СводкаСтатусов, "Использование", Истина);
		ДобавитьПроверкуПрава(Лог, "R5", Логин, Метаданные.Обработки.ПросроченныеСрокиИSLA, "Использование", Истина);
	Иначе
		ПроверитьР1КомандыПоЛогину(Лог, Логин);
		ЗаписатьЛог(ПутьЛога, Лог);
		ПроверитьР2МатрицуОбработок(Лог, Логин);
	КонецЕсли;
	
	ЗаписатьЛог(ПутьЛога, Лог);
	
КонецПроцедуры

// R1: права, по которым командный интерфейс показывает/скрывает команды (navigation-and-commands).
// Матрица - по ролевым JSON openspec/changes/add-access-roles/roles/*.json.
&НаСервере
Процедура ПроверитьР1КомандыПоЛогину(Лог, Логин)
	
	Если Логин = "ОператорСопровождения" Тогда
		ДобавитьПроверкуПрава(Лог, "R1", Логин, Метаданные.Документы.ПретензияПоставщику, "Просмотр", Ложь);
		ДобавитьПроверкуПрава(Лог, "R1", Логин, Метаданные.Документы.ПодтверждениеУслуги, "ИнтерактивноеПроведение", Истина);
		ДобавитьПроверкуПрава(Лог, "R1", Логин, Метаданные.Справочники.Туристы, "ИнтерактивноеДобавление", Истина);
	ИначеЕсли Логин = "КоординаторЛогистики" Тогда
		ДобавитьПроверкуПрава(Лог, "R1", Логин, Метаданные.Документы.МаршрутныйЛист, "ИнтерактивноеДобавление", Истина);
		ДобавитьПроверкуПрава(Лог, "R1", Логин, Метаданные.Документы.МаршрутныйЛист, "ИнтерактивноеПроведение", Истина);
		ДобавитьПроверкуПрава(Лог, "R1", Логин, Метаданные.Документы.ПретензияПоставщику, "Чтение", Ложь);
	ИначеЕсли Логин = "ТурГид" Тогда
		ДобавитьПроверкуПрава(Лог, "R1", Логин, Метаданные.Документы.Инцидент, "ИнтерактивноеДобавление", Истина);
		ДобавитьПроверкуПрава(Лог, "R1", Логин, Метаданные.Документы.Инцидент, "Проведение", Ложь);
		ДобавитьПроверкуПрава(Лог, "R1", Логин, Метаданные.Документы.МаршрутныйЛист, "ИнтерактивноеПроведение", Ложь);
	ИначеЕсли Логин = "МенеджерПоПретензиям" Тогда
		ДобавитьПроверкуПрава(Лог, "R1", Логин, Метаданные.Документы.ПретензияПоставщику, "ИнтерактивноеПроведение", Истина);
		ДобавитьПроверкуПрава(Лог, "R1", Логин, Метаданные.Документы.Инцидент, "ИнтерактивноеДобавление", Истина);
		ДобавитьПроверкуПрава(Лог, "R1", Логин, Метаданные.Документы.МаршрутныйЛист, "Редактирование", Ложь);
	ИначеЕсли Логин = "РуководительНаправления" Тогда
		ДобавитьПроверкуПрава(Лог, "R1", Логин, Метаданные.Документы.Инцидент, "ИнтерактивноеПроведение", Ложь);
		ДобавитьПроверкуПрава(Лог, "R1", Логин, Метаданные.Справочники.Туристы, "Редактирование", Ложь);
		ДобавитьПроверкуПрава(Лог, "R1", Логин, Метаданные.РегистрыНакопления.ВзаиморасчётыПоПретензиям, "Чтение", Истина);
	ИначеЕсли Логин = "Аудитор" Тогда
		ДобавитьПроверкуПрава(Лог, "R1", Логин, Метаданные.Справочники.Туристы, "Изменение", Ложь);
		ДобавитьПроверкуПрава(Лог, "R1", Логин, Метаданные.Справочники.Туристы, "Чтение", Истина);
		ДобавитьПроверкуПрава(Лог, "R1", Логин, Метаданные.Документы.Инцидент, "ИнтерактивноеДобавление", Ложь);
	Иначе
		Лог.Добавить("R1|" + Логин + "|-|логин вне матрицы R1|expected=-|actual=-|INFO");
	КонецЕсли;
	
КонецПроцедуры

// R2: матрица «Использование» всех пяти обработок (data-processors, пункт 6 спецификации).
&НаСервере
Процедура ПроверитьР2МатрицуОбработок(Лог, Логин)
	
	ИменаОбработок = Новый Массив;
	ИменаОбработок.Добавить("ПересчётТайминговМаршрутов");
	ИменаОбработок.Добавить("ПросроченныеСрокиИSLA");
	ИменаОбработок.Добавить("ФормированиеЗапросовПоставщикам");
	ИменаОбработок.Добавить("СводкаСтатусов");
	ИменаОбработок.Добавить("ОбменСФайлами");
	
	Матрица = МатрицаР2Использование();
	
	Для Каждого ИмяОбработки Из ИменаОбработок Цикл
		ОписаниеОбработки = Метаданные.Обработки.Найти(ИмяОбработки);
		Если ОписаниеОбработки = Неопределено Тогда
			Лог.Добавить("R2|" + Логин + "|Обработка." + ИмяОбработки + "|Использование|expected=объект найден"
				+ "|actual=объект метаданных не найден|FAIL");
			Продолжить;
		КонецЕсли;
		КлючМатрицы = Логин + "." + ИмяОбработки;
		Ожидание = Матрица.Получить(КлючМатрицы);
		Если Ожидание = Неопределено Тогда
			Ожидание = Ложь;
		КонецЕсли;
		ДобавитьПроверкуПрава(Лог, "R2", Логин, ОписаниеОбработки, "Использование", Ожидание);
	КонецЦикла;
	
КонецПроцедуры

// Положительные ячейки матрицы R2 (всё неперечисленное для профильных пользователей = Ложь).
&НаСервере
Функция МатрицаР2Использование()
	
	Матрица = Новый Соответствие;
	Матрица.Вставить("ОператорСопровождения.ПросроченныеСрокиИSLA", Истина);
	Матрица.Вставить("ОператорСопровождения.ФормированиеЗапросовПоставщикам", Истина);
	Матрица.Вставить("ОператорСопровождения.СводкаСтатусов", Истина);
	Матрица.Вставить("КоординаторЛогистики.ПересчётТайминговМаршрутов", Истина);
	Матрица.Вставить("КоординаторЛогистики.СводкаСтатусов", Истина);
	Матрица.Вставить("МенеджерПоПретензиям.СводкаСтатусов", Истина);
	Матрица.Вставить("РуководительНаправления.ПросроченныеСрокиИSLA", Истина);
	Матрица.Вставить("РуководительНаправления.СводкаСтатусов", Истина);
	Матрица.Вставить("Аудитор.СводкаСтатусов", Истина);
	Возврат Матрица;
	
КонецФункции

// R3 (data-exchange): экспортная половина обмена - выгрузка номенклатуры в CSV под администратором.
// Импортная половина НЕ выполняется (изменила бы демо-данные); она покрыта верификацией
// архивного изменения add-csv-data-exchange; право-сторона (Оператор: Использование=Ложь) - в R2.
&НаСервере
Процедура РегрессияР3Экспорт(Лог, Логин, ПутьОбмена, ПутьЛога)
	
	Лог.Добавить("R3|" + Логин + "|Обработка.ОбменСФайлами|импортная половина|expected=-"
		+ "|actual=не выполняется (защита демо-данных); покрыта верификацией add-csv-data-exchange|INFO");
	Лог.Добавить("R3|" + Логин + "|Обработка.ОбменСФайлами|право-сторона: ОператорСопровождения Использование"
		+ "|expected=Ложь|actual=см. строки R2 сеанса ОператорСопровождения|INFO");
	
	Если ПустаяСтрока(ПутьОбмена) Тогда
		Лог.Добавить("R3|" + Логин + "|Обработка.ОбменСФайлами|путь CSV-экспорта|expected=путь задан|actual=не задан|FAIL");
		Возврат;
	КонецЕсли;
	
	ДобавитьИнфоПробуПрава(Лог, "R3", Логин, Метаданные.Обработки.ОбменСФайлами, "Использование");
	
	Лог.Добавить("R3|" + Логин + "|Обработка.ОбменСФайлами|ВыгрузитьНоменклатуру(" + ПутьОбмена + ")|start|-|INFO");
	ЗаписатьЛог(ПутьЛога, Лог);
	
	Попытка
		ОбъектОбмена = Обработки.ОбменСФайлами.Создать();
		ОтчётОбмена = ОбъектОбмена.НовыйОтчёт();
		ОбъектОбмена.ВыгрузитьНоменклатуру(ПутьОбмена, ОтчётОбмена);
	Исключение
		Лог.Добавить("R3|" + Логин + "|Обработка.ОбменСФайлами|экспорт номенклатуры в CSV|expected=Истина|actual=ОШИБКА: "
			+ Однострочно(ОписаниеОшибки()) + "|FAIL");
		Возврат;
	КонецПопытки;
	
	Вердикт = "";
	Попытка
		Вердикт = Строка(ОбъектОбмена.ВердиктОтчёта(ОтчётОбмена));
	Исключение
		Вердикт = "не прочитан: " + Однострочно(ОписаниеОшибки());
	КонецПопытки;
	
	КоличествоСтрок = 0;
	ПерваяСтрока = "";
	ФайлПрочитан = Ложь;
	Попытка
		Чтение = Новый ЧтениеТекста(ПутьОбмена);
		СтрокаФайла = Чтение.ПрочитатьСтроку();
		Пока СтрокаФайла <> Неопределено Цикл
			КоличествоСтрок = КоличествоСтрок + 1;
			Если КоличествоСтрок = 1 Тогда
				ПерваяСтрока = СтрокаФайла;
			КонецЕсли;
			СтрокаФайла = Чтение.ПрочитатьСтроку();
		КонецЦикла;
		Чтение.Закрыть();
		ФайлПрочитан = Истина;
	Исключение
		Лог.Добавить("R3|" + Логин + "|" + ПутьОбмена + "|чтение CSV|expected=Истина|actual=ОШИБКА: "
			+ Однострочно(ОписаниеОшибки()) + "|FAIL");
	КонецПопытки;
	
	Если ФайлПрочитан Тогда
		ДобавитьСтрокуСценария(Лог, "R3", Логин, "Обработка.ОбменСФайлами (экспорт Номенклатура)",
			"CSV-файл экспорта создан и непустой", Истина, КоличествоСтрок > 0);
		Лог.Добавить("R3|" + Логин + "|" + ПутьОбмена + "|строк=" + КоличествоСтрок + "|вердикт=" + Вердикт
			+ "|заголовок=" + Лев(ПерваяСтрока, 200) + "|INFO");
	КонецЕсли;
	
КонецПроцедуры

// R4 (document-posting, админ-смоук): один демо-документ ПодтверждениеУслуги проводится/
// распроводится и возвращается в исходное состояние. Нулевое чистое изменение данных.
&НаСервере
Процедура РегрессияР4СмоукПроведения(Лог, Логин, ПутьЛога)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ПодтверждениеУслуги.Ссылка КАК Ссылка,
		|	ПодтверждениеУслуги.Номер КАК Номер,
		|	ПодтверждениеУслуги.Дата КАК Дата,
		|	ПодтверждениеУслуги.Проведен КАК Проведен
		|ИЗ
		|	Документ.ПодтверждениеУслуги КАК ПодтверждениеУслуги
		|ГДЕ
		|	НЕ ПодтверждениеУслуги.ВходящийНомер = ""SCRATCH-TASK12""
		|УПОРЯДОЧИТЬ ПО
		|	ПодтверждениеУслуги.Дата, ПодтверждениеУслуги.Номер";
	
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		Лог.Добавить("R4|" + Логин + "|Document.ПодтверждениеУслуги|выбор демо-документа|expected=Истина|actual=ОШИБКА: "
			+ Однострочно(ОписаниеОшибки()) + "|FAIL");
		Возврат;
	КонецПопытки;
	
	Если Не Выборка.Следующий() Тогда
		Лог.Добавить("R4|" + Логин + "|Document.ПодтверждениеУслуги|демо-документ|expected=найден|actual=в ИБ нет документов|FAIL");
		Возврат;
	КонецЕсли;
	
	СсылкаДокумента = Выборка.Ссылка;
	ИсходноПроведен = Выборка.Проведен;
	ОписаниеДокумента = "Document.ПодтверждениеУслуги Номер=" + Выборка.Номер
		+ " Дата=" + Формат(Выборка.Дата, "ДФ=yyyyMMddHHmmss");
	
	Лог.Добавить("R4|" + Логин + "|" + ОписаниеДокумента + "|состояние до старта|expected=-|actual=Проведен="
		+ СтрокаБулева(ИсходноПроведен) + "|INFO");
	ЗаписатьЛог(ПутьЛога, Лог);
	
	// Переход в противоположное состояние (Провести или ОтменитьПроведение).
	Попытка
		ДокументОбъект = СсылкаДокумента.ПолучитьОбъект();
		ДокументОбъект.Проведен = Не ИсходноПроведен;
		ДокументОбъект.Записать();
		ПромежуточноПроведен = СсылкаДокумента.Проведен;
		ДобавитьСтрокуСценария(Лог, "R4", Логин, ОписаниеДокумента,
			?(ИсходноПроведен, "ОтменитьПроведение (код)", "Провести (код)"),
			Не ИсходноПроведен, ПромежуточноПроведен);
		ЗаписатьЛог(ПутьЛога, Лог);
	Исключение
		Лог.Добавить("R4|" + Логин + "|" + ОписаниеДокумента + "|смена состояния проведения|expected=Истина|actual=ОШИБКА: "
			+ Однострочно(ОписаниеОшибки()) + "|FAIL");
	КонецПопытки;
	
	// Безусловное восстановление исходного состояния (нулевое чистое изменение данных).
	Попытка
		ДокументОбъект = СсылкаДокумента.ПолучитьОбъект();
		Если ДокументОбъект.Проведен <> ИсходноПроведен Тогда
			ДокументОбъект.Проведен = ИсходноПроведен;
			ДокументОбъект.Записать();
		КонецЕсли;
		ФинальноПроведен = СсылкаДокумента.Проведен;
		ДобавитьСтрокуСценария(Лог, "R4", Логин, ОписаниеДокумента,
			"восстановление исходного состояния (нулевое чистое изменение)", ИсходноПроведен, ФинальноПроведен);
	Исключение
		Лог.Добавить("R4|" + Логин + "|" + ОписаниеДокумента + "|восстановление состояния|expected=Истина|actual=ОШИБКА: "
			+ Однострочно(ОписаниеОшибки()) + "|FAIL");
	КонецПопытки;
	
КонецПроцедуры

// Дописывает клиентские строки R5 в конец файла лога (админ не в безопасном режиме -
// файловая запись доступна); при недоступности записи строки уходят в /Out сеанса.
&НаКлиенте
Процедура ДобавитьСтрокиРегрессии(ПутьЛога, Строки)
	
	ДобавитьСтрокиРегрессииНаСервере(ПутьЛога, Строки);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьСтрокиРегрессииНаСервере(ПутьЛога, Строки)
	
	Если ПустаяСтрока(ПутьЛога) Тогда
		Для Каждого СтрокаЛога Из Строки Цикл
			Сообщить(СтрокаЛога);
		КонецЦикла;
		Возврат;
	КонецЕсли;
	
	// Дописываем клиентские строки к серверному логу: читаем существующее содержимое
	// и перезаписываем файл целиком проверенным ЗаписатьЛог (конструктор ЗаписьТекста
	// с флагом «Добавлять» на тонком клиенте обрезал файл и писал «Да» вместо перевода строки).
	ПолныйЛог = Новый Массив;
	Попытка
		Чтение = Новый ЧтениеТекста(ПутьЛога, КодировкаТекста.UTF8);
		СтрокаФайла = Чтение.ПрочитатьСтроку();
		Пока СтрокаФайла <> Неопределено Цикл
			ПолныйЛог.Добавить(СтрокаФайла);
			СтрокаФайла = Чтение.ПрочитатьСтроку();
		КонецЦикла;
		Чтение.Закрыть();
	Исключение
		// Файл ещё не создан или недоступен - начинаем с чистого листа.
		ПолныйЛог = Новый Массив;
	КонецПопытки;
	
	Для Каждого СтрокаЛога Из Строки Цикл
		ПолныйЛог.Добавить(СтрокаЛога);
	КонецЦикла;
	
	ЗаписатьЛог(ПутьЛога, ПолныйЛог, Истина);
	
КонецПроцедуры

#КонецОбласти
