#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ВыполнитьПроверку(ПараметрЗапуска);
	ЗавершитьРаботуСистемы(Ложь);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ВыполнитьПроверку(ПутьЛога)
	
	Лог = Новый Массив;
	Итог = Новый Структура("Нарушений", 0);
	
	Лог.Добавить("=== Проверка демо-набора, " + Формат(ТекущаяДата(), "ДЛФ=DT") + " ===");
	Лог.Добавить("");
	
	Попытка
		ПроверитьКоличества(Лог, Итог);
		ПроверитьСсылки(Лог, Итог);
		ПроверитьТабличныеЧасти(Лог, Итог);
		ПроверитьПравила(Лог, Итог);
	Исключение
		Лог.Добавить("");
		Лог.Добавить("ОШИБКА ПРОВЕРКИ: " + ОписаниеОшибки());
		Итог.Нарушений = Итог.Нарушений + 1;
	КонецПопытки;
	
	Лог.Добавить("");
	Если Итог.Нарушений = 0 Тогда
		Лог.Добавить("ВЕРДИКТ: PASS");
	Иначе
		Лог.Добавить("ВЕРДИКТ: FAIL (нарушений: " + Итог.Нарушений + ")");
	КонецЕсли;
	
	ЗаписатьЛог(ПутьЛога, Лог);
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьКоличества(Лог, Итог)
	
	Лог.Добавить("--- Количества ---");
	
	Объекты = Новый Массив;
	Объекты.Добавить(Новый Структура("Имя, Цель", "Справочник.СтраныМира", 12));
	Объекты.Добавить(Новый Структура("Имя, Цель", "Справочник.Валюты", 5));
	Объекты.Добавить(Новый Структура("Имя, Цель", "Справочник.ЕдиницыИзмерения", 5));
	Объекты.Добавить(Новый Структура("Имя, Цель", "Справочник.Пользователи", 1));
	Объекты.Добавить(Новый Структура("Имя, Цель", "Справочник.Сотрудники", 15));
	Объекты.Добавить(Новый Структура("Имя, Цель", "Справочник.ТипыЗапросовТуристов", 6));
	Объекты.Добавить(Новый Структура("Имя, Цель", "Справочник.ТипыИнцидентов", 15));
	Объекты.Добавить(Новый Структура("Имя, Цель", "Справочник.Поставщики", 18));
	Объекты.Добавить(Новый Структура("Имя, Цель", "Справочник.ДоговорыСПоставщиками", 18));
	Объекты.Добавить(Новый Структура("Имя, Цель", "Справочник.ОбъектыГостеприимства", 15));
	Объекты.Добавить(Новый Структура("Имя, Цель", "Справочник.НоменклатураУслуг", 15));
	Объекты.Добавить(Новый Структура("Имя, Цель", "Справочник.ТурыМаршруты", 15));
	Объекты.Добавить(Новый Структура("Имя, Цель", "Справочник.Туристы", 20));
	Объекты.Добавить(Новый Структура("Имя, Цель", "Справочник.ЗаявкиНаТур", 20));
	Объекты.Добавить(Новый Структура("Имя, Цель", "Документ.ЗаказПоставщику", 4));
	Объекты.Добавить(Новый Структура("Имя, Цель", "Документ.ПодтверждениеУслуги", 3));
	Объекты.Добавить(Новый Структура("Имя, Цель", "Документ.МаршрутныйЛист", 2));
	Объекты.Добавить(Новый Структура("Имя, Цель", "Документ.СобытиеМаршрута", 4));
	Объекты.Добавить(Новый Структура("Имя, Цель", "Документ.КорректировкаМаршрута", 1));
	Объекты.Добавить(Новый Структура("Имя, Цель", "Документ.ЗаявкаТуристаНаМаршруте", 2));
	Объекты.Добавить(Новый Структура("Имя, Цель", "Документ.Инцидент", 2));
	Объекты.Добавить(Новый Структура("Имя, Цель", "Документ.ПретензияПоставщику", 1));
	Объекты.Добавить(Новый Структура("Имя, Цель", "Документ.АктОКомпенсации", 1));
	
	Иерархические = Новый Соответствие;
	Иерархические.Вставить("Справочник.НоменклатураУслуг", Истина);
	Иерархические.Вставить("Справочник.ТурыМаршруты", Истина);
	Иерархические.Вставить("Справочник.Поставщики", Истина);
	
	Для Каждого Позиция Из Объекты Цикл
		Условие = " ГДЕ Т.ПометкаУдаления = ЛОЖЬ";
		Если Иерархические.Получить(Позиция.Имя) = Истина Тогда
			Условие = Условие + " И Т.ЭтоГруппа = ЛОЖЬ";
		КонецЕсли;
		Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего ИЗ " + Позиция.Имя + " КАК Т" + Условие);
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		Факт = Выборка.Всего;
		Если Факт = Позиция.Цель Тогда
			Лог.Добавить("  " + Позиция.Имя + ": " + Факт + " из " + Позиция.Цель);
		Иначе
			Лог.Добавить("  ! " + Позиция.Имя + ": " + Факт + " из " + Позиция.Цель);
			Итог.Нарушений = Итог.Нарушений + 1;
		КонецЕсли;
	КонецЦикла;
	
	Лог.Добавить("");
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьСсылки(Лог, Итог)
	
	Лог.Добавить("--- Ссылки ---");
	
	Правила = Новый Массив;
	Правила.Добавить(Новый Структура("Объект, Реквизиты", "Документ.ЗаказПоставщику", "ЗаявкаНаТур,Поставщик,Договор,Ответственный"));
	Правила.Добавить(Новый Структура("Объект, Реквизиты", "Документ.ПодтверждениеУслуги", "ЗаказПоставщику,Поставщик"));
	Правила.Добавить(Новый Структура("Объект, Реквизиты", "Документ.МаршрутныйЛист", "ЗаявкаНаТур,Турист,Гид"));
	Правила.Добавить(Новый Структура("Объект, Реквизиты", "Документ.СобытиеМаршрута", "МаршрутныйЛист,Объект,Поставщик"));
	Правила.Добавить(Новый Структура("Объект, Реквизиты", "Документ.КорректировкаМаршрута", "МаршрутныйЛист,Инициатор"));
	Правила.Добавить(Новый Структура("Объект, Реквизиты", "Документ.ЗаявкаТуристаНаМаршруте", "МаршрутныйЛист,Турист,ТипЗапроса,Ответственный,Инициатор"));
	Правила.Добавить(Новый Структура("Объект, Реквизиты", "Документ.Инцидент", "ЗаявкаНаТур,Турист,ТипИнцидента,Объект,Поставщик,АвторРегистрации,Ответственный"));
	Правила.Добавить(Новый Структура("Объект, Реквизиты", "Документ.ПретензияПоставщику", "Инцидент,Поставщик,Договор,Валюта"));
	Правила.Добавить(Новый Структура("Объект, Реквизиты", "Документ.АктОКомпенсации", "Претензия,Инцидент,Валюта"));
	Правила.Добавить(Новый Структура("Объект, Реквизиты", "Справочник.Туристы", "Гражданство,Менеджер"));
	Правила.Добавить(Новый Структура("Объект, Реквизиты", "Справочник.ЗаявкиНаТур", "Турист,Маршрут,Валюта,Ответственный"));
	Правила.Добавить(Новый Структура("Объект, Реквизиты", "Справочник.ДоговорыСПоставщиками", "Владелец,ВалютаРасчётов"));
	Правила.Добавить(Новый Структура("Объект, Реквизиты", "Справочник.ОбъектыГостеприимства", "Владелец"));
	Правила.Добавить(Новый Структура("Объект, Реквизиты, Условие", "Справочник.НоменклатураУслуг", "Единица,Валюта", "ГДЕ Т.ЭтоГруппа = ЛОЖЬ"));
	Правила.Добавить(Новый Структура("Объект, Реквизиты, Условие", "Справочник.ТурыМаршруты", "Страна", "ГДЕ Т.ЭтоГруппа = ЛОЖЬ"));
	
	Для Каждого Правило Из Правила Цикл
		
		Реквизиты = СтрРазделить(Правило.Реквизиты, ",", Ложь);
		
		Текст = "ВЫБРАТЬ Т.Ссылка КАК Ссылка";
		Для Каждого ИмяРеквизита Из Реквизиты Цикл
			Текст = Текст + ", Т." + ИмяРеквизита + " КАК " + ИмяРеквизита;
		КонецЦикла;
		Условие = ?(Правило.Свойство("Условие"), Правило.Условие, "");
		Текст = Текст + " ИЗ " + Правило.Объект + " КАК Т " + Условие;
		
		Запрос = Новый Запрос(Текст);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Для Каждого ИмяРеквизита Из Реквизиты Цикл
				ЗначениеРеквизита = Выборка[ИмяРеквизита];
				Если Не ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
					Лог.Добавить("  ! " + Правило.Объект + " " + Выборка.Ссылка + ": " + ИмяРеквизита + " - пусто");
					Итог.Нарушений = Итог.Нарушений + 1;
				ИначеЕсли ЗначениеРеквизита.ПометкаУдаления Тогда
					Лог.Добавить("  ! " + Правило.Объект + " " + Выборка.Ссылка + ": " + ИмяРеквизита + " - помечен на удаление");
					Итог.Нарушений = Итог.Нарушений + 1;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
	КонецЦикла;
	
	Лог.Добавить("");
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьТабличныеЧасти(Лог, Итог)
	
	Лог.Добавить("--- Табличные части ---");
	
	Правила = Новый Массив;
	Правила.Добавить(Новый Структура("Объект, ИмяТЧ, Условие, Реквизиты", "Документ.ЗаказПоставщику", "Услуги", "", "Услуга,Объект,ДатаНачала,ДатаОкончания"));
	Правила.Добавить(Новый Структура("Объект, ИмяТЧ, Условие, Реквизиты", "Документ.ПодтверждениеУслуги", "ПодтверждённыеУслуги", "", "Услуга,Объект,ДатаНачала,ДатаОкончания"));
	Правила.Добавить(Новый Структура("Объект, ИмяТЧ, Условие, Реквизиты", "Документ.КорректировкаМаршрута", "Изменения", "", "СобытиеМаршрута,СтароеВремяUTC,НовоеВремяUTC"));
	Правила.Добавить(Новый Структура("Объект, ИмяТЧ, Условие, Реквизиты", "Документ.ЗаявкаТуристаНаМаршруте", "ИсторияОбработки", "", "Сотрудник,Действие"));
	Правила.Добавить(Новый Структура("Объект, ИмяТЧ, Условие, Реквизиты", "Документ.АктОКомпенсации", "СтруктураКомпенсации", "", "ВидКомпенсации,Описание"));
	Правила.Добавить(Новый Структура("Объект, ИмяТЧ, Условие, Реквизиты", "Справочник.ТурыМаршруты", "СтандартныйНаборУслуг", "ГДЕ Т.ЭтоГруппа = ЛОЖЬ", "Услуга,Поставщик"));
	
	Для Каждого Правило Из Правила Цикл
		
		Запрос = Новый Запрос("ВЫБРАТЬ Т.Ссылка КАК Ссылка ИЗ " + Правило.Объект + " КАК Т " + Правило.Условие);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ОбъектДанных = Выборка.Ссылка.ПолучитьОбъект();
			СтрокиТЧ = ОбъектДанных[Правило.ИмяТЧ];
			Если СтрокиТЧ.Количество() = 0 Тогда
				Лог.Добавить("  ! " + Правило.Объект + " " + Выборка.Ссылка + ": ТЧ " + Правило.ИмяТЧ + " пуста");
				Итог.Нарушений = Итог.Нарушений + 1;
			Иначе
				ИменаРеквизитов = СтрРазделить(Правило.Реквизиты, ",", Ложь);
				Для Каждого СтрокаТЧ Из СтрокиТЧ Цикл
					Для Каждого ИмяРеквизита Из ИменаРеквизитов Цикл
						Если Не ЗначениеЗаполнено(СтрокаТЧ[ИмяРеквизита]) Тогда
							Лог.Добавить("  ! " + Правило.Объект + " " + Выборка.Ссылка + ": в ТЧ " + Правило.ИмяТЧ + " не заполнено " + ИмяРеквизита);
							Итог.Нарушений = Итог.Нарушений + 1;
						КонецЕсли;
					КонецЦикла;
					Если Правило.ИмяТЧ = "Услуги" ИЛИ Правило.ИмяТЧ = "ПодтверждённыеУслуги" ИЛИ Правило.ИмяТЧ = "СтруктураКомпенсации" Тогда
						Если СтрокаТЧ.Сумма <= 0 Тогда
						Лог.Добавить("  ! " + Правило.Объект + " " + Выборка.Ссылка + ": в ТЧ " + Правило.ИмяТЧ + " сумма не положительна");
						Итог.Нарушений = Итог.Нарушений + 1;
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
	Лог.Добавить("");
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьПравила(Лог, Итог)
	
	Лог.Добавить("--- Правила 5.3 ---");
	
	ПроверитьПериодыИСуммы(Лог, Итог, "ЗаказПоставщику", "Услуги");
	ПроверитьПериодыИСуммы(Лог, Итог, "ПодтверждениеУслуги", "ПодтверждённыеУслуги");
	
	Запрос = Новый Запрос("ВЫБРАТЬ Т.Ссылка КАК Ссылка ИЗ Документ.Инцидент КАК Т ГДЕ Т.ДатаИнцидента > &Текущая");
	Запрос.УстановитьПараметр("Текущая", ТекущаяДата());
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Лог.Добавить("  ! Инцидент " + Выборка.Ссылка + ": дата инцидента позже текущей");
		Итог.Нарушений = Итог.Нарушений + 1;
	КонецЦикла;
	
	Запрос = Новый Запрос("ВЫБРАТЬ Т.Ссылка КАК Ссылка ИЗ Документ.ЗаявкаТуристаНаМаршруте КАК Т ГДЕ Т.СрокSLA <= Т.Дата");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Лог.Добавить("  ! ЗаявкаТуристаНаМаршруте " + Выборка.Ссылка + ": срок SLA не позже даты документа");
		Итог.Нарушений = Итог.Нарушений + 1;
	КонецЦикла;
	
	Запрос = Новый Запрос("ВЫБРАТЬ Т.Ссылка КАК Ссылка ИЗ Документ.ПретензияПоставщику КАК Т ГДЕ Т.СуммаТребования < 0");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Лог.Добавить("  ! ПретензияПоставщику " + Выборка.Ссылка + ": отрицательная сумма требования");
		Итог.Нарушений = Итог.Нарушений + 1;
	КонецЦикла;
	
	Запрос = Новый Запрос("ВЫБРАТЬ Т.Ссылка КАК Ссылка ИЗ Документ.АктОКомпенсации КАК Т
		|ГДЕ Т.СуммаКомпенсацииТуристу < 0 ИЛИ Т.СуммаВзысканияСПоставщика < 0");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Лог.Добавить("  ! АктОКомпенсации " + Выборка.Ссылка + ": отрицательная сумма");
		Итог.Нарушений = Итог.Нарушений + 1;
	КонецЦикла;
	
	Запрос = Новый Запрос("ВЫБРАТЬ Т.Ссылка КАК Ссылка ИЗ Документ.АктОКомпенсации КАК Т
		|ГДЕ Т.СуммаВзысканияСПоставщика > Т.Претензия.СуммаТребования");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Лог.Добавить("  ! АктОКомпенсации " + Выборка.Ссылка + ": взыскание больше суммы требования");
		Итог.Нарушений = Итог.Нарушений + 1;
	КонецЦикла;
	
	Виды = Новый Массив;
	Виды.Добавить("ЗаказПоставщику");
	Виды.Добавить("ПодтверждениеУслуги");
	Виды.Добавить("МаршрутныйЛист");
	Виды.Добавить("СобытиеМаршрута");
	Виды.Добавить("КорректировкаМаршрута");
	Виды.Добавить("ЗаявкаТуристаНаМаршруте");
	Виды.Добавить("Инцидент");
	Виды.Добавить("ПретензияПоставщику");
	Виды.Добавить("АктОКомпенсации");
	
	Для Каждого Вид Из Виды Цикл
		Запрос = Новый Запрос("ВЫБРАТЬ Т.Ссылка КАК Ссылка ИЗ Документ." + Вид + " КАК Т ГДЕ Т.Проведен");
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Лог.Добавить("  ! " + Вид + " " + Выборка.Ссылка + ": документ проведён, движения регистров не ожидались");
			Итог.Нарушений = Итог.Нарушений + 1;
		КонецЦикла;
	КонецЦикла;
	
	ОжидаемыеSLA = Новый Соответствие;
	ОжидаемыеSLA.Вставить("Медицинская помощь", 0.5);
	ОжидаемыеSLA.Вставить("Диетическое питание", 2);
	ОжидаемыеSLA.Вставить("Бытовой вопрос", 4);
	ОжидаемыеSLA.Вставить("Прочее", 24);
	
	Запрос = Новый Запрос("ВЫБРАТЬ Т.Наименование КАК Наименование, Т.SLAЧасов КАК SLAЧасов ИЗ Справочник.ТипыЗапросовТуристов КАК Т");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ожидаемое = ОжидаемыеSLA.Получить(Выборка.Наименование);
		Если Ожидаемое <> Неопределено И Выборка.SLAЧасов <> Ожидаемое Тогда
			Лог.Добавить("  ! ТипыЗапросовТуристов " + Выборка.Наименование + ": SLA " + Выборка.SLAЧасов + " вместо " + Ожидаемое);
			Итог.Нарушений = Итог.Нарушений + 1;
		КонецЕсли;
	КонецЦикла;
	
	ОжидаемыеСроки = Новый Соответствие;
	ОжидаемыеСроки.Вставить(Перечисления.ВидыУслуг.Номер, 14);
	ОжидаемыеСроки.Вставить(Перечисления.ВидыУслуг.Трансфер, 3);
	ОжидаемыеСроки.Вставить(Перечисления.ВидыУслуг.Экскурсия, 7);
	ОжидаемыеСроки.Вставить(Перечисления.ВидыУслуг.Питание, 10);
	
	Запрос = Новый Запрос("ВЫБРАТЬ Т.ВидУслуги КАК ВидУслуги, Т.КонтрольныйСрокДней КАК Срок ИЗ РегистрСведений.СрокиКонтроля КАК Т");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ожидаемое = ОжидаемыеСроки.Получить(Выборка.ВидУслуги);
		Если Ожидаемое <> Неопределено И Выборка.Срок <> Ожидаемое Тогда
			Лог.Добавить("  ! СрокиКонтроля " + Выборка.ВидУслуги + ": " + Выборка.Срок + " дней вместо " + Ожидаемое);
			Итог.Нарушений = Итог.Нарушений + 1;
		КонецЕсли;
	КонецЦикла;
	
	Лог.Добавить("");
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьПериодыИСуммы(Лог, Итог, ИмяДокумента, ИмяТЧ)
	
	Запрос = Новый Запрос("ВЫБРАТЬ Т.Ссылка КАК Ссылка ИЗ Документ." + ИмяДокумента + " КАК Т");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Док = Выборка.Ссылка.ПолучитьОбъект();
		Для Каждого СтрокаТЧ Из Док[ИмяТЧ] Цикл
			Если СтрокаТЧ.ДатаНачала > СтрокаТЧ.ДатаОкончания Тогда
				Лог.Добавить("  ! " + ИмяДокумента + " " + Выборка.Ссылка + ": дата начала позже даты окончания");
				Итог.Нарушений = Итог.Нарушений + 1;
			КонецЕсли;
			Если СтрокаТЧ.Цена < 0 ИЛИ СтрокаТЧ.Сумма < 0 Тогда
				Лог.Добавить("  ! " + ИмяДокумента + " " + Выборка.Ссылка + ": отрицательная сумма в строке услуг");
				Итог.Нарушений = Итог.Нарушений + 1;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьЛог(ПутьЛога, Лог)
	
	Файл = Новый ЗаписьТекста(ПутьЛога, "UTF-8");
	Для Каждого СтрокаЛога Из Лог Цикл
		Файл.ЗаписатьСтроку(СтрокаЛога);
	КонецЦикла;
	Файл.Закрыть();
	
КонецПроцедуры

#КонецОбласти
