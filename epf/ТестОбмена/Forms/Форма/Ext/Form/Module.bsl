#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ВыполнитьСценарий(ПараметрЗапуска);
	ЗавершитьРаботуСистемы(Ложь);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ВыполнитьСценарий(Параметр)
	
	Части = СтрРазделить(Параметр, "|");
	ИмяСценария = ?(Части.Количество() > 0, Части[0], "");
	ПутьФайла   = ?(Части.Количество() > 1, Части[1], "");
	ПутьОтчёта  = ?(Части.Количество() > 2, Части[2], "");
	
	Лог = Новый Массив;
	
	Если ИмяСценария = "selftest" Тогда
		ВыполнитьСамопроверку(Лог);
	Иначе
		Лог.Добавить("НЕИЗВЕСТНЫЙ СЦЕНАРИЙ: " + ИмяСценария);
	КонецЕсли;
	
	ЗаписатьЛог(ПутьОтчёта, Лог);
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьСамопроверку(Лог)
	
	Лог.Добавить("parse: " + ПроверитьРазбор());
	Лог.Добавить("file: "  + ПроверитьФайл());
	Лог.Добавить("types: " + ПроверитьТипы());
	
	Если Найти(СтрСоединить(Лог, ""), "FAIL") > 0 Тогда
		Лог.Добавить("ВЕРДИКТ: FAIL");
	Иначе
		Лог.Добавить("ВЕРДИКТ: PASS");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПроверитьРазбор()
	
	// Проверка обёрнута в Попытку, чтобы любая непредвиденная ошибка попала в лог
	// текстом, а не всплыла на клиенте диалогом «непредвиденная ошибка».
	Попытка
		
		Ожидаемые = Новый Массив;
		Ожидаемые.Добавить("обычное");
		Ожидаемые.Добавить("есть ; и """);
		Ожидаемые.Добавить("две" + Символы.ПС + "строки");
		
		СтрокаCSV = ОбменCSV.СобратьСтроку(Ожидаемые);
		Полученные = ОбменCSV.РазобратьСтроку(СтрокаCSV);
		
		Если Полученные.Количество() <> Ожидаемые.Количество() Тогда
			Возврат "FAIL 0: ожидалось полей " + Ожидаемые.Количество() + ", получено " + Полученные.Количество();
		КонецЕсли;
		
		Для Индекс = 0 По Ожидаемые.Количество() - 1 Цикл
			Если Полученные[Индекс] <> Ожидаемые[Индекс] Тогда
				Возврат "FAIL " + Индекс + ": ожидалось " + Ожидаемые[Индекс] + ", получено " + Полученные[Индекс];
			КонецЕсли;
		КонецЦикла;
		
		Возврат "OK";
		
	Исключение
		Возврат "FAIL " + ОписаниеОшибки();
	КонецПопытки;
	
КонецФункции

&НаСервере
Функция ПроверитьФайл()
	
	Попытка
		
		ПутьФайла = ПолучитьИмяВременногоФайла("csv");
		
		// ВНИМАНИЕ: имя переменной - КолонкиФайла, а не Заголовок.
		// Управляемая форма имеет собственное свойство Заголовок (Title, Строка):
		// присвоение «Заголовок = Новый Массив» ушло бы в свойство формы,
		// и следующий вызов Заголовок.Добавить(...) упал бы с
		// «Значение не является значением объектного типа (Добавить)».
		КолонкиФайла = Новый Массив;
		КолонкиФайла.Добавить("Код");
		КолонкиФайла.Добавить("Наименование");
		
		Строки = Новый Массив;
		
		Строка1 = Новый Массив;
		Строка1.Добавить("001");
		Строка1.Добавить("Обычное наименование");
		Строки.Добавить(Строка1);
		
		Строка2 = Новый Массив;
		Строка2.Добавить("002");
		Строка2.Добавить("Наименование; с точкой с запятой");
		Строки.Добавить(Строка2);
		
		ОбменCSV.ЗаписатьФайл(ПутьФайла, КолонкиФайла, Строки);
		
		// Проверка BOM: первые три байта файла должны быть 239, 187, 191.
		ЧтениеДанных = Новый ЧтениеДанных(ПутьФайла);
		Байт1 = ЧтениеДанных.ПрочитатьБайт();
		Байт2 = ЧтениеДанных.ПрочитатьБайт();
		Байт3 = ЧтениеДанных.ПрочитатьБайт();
		ЧтениеДанных.Закрыть();
		
		Если Байт1 <> 239 Или Байт2 <> 187 Или Байт3 <> 191 Тогда
			Возврат "FAIL BOM: " + Байт1 + ", " + Байт2 + ", " + Байт3;
		КонецЕсли;
		
		// Диагностика: сырая первая строка файла и все строки файла целиком.
		// Помогает понять, что именно попало на диск (BOM, кавычки, разделители).
		ЧтениеСырого = Новый ЧтениеТекста(ПутьФайла, "UTF-8");
		СырыеСтроки = Новый Массив;
		Пока Истина Цикл
			ОчереднаяСтрока = ЧтениеСырого.ПрочитатьСтроку();
			Если ОчереднаяСтрока = Неопределено Тогда
				Прервать;
			КонецЕсли;
			СырыеСтроки.Добавить(ОчереднаяСтрока);
		КонецЦикла;
		ЧтениеСырого.Закрыть();
		Диагностика = " raw=[" + СтрСоединить(СырыеСтроки, " / ") + "]";
		
		Прочитанное = ОбменCSV.ПрочитатьФайл(ПутьФайла);
		
		Если Прочитанное.Заголовок.Количество() <> КолонкиФайла.Количество() Тогда
			Возврат "FAIL заголовок: ожидалось полей " + КолонкиФайла.Количество() + ", получено " + Прочитанное.Заголовок.Количество() + Диагностика;
		КонецЕсли;
		
		Для Индекс = 0 По КолонкиФайла.Количество() - 1 Цикл
			Если Прочитанное.Заголовок[Индекс] <> КолонкиФайла[Индекс] Тогда
				Возврат "FAIL заголовок " + Индекс + ": ожидалось " + КолонкиФайла[Индекс] + ", получено " + Прочитанное.Заголовок[Индекс];
			КонецЕсли;
		КонецЦикла;
		
		Если Прочитанное.Строки.Количество() <> Строки.Количество() Тогда
			Возврат "FAIL строки: ожидалось " + Строки.Количество() + ", получено " + Прочитанное.Строки.Количество();
		КонецЕсли;
		
		Для ИндексСтроки = 0 По Строки.Количество() - 1 Цикл
			
			Ожидаемая = Строки[ИндексСтроки];
			Прочитанная = Прочитанное.Строки[ИндексСтроки];
			
			Если Прочитанная.Количество() <> Ожидаемая.Количество() Тогда
				Возврат "FAIL строка " + ИндексСтроки + ": ожидалось полей " + Ожидаемая.Количество() + ", получено " + Прочитанная.Количество();
			КонецЕсли;
			
			Для ИндексПоля = 0 По Ожидаемая.Количество() - 1 Цикл
				Если Прочитанная[ИндексПоля] <> Ожидаемая[ИндексПоля] Тогда
					Возврат "FAIL строка " + ИндексСтроки + " поле " + ИндексПоля + ": ожидалось " + Ожидаемая[ИндексПоля] + ", получено " + Прочитанная[ИндексПоля];
				КонецЕсли;
			КонецЦикла;
			
		КонецЦикла;
		
		УдалитьФайлы(ПутьФайла);
		
		Возврат "OK";
		
	Исключение
		Возврат "FAIL " + ОписаниеОшибки();
	КонецПопытки;
	
КонецФункции

&НаСервере
Функция ПроверитьТипы()
	
	Попытка
		
		Возврат "FAIL не реализовано";
		
	Исключение
		Возврат "FAIL " + ОписаниеОшибки();
	КонецПопытки;
	
КонецФункции

&НаСервере
Процедура ЗаписатьЛог(ПутьОтчёта, Лог)
	
	Если ПустаяСтрока(ПутьОтчёта) Тогда
		Возврат;
	КонецЕсли;
	
	Файл = Новый ЗаписьТекста(ПутьОтчёта, "UTF-8");
	Для Каждого СтрокаЛога Из Лог Цикл
		Файл.ЗаписатьСтроку(СтрокаЛога);
	КонецЦикла;
	Файл.Закрыть();
	
КонецПроцедуры

#КонецОбласти
