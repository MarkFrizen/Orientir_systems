#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ВыполнитьСценарий(ПараметрЗапуска);
	ЗавершитьРаботуСистемы(Ложь);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ВыполнитьСценарий(Параметр)
	
	Части = СтрРазделить(Параметр, "|");
	ИмяСценария = ?(Части.Количество() > 0, Части[0], "");
	ПутьФайла   = ?(Части.Количество() > 1, Части[1], "");
	ПутьОтчёта  = ?(Части.Количество() > 2, Части[2], "");
	
	Лог = Новый Массив;
	
	Если ИмяСценария = "selftest" Тогда
		ВыполнитьСамопроверку(Лог);
	ИначеЕсли ИмяСценария = "export-nomenclature" Тогда
		ВыполнитьВыгрузкуНоменклатуры(ПутьФайла, Лог);
	ИначеЕсли ИмяСценария = "import-nomenclature-bad-header" Тогда
		ВыполнитьЗагрузкуСПлохимЗаголовком(ПутьФайла, Лог);
	ИначеЕсли ИмяСценария = "import-nomenclature-bad-types" Тогда
		ВыполнитьЗагрузкуСПлохимиТипами(ПутьФайла, Лог);
	ИначеЕсли ИмяСценария = "import-nomenclature-missing-ref" Тогда
		ВыполнитьЗагрузкуСНесуществующимиСсылками(ПутьФайла, Лог);
	ИначеЕсли ИмяСценария = "import-nomenclature-duplicates" Тогда
		ВыполнитьЗагрузкуСДублямиКодов(ПутьФайла, Лог);
	ИначеЕсли ИмяСценария = "import-nomenclature-rules" Тогда
		ВыполнитьЗагрузкуСПравиламиЗаписи(ПутьФайла, Лог);
	ИначеЕсли ИмяСценария = "import-nomenclature-report" Тогда
		ВыполнитьЗагрузкуСОтчётами(ПутьФайла, Лог);
	ИначеЕсли ИмяСценария = "import-nomenclature-valid" Тогда
		ВыполнитьЗагрузкуВалидногоФайла(ПутьФайла, Лог);
	ИначеЕсли ИмяСценария = "import-nomenclature-hierarchy" Тогда
		ВыполнитьЗагрузкуСИерархией(ПутьФайла, Лог);
	ИначеЕсли ИмяСценария = "import-nomenclature-partial" Тогда
		ВыполнитьЗагрузкуЧастичногоФайла(ПутьФайла, Лог);
	ИначеЕсли ИмяСценария = "export-orders" Тогда
		ВыполнитьВыгрузкуЗаказов(ПутьФайла, Лог);
	ИначеЕсли ИмяСценария = "cleanup" Тогда
		ВыполнитьУборкуТестовойНоменклатуры(Лог);
	Иначе
		Лог.Добавить("НЕИЗВЕСТНЫЙ СЦЕНАРИЙ: " + ИмяСценария);
	КонецЕсли;
	
	ЗаписатьЛог(ПутьОтчёта, Лог);
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьСамопроверку(Лог)
	
	Лог.Добавить("parse: " + ПроверитьРазбор());
	Лог.Добавить("file: "  + ПроверитьФайл());
	Лог.Добавить("types: " + ПроверитьТипы());
	
	Если Найти(СтрСоединить(Лог, ""), "FAIL") > 0 Тогда
		Лог.Добавить("ВЕРДИКТ: FAIL");
	Иначе
		Лог.Добавить("ВЕРДИКТ: PASS");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПроверитьРазбор()
	
	// Проверка обёрнута в Попытку, чтобы любая непредвиденная ошибка попала в лог
	// текстом, а не всплыла на клиенте диалогом «непредвиденная ошибка».
	Попытка
		
		Ожидаемые = Новый Массив;
		Ожидаемые.Добавить("обычное");
		Ожидаемые.Добавить("есть ; и """);
		Ожидаемые.Добавить("две" + Символы.ПС + "строки");
		
		СтрокаCSV = ОбменCSV.СобратьСтроку(Ожидаемые);
		Полученные = ОбменCSV.РазобратьСтроку(СтрокаCSV);
		
		Если Полученные.Количество() <> Ожидаемые.Количество() Тогда
			Возврат "FAIL 0: ожидалось полей " + Ожидаемые.Количество() + ", получено " + Полученные.Количество();
		КонецЕсли;
		
		Для Индекс = 0 По Ожидаемые.Количество() - 1 Цикл
			Если Полученные[Индекс] <> Ожидаемые[Индекс] Тогда
				Возврат "FAIL " + Индекс + ": ожидалось " + Ожидаемые[Индекс] + ", получено " + Полученные[Индекс];
			КонецЕсли;
		КонецЦикла;
		
		// Пример строки дословно из docs/Обмен-данными.md, раздел «Формат номенклатуры услуг».
		// Если пример из документации перестанет разбираться, значит документация и парсер
		// разошлись, и это должно ломать прогон, а не тихо оставаться текстом в документе.
		ПримерИзДокументации = "000000017;""Виза ОАЭ; срочная"";Ложь;Виза;Виза;Штука;9000,00;Российский рубль";
		
		ПоляПримера = Новый Массив;
		ПоляПримера.Добавить("000000017");
		ПоляПримера.Добавить("Виза ОАЭ; срочная");
		ПоляПримера.Добавить("Ложь");
		ПоляПримера.Добавить("Виза");
		ПоляПримера.Добавить("Виза");
		ПоляПримера.Добавить("Штука");
		ПоляПримера.Добавить("9000,00");
		ПоляПримера.Добавить("Российский рубль");
		
		РазобранныйПример = ОбменCSV.РазобратьСтроку(ПримерИзДокументации);
		Если РазобранныйПример.Количество() <> ПоляПримера.Количество() Тогда
			Возврат "FAIL пример из документации: полей " + РазобранныйПример.Количество() + "/" + ПоляПримера.Количество();
		КонецЕсли;
		Для ИндексПримера = 0 По ПоляПримера.Количество() - 1 Цикл
			Если РазобранныйПример[ИндексПримера] <> ПоляПримера[ИндексПримера] Тогда
				Возврат "FAIL пример из документации, поле " + (ИндексПримера + 1) + ": получено """ + РазобранныйПример[ИндексПримера] + """, ожидалось """ + ПоляПримера[ИндексПримера] + """";
			КонецЕсли;
		КонецЦикла;
		
		// Пример строки группы: обязательны три первых поля, остальные пять пустые.
		ПоляГруппы = ОбменCSV.РазобратьСтроку("000000006;Виза;Истина;;;;;");
		Если ПоляГруппы.Количество() <> 8 Тогда
			Возврат "FAIL пример группы: полей " + ПоляГруппы.Количество() + "/8";
		КонецЕсли;
		Если ПоляГруппы[2] <> "Истина" Или ПоляГруппы[7] <> "" Тогда
			Возврат "FAIL пример группы: ""Истина""/пусто не на своих местах";
		КонецЕсли;
		
		Возврат "OK";
		
	Исключение
		Возврат "FAIL " + ОписаниеОшибки();
	КонецПопытки;
	
КонецФункции

&НаСервере
Функция ПроверитьФайл()
	
	Попытка
		
		ПутьФайла = ПолучитьИмяВременногоФайла("csv");
		
		// ВНИМАНИЕ: имя переменной - КолонкиФайла, а не Заголовок.
		// Управляемая форма имеет собственное свойство Заголовок (Title, Строка):
		// присвоение «Заголовок = Новый Массив» ушло бы в свойство формы,
		// и следующий вызов Заголовок.Добавить(...) упал бы с
		// «Значение не является значением объектного типа (Добавить)».
		КолонкиФайла = Новый Массив;
		КолонкиФайла.Добавить("Код");
		КолонкиФайла.Добавить("Наименование");
		
		Строки = Новый Массив;
		
		Строка1 = Новый Массив;
		Строка1.Добавить("001");
		Строка1.Добавить("Обычное наименование");
		Строки.Добавить(Строка1);
		
		Строка2 = Новый Массив;
		Строка2.Добавить("002");
		Строка2.Добавить("Наименование; с точкой с запятой");
		Строки.Добавить(Строка2);
		
		ОбменCSV.ЗаписатьФайл(ПутьФайла, КолонкиФайла, Строки);
		
		// Проверка BOM: первые три байта файла должны быть 239, 187, 191.
		ЧтениеДанных = Новый ЧтениеДанных(ПутьФайла);
		Байт1 = ЧтениеДанных.ПрочитатьБайт();
		Байт2 = ЧтениеДанных.ПрочитатьБайт();
		Байт3 = ЧтениеДанных.ПрочитатьБайт();
		ЧтениеДанных.Закрыть();
		
		Если Байт1 <> 239 Или Байт2 <> 187 Или Байт3 <> 191 Тогда
			Возврат "FAIL BOM: " + Байт1 + ", " + Байт2 + ", " + Байт3;
		КонецЕсли;
		
		// Диагностика: сырая первая строка файла и все строки файла целиком.
		// Помогает понять, что именно попало на диск (BOM, кавычки, разделители).
		ЧтениеСырого = Новый ЧтениеТекста(ПутьФайла, "UTF-8");
		СырыеСтроки = Новый Массив;
		Пока Истина Цикл
			ОчереднаяСтрока = ЧтениеСырого.ПрочитатьСтроку();
			Если ОчереднаяСтрока = Неопределено Тогда
				Прервать;
			КонецЕсли;
			СырыеСтроки.Добавить(ОчереднаяСтрока);
		КонецЦикла;
		ЧтениеСырого.Закрыть();
		Диагностика = " raw=[" + СтрСоединить(СырыеСтроки, " / ") + "]";
		
		Прочитанное = ОбменCSV.ПрочитатьФайл(ПутьФайла);
		
		Если Прочитанное.Заголовок.Количество() <> КолонкиФайла.Количество() Тогда
			Возврат "FAIL заголовок: ожидалось полей " + КолонкиФайла.Количество() + ", получено " + Прочитанное.Заголовок.Количество() + Диагностика;
		КонецЕсли;
		
		Для Индекс = 0 По КолонкиФайла.Количество() - 1 Цикл
			Если Прочитанное.Заголовок[Индекс] <> КолонкиФайла[Индекс] Тогда
				Возврат "FAIL заголовок " + Индекс + ": ожидалось " + КолонкиФайла[Индекс] + ", получено " + Прочитанное.Заголовок[Индекс];
			КонецЕсли;
		КонецЦикла;
		
		Если Прочитанное.Строки.Количество() <> Строки.Количество() Тогда
			Возврат "FAIL строки: ожидалось " + Строки.Количество() + ", получено " + Прочитанное.Строки.Количество();
		КонецЕсли;
		
		Для ИндексСтроки = 0 По Строки.Количество() - 1 Цикл
			
			Ожидаемая = Строки[ИндексСтроки];
			Прочитанная = Прочитанное.Строки[ИндексСтроки];
			
			Если Прочитанная.Количество() <> Ожидаемая.Количество() Тогда
				Возврат "FAIL строка " + ИндексСтроки + ": ожидалось полей " + Ожидаемая.Количество() + ", получено " + Прочитанная.Количество();
			КонецЕсли;
			
			Для ИндексПоля = 0 По Ожидаемая.Количество() - 1 Цикл
				Если Прочитанная[ИндексПоля] <> Ожидаемая[ИндексПоля] Тогда
					Возврат "FAIL строка " + ИндексСтроки + " поле " + ИндексПоля + ": ожидалось " + Ожидаемая[ИндексПоля] + ", получено " + Прочитанная[ИндексПоля];
				КонецЕсли;
			КонецЦикла;
			
		КонецЦикла;
		
		УдалитьФайлы(ПутьФайла);
		
		Возврат "OK";
		
	Исключение
		Возврат "FAIL " + ОписаниеОшибки();
	КонецПопытки;
	
КонецФункции

&НаСервере
Функция ПроверитьТипы()
	
	Попытка
		
		// Имена переменных не должны совпадать со свойствами управляемой формы
		// (Заголовок, ТолькоПросмотр и т.п.) - иначе присвоение уйдёт в свойство.
		ЧислоРезультат = ОбменCSV.ПривестиКЧислу("1,5");
		Если Не ЧислоРезультат.Успех Или ЧислоРезультат.Значение <> 1.5 Тогда
			Возврат "FAIL число: ожидалось 1,5, получено " + ЧислоРезультат.Значение;
		КонецЕсли;
		
		ЧислоОшибка = ОбменCSV.ПривестиКЧислу("дорого");
		Если ЧислоОшибка.Успех Тогда
			Возврат "FAIL число-ошибка: ожидался неуспех, получено " + ЧислоОшибка.Значение;
		КонецЕсли;
		
		ДатаРезультат = ОбменCSV.ПривестиКДате("2026-03-14");
		Если Не ДатаРезультат.Успех Или ДатаРезультат.Значение <> Дата(2026, 3, 14) Тогда
			Возврат "FAIL дата: ожидалось 2026-03-14";
		КонецЕсли;
		
		БулевоРезультат = ОбменCSV.ПривестиКБулеву("Истина");
		Если Не БулевоРезультат.Успех Или БулевоРезультат.Значение <> Истина Тогда
			Возврат "FAIL булево: ожидалась Истина";
		КонецЕсли;
		
		// Ожидается два знака после запятой: формат числа задан как ЧДЦ=2;ЧН=0,00.
		// Литерал "1,5" из брифа недостижим при ЧДЦ=2 - платформа отдаёт "1,50".
		ЧислоТекст = ОбменCSV.СформироватьЧисло(1.5);
		Если ЧислоТекст <> "1,50" Тогда
			Возврат "FAIL формат числа: ожидалось ""1,50"", получено """ + ЧислоТекст + """";
		КонецЕсли;
		
		// Разделитель групп запрещён: "1 234,50" не прочитается обратно.
		ЧислоБезГрупп = ОбменCSV.СформироватьЧисло(1234.5);
		Если ЧислоБезГрупп <> "1234,50" Тогда
			Возврат "FAIL разделитель групп: ожидалось ""1234,50"", получено """ + ЧислоБезГрупп + """";
		КонецЕсли;
		
		// Круговой рейс: выгрузили -> загрузили -> получили то же число.
		ЧислоКруговое = ОбменCSV.ПривестиКЧислу(ОбменCSV.СформироватьЧисло(1234.5));
		Если Не ЧислоКруговое.Успех Или ЧислоКруговое.Значение <> 1234.5 Тогда
			Возврат "FAIL круговой рейс: ожидалось 1234,5, получено " + ЧислоКруговое.Значение + " " + ЧислоКруговое.ТекстОшибки;
		КонецЕсли;
		
		Возврат "OK";
		
	Исключение
		Возврат "FAIL " + ОписаниеОшибки();
	КонецПопытки;
	
КонецФункции

&НаСервере
Функция КоличествоНоменклатурыПоПризнакуГруппы(ПризнакГруппы)
	
	// Пересчёт запросом, а не обходом Выбрать(): число позиций и групп должно
	// подтверждаться независимым от выгрузки способом.
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ
		|	Справочник.НоменклатураУслуг
		|ГДЕ
		|	ЭтоГруппа = &ЭтоГруппа";
	Запрос.УстановитьПараметр("ЭтоГруппа", ПризнакГруппы);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат Выборка.Количество;
	
КонецФункции

&НаСервере
Процедура ВыполнитьВыгрузкуНоменклатуры(ПутьФайла, Лог)
	
	Попытка
		
		Результат = Обработки.ОбменСФайлами.Создать().ВыгрузитьНоменклатуру(ПутьФайла);
		Прочитанное = ОбменCSV.ПрочитатьФайл(ПутьФайла);
		
		ОжидаемоеКоличество = 0;
		Выборка = Справочники.НоменклатураУслуг.Выбрать();
		Пока Выборка.Следующий() Цикл
			ОжидаемоеКоличество = ОжидаемоеКоличество + 1;
		КонецЦикла;
		
		Позиций = КоличествоНоменклатурыПоПризнакуГруппы(Ложь);
		Групп   = КоличествоНоменклатурыПоПризнакуГруппы(Истина);
		
		// Круговой контроль иерархии: число групп в файле обязано совпасть с числом
		// групп в справочнике. Иначе признак группы теряется где-то между базой
		// и файлом, и обратная загрузка снова сделает справочник плоским.
		ГруппВФайле  = 0;
		ИндексГруппы = -1;
		ИндексКолонки = 0;
		Для Каждого КолонкаФайла Из Прочитанное.Заголовок Цикл
			Если СокрЛП(КолонкаФайла) = "ЭтоГруппа" Тогда
				ИндексГруппы = ИндексКолонки;
				Прервать;
			КонецЕсли;
			ИндексКолонки = ИндексКолонки + 1;
		КонецЦикла;
		Если ИндексГруппы >= 0 Тогда
			Для Каждого СтрокаФайла Из Прочитанное.Строки Цикл
				Если ИндексГруппы < СтрокаФайла.Количество()
					И СокрЛП(СтрокаФайла[ИндексГруппы]) = "Истина" Тогда
					ГруппВФайле = ГруппВФайле + 1;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Колонок = Прочитанное.Заголовок.Количество();
		СтрокДанных = Прочитанное.Строки.Количество();
		
		Лог.Добавить("строк: " + СтрокДанных);
		Лог.Добавить("колонок: " + Колонок);
		Лог.Добавить("позиций: " + Позиций + ", групп: " + Групп);
		Лог.Добавить("строк с ЭтоГруппа=Истина: " + ГруппВФайле);
		
		Проблемы = Новый Массив;
		УникальныхКодов = 0;
		
		Если Колонок <> 8 Тогда
			// Ширину строк отдельно не проверяем: она задаётся тем же массивом
			// колонок, поэтому при неверном заголовке дала бы вторичный шум.
			Проблемы.Добавить("колонок: " + Колонок + "/8");
		Иначе
			
			Если Прочитанное.Заголовок[0] <> "Код" Тогда
				Проблемы.Добавить("первая колонка: " + Прочитанное.Заголовок[0] + "/Код");
			КонецЕсли;
			Если Прочитанное.Заголовок[Колонок - 1] <> "Валюта" Тогда
				Проблемы.Добавить("последняя колонка: " + Прочитанное.Заголовок[Колонок - 1] + "/Валюта");
			КонецЕсли;
			
			// Ширина каждой строки = 8 и коды не повторяются - за один проход.
			Коды = Новый Соответствие;
			Дубли = Новый Массив;
			Для Каждого СтрокаДанных Из Прочитанное.Строки Цикл
				Если СтрокаДанных.Количество() <> 8 Тогда
					Проблемы.Добавить("ширина строки: " + СтрокаДанных.Количество() + "/8");
					Прервать;
				КонецЕсли;
				КодСтроки = СтрокаДанных[0];
				Если Коды.Получить(КодСтроки) = Неопределено Тогда
					Коды.Вставить(КодСтроки, Истина);
				Иначе
					Дубли.Добавить(КодСтроки);
				КонецЕсли;
			КонецЦикла;
			
			УникальныхКодов = Коды.Количество();
			
			Если Дубли.Количество() > 0 Тогда
				Проблемы.Добавить("дубли кодов: " + СтрСоединить(Дубли, ",") + "/нет");
			КонецЕсли;
			
			Если УникальныхКодов <> СтрокДанных Тогда
				Проблемы.Добавить("уникальных кодов: " + УникальныхКодов + "/" + СтрокДанных);
			КонецЕсли;
			
		КонецЕсли;
		
		Лог.Добавить("уникальных кодов: " + УникальныхКодов);
		
		Если СтрокДанных <> ОжидаемоеКоличество Тогда
			Проблемы.Добавить("строк: " + СтрокДанных + "/" + ОжидаемоеКоличество);
		КонецЕсли;
		
		Если Позиций + Групп <> ОжидаемоеКоличество Тогда
			Проблемы.Добавить("состав справочника: " + (Позиций + Групп) + "/" + ОжидаемоеКоличество);
		КонецЕсли;
		
		Если ГруппВФайле <> Групп Тогда
			Проблемы.Добавить("групп в файле: " + ГруппВФайле + "/" + Групп);
		КонецЕсли;
		
		Если Результат.Вердикт <> "PASS" Тогда
			Проблемы.Добавить("вердикт обработки: " + Результат.Вердикт + "/PASS");
		КонецЕсли;
		
		Если Проблемы.Количество() > 0 Тогда
			Лог.Добавить("FAIL " + СтрСоединить(Проблемы, "; "));
			Лог.Добавить("ВЕРДИКТ: FAIL");
		Иначе
			Лог.Добавить("ВЕРДИКТ: PASS");
		КонецЕсли;
		
	Исключение
		Лог.Добавить("ошибка: " + ОписаниеОшибки());
		Лог.Добавить("ВЕРДИКТ: FAIL");
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Функция ОжидаемыеСчётчикиЗаказов(ПериодС, ПериодПо)
	
	// Ожидаемые числа считаются запросами, а не пересчётом файла: проверка должна
	// иметь независимый от выгрузки источник правды.
	Результат = Новый Структура("Документов, Строк", 0, 0);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ
		|	Документ.ЗаказПоставщику КАК ЗаказПоставщику
		|ГДЕ
		|	ЗаказПоставщику.Дата МЕЖДУ &ПериодС И &ПериодПо";
	Запрос.УстановитьПараметр("ПериодС",  ПериодС);
	Запрос.УстановитьПараметр("ПериодПо", ПериодПо);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.Документов = Выборка.Количество;
	КонецЕсли;
	
	// Строки считаются по табличной части: выгрузка плоская, и число строк файла
	// обязано совпасть с числом строк услуги всех документов периода.
	ЗапросСтрок = Новый Запрос;
	ЗапросСтрок.Текст =
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ
		|	Документ.ЗаказПоставщику.Услуги КАК ЗаказПоставщикуУслуги
		|ГДЕ
		|	ЗаказПоставщикуУслуги.Ссылка В
		|		(ВЫБРАТЬ
		|			ЗаказПоставщику.Ссылка КАК Ссылка
		|		ИЗ
		|			Документ.ЗаказПоставщику КАК ЗаказПоставщику
		|		ГДЕ
		|			ЗаказПоставщику.Дата МЕЖДУ &ПериодС И &ПериодПо)";
	ЗапросСтрок.УстановитьПараметр("ПериодС",  ПериодС);
	ЗапросСтрок.УстановитьПараметр("ПериодПо", ПериодПо);
	
	ВыборкаСтрок = ЗапросСтрок.Выполнить().Выбрать();
	Если ВыборкаСтрок.Следующий() Тогда
		Результат.Строк = ВыборкаСтрок.Количество;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ВыполнитьВыгрузкуЗаказов(ПутьФайла, Лог)
	
	Попытка
		
		// Период заведомо шире данных демо-базы: сценарий проверяет механику
		// выгрузки, а не конкретные даты заказов, и не должен краснеть от их сдвига.
		ПериодС  = Дата(2020, 1, 1);
		ПериодПо = Дата(2030, 1, 1);
		
		Обработка  = Обработки.ОбменСФайлами.Создать();
		Результат  = Обработка.ВыгрузитьЗаказы(ПутьФайла, ПериодС, ПериодПо);
		
		Прочитанное = ОбменCSV.ПрочитатьФайл(ПутьФайла);
		Ожидаемое   = ОжидаемыеСчётчикиЗаказов(ПериодС, ПериодПо);
		
		Колонок     = Прочитанное.Заголовок.Количество();
		СтрокДанных = Прочитанное.Строки.Количество();
		
		// Уникальные номера считаются по файлу: шапка повторяется в каждой строке
		// услуги и без этой проверки число документов было бы не проверить.
		Номера = Новый Соответствие;
		Для Каждого СтрокаФайла Из Прочитанное.Строки Цикл
			Если СтрокаФайла.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			Номера.Вставить(СтрокаФайла[0], Истина);
		КонецЦикла;
		
		Лог.Добавить("документов: " + Номера.Количество());
		Лог.Добавить("строк: " + СтрокДанных);
		Лог.Добавить("колонок: " + Колонок);
		Лог.Добавить("документов в базе за период: " + Ожидаемое.Документов);
		Лог.Добавить("строк услуги в базе за период: " + Ожидаемое.Строк);
		
		Проблемы = Новый Массив;
		
		Если Колонок <> 19 Тогда
			// Ширину строк отдельно не перебираем: она задаётся тем же массивом
			// колонок, поэтому при неверном заголовке дала бы вторичный шум.
			Проблемы.Добавить("колонок: " + Колонок + "/19");
		Иначе
			
			Если Прочитанное.Заголовок[0] <> "Номер" Тогда
				Проблемы.Добавить("первая колонка: " + Прочитанное.Заголовок[0] + "/Номер");
			КонецЕсли;
			Если Прочитанное.Заголовок[Колонок - 1] <> "ДополнительныеПараметры" Тогда
				Проблемы.Добавить("последняя колонка: " + Прочитанное.Заголовок[Колонок - 1] + "/ДополнительныеПараметры");
			КонецЕсли;
			
			Для Каждого СтрокаДанныхФайла Из Прочитанное.Строки Цикл
				Если СтрокаДанныхФайла.Количество() <> 19 Тогда
					Проблемы.Добавить("ширина строки: " + СтрокаДанныхФайла.Количество() + "/19");
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
		
		Если Номера.Количество() <> Ожидаемое.Документов Тогда
			Проблемы.Добавить("документов: " + Номера.Количество() + "/" + Ожидаемое.Документов);
		КонецЕсли;
		Если СтрокДанных <> Ожидаемое.Строк Тогда
			Проблемы.Добавить("строк: " + СтрокДанных + "/" + Ожидаемое.Строк);
		КонецЕсли;
		Если Результат.Вердикт <> "PASS" Тогда
			Проблемы.Добавить("вердикт обработки: " + Результат.Вердикт + "/PASS");
		КонецЕсли;
		
		Если Проблемы.Количество() > 0 Тогда
			Лог.Добавить("FAIL " + СтрСоединить(Проблемы, "; "));
			Лог.Добавить("ВЕРДИКТ: FAIL");
		Иначе
			Лог.Добавить("ВЕРДИКТ: PASS");
		КонецЕсли;
		
	Исключение
		Лог.Добавить("ошибка: " + ОписаниеОшибки());
		Лог.Добавить("ВЕРДИКТ: FAIL");
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Функция КоличествоНоменклатурыПоКоду(ИскомыйКод)
	
	Если ПустаяСтрока(ИскомыйКод) Тогда
		Возврат 0;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ
		|	Справочник.НоменклатураУслуг
		|ГДЕ
		|	Код = &Код";
	Запрос.УстановитьПараметр("Код", ИскомыйКод);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат Выборка.Количество;
	
КонецФункции

&НаСервере
Процедура ПодготовитьФайлБезБазовойЦены(Обработка, ПутьФайла)
	
	// Файл пишет сам драйвер: прогон не должен зависеть от внешней заготовки,
	// которую можно «починить», отредактировав файл руками.
	ПолныйСписок = Обработка.ОбязательныеКолонкиНоменклатуры();
	
	КолонкиФайла = Новый Массив;
	Для Каждого ИмяКолонки Из ПолныйСписок Цикл
		Если ИмяКолонки = "БазоваяЦена" Тогда
			Продолжить;
		КонецЕсли;
		КолонкиФайла.Добавить(ИмяКолонки);
	КонецЦикла;
	
	СтрокаДанных = Новый Массив;
	СтрокаДанных.Добавить("000000900");
	СтрокаДанных.Добавить("Позиция с неполным заголовком");
	СтрокаДанных.Добавить("Ложь");
	СтрокаДанных.Добавить("");
	СтрокаДанных.Добавить("Виза");
	СтрокаДанных.Добавить("Штука");
	СтрокаДанных.Добавить("Российский рубль");
	
	СтрокиФайла = Новый Массив;
	СтрокиФайла.Добавить(СтрокаДанных);
	
	ОбменCSV.ЗаписатьФайл(ПутьФайла, КолонкиФайла, СтрокиФайла);
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьЗагрузкуСПлохимЗаголовком(ПутьФайла, Лог)
	
	Попытка
		
		Обработка = Обработки.ОбменСФайлами.Создать();
		
		ФайлДанных = Новый Файл(ПутьФайла);
		Если Не ФайлДанных.Существует() Тогда
			ПодготовитьФайлБезБазовойЦены(Обработка, ПутьФайла);
		КонецЕсли;
		
		// Код берём из самого файла, а не из константы: проверка «элемента нет
		// в базе» должна относиться именно к тем данным, что подали на вход.
		Прочитанное = ОбменCSV.ПрочитатьФайл(ПутьФайла);
		КодИзФайла = "";
		Если Прочитанное.Строки.Количество() > 0 Тогда
			ПерваяСтрока = Прочитанное.Строки[0];
			Если ПерваяСтрока.Количество() > 0 Тогда
				КодИзФайла = ПерваяСтрока[0];
			КонецЕсли;
		КонецЕсли;
		
		Результат = Обработка.ЗагрузитьНоменклатуру(ПутьФайла);
		
		Причины = Новый Массив;
		Для Каждого СтрокаОшибки Из Результат.Ошибки Цикл
			Причины.Добавить(СтрокаОшибки.Сообщение);
		КонецЦикла;
		ТекстПричин = СтрСоединить(Причины, " | ");
		
		КоличествоВБазе = КоличествоНоменклатурыПоКоду(КодИзФайла);
		
		Лог.Добавить("вердикт обработки: " + Результат.Вердикт);
		Лог.Добавить("причина: " + ТекстПричин);
		Лог.Добавить("причина содержит БазоваяЦена: " + ?(Найти(ТекстПричин, "БазоваяЦена") > 0, "да", "нет"));
		Лог.Добавить("код из файла: " + КодИзФайла + ", позиций в базе: " + КоличествоВБазе);
		
		Проблемы = Новый Массив;
		
		Если Результат.Вердикт <> "FAIL" Тогда
			Проблемы.Добавить("вердикт обработки: " + Результат.Вердикт + "/FAIL");
		КонецЕсли;
		Если Найти(ТекстПричин, "БазоваяЦена") = 0 Тогда
			Проблемы.Добавить("в причине нет ""БазоваяЦена""");
		КонецЕсли;
		Если КоличествоВБазе <> 0 Тогда
			Проблемы.Добавить("создано элементов: " + КоличествоВБазе + "/0");
		КонецЕсли;
		
		Если Проблемы.Количество() > 0 Тогда
			Лог.Добавить("FAIL " + СтрСоединить(Проблемы, "; "));
			Лог.Добавить("ВЕРДИКТ: FAIL");
		Иначе
			Лог.Добавить("ВЕРДИКТ: PASS");
		КонецЕсли;
		
	Исключение
		Лог.Добавить("ошибка: " + ОписаниеОшибки());
		Лог.Добавить("ВЕРДИКТ: FAIL");
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФайлСПлохимиТипами(Обработка, ПутьФайла)
	
	// Файл пишет сам драйвер: прогон не должен зависеть от внешней заготовки,
	// которую можно «починить», отредактировав файл руками.
	КолонкиФайла = Обработка.ОбязательныеКолонкиНоменклатуры();
	
	СтрокиФайла = Новый Массив;
	
	// Строка 1 - корректные типы во всех типизированных колонках.
	СтрокиФайла.Добавить(СтрокаНоменклатуры("999000301", "Позиция с корректными типами", "Ложь", "100,00"));
	
	// Строка 2 - БазоваяЦена не приводится к числу.
	СтрокиФайла.Добавить(СтрокаНоменклатуры("999000302", "Позиция с ценой-текстом", "Ложь", "дорого"));
	
	// Строка 3 - ЭтоГруппа не приводится к булеву.
	СтрокиФайла.Добавить(СтрокаНоменклатуры("999000303", "Позиция с булевым-текстом", "может быть", "100,00"));
	
	// Строка 4 - цена отрицательная, но приводится к числу: это нарушение правил
	// записи, а не типа, поэтому проверка типов её пропускать обязана.
	СтрокиФайла.Добавить(СтрокаНоменклатуры("999000304", "Позиция с отрицательной ценой", "Ложь", "-5"));
	
	ОбменCSV.ЗаписатьФайл(ПутьФайла, КолонкиФайла, СтрокиФайла);
	
КонецПроцедуры

&НаСервере
Функция СтрокаНоменклатуры(КодСтроки, НаименованиеСтроки, ЭтоГруппаСтроки, БазоваяЦенаСтроки)
	
	// Состав и порядок полей повторяют ОбязательныеКолонкиНоменклатуры:
	// Код, Наименование, ЭтоГруппа, Родитель, ВидУслуги, Единица, БазоваяЦена, Валюта.
	Поля = Новый Массив;
	Поля.Добавить(КодСтроки);
	Поля.Добавить(НаименованиеСтроки);
	Поля.Добавить(ЭтоГруппаСтроки);
	Поля.Добавить("");
	Поля.Добавить("Виза");
	Поля.Добавить("Штука");
	Поля.Добавить(БазоваяЦенаСтроки);
	Поля.Добавить("Российский рубль");
	
	Возврат Поля;
	
КонецФункции

&НаСервере
Процедура ВыполнитьЗагрузкуСПлохимиТипами(ПутьФайла, Лог)
	
	Попытка
		
		Обработка = Обработки.ОбменСФайлами.Создать();
		
		ФайлДанных = Новый Файл(ПутьФайла);
		Если Не ФайлДанных.Существует() Тогда
			ПодготовитьФайлСПлохимиТипами(Обработка, ПутьФайла);
		КонецЕсли;
		
		Результат = Обработка.ЗагрузитьНоменклатуру(ПутьФайла);
		
		Причины = Новый Массив;
		ОшибокТипов = 0;
		ЕстьУпоминаниеОтрицательнойЦены = Ложь;
		
		Для Каждого СтрокаОшибки Из Результат.Ошибки Цикл
			Причины.Добавить(СтрокаОшибки.Сообщение);
			// Ошибка типа всегда несёт контекст колонки: «колонка "<имя>"».
			Если Найти(СтрокаОшибки.Сообщение, "колонка """) > 0 Тогда
				ОшибокТипов = ОшибокТипов + 1;
			КонецЕсли;
			Если Найти(СтрокаОшибки.Сообщение, "-5") > 0 Тогда
				ЕстьУпоминаниеОтрицательнойЦены = Истина;
			КонецЕсли;
		КонецЦикла;
		
		ТекстПричин = СтрСоединить(Причины, " | ");
		
		Лог.Добавить("вердикт: " + Результат.Вердикт);
		Лог.Добавить("записано: " + Результат.Загружено);
		Лог.Добавить("отклонено: " + Результат.Отклонено);
		Лог.Добавить("тип-ошибок: " + ОшибокТипов);
		Лог.Добавить("причина: " + ТекстПричин);
		
		Проблемы = Новый Массив;
		
		Если Результат.Вердикт <> "ЧАСТИЧНО" Тогда
			Проблемы.Добавить("вердикт обработки: " + Результат.Вердикт + "/ЧАСТИЧНО");
		КонецЕсли;
		Если ОшибокТипов <> 2 Тогда
			Проблемы.Добавить("ошибок типов: " + ОшибокТипов + "/2");
		КонецЕсли;
		Если Найти(ТекстПричин, "БазоваяЦена") = 0 Или Найти(ТекстПричин, "дорого") = 0 Тогда
			Проблемы.Добавить("в причине нет ""БазоваяЦена""/""дорого""");
		КонецЕсли;
		Если Найти(ТекстПричин, "может быть") = 0 Тогда
			Проблемы.Добавить("в причине нет ""может быть""");
		КонецЕсли;
		// Строка с ценой -5 обязана пройти проверку типов: -5 приводится к числу.
		Если ЕстьУпоминаниеОтрицательнойЦены Тогда
			Проблемы.Добавить("строка с ценой -5 отклонена проверкой типа, а не правилом записи");
		КонецЕсли;
		
		// Строка с корректными типами теперь действительно пишется: прогон обязан
		// убрать её за собой, иначе справочник копится от запуска к запуску.
		УдаленоТестовых = УдалитьТестовуюНоменклатуру();
		Лог.Добавить("удалено: " + УдаленоТестовых);
		
		Если Проблемы.Количество() > 0 Тогда
			Лог.Добавить("FAIL " + СтрСоединить(Проблемы, "; "));
			Лог.Добавить("ВЕРДИКТ: FAIL");
		Иначе
			Лог.Добавить("ВЕРДИКТ: PASS");
		КонецЕсли;
		
	Исключение
		Лог.Добавить("ошибка: " + ОписаниеОшибки());
		Лог.Добавить("ВЕРДИКТ: FAIL");
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФайлСНесуществующимиСсылками(Обработка, ПутьФайла)
	
	// Файл пишет сам драйвер: прогон не должен зависеть от внешней заготовки,
	// которую можно «починить», отредактировав файл руками.
	КолонкиФайла = Обработка.ОбязательныеКолонкиНоменклатуры();
	
	СтрокиФайла = Новый Массив;
	
	// Строка 1 - все ссылки разрешаются, строка обязана пройти.
	СтрокиФайла.Добавить(СтрокаНоменклатурыССылками("999000401", "Позиция с корректными ссылками",
		"", "Виза", "Штука", "Российский рубль"));
	
	// Строка 2 - вид услуги, которого нет в перечислении ВидыУслуг.
	СтрокиФайла.Добавить(СтрокаНоменклатурыССылками("999000402", "Позиция с несуществующим видом услуги",
		"", "Космос", "Штука", "Российский рубль"));
	
	// Строка 3 - единица, которой нет в справочнике ЕдиницыИзмерения.
	СтрокиФайла.Добавить(СтрокаНоменклатурыССылками("999000403", "Позиция с несуществующей единицей",
		"", "Виза", "Несуществующая единица", "Российский рубль"));
	
	ОбменCSV.ЗаписатьФайл(ПутьФайла, КолонкиФайла, СтрокиФайла);
	
КонецПроцедуры

&НаСервере
Функция СтрокаНоменклатурыССылками(КодСтроки, НаименованиеСтроки, РодительСтроки,
	ВидУслугиСтроки, ЕдиницаСтроки, ВалютаСтроки)
	
	// Состав и порядок полей повторяют ОбязательныеКолонкиНоменклатуры:
	// Код, Наименование, ЭтоГруппа, Родитель, ВидУслуги, Единица, БазоваяЦена, Валюта.
	Поля = Новый Массив;
	Поля.Добавить(КодСтроки);
	Поля.Добавить(НаименованиеСтроки);
	Поля.Добавить("Ложь");
	Поля.Добавить(РодительСтроки);
	Поля.Добавить(ВидУслугиСтроки);
	Поля.Добавить(ЕдиницаСтроки);
	Поля.Добавить("100,00");
	Поля.Добавить(ВалютаСтроки);
	
	Возврат Поля;
	
КонецФункции

&НаСервере
Процедура ВыполнитьЗагрузкуСНесуществующимиСсылками(ПутьФайла, Лог)
	
	Попытка
		
		Обработка = Обработки.ОбменСФайлами.Создать();
		
		ФайлДанных = Новый Файл(ПутьФайла);
		Если Не ФайлДанных.Существует() Тогда
			ПодготовитьФайлСНесуществующимиСсылками(Обработка, ПутьФайла);
		КонецЕсли;
		
		// Остатки прошлого прогона удаляются до загрузки: иначе код «уже существует»
		// отклонил бы валидную строку.
		УдалитьТестовуюНоменклатуру();
		
		КоличествоДоЗагрузки = КоличествоНоменклатуры();
		
		Результат = Обработка.ЗагрузитьНоменклатуру(ПутьФайла);
		
		Причины = Новый Массив;
		ОшибокНеНайденоЗначение = 0;
		УпоминаетсяПеречисление = Ложь;
		УпоминаетсяСправочник   = Ложь;
		ОшибкиРазличаются        = Ложь;
		ПредыдущийТекст          = "";
		
		Для Каждого СтрокаОшибки Из Результат.Ошибки Цикл
			
			Причины.Добавить(СтрокаОшибки.Сообщение);
			
			Если Найти(СтрокаОшибки.Сообщение, "не найдено") = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			ОшибокНеНайденоЗначение = ОшибокНеНайденоЗначение + 1;
			
			Если Найти(СтрокаОшибки.Сообщение, "ВидыУслуг") > 0 Тогда
				УпоминаетсяПеречисление = Истина;
			КонецЕсли;
			Если Найти(СтрокаОшибки.Сообщение, "ЕдиницыИзмерения") > 0 Тогда
				УпоминаетсяСправочник = Истина;
			КонецЕсли;
			// Две ошибки должны быть разными текстами: иначе сообщение не объясняет,
			// какая именно колонка и какой справочник не сработали.
			Если Не ПустаяСтрока(ПредыдущийТекст) И ПредыдущийТекст <> СтрокаОшибки.Сообщение Тогда
				ОшибкиРазличаются = Истина;
			КонецЕсли;
			ПредыдущийТекст = СтрокаОшибки.Сообщение;
			
		КонецЦикла;
		
		ТекстПричин = СтрСоединить(Причины, " | ");
		
		// Запись теперь настоящая: строка с корректными ссылками обязана появиться
		// в базе, строки с несуществующими ссылками - нет.
		КоличествоПослеЗагрузки = КоличествоНоменклатуры();
		СозданоПоКодамФайла = КоличествоНоменклатурыПоКоду("999000401")
			+ КоличествоНоменклатурыПоКоду("999000402")
			+ КоличествоНоменклатурыПоКоду("999000403");
		
		// Уборка возвращает справочник к исходному составу: прогон не оставляет следов.
		УдаленоТестовых        = УдалитьТестовуюНоменклатуру();
		КоличествоПослеУборки  = КоличествоНоменклатуры();
		
		Лог.Добавить("вердикт: " + Результат.Вердикт);
		Лог.Добавить("записано: " + Результат.Загружено);
		Лог.Добавить("отклонено: " + Результат.Отклонено);
		Лог.Добавить("ошибок ""не найдено"": " + ОшибокНеНайденоЗначение);
		Лог.Добавить("причина: " + ТекстПричин);
		Лог.Добавить("позиций в справочнике: " + КоличествоДоЗагрузки + " -> " + КоличествоПослеЗагрузки);
		Лог.Добавить("удалено: " + УдаленоТестовых);
		Лог.Добавить("позиций после уборки: " + КоличествоПослеУборки);
		
		Проблемы = Новый Массив;
		
		Если Результат.Вердикт <> "ЧАСТИЧНО" Тогда
			Проблемы.Добавить("вердикт обработки: " + Результат.Вердикт + "/ЧАСТИЧНО");
		КонецЕсли;
		Если Результат.Загружено <> 1 Тогда
			Проблемы.Добавить("записано: " + Результат.Загружено + "/1");
		КонецЕсли;
		Если Результат.Отклонено <> 2 Тогда
			Проблемы.Добавить("отклонено: " + Результат.Отклонено + "/2");
		КонецЕсли;
		Если ОшибокНеНайденоЗначение <> 2 Тогда
			Проблемы.Добавить("ошибок ""не найдено"": " + ОшибокНеНайденоЗначение + "/2");
		КонецЕсли;
		Если Не УпоминаетсяПеречисление Тогда
			Проблемы.Добавить("нет упоминания перечисления ""ВидыУслуг""");
		КонецЕсли;
		Если Не УпоминаетсяСправочник Тогда
			Проблемы.Добавить("нет упоминания справочника ""ЕдиницыИзмерения""");
		КонецЕсли;
		Если Не ОшибкиРазличаются Тогда
			Проблемы.Добавить("тексты ошибок не различаются");
		КонецЕсли;
		Если Найти(ТекстПричин, "колонка """) = 0 Тогда
			Проблемы.Добавить("в причине нет контекста колонки");
		КонецЕсли;
		Если КоличествоПослеЗагрузки <> КоличествоДоЗагрузки + 1 Тогда
			Проблемы.Добавить("записанных позиций: " + КоличествоДоЗагрузки + "/" + (КоличествоДоЗагрузки + 1) + ", получено " + КоличествоПослеЗагрузки);
		КонецЕсли;
		Если СозданоПоКодамФайла <> 1 Тогда
			Проблемы.Добавить("создано элементов из файла: " + СозданоПоКодамФайла + "/1");
		КонецЕсли;
		Если КоличествоПослеУборки <> КоличествоДоЗагрузки Тогда
			Проблемы.Добавить("состав справочника после уборки: " + КоличествоДоЗагрузки + "/" + КоличествоПослеУборки);
		КонецЕсли;
		
		Если Проблемы.Количество() > 0 Тогда
			Лог.Добавить("FAIL " + СтрСоединить(Проблемы, "; "));
			Лог.Добавить("ВЕРДИКТ: FAIL");
		Иначе
			Лог.Добавить("ВЕРДИКТ: PASS");
		КонецЕсли;
		
	Исключение
		Лог.Добавить("ошибка: " + ОписаниеОшибки());
		Лог.Добавить("ВЕРДИКТ: FAIL");
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФайлСДублямиКодов(Обработка, ПутьФайла)
	
	// Файл пишет сам драйвер: прогон не должен зависеть от внешней заготовки,
	// которую можно «починить», отредактировав файл руками.
	КолонкиФайла = Обработка.ОбязательныеКолонкиНоменклатуры();
	
	СтрокиФайла = Новый Массив;
	
	// Код 999000501 стоит в строках 2 и 4: этого достаточно, чтобы проверить и сам
	// дубль, и то, что первым вхождением считается именно строка 2.
	СтрокиФайла.Добавить(СтрокаНоменклатуры("999000502", "Позиция с уникальным кодом первая", "Ложь", "100,00"));
	СтрокиФайла.Добавить(СтрокаНоменклатуры("999000501", "Позиция с повторяющимся кодом", "Ложь", "100,00"));
	СтрокиФайла.Добавить(СтрокаНоменклатуры("999000503", "Позиция с уникальным кодом вторая", "Ложь", "100,00"));
	СтрокиФайла.Добавить(СтрокаНоменклатуры("999000501", "Позиция-дубль того же кода", "Ложь", "100,00"));
	
	ОбменCSV.ЗаписатьФайл(ПутьФайла, КолонкиФайла, СтрокиФайла);
	
КонецПроцедуры

&НаСервере
Функция КодыСуществующейНоменклатуры(Максимум)
	
	// Коды берутся из справочника, а не выдумываются: запись в справочник ещё не
	// реализована, и код не может появиться в базе сам собой между прогонами.
	КодыНайденные = Новый Массив;
	
	Выборка = Справочники.НоменклатураУслуг.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если КодыНайденные.Количество() >= Максимум Тогда
			Прервать;
		КонецЕсли;
		КодыНайденные.Добавить(СокрЛП(Строка(Выборка.Код)));
	КонецЦикла;
	
	Возврат КодыНайденные;
	
КонецФункции

&НаСервере
Процедура ПодготовитьФайлССуществующимиКодами(Обработка, ПутьФайла, СуществующиеКоды)
	
	КолонкиФайла = Обработка.ОбязательныеКолонкиНоменклатуры();
	
	СтрокиФайла = Новый Массив;
	// По одному коду на строку: если поставить существующий код дважды, сработает
	// проверка дубля внутри файла и до проверки по базе дело не дойдёт.
	Для Каждого КодСтроки Из СуществующиеКоды Цикл
		СтрокиФайла.Добавить(СтрокаНоменклатуры(КодСтроки, "Позиция с кодом из базы", "Ложь", "100,00"));
	КонецЦикла;
	
	ОбменCSV.ЗаписатьФайл(ПутьФайла, КолонкиФайла, СтрокиФайла);
	
КонецПроцедуры

&НаСервере
Функция ТекстПричинЗагрузки(Результат)
	
	Причины = Новый Массив;
	Для Каждого СтрокаОшибки Из Результат.Ошибки Цикл
		Причины.Добавить(СтрокаОшибки.Сообщение);
	КонецЦикла;
	
	Возврат СтрСоединить(Причины, " | ");
	
КонецФункции

&НаСервере
Процедура ВыполнитьЗагрузкуСДублямиКодов(ПутьФайла, Лог)
	
	Попытка
		
		Обработка = Обработки.ОбменСФайлами.Создать();
		Проблемы = Новый Массив;
		
		// --- Прогон 1: дубль внутри файла ------------------------------------
		// Файл перезаписывается при каждом прогоне, а не только если его нет:
		// иначе на диске остался бы файл второго прогона и сломал ожидания первого.
		ПодготовитьФайлСДублямиКодов(Обработка, ПутьФайла);
		
		РезультатВФайле = Обработка.ЗагрузитьНоменклатуру(ПутьФайла);
		ТекстПричинВФайле = ТекстПричинЗагрузки(РезультатВФайле);
		
		// «вердикт обработки», а не «вердикт»: обёртка run-driver.ps1 ищет в логе
		// строку «ВЕРДИКТ: FAIL» и завершилась бы кодом 1 на ожидаемом FAIL второго
		// прогона, хотя сценарий в целом пройден.
		Лог.Добавить("прогон 1 (дубль в файле): вердикт обработки: " + РезультатВФайле.Вердикт);
		Лог.Добавить("прогон 1: записано: " + РезультатВФайле.Загружено);
		Лог.Добавить("прогон 1: отклонено: " + РезультатВФайле.Отклонено);
		Лог.Добавить("прогон 1: причина: " + ТекстПричинВФайле);
		
		Если РезультатВФайле.Вердикт <> "ЧАСТИЧНО" Тогда
			Проблемы.Добавить("прогон 1, вердикт: " + РезультатВФайле.Вердикт + "/ЧАСТИЧНО");
		КонецЕсли;
		Если РезультатВФайле.Загружено <> 2 Тогда
			Проблемы.Добавить("прогон 1, записано: " + РезультатВФайле.Загружено + "/2");
		КонецЕсли;
		Если РезультатВФайле.Отклонено <> 2 Тогда
			Проблемы.Добавить("прогон 1, отклонено: " + РезультатВФайле.Отклонено + "/2");
		КонецЕсли;
		// Сообщение о дубле обязано называть обе строки: иначе непонятно, с какой
		// строкой сверялась повторная, и файл не разобрать по логу.
		Если Найти(ТекстПричинВФайле, "Строка 4: код ""999000501"" уже встречался в строке 2") = 0 Тогда
			Проблемы.Добавить("прогон 1: нет сообщения о дубле строк 2 и 4");
		КонецЕсли;
		// Первая из повторяющихся строк отклоняется тоже, и её сообщение обязано
		// называть строку повтора - иначе отклонение выглядит беспричинным.
		Если Найти(ТекстПричинВФайле, "Строка 2: код ""999000501"" повторяется в строке 4") = 0 Тогда
			Проблемы.Добавить("прогон 1: нет сообщения о повторе для строки 2");
		КонецЕсли;
		
		// --- Прогон 2: код уже есть в базе, тот же путь файла -----------------
		СуществующиеКоды = КодыСуществующейНоменклатуры(3);
		
		Если СуществующиеКоды.Количество() = 0 Тогда
			Проблемы.Добавить("прогон 2: в справочнике нет элементов для проверки");
		Иначе
			
			ПодготовитьФайлССуществующимиКодами(Обработка, ПутьФайла, СуществующиеКоды);
			
			РезультатВБазе = Обработка.ЗагрузитьНоменклатуру(ПутьФайла);
			ТекстПричинВБазе = ТекстПричинЗагрузки(РезультатВБазе);
			
			Лог.Добавить("прогон 2 (коды уже в базе): коды: " + СтрСоединить(СуществующиеКоды, ","));
			Лог.Добавить("прогон 2: вердикт обработки: " + РезультатВБазе.Вердикт);
			Лог.Добавить("прогон 2: записано: " + РезультатВБазе.Загружено);
			Лог.Добавить("прогон 2: отклонено: " + РезультатВБазе.Отклонено);
			Лог.Добавить("прогон 2: причина: " + ТекстПричинВБазе);
			
			Если РезультатВБазе.Вердикт <> "FAIL" Тогда
				Проблемы.Добавить("прогон 2, вердикт: " + РезультатВБазе.Вердикт + "/FAIL");
			КонецЕсли;
			Если РезультатВБазе.Загружено <> 0 Тогда
				Проблемы.Добавить("прогон 2, записано: " + РезультатВБазе.Загружено + "/0");
			КонецЕсли;
			Если РезультатВБазе.Отклонено <> СуществующиеКоды.Количество() Тогда
				Проблемы.Добавить("прогон 2, отклонено: " + РезультатВБазе.Отклонено + "/" + СуществующиеКоды.Количество());
			КонецЕсли;
			Если Найти(ТекстПричинВБазе, "уже существует") = 0 Тогда
				Проблемы.Добавить("прогон 2: в причине нет ""уже существует""");
			КонецЕсли;
			
		КонецЕсли;
		
		// Оба прогона пишут в справочник: тестовые позиции убираются за собой,
		// иначе база копила бы их от запуска к запуску.
		УдаленоТестовых = УдалитьТестовуюНоменклатуру();
		Лог.Добавить("удалено: " + УдаленоТестовых);
		
		Если Проблемы.Количество() > 0 Тогда
			Лог.Добавить("FAIL " + СтрСоединить(Проблемы, "; "));
			Лог.Добавить("ВЕРДИКТ: FAIL");
		Иначе
			Лог.Добавить("ВЕРДИКТ: PASS");
		КонецЕсли;
		
	Исключение
		Лог.Добавить("ошибка: " + ОписаниеОшибки());
		Лог.Добавить("ВЕРДИКТ: FAIL");
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Функция КоличествоНоменклатуры()
	
	Возврат КоличествоНоменклатурыПоПризнакуГруппы(Ложь)
		+ КоличествоНоменклатурыПоПризнакуГруппы(Истина);
	
КонецФункции

&НаСервере
Функция УдалитьТестовуюНоменклатуру()
	
	// Тестовые позиции опознаются по коду «999…» и по префиксу «ТЕСТ-»: прогон
	// не должен оставлять в справочнике ни одной своей строки, иначе следующий
	// прогон увидит «код уже существует» и счётчики разойдутся.
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.НоменклатураУслуг
		|ГДЕ
		|	ПОДСТРОКА(Код, 1, 3) = ""999""
		|	ИЛИ ПОДСТРОКА(Наименование, 1, 5) = ""ТЕСТ-""";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Ссылки = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Ссылки.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Если Ссылки.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		Для Каждого СсылкаЭлемента Из Ссылки Цикл
			ОбъектЭлемента = СсылкаЭлемента.ПолучитьОбъект();
			Если ОбъектЭлемента <> Неопределено Тогда
				ОбъектЭлемента.Удалить();
			КонецЕсли;
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат Ссылки.Количество();
	
КонецФункции

&НаСервере
Процедура ПодготовитьФайлСПравиламиЗаписи(Обработка, ПутьФайла)
	
	// Файл пишет сам драйвер: прогон не должен зависеть от внешней заготовки,
	// которую можно «починить», отредактировав файл руками.
	КолонкиФайла = Обработка.ОбязательныеКолонкиНоменклатуры();
	
	СтрокиФайла = Новый Массив;
	
	// Строка 1 проходит все проверки и обязана быть записана.
	СтрокиФайла.Добавить(СтрокаНоменклатуры("999000601", "ТЕСТ-правило-годная", "Ложь", "100,00"));
	
	// Строка 2 проходит проверку типов (минус пять приводится к числу), но
	// нарушает правило записи объекта: отклонять её обязана запись, а не разбор.
	СтрокиФайла.Добавить(СтрокаНоменклатуры("999000602", "ТЕСТ-правило-минус", "Ложь", "-5"));
	
	ОбменCSV.ЗаписатьФайл(ПутьФайла, КолонкиФайла, СтрокиФайла);
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьЗагрузкуСПравиламиЗаписи(ПутьФайла, Лог)
	
	Попытка
		
		Обработка = Обработки.ОбменСФайлами.Создать();
		ПодготовитьФайлСПравиламиЗаписи(Обработка, ПутьФайла);
		
		// Остатки прошлого прогона удаляются до загрузки: иначе код «уже существует»
		// отклонил бы валидную строку и прогон проверял бы не то.
		УдалитьТестовуюНоменклатуру();
		
		КоличествоДоЗагрузки = КоличествоНоменклатуры();
		
		Результат = Обработка.ЗагрузитьНоменклатуру(ПутьФайла);
		ТекстПричин = ТекстПричинЗагрузки(Результат);
		
		ЗаписанКод   = КоличествоНоменклатурыПоКоду("999000601");
		ОтклонёнКод  = КоличествоНоменклатурыПоКоду("999000602");
		
		// Уборка идёт до проверок: отклонённая строка не должна остаться в базе
		// даже тогда, когда сам прогон окажется красным.
		Удалено = УдалитьТестовуюНоменклатуру();
		КоличествоПослеУборки = КоличествоНоменклатуры();
		
		Лог.Добавить("вердикт: " + Результат.Вердикт);
		Лог.Добавить("записано: " + Результат.Загружено);
		Лог.Добавить("отклонено: " + Результат.Отклонено);
		Лог.Добавить("причина: " + ТекстПричин);
		Лог.Добавить("999000601 в базе: " + ЗаписанКод);
		Лог.Добавить("999000602 в базе: " + ОтклонёнКод);
		Лог.Добавить("удалено: " + Удалено);
		Лог.Добавить("позиций в справочнике: " + КоличествоДоЗагрузки + " -> " + КоличествоПослеУборки);
		
		Проблемы = Новый Массив;
		
		Если Результат.Вердикт <> "ЧАСТИЧНО" Тогда
			Проблемы.Добавить("вердикт обработки: " + Результат.Вердикт + "/ЧАСТИЧНО");
		КонецЕсли;
		Если Результат.Загружено <> 1 Тогда
			Проблемы.Добавить("записано: " + Результат.Загружено + "/1");
		КонецЕсли;
		Если Результат.Отклонено <> 1 Тогда
			Проблемы.Добавить("отклонено: " + Результат.Отклонено + "/1");
		КонецЕсли;
		Если ЗаписанКод <> 1 Тогда
			Проблемы.Добавить("позиций с кодом ""999000601"": " + ЗаписанКод + "/1");
		КонецЕсли;
		Если ОтклонёнКод <> 0 Тогда
			Проблемы.Добавить("позиций с кодом ""999000602"": " + ОтклонёнКод + "/0");
		КонецЕсли;
		// Текст нарушения берётся у самого объекта: общий отказ платформы не
		// объясняет, какое правило нарушено, и такая причина бесполезна.
		Если Найти(ТекстПричин, "Базовая цена не может быть отрицательной") = 0 Тогда
			Проблемы.Добавить("в причине нет текста нарушения ""ПравилаЗаписи""");
		КонецЕсли;
		Если КоличествоПослеУборки <> КоличествоДоЗагрузки Тогда
			Проблемы.Добавить("состав справочника после уборки: " + КоличествоДоЗагрузки + "/" + КоличествоПослеУборки);
		КонецЕсли;
		
		Если Проблемы.Количество() > 0 Тогда
			Лог.Добавить("FAIL " + СтрСоединить(Проблемы, "; "));
			Лог.Добавить("ВЕРДИКТ: FAIL");
		Иначе
			Лог.Добавить("ВЕРДИКТ: PASS");
		КонецЕсли;
		
	Исключение
		// Уборка в обработчике исключения: тестовые позиции не должны остаться
		// в базе, даже если сценарий упал на середине.
		Попытка
			УдалитьТестовуюНоменклатуру();
		Исключение
		КонецПопытки;
		Лог.Добавить("ошибка: " + ОписаниеОшибки());
		Лог.Добавить("ВЕРДИКТ: FAIL");
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФайлПолностьюВалидный(Обработка, ПутьФайла)
	
	// Файл пишет сам драйвер: прогон не должен зависеть от внешней заготовки,
	// которую можно «починить», отредактировав файл руками.
	КолонкиФайла = Обработка.ОбязательныеКолонкиНоменклатуры();
	
	СтрокиФайла = Новый Массив;
	// Две строки, проходящие все проверки: вердикт обязан быть PASS.
	СтрокиФайла.Добавить(СтрокаНоменклатуры("999000701", "ТЕСТ-отчёт-годная-1", "Ложь", "100,00"));
	СтрокиФайла.Добавить(СтрокаНоменклатуры("999000702", "ТЕСТ-отчёт-годная-2", "Ложь", "200,00"));
	
	ОбменCSV.ЗаписатьФайл(ПутьФайла, КолонкиФайла, СтрокиФайла);
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФайлПолностьюБитый(Обработка, ПутьФайла)
	
	КолонкиФайла = Обработка.ОбязательныеКолонкиНоменклатуры();
	
	СтрокиФайла = Новый Массив;
	// Обе строки не проходят разрешение ссылок: единицы с таким наименованием нет.
	// Ни одной записанной строки при непустом файле - это FAIL, а не ЧАСТИЧНО.
	СтрокиФайла.Добавить(СтрокаНоменклатурыССылками("999000703", "ТЕСТ-отчёт-битая-1",
		"", "Виза", "Несуществующая единица", "Российский рубль"));
	СтрокиФайла.Добавить(СтрокаНоменклатурыССылками("999000704", "ТЕСТ-отчёт-битая-2",
		"", "Виза", "Несуществующая единица", "Российский рубль"));
	
	ОбменCSV.ЗаписатьФайл(ПутьФайла, КолонкиФайла, СтрокиФайла);
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФайлСмешанный(Обработка, ПутьФайла)
	
	КолонкиФайла = Обработка.ОбязательныеКолонкиНоменклатуры();
	
	СтрокиФайла = Новый Массив;
	// Две годные строки и две битые: состоявшийся обмен с потерями - ЧАСТИЧНО.
	СтрокиФайла.Добавить(СтрокаНоменклатуры("999000705", "ТЕСТ-отчёт-смешанная-годная-1", "Ложь", "100,00"));
	СтрокиФайла.Добавить(СтрокаНоменклатуры("999000706", "ТЕСТ-отчёт-смешанная-годная-2", "Ложь", "200,00"));
	СтрокиФайла.Добавить(СтрокаНоменклатурыССылками("999000707", "ТЕСТ-отчёт-смешанная-битая-1",
		"", "Виза", "Несуществующая единица", "Российский рубль"));
	СтрокиФайла.Добавить(СтрокаНоменклатурыССылками("999000708", "ТЕСТ-отчёт-смешанная-битая-2",
		"", "Космос", "Штука", "Российский рубль"));
	
	ОбменCSV.ЗаписатьФайл(ПутьФайла, КолонкиФайла, СтрокиФайла);
	
КонецПроцедуры

&НаСервере
Функция ПутьФайлаПрогона(БазовыйПуть, СуффиксИмени, РасширениеФайла)
	
	// Без явного пути каждый прогон пишет во временный файл: три прогона не должны
	// делить один файл и затирать данные друг друга.
	Если ПустаяСтрока(БазовыйПуть) Тогда
		Возврат ПолучитьИмяВременногоФайла(РасширениеФайла);
	КонецЕсли;
	
	// Базовый путь используется как заготовка имени: каталог берётся у него,
	// а к имени добавляется номер прогона - иначе файлы перекрылись бы.
	ФайлБазы = Новый Файл(БазовыйПуть);
	Каталог  = ФайлБазы.Путь;
	Если Не ПустаяСтрока(Каталог) Тогда
		Каталог = Каталог + "\";
	КонецЕсли;
	
	Возврат Каталог + ФайлБазы.ИмяБезРасширения + "-" + СуффиксИмени + "." + РасширениеФайла;
	
КонецФункции

&НаСервере
Функция ТекстФайлаОтчёта(ПутьФайлаОтчёта)
	
	Если ПустаяСтрока(ПутьФайлаОтчёта) Тогда
		Возврат "";
	КонецЕсли;
	
	ФайлОтчёта = Новый Файл(ПутьФайлаОтчёта);
	
	Если Не ФайлОтчёта.Существует() Тогда
		Возврат "";
	КонецЕсли;
	
	Чтение = Новый ЧтениеТекста(ПутьФайлаОтчёта, "UTF-8");
	ТекстПолный = Чтение.Прочитать();
	Чтение.Закрыть();
	
	Возврат ТекстПолный;
	
КонецФункции

&НаСервере
Процедура ВыполнитьЗагрузкуСОтчётами(ПутьФайла, Лог)
	
	Попытка
		
		Обработка = Обработки.ОбменСФайлами.Создать();
		Проблемы = Новый Массив;
		
		// Три прогона на трёх разных файлах: проверяется правило расчёта вердикта,
		// поэтому один и тот же файл тут не годится - вердикт обязан различаться
		// именно из-за состава файла.
		ОжидаемыеВердикты = Новый Массив;
		ОжидаемыеВердикты.Добавить("PASS");
		ОжидаемыеВердикты.Добавить("FAIL");
		ОжидаемыеВердикты.Добавить("ЧАСТИЧНО");
		
		ОжидаемыеЗагружено = Новый Массив;
		ОжидаемыеЗагружено.Добавить(2);
		ОжидаемыеЗагружено.Добавить(0);
		ОжидаемыеЗагружено.Добавить(2);
		
		ОжидаемыеОтклонено = Новый Массив;
		ОжидаемыеОтклонено.Добавить(0);
		ОжидаемыеОтклонено.Добавить(2);
		ОжидаемыеОтклонено.Добавить(2);
		
		ОжидаемыеСтрок = Новый Массив;
		ОжидаемыеСтрок.Добавить(2);
		ОжидаемыеСтрок.Добавить(2);
		ОжидаемыеСтрок.Добавить(4);
		
		КоличествоДоПрогонов = КоличествоНоменклатуры();
		
		Для ИндексПрогона = 0 По ОжидаемыеВердикты.Количество() - 1 Цикл
			
			НомерПрогона     = ИндексПрогона + 1;
			ОжидаемыйВердикт = ОжидаемыеВердикты[ИндексПрогона];
			
			// У каждого прогона свои файлы данных и отчёта: иначе второй прогон
			// проверял бы отчёт, оставшийся от первого.
			ПутьДанных        = ПутьФайлаПрогона(ПутьФайла, "прогон" + НомерПрогона, "csv");
			ПутьОтчётаПрогона = ПутьФайлаПрогона(ПутьФайла, "прогон" + НомерПрогона, "txt");
			
			Если НомерПрогона = 1 Тогда
				ПодготовитьФайлПолностьюВалидный(Обработка, ПутьДанных);
			ИначеЕсли НомерПрогона = 2 Тогда
				ПодготовитьФайлПолностьюБитый(Обработка, ПутьДанных);
			Иначе
				ПодготовитьФайлСмешанный(Обработка, ПутьДанных);
			КонецЕсли;
			
			// Остатки прошлого прогона удаляются до загрузки: иначе код «уже
			// существует» отклонил бы валидную строку и вердикт соврал бы.
			УдалитьТестовуюНоменклатуру();
			
			Результат = Обработка.ЗагрузитьНоменклатуру(ПутьДанных);
			
			// Отчёт пишется всегда, в том числе при FAIL: именно он объясняет отказ.
			Обработка.ЗаписатьОтчёт(ПутьОтчётаПрогона, Результат);
			
			ТекстОтчёта        = ТекстФайлаОтчёта(ПутьОтчётаПрогона);
			ЕстьСтрокаВердикта = Найти(ТекстОтчёта, "ВЕРДИКТ: " + ОжидаемыйВердикт) > 0;
			
			// Уборка до проверок: прогон не оставляет следов даже при красном
			// результате, иначе следующая проверка состава справочника не сойдётся.
			Удалено   = УдалитьТестовуюНоменклатуру();
			БезСледов = КоличествоНоменклатуры() = КоличествоДоПрогонов;
			
			// Строка без префикса «ВЕРДИКТ:»: обёртка run-driver.ps1 ищет в логе
			// именно «ВЕРДИКТ: FAIL» и завершилась бы кодом 1 на ожидаемом FAIL
			// второго прогона, хотя сценарий в целом пройден.
			Лог.Добавить("прогон " + НомерПрогона + ": вердикт " + Результат.Вердикт
				+ ", записано " + Результат.Загружено
				+ ", отклонено " + Результат.Отклонено
				+ ", файл: " + ?(ЕстьСтрокаВердикта, "OK", "FAIL"));
			Лог.Добавить("прогон " + НомерПрогона + ": файл данных: " + ПутьДанных);
			Лог.Добавить("прогон " + НомерПрогона + ": отчёт: " + ПутьОтчётаПрогона + ", удалено: " + Удалено);
			
			Если Результат.Вердикт <> ОжидаемыйВердикт Тогда
				Проблемы.Добавить("прогон " + НомерПрогона + ", вердикт: " + Результат.Вердикт + "/" + ОжидаемыйВердикт);
			КонецЕсли;
			Если Результат.ВсегоСтрок <> ОжидаемыеСтрок[ИндексПрогона] Тогда
				Проблемы.Добавить("прогон " + НомерПрогона + ", всего строк: " + Результат.ВсегоСтрок + "/" + ОжидаемыеСтрок[ИндексПрогона]);
			КонецЕсли;
			Если Результат.Загружено <> ОжидаемыеЗагружено[ИндексПрогона] Тогда
				Проблемы.Добавить("прогон " + НомерПрогона + ", записано: " + Результат.Загружено + "/" + ОжидаемыеЗагружено[ИндексПрогона]);
			КонецЕсли;
			Если Результат.Отклонено <> ОжидаемыеОтклонено[ИндексПрогона] Тогда
				Проблемы.Добавить("прогон " + НомерПрогона + ", отклонено: " + Результат.Отклонено + "/" + ОжидаемыеОтклонено[ИндексПрогона]);
			КонецЕсли;
			Если Не ЕстьСтрокаВердикта Тогда
				Проблемы.Добавить("прогон " + НомерПрогона + ": в отчёте нет строки ""ВЕРДИКТ: " + ОжидаемыйВердикт + """");
			КонецЕсли;
			// Счётчики в файле проверяются отдельно от вердикта: отчёт с верным
			// вердиктом и пустыми счётчиками бесполезен.
			Если Найти(ТекстОтчёта, "Всего строк: " + Результат.ВсегоСтрок) = 0 Тогда
				Проблемы.Добавить("прогон " + НомерПрогона + ": в отчёте нет счётчика ""Всего строк""");
			КонецЕсли;
			Если Найти(ТекстОтчёта, "Загружено: " + Результат.Загружено) = 0 Тогда
				Проблемы.Добавить("прогон " + НомерПрогона + ": в отчёте нет счётчика ""Загружено""");
			КонецЕсли;
			Если Найти(ТекстОтчёта, "Отклонено: " + Результат.Отклонено) = 0 Тогда
				Проблемы.Добавить("прогон " + НомерПрогона + ": в отчёте нет счётчика ""Отклонено""");
			КонецЕсли;
			// Каждая ошибка обязана попасть в отчёт построчно: вердикт без причин
			// не объясняет, что править в файле.
			Для Каждого СтрокаОшибки Из Результат.Ошибки Цикл
				Если Найти(ТекстОтчёта, "СТРОКА " + СтрокаОшибки.Строка + ": ") = 0 Тогда
					Проблемы.Добавить("прогон " + НомерПрогона + ": в отчёте нет строки ошибки " + СтрокаОшибки.Строка);
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если Не БезСледов Тогда
				Проблемы.Добавить("прогон " + НомерПрогона + ", состав справочника после уборки: "
					+ КоличествоНоменклатуры() + "/" + КоличествоДоПрогонов);
			КонецЕсли;
			
		КонецЦикла;
		
		// Пустой путь означает «отчёт не нужен»: обработка не угадывает каталог
		// и не пишет файл там, где ей не место.
		Попытка
			Обработка.ЗаписатьОтчёт("", Обработка.НовыйОтчёт());
		Исключение
			Проблемы.Добавить("пустой путь отчёта вызвал исключение: " + ОписаниеОшибки());
		КонецПопытки;
		
		Лог.Добавить("позиций в справочнике: " + КоличествоДоПрогонов + " -> " + КоличествоНоменклатуры());
		
		Если Проблемы.Количество() > 0 Тогда
			Лог.Добавить("FAIL " + СтрСоединить(Проблемы, "; "));
			Лог.Добавить("ВЕРДИКТ: FAIL");
		Иначе
			Лог.Добавить("ВЕРДИКТ: PASS");
		КонецЕсли;
		
	Исключение
		// Уборка в обработчике исключения: тестовые позиции не должны остаться
		// в базе, даже если сценарий упал на середине.
		Попытка
			УдалитьТестовуюНоменклатуру();
		Исключение
		КонецПопытки;
		Лог.Добавить("ошибка: " + ОписаниеОшибки());
		Лог.Добавить("ВЕРДИКТ: FAIL");
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФайлВалидногоИмпорта(Обработка, ПутьФайла)
	
	// Файл пишет сам драйвер: прогон не должен зависеть от внешней заготовки,
	// которую можно «починить», отредактировав файл руками.
	КолонкиФайла = Обработка.ОбязательныеКолонкиНоменклатуры();
	
	СтрокиФайла = Новый Массив;
	// Три строки проходят все проверки: вердикт обязан быть PASS, все три - в базе.
	СтрокиФайла.Добавить(СтрокаНоменклатуры("999000101", "ТЕСТ-валид-1", "Ложь", "100,00"));
	СтрокиФайла.Добавить(СтрокаНоменклатуры("999000102", "ТЕСТ-валид-2", "Ложь", "200,00"));
	СтрокиФайла.Добавить(СтрокаНоменклатуры("999000103", "ТЕСТ-валид-3", "Ложь", "300,00"));
	
	ОбменCSV.ЗаписатьФайл(ПутьФайла, КолонкиФайла, СтрокиФайла);
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьЗагрузкуВалидногоФайла(ПутьФайла, Лог)
	
	Попытка
		
		Обработка = Обработки.ОбменСФайлами.Создать();
		
		// Файл готовится только если его нет: повторный прогон обязан читать
		// тот же файл, иначе проверка «код уже существует» ничего не докажет.
		ФайлДанных = Новый Файл(ПутьФайла);
		Если Не ФайлДанных.Существует() Тогда
			ПодготовитьФайлВалидногоИмпорта(Обработка, ПутьФайла);
		КонецЕсли;
		
		// Уборки до загрузки нет намеренно: база должна быть чистой по условиям
		// прогона, а иначе «PASS» означал бы «нашёл и перезаписал», а не «создал».
		КоличествоДоЗагрузки = КоличествоНоменклатуры();
		
		Результат = Обработка.ЗагрузитьНоменклатуру(ПутьФайла);
		ТекстПричин = ТекстПричинЗагрузки(Результат);
		
		КодыФайла = Новый Массив;
		КодыФайла.Добавить("999000101");
		КодыФайла.Добавить("999000102");
		КодыФайла.Добавить("999000103");
		
		НайденоВБазе = 0;
		Для Каждого КодСтроки Из КодыФайла Цикл
			НайденоВБазе = НайденоВБазе + КоличествоНоменклатурыПоКоду(КодСтроки);
		КонецЦикла;
		
		КоличествоПослеЗагрузки = КоличествоНоменклатуры();
		
		Лог.Добавить("вердикт обработки: " + Результат.Вердикт);
		Лог.Добавить("записано: " + Результат.Загружено);
		Лог.Добавить("отклонено: " + Результат.Отклонено);
		Лог.Добавить("причина: " + ТекстПричин);
		Лог.Добавить("элементов из файла в базе: " + НайденоВБазе + "/3");
		Лог.Добавить("позиций в справочнике: " + КоличествоДоЗагрузки + " -> " + КоличествоПослеЗагрузки);
		
		Проблемы = Новый Массив;
		
		Если Результат.Вердикт <> "PASS" Тогда
			Проблемы.Добавить("вердикт обработки: " + Результат.Вердикт + "/PASS");
		КонецЕсли;
		Если Результат.Загружено <> 3 Тогда
			Проблемы.Добавить("записано: " + Результат.Загружено + "/3");
		КонецЕсли;
		Если Результат.Отклонено <> 0 Тогда
			Проблемы.Добавить("отклонено: " + Результат.Отклонено + "/0");
		КонецЕсли;
		Если НайденоВБазе <> 3 Тогда
			Проблемы.Добавить("элементов из файла в базе: " + НайденоВБазе + "/3");
		КонецЕсли;
		Если КоличествоПослеЗагрузки <> КоличествоДоЗагрузки + 3 Тогда
			Проблемы.Добавить("прирост справочника: " + (КоличествоПослеЗагрузки - КоличествоДоЗагрузки) + "/3");
		КонецЕсли;
		
		Если Проблемы.Количество() > 0 Тогда
			Лог.Добавить("FAIL " + СтрСоединить(Проблемы, "; "));
			Лог.Добавить("ВЕРДИКТ: FAIL");
		Иначе
			Лог.Добавить("ВЕРДИКТ: PASS");
		КонецЕсли;
		
	Исключение
		Лог.Добавить("ошибка: " + ОписаниеОшибки());
		Лог.Добавить("ВЕРДИКТ: FAIL");
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФайлСИерархией(Обработка, ПутьФайла)
	
	// Файл с иерархией: группа верхнего уровня, вложенная в неё позиция и позиция
	// верхнего уровня. Порядок строк - как в выгрузке: родитель раньше потомка.
	КолонкиФайла = Обработка.ОбязательныеКолонкиНоменклатуры();
	
	СтрокиФайла = Новый Массив;
	СтрокиФайла.Добавить(СтрокаИерархии("999000801", "ТЕСТ-Группа", "Истина", "", "0,00"));
	СтрокиФайла.Добавить(СтрокаИерархии("999000802", "ТЕСТ-Позиция", "Ложь", "ТЕСТ-Группа", "150,00"));
	СтрокиФайла.Добавить(СтрокаИерархии("999000803", "ТЕСТ-Верхняя", "Ложь", "", "250,00"));
	
	ОбменCSV.ЗаписатьФайл(ПутьФайла, КолонкиФайла, СтрокиФайла);
	
КонецПроцедуры

&НаСервере
Функция СтрокаИерархии(КодСтроки, НаименованиеСтроки, ЭтоГруппаСтроки, РодительСтроки, БазоваяЦенаСтроки)
	
	// Состав и порядок полей повторяют ОбязательныеКолонкиНоменклатуры:
	// Код, Наименование, ЭтоГруппа, Родитель, ВидУслуги, Единица, БазоваяЦена, Валюта.
	Поля = Новый Массив;
	Поля.Добавить(КодСтроки);
	Поля.Добавить(НаименованиеСтроки);
	Поля.Добавить(ЭтоГруппаСтроки);
	Поля.Добавить(РодительСтроки);
	Поля.Добавить("Виза");
	Поля.Добавить("Штука");
	Поля.Добавить(БазоваяЦенаСтроки);
	Поля.Добавить("Российский рубль");
	
	Возврат Поля;
	
КонецФункции

&НаСервере
Функция ПризнакиЭлементаПоКоду(ИскомыйКод)
	
	// Флаг группы и код родителя читаются запросом: проверка иерархии не должна
	// опираться на тот же код, который эту иерархию записывал.
	Результат = Новый Структура("Найден, ЭтоГруппа, КодРодителя", Ложь, Ложь, "");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЭтоГруппа КАК ЭтоГруппа,
		|	Родитель.Код КАК КодРодителя
		|ИЗ
		|	Справочник.НоменклатураУслуг
		|ГДЕ
		|	Код = &Код";
	Запрос.УстановитьПараметр("Код", ИскомыйКод);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат.Найден      = Истина;
	Результат.ЭтоГруппа   = Выборка.ЭтоГруппа;
	Результат.КодРодителя = СокрЛП(Строка(Выборка.КодРодителя));
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция УдалитьИерархиюПоКодам()
	
	// Позиции удаляются раньше групп: у группы с вложенными элементами удаление
	// платформа может отклонить. УПОРЯДОЧИТЬ ПО ЭтоГруппа даёт ровно этот порядок.
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.НоменклатураУслуг
		|ГДЕ
		|	ПОДСТРОКА(Код, 1, 3) = ""999""
		|УПОРЯДОЧИТЬ ПО
		|	ЭтоГруппа";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Ссылки = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Ссылки.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Если Ссылки.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		Для Каждого СсылкаЭлемента Из Ссылки Цикл
			ОбъектЭлемента = СсылкаЭлемента.ПолучитьОбъект();
			Если ОбъектЭлемента <> Неопределено Тогда
				ОбъектЭлемента.Удалить();
			КонецЕсли;
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат Ссылки.Количество();
	
КонецФункции

&НаСервере
Процедура ВыполнитьЗагрузкуСИерархией(ПутьФайла, Лог)
	
	Попытка
		
		Обработка = Обработки.ОбменСФайлами.Создать();
		
		// Файл готовится только если его нет: повторный прогон обязан читать
		// тот же файл, иначе проверка иерархии ничего не докажет.
		ФайлДанных = Новый Файл(ПутьФайла);
		Если Не ФайлДанных.Существует() Тогда
			ПодготовитьФайлСИерархией(Обработка, ПутьФайла);
		КонецЕсли;
		
		// Остатки прошлого прогона удаляются до загрузки: иначе код «уже существует»
		// отклонил бы валидную строку.
		УдалитьИерархиюПоКодам();
		
		КоличествоДоЗагрузки = КоличествоНоменклатуры();
		
		Результат = Обработка.ЗагрузитьНоменклатуру(ПутьФайла);
		ТекстПричин = ТекстПричинЗагрузки(Результат);
		
		Группа   = ПризнакиЭлементаПоКоду("999000801");
		Вложенная = ПризнакиЭлементаПоКоду("999000802");
		Верхняя  = ПризнакиЭлементаПоКоду("999000803");
		
		// Проверки до уборки: после неё элементов из файла в базе уже нет.
		Проблемы = Новый Массив;
		
		Если Результат.Вердикт <> "PASS" Тогда
			Проблемы.Добавить("вердикт обработки: " + Результат.Вердикт + "/PASS");
		КонецЕсли;
		Если Результат.Загружено <> 3 Тогда
			Проблемы.Добавить("записано: " + Результат.Загружено + "/3");
		КонецЕсли;
		Если Результат.Отклонено <> 0 Тогда
			Проблемы.Добавить("отклонено: " + Результат.Отклонено + "/0");
		КонецЕсли;
		Если Не Группа.Найден Или Не Группа.ЭтоГруппа Тогда
			Проблемы.Добавить("999000801 не группа");
		КонецЕсли;
		Если Не ПустаяСтрока(Группа.КодРодителя) Тогда
			Проблемы.Добавить("999000801 не верхний уровень: родитель " + Группа.КодРодителя);
		КонецЕсли;
		Если Не Вложенная.Найден Или Вложенная.ЭтоГруппа Тогда
			Проблемы.Добавить("999000802 не позиция");
		КонецЕсли;
		Если Вложенная.КодРодителя <> "999000801" Тогда
			Проблемы.Добавить("999000802 родитель: """ + Вложенная.КодРодителя + """/999000801");
		КонецЕсли;
		Если Не Верхняя.Найден Или Верхняя.ЭтоГруппа Тогда
			Проблемы.Добавить("999000803 не позиция");
		КонецЕсли;
		Если Не ПустаяСтрока(Верхняя.КодРодителя) Тогда
			Проблемы.Добавить("999000803 не верхний уровень: родитель " + Верхняя.КодРодителя);
		КонецЕсли;
		
		Лог.Добавить("вердикт обработки: " + Результат.Вердикт);
		Лог.Добавить("записано: " + Результат.Загружено);
		Лог.Добавить("отклонено: " + Результат.Отклонено);
		Лог.Добавить("причина: " + ТекстПричин);
		Лог.Добавить("999000801 этогруппа: " + ?(Группа.ЭтоГруппа, "Истина", "Ложь")
			+ ", родитель: """ + Группа.КодРодителя + """");
		Лог.Добавить("999000802 этогруппа: " + ?(Вложенная.ЭтоГруппа, "Истина", "Ложь")
			+ ", родитель: """ + Вложенная.КодРодителя + """");
		Лог.Добавить("999000803 этогруппа: " + ?(Верхняя.ЭтоГруппа, "Истина", "Ложь")
			+ ", родитель: """ + Верхняя.КодРодителя + """");
		
		// Уборка возвращает справочник к исходному составу: прогон не оставляет следов.
		Удалено = УдалитьИерархиюПоКодам();
		КоличествоПослеУборки = КоличествоНоменклатуры();
		
		Лог.Добавить("удалено: " + Удалено);
		Лог.Добавить("позиций в справочнике: " + КоличествоДоЗагрузки + " -> " + КоличествоПослеУборки);
		
		Если КоличествоПослеУборки <> КоличествоДоЗагрузки Тогда
			Проблемы.Добавить("состав справочника после уборки: " + КоличествоДоЗагрузки + "/" + КоличествоПослеУборки);
		КонецЕсли;
		
		Если Проблемы.Количество() > 0 Тогда
			Лог.Добавить("FAIL " + СтрСоединить(Проблемы, "; "));
			Лог.Добавить("ВЕРДИКТ: FAIL");
		Иначе
			Лог.Добавить("ВЕРДИКТ: PASS");
		КонецЕсли;
		
	Исключение
		Лог.Добавить("ошибка: " + ОписаниеОшибки());
		Лог.Добавить("ВЕРДИКТ: FAIL");
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФайлЧастичногоИмпорта(Обработка, ПутьФайла)
	
	// Файл пишет сам драйвер: прогон не должен зависеть от внешней заготовки,
	// которую можно «починить», отредактировав файл руками.
	КолонкиФайла = Обработка.ОбязательныеКолонкиНоменклатуры();
	
	СтрокиФайла = Новый Массив;
	
	// Строки 1 и 2 проходят все проверки и обязаны быть записаны.
	СтрокиФайла.Добавить(СтрокаНоменклатуры("999000201", "ТЕСТ-частично-годная-1", "Ложь", "100,00"));
	СтрокиФайла.Добавить(СтрокаНоменклатуры("999000202", "ТЕСТ-частично-годная-2", "Ложь", "200,00"));
	
	// Строка 3: единицы с таким наименованием нет в справочнике - отказ по ссылке.
	СтрокиФайла.Добавить(СтрокаНоменклатурыССылками("999000203", "ТЕСТ-частично-битая-единица",
		"", "Виза", "Несуществующая единица", "Российский рубль"));
	
	// Строка 4: цена не приводится к числу - отказ по типу.
	СтрокиФайла.Добавить(СтрокаНоменклатуры("999000204", "ТЕСТ-частично-битая-цена", "Ложь", "дорого"));
	
	ОбменCSV.ЗаписатьФайл(ПутьФайла, КолонкиФайла, СтрокиФайла);
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьЗагрузкуЧастичногоФайла(ПутьФайла, Лог)
	
	Попытка
		
		Обработка = Обработки.ОбменСФайлами.Создать();
		
		ФайлДанных = Новый Файл(ПутьФайла);
		Если Не ФайлДанных.Существует() Тогда
			ПодготовитьФайлЧастичногоИмпорта(Обработка, ПутьФайла);
		КонецЕсли;
		
		КоличествоДоЗагрузки = КоличествоНоменклатуры();
		
		Результат = Обработка.ЗагрузитьНоменклатуру(ПутьФайла);
		ТекстПричин = ТекстПричинЗагрузки(Результат);
		
		ЗаписанКод1 = КоличествоНоменклатурыПоКоду("999000201");
		ЗаписанКод2 = КоличествоНоменклатурыПоКоду("999000202");
		ОтклонёнКод1 = КоличествоНоменклатурыПоКоду("999000203");
		ОтклонёнКод2 = КоличествоНоменклатурыПоКоду("999000204");
		ВсегоИзФайла = ЗаписанКод1 + ЗаписанКод2 + ОтклонёнКод1 + ОтклонёнКод2;
		
		КоличествоПослеЗагрузки = КоличествоНоменклатуры();
		
		Лог.Добавить("вердикт обработки: " + Результат.Вердикт);
		Лог.Добавить("записано: " + Результат.Загружено);
		Лог.Добавить("отклонено: " + Результат.Отклонено);
		Лог.Добавить("причина: " + ТекстПричин);
		Лог.Добавить("999000201 в базе: " + ЗаписанКод1);
		Лог.Добавить("999000202 в базе: " + ЗаписанКод2);
		Лог.Добавить("999000203 в базе: " + ОтклонёнКод1);
		Лог.Добавить("999000204 в базе: " + ОтклонёнКод2);
		Лог.Добавить("элементов из файла в базе: " + ВсегоИзФайла + "/2");
		Лог.Добавить("позиций в справочнике: " + КоличествоДоЗагрузки + " -> " + КоличествоПослеЗагрузки);
		
		Проблемы = Новый Массив;
		
		Если Результат.Вердикт <> "ЧАСТИЧНО" Тогда
			Проблемы.Добавить("вердикт обработки: " + Результат.Вердикт + "/ЧАСТИЧНО");
		КонецЕсли;
		Если Результат.Загружено <> 2 Тогда
			Проблемы.Добавить("записано: " + Результат.Загружено + "/2");
		КонецЕсли;
		Если Результат.Отклонено <> 2 Тогда
			Проблемы.Добавить("отклонено: " + Результат.Отклонено + "/2");
		КонецЕсли;
		// Причины обязаны называть обе строки отказа: вердикт без адреса бесполезен.
		Если Найти(ТекстПричин, "Несуществующая единица") = 0 Тогда
			Проблемы.Добавить("в причине нет ""Несуществующая единица""");
		КонецЕсли;
		Если Найти(ТекстПричин, "дорого") = 0 Тогда
			Проблемы.Добавить("в причине нет ""дорого""");
		КонецЕсли;
		Если ЗаписанКод1 <> 1 Или ЗаписанКод2 <> 1 Тогда
			Проблемы.Добавить("записанных кодов в базе: " + (ЗаписанКод1 + ЗаписанКод2) + "/2");
		КонецЕсли;
		Если ОтклонёнКод1 <> 0 Или ОтклонёнКод2 <> 0 Тогда
			Проблемы.Добавить("отклонённые коды попали в базу: " + (ОтклонёнКод1 + ОтклонёнКод2) + "/0");
		КонецЕсли;
		Если ВсегоИзФайла <> 2 Тогда
			Проблемы.Добавить("элементов из файла в базе: " + ВсегоИзФайла + "/2");
		КонецЕсли;
		Если КоличествоПослеЗагрузки <> КоличествоДоЗагрузки + 2 Тогда
			Проблемы.Добавить("прирост справочника: " + (КоличествоПослеЗагрузки - КоличествоДоЗагрузки) + "/2");
		КонецЕсли;
		
		Если Проблемы.Количество() > 0 Тогда
			Лог.Добавить("FAIL " + СтрСоединить(Проблемы, "; "));
			Лог.Добавить("ВЕРДИКТ: FAIL");
		Иначе
			Лог.Добавить("ВЕРДИКТ: PASS");
		КонецЕсли;
		
	Исключение
		Лог.Добавить("ошибка: " + ОписаниеОшибки());
		Лог.Добавить("ВЕРДИКТ: FAIL");
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьУборкуТестовойНоменклатуры(Лог)
	
	// Отдельный сценарий, а не шаг внутри прогона: уборку вызывают и между
	// прогонами, и руками после падения. Повторный вызов обязан быть безопасным.
	Попытка
		
		КоличествоДоУборки = КоличествоНоменклатуры();
		Удалено = УдалитьТестовуюНоменклатуру();
		КоличествоПослеУборки = КоличествоНоменклатуры();
		
		Лог.Добавить("удалено: " + Удалено);
		Лог.Добавить("позиций в справочнике: " + КоличествоДоУборки + " -> " + КоличествоПослеУборки);
		
		Проблемы = Новый Массив;
		
		// Идемпотентность: состав справочника обязан сойтись с ожидаемым числом
		// удалённых, иначе уборка снесла лишнее или не досчитала.
		Если КоличествоПослеУборки <> КоличествоДоУборки - Удалено Тогда
			Проблемы.Добавить("состав справочника: " + КоличествоДоУборки + "-" + Удалено + "/" + КоличествоПослеУборки);
		КонецЕсли;
		
		Если Проблемы.Количество() > 0 Тогда
			Лог.Добавить("FAIL " + СтрСоединить(Проблемы, "; "));
			Лог.Добавить("ВЕРДИКТ: FAIL");
		Иначе
			Лог.Добавить("ВЕРДИКТ: PASS");
		КонецЕсли;
		
	Исключение
		Лог.Добавить("ошибка: " + ОписаниеОшибки());
		Лог.Добавить("ВЕРДИКТ: FAIL");
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьЛог(ПутьОтчёта, Лог)
	
	Если ПустаяСтрока(ПутьОтчёта) Тогда
		Возврат;
	КонецЕсли;
	
	Файл = Новый ЗаписьТекста(ПутьОтчёта, "UTF-8");
	Для Каждого СтрокаЛога Из Лог Цикл
		Файл.ЗаписатьСтроку(СтрокаЛога);
	КонецЦикла;
	Файл.Закрыть();
	
КонецПроцедуры

#КонецОбласти
