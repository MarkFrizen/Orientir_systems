&НаСервере
Процедура ВыполнитьЗагрузкуСНесуществующимиСсылками(ПутьФайла, Лог)
	
	Попытка
		
		Обработка = Обработки.ОбменСФайлами.Создать();
		
		ФайлДанных = Новый Файл(ПутьФайла);
		Если Не ФайлДанных.Существует() Тогда
			ПодготовитьФайлСНесуществующимиСсылками(Обработка, ПутьФайла);
		КонецЕсли;
		
		КоличествоДоЗагрузки = КоличествоНоменклатурыПоПризнакуГруппы(Ложь)
			+ КоличествоНоменклатурыПоПризнакуГруппы(Истина);
		
		Результат = Обработка.ЗагрузитьНоменклатуру(ПутьФайла);
		
		Причины = Новый Массив;
		ОшибокНеНайденоЗначение = 0;
		УпоминаетсяПеречисление = Ложь;
		УпоминаетсяСправочник   = Ложь;
		ОшибкиРазличаются        = Ложь;
		ПредыдущийТекст          = "";
		
		Для Каждого СтрокаОшибки Из Результат.Ошибки Цикл
			
			Причины.Добавить(СтрокаОшибки.Сообщение);
			
			Если Найти(СтрокаОшибки.Сообщение, "не найдено") = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			ОшибокНеНайденоЗначение = ОшибокНеНайденоЗначение + 1;
			
			Если Найти(СтрокаОшибки.Сообщение, "ВидыУслуг") > 0 Тогда
				УпоминаетсяПеречисление = Истина;
			КонецЕсли;
			Если Найти(СтрокаОшибки.Сообщение, "ЕдиницыИзмерения") > 0 Тогда
				УпоминаетсяСправочник = Истина;
			КонецЕсли;
			// Две ошибки должны быть разными текстами: иначе сообщение не объясняет,
			// какая именно колонка и какой справочник не сработали.
			Если Не ПустаяСтрока(ПредыдущийТекст) И ПредыдущийТекст <> СтрокаОшибки.Сообщение Тогда
				ОшибкиРазличаются = Истина;
			КонецЕсли;
			ПредыдущийТекст = СтрокаОшибки.Сообщение;
			
		КонецЦикла;
		
		ТекстПричин = СтрСоединить(Причины, " | ");
		
		// Запись в справочник ещё не реализована: состав справочника меняться не должен.
		КоличествоПослеЗагрузки = КоличествоНоменклатурыПоПризнакуГруппы(Ложь)
			+ КоличествоНоменклатурыПоПризнакуГруппы(Истина);
		СозданоПоКодамФайла = КоличествоНоменклатурыПоКоду("999000401")
			+ КоличествоНоменклатурыПоКоду("999000402")
			+ КоличествоНоменклатурыПоКоду("999000403");
		
		Лог.Добавить("вердикт: " + Результат.Вердикт);
		Лог.Добавить("записано: " + Результат.Загружено);
		Лог.Добавить("отклонено: " + Результат.Отклонено);
		Лог.Добавить("ошибок ""не найдено"": " + ОшибокНеНайденоЗначение);
		Лог.Добавить("причина: " + ТекстПричин);
		Лог.Добавить("позиций в справочнике: " + КоличествоДоЗагрузки + " -> " + КоличествоПослеЗагрузки);
		
		Проблемы = Новый Массив;
		
		Если Результат.Вердикт <> "ЧАСТИЧНО" Тогда
			Проблемы.Добавить("вердикт обработки: " + Результат.Вердикт + "/ЧАСТИЧНО");
		КонецЕсли;
		Если Результат.Загружено <> 1 Тогда
			Проблемы.Добавить("записано: " + Результат.Загружено + "/1");
		КонецЕсли;
		Если Результат.Отклонено <> 2 Тогда
			Проблемы.Добавить("отклонено: " + Результат.Отклонено + "/2");
		КонецЕсли;
		Если ОшибокНеНайденоЗначение <> 2 Тогда
			Проблемы.Добавить("ошибок ""не найдено"": " + ОшибокНеНайденоЗначение + "/2");
		КонецЕсли;
		Если Не УпоминаетсяПеречисление Тогда
			Проблемы.Добавить("нет упоминания перечисления ""ВидыУслуг""");
		КонецЕсли;
		Если Не УпоминаетсяСправочник Тогда
			Проблемы.Добавить("нет упоминания справочника ""ЕдиницыИзмерения""");
		КонецЕсли;
		Если Не ОшибкиРазличаются Тогда
			Проблемы.Добавить("тексты ошибок не различаются");
		КонецЕсли;
		Если Найти(ТекстПричин, "колонка """) = 0 Тогда
			Проблемы.Добавить("в причине нет контекста колонки");
		КонецЕсли;
		Если КоличествоПослеЗагрузки <> КоличествоДоЗагрузки Тогда
			Проблемы.Добавить("состав справочника изменился: " + КоличествоДоЗагрузки + "/" + КоличествоПослеЗагрузки);
		КонецЕсли;
		Если СозданоПоКодамФайла <> 0 Тогда
			Проблемы.Добавить("создано элементов из файла: " + СозданоПоКодамФайла + "/0");
		КонецЕсли;
		
		Если Проблемы.Количество() > 0 Тогда
			Лог.Добавить("FAIL " + СтрСоединить(Проблемы, "; "));
			Лог.Добавить("ВЕРДИКТ: FAIL");
		Иначе
			Лог.Добавить("ВЕРДИКТ: PASS");
		КонецЕсли;
		
	Исключение
		Лог.Добавить("ошибка: " + ОписаниеОшибки());
		Лог.Добавить("ВЕРДИКТ: FAIL");
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФайлСДублямиКодов(Обработка, ПутьФайла)
	
	// Файл пишет сам драйвер: прогон не должен зависеть от внешней заготовки,
	// которую можно «починить», отредактировав файл руками.
	КолонкиФайла = Обработка.ОбязательныеКолонкиНоменклатуры();
	
	СтрокиФайла = Новый Массив;
	
	// Код 999000501 стоит в строках 2 и 4: этого достаточно, чтобы проверить и сам
	// дубль, и то, что первым вхождением считается именно строка 2.
	СтрокиФайла.Добавить(СтрокаНоменклатуры("999000502", "Позиция с уникальным кодом первая", "Ложь", "100,00"));
	СтрокиФайла.Добавить(СтрокаНоменклатуры("999000501", "Позиция с повторяющимся кодом", "Ложь", "100,00"));
	СтрокиФайла.Добавить(СтрокаНоменклатуры("999000503", "Позиция с уникальным кодом вторая", "Ложь", "100,00"));
	СтрокиФайла.Добавить(СтрокаНоменклатуры("999000501", "Позиция-дубль того же кода", "Ложь", "100,00"));
	
	ОбменCSV.ЗаписатьФайл(ПутьФайла, КолонкиФайла, СтрокиФайла);
	
КонецПроцедуры

&НаСервере
Функция КодыСуществующейНоменклатуры(Максимум)
	
	// Коды берутся из справочника, а не выдумываются: запись в справочник ещё не
	// реализована, и код не может появиться в базе сам собой между прогонами.
	КодыНайденные = Новый Массив;
	
	Выборка = Справочники.НоменклатураУслуг.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если КодыНайденные.Количество() >= Максимум Тогда
			Прервать;
		КонецЕсли;
		КодыНайденные.Добавить(СокрЛП(Строка(Выборка.Код)));
	КонецЦикла;
	
	Возврат КодыНайденные;
	
КонецФункции

&НаСервере
Процедура ПодготовитьФайлССуществующимиКодами(Обработка, ПутьФайла, СуществующиеКоды)
	
	КолонкиФайла = Обработка.ОбязательныеКолонкиНоменклатуры();
	
	СтрокиФайла = Новый Массив;
	// По одному коду на строку: если поставить существующий код дважды, сработает
	// проверка дубля внутри файла и до проверки по базе дело не дойдёт.
	Для Каждого КодСтроки Из СуществующиеКоды Цикл
		СтрокиФайла.Добавить(СтрокаНоменклатуры(КодСтроки, "Позиция с кодом из базы", "Ложь", "100,00"));
	КонецЦикла;
	
	ОбменCSV.ЗаписатьФайл(ПутьФайла, КолонкиФайла, СтрокиФайла);
	
КонецПроцедуры

&НаСервере
Функция ТекстПричинЗагрузки(Результат)
	
	Причины = Новый Массив;
	Для Каждого СтрокаОшибки Из Результат.Ошибки Цикл
		Причины.Добавить(СтрокаОшибки.Сообщение);
	КонецЦикла;
	
	Возврат СтрСоединить(Причины, " | ");
	
КонецФункции

&НаСервере
Процедура ВыполнитьЗагрузкуСДублямиКодов(ПутьФайла, Лог)
	
	Попытка
		
		Обработка = Обработки.ОбменСФайлами.Создать();
		Проблемы = Новый Массив;
		
		// --- Прогон 1: дубль внутри файла ------------------------------------
		// Файл перезаписывается при каждом прогоне, а не только если его нет:
		// иначе на диске остался бы файл второго прогона и сломал ожидания первого.
		ПодготовитьФайлСДублямиКодов(Обработка, ПутьФайла);
		
		РезультатВФайле = Обработка.ЗагрузитьНоменклатуру(ПутьФайла);
		ТекстПричинВФайле = ТекстПричинЗагрузки(РезультатВФайле);
		
		// «вердикт обработки», а не «вердикт»: обёртка run-driver.ps1 ищет в логе
		// строку «ВЕРДИКТ: FAIL» и завершилась бы кодом 1 на ожидаемом FAIL второго
		// прогона, хотя сценарий в целом пройден.
		Лог.Добавить("прогон 1 (дубль в файле): вердикт обработки: " + РезультатВФайле.Вердикт);
		Лог.Добавить("прогон 1: записано: " + РезультатВФайле.Загружено);
		Лог.Добавить("прогон 1: отклонено: " + РезультатВФайле.Отклонено);
		Лог.Добавить("прогон 1: причина: " + ТекстПричинВФайле);
		
		Если РезультатВФайле.Вердикт <> "ЧАСТИЧНО" Тогда
			Проблемы.Добавить("прогон 1, вердикт: " + РезультатВФайле.Вердикт + "/ЧАСТИЧНО");
		КонецЕсли;
		Если РезультатВФайле.Загружено <> 2 Тогда
			Проблемы.Добавить("прогон 1, записано: " + РезультатВФайле.Загружено + "/2");
		КонецЕсли;
		Если РезультатВФайле.Отклонено <> 2 Тогда
			Проблемы.Добавить("прогон 1, отклонено: " + РезультатВФайле.Отклонено + "/2");
		КонецЕсли;
		// Сообщение о дубле обязано называть обе строки: иначе непонятно, с какой
		// строкой сверялась повторная, и файл не разобрать по логу.
		Если Найти(ТекстПричинВФайле, "Строка 4: код ""999000501"" уже встречался в строке 2") = 0 Тогда
			Проблемы.Добавить("прогон 1: нет сообщения о дубле строк 2 и 4");
		КонецЕсли;
		// Первая из повторяющихся строк отклоняется тоже, и её сообщение обязано
		// называть строку повтора - иначе отклонение выглядит беспричинным.
		Если Найти(ТекстПричинВФайле, "Строка 2: код ""999000501"" повторяется в строке 4") = 0 Тогда
			Проблемы.Добавить("прогон 1: нет сообщения о повторе для строки 2");
		КонецЕсли;
		
		// --- Прогон 2: код уже есть в базе, тот же путь файла -----------------
		СуществующиеКоды = КодыСуществующейНоменклатуры(3);
		
		Если СуществующиеКоды.Количество() = 0 Тогда
			Проблемы.Добавить("прогон 2: в справочнике нет элементов для проверки");
		Иначе
			
			ПодготовитьФайлССуществующимиКодами(Обработка, ПутьФайла, СуществующиеКоды);
			
			РезультатВБазе = Обработка.ЗагрузитьНоменклатуру(ПутьФайла);
			ТекстПричинВБазе = ТекстПричинЗагрузки(РезультатВБазе);
			
			Лог.Добавить("прогон 2 (коды уже в базе): коды: " + СтрСоединить(СуществующиеКоды, ","));
			Лог.Добавить("прогон 2: вердикт обработки: " + РезультатВБазе.Вердикт);
			Лог.Добавить("прогон 2: записано: " + РезультатВБазе.Загружено);
			Лог.Добавить("прогон 2: отклонено: " + РезультатВБазе.Отклонено);
			Лог.Добавить("прогон 2: причина: " + ТекстПричинВБазе);
			
			Если РезультатВБазе.Вердикт <> "FAIL" Тогда
				Проблемы.Добавить("прогон 2, вердикт: " + РезультатВБазе.Вердикт + "/FAIL");
			КонецЕсли;
			Если РезультатВБазе.Загружено <> 0 Тогда
				Проблемы.Добавить("прогон 2, записано: " + РезультатВБазе.Загружено + "/0");
			КонецЕсли;
			Если РезультатВБазе.Отклонено <> СуществующиеКоды.Количество() Тогда
				Проблемы.Добавить("прогон 2, отклонено: " + РезультатВБазе.Отклонено + "/" + СуществующиеКоды.Количество());
			КонецЕсли;
			Если Найти(ТекстПричинВБазе, "уже существует") = 0 Тогда
				Проблемы.Добавить("прогон 2: в причине нет ""уже существует""");
			КонецЕсли;
			
		КонецЕсли;
		
		Если Проблемы.Количество() > 0 Тогда
			Лог.Добавить("FAIL " + СтрСоединить(Проблемы, "; "));
			Лог.Добавить("ВЕРДИКТ: FAIL");
		Иначе
			Лог.Добавить("ВЕРДИКТ: PASS");
		КонецЕсли;
		
	Исключение
		Лог.Добавить("ошибка: " + ОписаниеОшибки());
		Лог.Добавить("ВЕРДИКТ: FAIL");
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьЛог(ПутьОтчёта, Лог)
	
	Если ПустаяСтрока(ПутьОтчёта) Тогда
		Возврат;
	КонецЕсли;
	
	Файл = Новый ЗаписьТекста(ПутьОтчёта, "UTF-8");
	Для Каждого СтрокаЛога Из Лог Цикл
		Файл.ЗаписатьСтроку(СтрокаЛога);
	КонецЦикла;
	Файл.Закрыть();
	
КонецПроцедуры

#КонецОбласти
