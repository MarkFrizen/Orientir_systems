#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ВыполнитьСценарий(ПараметрЗапуска);
	ЗавершитьРаботуСистемы(Ложь);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ВыполнитьСценарий(Параметр)
	
	Части = СтрРазделить(Параметр, "|");
	ИмяСценария = ?(Части.Количество() > 0, Части[0], "");
	ПутьФайла   = ?(Части.Количество() > 1, Части[1], "");
	ПутьОтчёта  = ?(Части.Количество() > 2, Части[2], "");
	
	Лог = Новый Массив;
	
	Если ИмяСценария = "selftest" Тогда
		ВыполнитьСамопроверку(Лог);
	ИначеЕсли ИмяСценария = "export-nomenclature" Тогда
		ВыполнитьВыгрузкуНоменклатуры(ПутьФайла, Лог);
	ИначеЕсли ИмяСценария = "import-nomenclature-bad-header" Тогда
		ВыполнитьЗагрузкуСПлохимЗаголовком(ПутьФайла, Лог);
	ИначеЕсли ИмяСценария = "import-nomenclature-bad-types" Тогда
		ВыполнитьЗагрузкуСПлохимиТипами(ПутьФайла, Лог);
	ИначеЕсли ИмяСценария = "import-nomenclature-missing-ref" Тогда
		ВыполнитьЗагрузкуСНесуществующимиСсылками(ПутьФайла, Лог);
	ИначеЕсли ИмяСценария = "import-nomenclature-duplicates" Тогда
		ВыполнитьЗагрузкуСДублямиКодов(ПутьФайла, Лог);
	Иначе
		Лог.Добавить("НЕИЗВЕСТНЫЙ СЦЕНАРИЙ: " + ИмяСценария);
	КонецЕсли;
	
	ЗаписатьЛог(ПутьОтчёта, Лог);
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьСамопроверку(Лог)
	
	Лог.Добавить("parse: " + ПроверитьРазбор());
	Лог.Добавить("file: "  + ПроверитьФайл());
	Лог.Добавить("types: " + ПроверитьТипы());
	
	Если Найти(СтрСоединить(Лог, ""), "FAIL") > 0 Тогда
		Лог.Добавить("ВЕРДИКТ: FAIL");
	Иначе
		Лог.Добавить("ВЕРДИКТ: PASS");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПроверитьРазбор()
	
	// Проверка обёрнута в Попытку, чтобы любая непредвиденная ошибка попала в лог
	// текстом, а не всплыла на клиенте диалогом «непредвиденная ошибка».
	Попытка
		
		Ожидаемые = Новый Массив;
		Ожидаемые.Добавить("обычное");
		Ожидаемые.Добавить("есть ; и """);
		Ожидаемые.Добавить("две" + Символы.ПС + "строки");
		
		СтрокаCSV = ОбменCSV.СобратьСтроку(Ожидаемые);
		Полученные = ОбменCSV.РазобратьСтроку(СтрокаCSV);
		
		Если Полученные.Количество() <> Ожидаемые.Количество() Тогда
			Возврат "FAIL 0: ожидалось полей " + Ожидаемые.Количество() + ", получено " + Полученные.Количество();
		КонецЕсли;
		
		Для Индекс = 0 По Ожидаемые.Количество() - 1 Цикл
			Если Полученные[Индекс] <> Ожидаемые[Индекс] Тогда
				Возврат "FAIL " + Индекс + ": ожидалось " + Ожидаемые[Индекс] + ", получено " + Полученные[Индекс];
			КонецЕсли;
		КонецЦикла;
		
		// Пример строки дословно из docs/Обмен-данными.md, раздел «Формат номенклатуры услуг».
		// Если пример из документации перестанет разбираться, значит документация и парсер
		// разошлись, и это должно ломать прогон, а не тихо оставаться текстом в документе.
		ПримерИзДокументации = "000000017;""Виза ОАЭ; срочная"";Ложь;Виза;Виза;Штука;9000,00;Российский рубль";
		
		ПоляПримера = Новый Массив;
		ПоляПримера.Добавить("000000017");
		ПоляПримера.Добавить("Виза ОАЭ; срочная");
		ПоляПримера.Добавить("Ложь");
		ПоляПримера.Добавить("Виза");
		ПоляПримера.Добавить("Виза");
		ПоляПримера.Добавить("Штука");
		ПоляПримера.Добавить("9000,00");
		ПоляПримера.Добавить("Российский рубль");
		
		РазобранныйПример = ОбменCSV.РазобратьСтроку(ПримерИзДокументации);
		Если РазобранныйПример.Количество() <> ПоляПримера.Количество() Тогда
			Возврат "FAIL пример из документации: полей " + РазобранныйПример.Количество() + "/" + ПоляПримера.Количество();
		КонецЕсли;
		Для ИндексПримера = 0 По ПоляПримера.Количество() - 1 Цикл
			Если РазобранныйПример[ИндексПримера] <> ПоляПримера[ИндексПримера] Тогда
				Возврат "FAIL пример из документации, поле " + (ИндексПримера + 1) + ": получено """ + РазобранныйПример[ИндексПримера] + """, ожидалось """ + ПоляПримера[ИндексПримера] + """";
			КонецЕсли;
		КонецЦикла;
		
		// Пример строки группы: обязательны три первых поля, остальные пять пустые.
		ПоляГруппы = ОбменCSV.РазобратьСтроку("000000006;Виза;Истина;;;;;");
		Если ПоляГруппы.Количество() <> 8 Тогда
			Возврат "FAIL пример группы: полей " + ПоляГруппы.Количество() + "/8";
		КонецЕсли;
		Если ПоляГруппы[2] <> "Истина" Или ПоляГруппы[7] <> "" Тогда
			Возврат "FAIL пример группы: ""Истина""/пусто не на своих местах";
		КонецЕсли;
		
		Возврат "OK";
		
	Исключение
		Возврат "FAIL " + ОписаниеОшибки();
	КонецПопытки;
	
КонецФункции

&НаСервере
Функция ПроверитьФайл()
	
	Попытка
		
		ПутьФайла = ПолучитьИмяВременногоФайла("csv");
		
		// ВНИМАНИЕ: имя переменной - КолонкиФайла, а не Заголовок.
		// Управляемая форма имеет собственное свойство Заголовок (Title, Строка):
		// присвоение «Заголовок = Новый Массив» ушло бы в свойство формы,
		// и следующий вызов Заголовок.Добавить(...) упал бы с
		// «Значение не является значением объектного типа (Добавить)».
		КолонкиФайла = Новый Массив;
		КолонкиФайла.Добавить("Код");
		КолонкиФайла.Добавить("Наименование");
		
		Строки = Новый Массив;
		
		Строка1 = Новый Массив;
		Строка1.Добавить("001");
		Строка1.Добавить("Обычное наименование");
		Строки.Добавить(Строка1);
		
		Строка2 = Новый Массив;
		Строка2.Добавить("002");
		Строка2.Добавить("Наименование; с точкой с запятой");
		Строки.Добавить(Строка2);
		
		ОбменCSV.ЗаписатьФайл(ПутьФайла, КолонкиФайла, Строки);
		
		// Проверка BOM: первые три байта файла должны быть 239, 187, 191.
		ЧтениеДанных = Новый ЧтениеДанных(ПутьФайла);
		Байт1 = ЧтениеДанных.ПрочитатьБайт();
		Байт2 = ЧтениеДанных.ПрочитатьБайт();
		Байт3 = ЧтениеДанных.ПрочитатьБайт();
		ЧтениеДанных.Закрыть();
		
		Если Байт1 <> 239 Или Байт2 <> 187 Или Байт3 <> 191 Тогда
			Возврат "FAIL BOM: " + Байт1 + ", " + Байт2 + ", " + Байт3;
		КонецЕсли;
		
		// Диагностика: сырая первая строка файла и все строки файла целиком.
		// Помогает понять, что именно попало на диск (BOM, кавычки, разделители).
		ЧтениеСырого = Новый ЧтениеТекста(ПутьФайла, "UTF-8");
		СырыеСтроки = Новый Массив;
		Пока Истина Цикл
			ОчереднаяСтрока = ЧтениеСырого.ПрочитатьСтроку();
			Если ОчереднаяСтрока = Неопределено Тогда
				Прервать;
			КонецЕсли;
			СырыеСтроки.Добавить(ОчереднаяСтрока);
		КонецЦикла;
		ЧтениеСырого.Закрыть();
		Диагностика = " raw=[" + СтрСоединить(СырыеСтроки, " / ") + "]";
		
		Прочитанное = ОбменCSV.ПрочитатьФайл(ПутьФайла);
		
		Если Прочитанное.Заголовок.Количество() <> КолонкиФайла.Количество() Тогда
			Возврат "FAIL заголовок: ожидалось полей " + КолонкиФайла.Количество() + ", получено " + Прочитанное.Заголовок.Количество() + Диагностика;
		КонецЕсли;
		
		Для Индекс = 0 По КолонкиФайла.Количество() - 1 Цикл
			Если Прочитанное.Заголовок[Индекс] <> КолонкиФайла[Индекс] Тогда
				Возврат "FAIL заголовок " + Индекс + ": ожидалось " + КолонкиФайла[Индекс] + ", получено " + Прочитанное.Заголовок[Индекс];
			КонецЕсли;
		КонецЦикла;
		
		Если Прочитанное.Строки.Количество() <> Строки.Количество() Тогда
			Возврат "FAIL строки: ожидалось " + Строки.Количество() + ", получено " + Прочитанное.Строки.Количество();
		КонецЕсли;
		
		Для ИндексСтроки = 0 По Строки.Количество() - 1 Цикл
			
			Ожидаемая = Строки[ИндексСтроки];
			Прочитанная = Прочитанное.Строки[ИндексСтроки];
			
			Если Прочитанная.Количество() <> Ожидаемая.Количество() Тогда
				Возврат "FAIL строка " + ИндексСтроки + ": ожидалось полей " + Ожидаемая.Количество() + ", получено " + Прочитанная.Количество();
			КонецЕсли;
			
			Для ИндексПоля = 0 По Ожидаемая.Количество() - 1 Цикл
				Если Прочитанная[ИндексПоля] <> Ожидаемая[ИндексПоля] Тогда
					Возврат "FAIL строка " + ИндексСтроки + " поле " + ИндексПоля + ": ожидалось " + Ожидаемая[ИндексПоля] + ", получено " + Прочитанная[ИндексПоля];
				КонецЕсли;
			КонецЦикла;
			
		КонецЦикла;
		
		УдалитьФайлы(ПутьФайла);
		
		Возврат "OK";
		
	Исключение
		Возврат "FAIL " + ОписаниеОшибки();
	КонецПопытки;
	
КонецФункции

&НаСервере
Функция ПроверитьТипы()
	
	Попытка
		
		// Имена переменных не должны совпадать со свойствами управляемой формы
		// (Заголовок, ТолькоПросмотр и т.п.) - иначе присвоение уйдёт в свойство.
		ЧислоРезультат = ОбменCSV.ПривестиКЧислу("1,5");
		Если Не ЧислоРезультат.Успех Или ЧислоРезультат.Значение <> 1.5 Тогда
			Возврат "FAIL число: ожидалось 1,5, получено " + ЧислоРезультат.Значение;
		КонецЕсли;
		
		ЧислоОшибка = ОбменCSV.ПривестиКЧислу("дорого");
		Если ЧислоОшибка.Успех Тогда
			Возврат "FAIL число-ошибка: ожидался неуспех, получено " + ЧислоОшибка.Значение;
		КонецЕсли;
		
		ДатаРезультат = ОбменCSV.ПривестиКДате("2026-03-14");
		Если Не ДатаРезультат.Успех Или ДатаРезультат.Значение <> Дата(2026, 3, 14) Тогда
			Возврат "FAIL дата: ожидалось 2026-03-14";
		КонецЕсли;
		
		БулевоРезультат = ОбменCSV.ПривестиКБулеву("Истина");
		Если Не БулевоРезультат.Успех Или БулевоРезультат.Значение <> Истина Тогда
			Возврат "FAIL булево: ожидалась Истина";
		КонецЕсли;
		
		// Ожидается два знака после запятой: формат числа задан как ЧДЦ=2;ЧН=0,00.
		// Литерал "1,5" из брифа недостижим при ЧДЦ=2 - платформа отдаёт "1,50".
		ЧислоТекст = ОбменCSV.СформироватьЧисло(1.5);
		Если ЧислоТекст <> "1,50" Тогда
			Возврат "FAIL формат числа: ожидалось ""1,50"", получено """ + ЧислоТекст + """";
		КонецЕсли;
		
		// Разделитель групп запрещён: "1 234,50" не прочитается обратно.
		ЧислоБезГрупп = ОбменCSV.СформироватьЧисло(1234.5);
		Если ЧислоБезГрупп <> "1234,50" Тогда
			Возврат "FAIL разделитель групп: ожидалось ""1234,50"", получено """ + ЧислоБезГрупп + """";
		КонецЕсли;
		
		// Круговой рейс: выгрузили -> загрузили -> получили то же число.
		ЧислоКруговое = ОбменCSV.ПривестиКЧислу(ОбменCSV.СформироватьЧисло(1234.5));
		Если Не ЧислоКруговое.Успех Или ЧислоКруговое.Значение <> 1234.5 Тогда
			Возврат "FAIL круговой рейс: ожидалось 1234,5, получено " + ЧислоКруговое.Значение + " " + ЧислоКруговое.ТекстОшибки;
		КонецЕсли;
		
		Возврат "OK";
		
	Исключение
		Возврат "FAIL " + ОписаниеОшибки();
	КонецПопытки;
	
КонецФункции

&НаСервере
Функция КоличествоНоменклатурыПоПризнакуГруппы(ПризнакГруппы)
	
	// Пересчёт запросом, а не обходом Выбрать(): число позиций и групп должно
	// подтверждаться независимым от выгрузки способом.
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ
		|	Справочник.НоменклатураУслуг
		|ГДЕ
		|	ЭтоГруппа = &ЭтоГруппа";
	Запрос.УстановитьПараметр("ЭтоГруппа", ПризнакГруппы);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат Выборка.Количество;
	
КонецФункции

&НаСервере
Процедура ВыполнитьВыгрузкуНоменклатуры(ПутьФайла, Лог)
	
	Попытка
		
		Результат = Обработки.ОбменСФайлами.Создать().ВыгрузитьНоменклатуру(ПутьФайла);
		Прочитанное = ОбменCSV.ПрочитатьФайл(ПутьФайла);
		
		ОжидаемоеКоличество = 0;
		Выборка = Справочники.НоменклатураУслуг.Выбрать();
		Пока Выборка.Следующий() Цикл
			ОжидаемоеКоличество = ОжидаемоеКоличество + 1;
		КонецЦикла;
		
		Позиций = КоличествоНоменклатурыПоПризнакуГруппы(Ложь);
		Групп   = КоличествоНоменклатурыПоПризнакуГруппы(Истина);
		
		Колонок = Прочитанное.Заголовок.Количество();
		СтрокДанных = Прочитанное.Строки.Количество();
		
		Лог.Добавить("строк: " + СтрокДанных);
		Лог.Добавить("колонок: " + Колонок);
		Лог.Добавить("позиций: " + Позиций + ", групп: " + Групп);
		
		Проблемы = Новый Массив;
		УникальныхКодов = 0;
		
		Если Колонок <> 8 Тогда
			// Ширину строк отдельно не проверяем: она задаётся тем же массивом
			// колонок, поэтому при неверном заголовке дала бы вторичный шум.
			Проблемы.Добавить("колонок: " + Колонок + "/8");
		Иначе
			
			Если Прочитанное.Заголовок[0] <> "Код" Тогда
				Проблемы.Добавить("первая колонка: " + Прочитанное.Заголовок[0] + "/Код");
			КонецЕсли;
			Если Прочитанное.Заголовок[Колонок - 1] <> "Валюта" Тогда
				Проблемы.Добавить("последняя колонка: " + Прочитанное.Заголовок[Колонок - 1] + "/Валюта");
			КонецЕсли;
			
			// Ширина каждой строки = 8 и коды не повторяются — за один проход.
			Коды = Новый Соответствие;
			Дубли = Новый Массив;
			Для Каждого СтрокаДанных Из Прочитанное.Строки Цикл
				Если СтрокаДанных.Количество() <> 8 Тогда
					Проблемы.Добавить("ширина строки: " + СтрокаДанных.Количество() + "/8");
					Прервать;
				КонецЕсли;
				КодСтроки = СтрокаДанных[0];
				Если Коды.Получить(КодСтроки) = Неопределено Тогда
					Коды.Вставить(КодСтроки, Истина);
				Иначе
					Дубли.Добавить(КодСтроки);
				КонецЕсли;
			КонецЦикла;
			
			УникальныхКодов = Коды.Количество();
			
			Если Дубли.Количество() > 0 Тогда
				Проблемы.Добавить("дубли кодов: " + СтрСоединить(Дубли, ",") + "/нет");
			КонецЕсли;
			
			Если УникальныхКодов <> СтрокДанных Тогда
				Проблемы.Добавить("уникальных кодов: " + УникальныхКодов + "/" + СтрокДанных);
			КонецЕсли;
			
		КонецЕсли;
		
		Лог.Добавить("уникальных кодов: " + УникальныхКодов);
		
		Если СтрокДанных <> ОжидаемоеКоличество Тогда
			Проблемы.Добавить("строк: " + СтрокДанных + "/" + ОжидаемоеКоличество);
		КонецЕсли;
		
		Если Позиций + Групп <> ОжидаемоеКоличество Тогда
			Проблемы.Добавить("состав справочника: " + (Позиций + Групп) + "/" + ОжидаемоеКоличество);
		КонецЕсли;
		
		Если Результат.Вердикт <> "PASS" Тогда
			Проблемы.Добавить("вердикт обработки: " + Результат.Вердикт + "/PASS");
		КонецЕсли;
		
		Если Проблемы.Количество() > 0 Тогда
			Лог.Добавить("FAIL " + СтрСоединить(Проблемы, "; "));
			Лог.Добавить("ВЕРДИКТ: FAIL");
		Иначе
			Лог.Добавить("ВЕРДИКТ: PASS");
		КонецЕсли;
		
	Исключение
		Лог.Добавить("ошибка: " + ОписаниеОшибки());
		Лог.Добавить("ВЕРДИКТ: FAIL");
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Функция КоличествоНоменклатурыПоКоду(ИскомыйКод)
	
	Если ПустаяСтрока(ИскомыйКод) Тогда
		Возврат 0;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ
		|	Справочник.НоменклатураУслуг
		|ГДЕ
		|	Код = &Код";
	Запрос.УстановитьПараметр("Код", ИскомыйКод);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат Выборка.Количество;
	
КонецФункции

&НаСервере
Процедура ПодготовитьФайлБезБазовойЦены(Обработка, ПутьФайла)
	
	// Файл пишет сам драйвер: прогон не должен зависеть от внешней заготовки,
	// которую можно «починить», отредактировав файл руками.
	ПолныйСписок = Обработка.ОбязательныеКолонкиНоменклатуры();
	
	КолонкиФайла = Новый Массив;
	Для Каждого ИмяКолонки Из ПолныйСписок Цикл
		Если ИмяКолонки = "БазоваяЦена" Тогда
			Продолжить;
		КонецЕсли;
		КолонкиФайла.Добавить(ИмяКолонки);
	КонецЦикла;
	
	СтрокаДанных = Новый Массив;
	СтрокаДанных.Добавить("000000900");
	СтрокаДанных.Добавить("Позиция с неполным заголовком");
	СтрокаДанных.Добавить("Ложь");
	СтрокаДанных.Добавить("");
	СтрокаДанных.Добавить("Виза");
	СтрокаДанных.Добавить("Штука");
	СтрокаДанных.Добавить("Российский рубль");
	
	СтрокиФайла = Новый Массив;
	СтрокиФайла.Добавить(СтрокаДанных);
	
	ОбменCSV.ЗаписатьФайл(ПутьФайла, КолонкиФайла, СтрокиФайла);
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьЗагрузкуСПлохимЗаголовком(ПутьФайла, Лог)
	
	Попытка
		
		Обработка = Обработки.ОбменСФайлами.Создать();
		
		ФайлДанных = Новый Файл(ПутьФайла);
		Если Не ФайлДанных.Существует() Тогда
			ПодготовитьФайлБезБазовойЦены(Обработка, ПутьФайла);
		КонецЕсли;
		
		// Код берём из самого файла, а не из константы: проверка «элемента нет
		// в базе» должна относиться именно к тем данным, что подали на вход.
		Прочитанное = ОбменCSV.ПрочитатьФайл(ПутьФайла);
		КодИзФайла = "";
		Если Прочитанное.Строки.Количество() > 0 Тогда
			ПерваяСтрока = Прочитанное.Строки[0];
			Если ПерваяСтрока.Количество() > 0 Тогда
				КодИзФайла = ПерваяСтрока[0];
			КонецЕсли;
		КонецЕсли;
		
		Результат = Обработка.ЗагрузитьНоменклатуру(ПутьФайла);
		
		Причины = Новый Массив;
		Для Каждого СтрокаОшибки Из Результат.Ошибки Цикл
			Причины.Добавить(СтрокаОшибки.Сообщение);
		КонецЦикла;
		ТекстПричин = СтрСоединить(Причины, " | ");
		
		КоличествоВБазе = КоличествоНоменклатурыПоКоду(КодИзФайла);
		
		Лог.Добавить("вердикт обработки: " + Результат.Вердикт);
		Лог.Добавить("причина: " + ТекстПричин);
		Лог.Добавить("причина содержит БазоваяЦена: " + ?(Найти(ТекстПричин, "БазоваяЦена") > 0, "да", "нет"));
		Лог.Добавить("код из файла: " + КодИзФайла + ", позиций в базе: " + КоличествоВБазе);
		
		Проблемы = Новый Массив;
		
		Если Результат.Вердикт <> "FAIL" Тогда
			Проблемы.Добавить("вердикт обработки: " + Результат.Вердикт + "/FAIL");
		КонецЕсли;
		Если Найти(ТекстПричин, "БазоваяЦена") = 0 Тогда
			Проблемы.Добавить("в причине нет ""БазоваяЦена""");
		КонецЕсли;
		Если КоличествоВБазе <> 0 Тогда
			Проблемы.Добавить("создано элементов: " + КоличествоВБазе + "/0");
		КонецЕсли;
		
		Если Проблемы.Количество() > 0 Тогда
			Лог.Добавить("FAIL " + СтрСоединить(Проблемы, "; "));
			Лог.Добавить("ВЕРДИКТ: FAIL");
		Иначе
			Лог.Добавить("ВЕРДИКТ: PASS");
		КонецЕсли;
		
	Исключение
		Лог.Добавить("ошибка: " + ОписаниеОшибки());
		Лог.Добавить("ВЕРДИКТ: FAIL");
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФайлСПлохимиТипами(Обработка, ПутьФайла)
	
	// Файл пишет сам драйвер: прогон не должен зависеть от внешней заготовки,
	// которую можно «починить», отредактировав файл руками.
	КолонкиФайла = Обработка.ОбязательныеКолонкиНоменклатуры();
	
	СтрокиФайла = Новый Массив;
	
	// Строка 1 - корректные типы во всех типизированных колонках.
	СтрокиФайла.Добавить(СтрокаНоменклатуры("999000301", "Позиция с корректными типами", "Ложь", "100,00"));
	
	// Строка 2 - БазоваяЦена не приводится к числу.
	СтрокиФайла.Добавить(СтрокаНоменклатуры("999000302", "Позиция с ценой-текстом", "Ложь", "дорого"));
	
	// Строка 3 - ЭтоГруппа не приводится к булеву.
	СтрокиФайла.Добавить(СтрокаНоменклатуры("999000303", "Позиция с булевым-текстом", "может быть", "100,00"));
	
	// Строка 4 - цена отрицательная, но приводится к числу: это нарушение правил
	// записи, а не типа, поэтому проверка типов её пропускать обязана.
	СтрокиФайла.Добавить(СтрокаНоменклатуры("999000304", "Позиция с отрицательной ценой", "Ложь", "-5"));
	
	ОбменCSV.ЗаписатьФайл(ПутьФайла, КолонкиФайла, СтрокиФайла);
	
КонецПроцедуры

&НаСервере
Функция СтрокаНоменклатуры(КодСтроки, НаименованиеСтроки, ЭтоГруппаСтроки, БазоваяЦенаСтроки)
	
	// Состав и порядок полей повторяют ОбязательныеКолонкиНоменклатуры:
	// Код, Наименование, ЭтоГруппа, Родитель, ВидУслуги, Единица, БазоваяЦена, Валюта.
	Поля = Новый Массив;
	Поля.Добавить(КодСтроки);
	Поля.Добавить(НаименованиеСтроки);
	Поля.Добавить(ЭтоГруппаСтроки);
	Поля.Добавить("");
	Поля.Добавить("Виза");
	Поля.Добавить("Штука");
	Поля.Добавить(БазоваяЦенаСтроки);
	Поля.Добавить("Российский рубль");
	
	Возврат Поля;
	
КонецФункции

&НаСервере
Процедура ВыполнитьЗагрузкуСПлохимиТипами(ПутьФайла, Лог)
	
	Попытка
		
		Обработка = Обработки.ОбменСФайлами.Создать();
		
		ФайлДанных = Новый Файл(ПутьФайла);
		Если Не ФайлДанных.Существует() Тогда
			ПодготовитьФайлСПлохимиТипами(Обработка, ПутьФайла);
		КонецЕсли;
		
		Результат = Обработка.ЗагрузитьНоменклатуру(ПутьФайла);
		
		Причины = Новый Массив;
		ОшибокТипов = 0;
		ЕстьУпоминаниеОтрицательнойЦены = Ложь;
		
		Для Каждого СтрокаОшибки Из Результат.Ошибки Цикл
			Причины.Добавить(СтрокаОшибки.Сообщение);
			// Ошибка типа всегда несёт контекст колонки: «колонка "<имя>"».
			Если Найти(СтрокаОшибки.Сообщение, "колонка """) > 0 Тогда
				ОшибокТипов = ОшибокТипов + 1;
			КонецЕсли;
			Если Найти(СтрокаОшибки.Сообщение, "-5") > 0 Тогда
				ЕстьУпоминаниеОтрицательнойЦены = Истина;
			КонецЕсли;
		КонецЦикла;
		
		ТекстПричин = СтрСоединить(Причины, " | ");
		
		Лог.Добавить("вердикт: " + Результат.Вердикт);
		Лог.Добавить("записано: " + Результат.Загружено);
		Лог.Добавить("отклонено: " + Результат.Отклонено);
		Лог.Добавить("тип-ошибок: " + ОшибокТипов);
		Лог.Добавить("причина: " + ТекстПричин);
		
		Проблемы = Новый Массив;
		
		Если Результат.Вердикт <> "ЧАСТИЧНО" Тогда
			Проблемы.Добавить("вердикт обработки: " + Результат.Вердикт + "/ЧАСТИЧНО");
		КонецЕсли;
		Если ОшибокТипов <> 2 Тогда
			Проблемы.Добавить("ошибок типов: " + ОшибокТипов + "/2");
		КонецЕсли;
		Если Найти(ТекстПричин, "БазоваяЦена") = 0 Или Найти(ТекстПричин, "дорого") = 0 Тогда
			Проблемы.Добавить("в причине нет ""БазоваяЦена""/""дорого""");
		КонецЕсли;
		Если Найти(ТекстПричин, "может быть") = 0 Тогда
			Проблемы.Добавить("в причине нет ""может быть""");
		КонецЕсли;
		// Строка с ценой -5 обязана пройти проверку типов: -5 приводится к числу.
		Если ЕстьУпоминаниеОтрицательнойЦены Тогда
			Проблемы.Добавить("строка с ценой -5 отклонена проверкой типа, а не правилом записи");
		КонецЕсли;
		
		Если Проблемы.Количество() > 0 Тогда
			Лог.Добавить("FAIL " + СтрСоединить(Проблемы, "; "));
			Лог.Добавить("ВЕРДИКТ: FAIL");
		Иначе
			Лог.Добавить("ВЕРДИКТ: PASS");
		КонецЕсли;
		
	Исключение
		Лог.Добавить("ошибка: " + ОписаниеОшибки());
		Лог.Добавить("ВЕРДИКТ: FAIL");
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
