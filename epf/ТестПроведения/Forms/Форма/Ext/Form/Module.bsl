Процедура ВыполнитьСценарийПроведенияПретензии(Лог)
	
	// Сценарий «post-claim»: драйвер создаёт претензию поставщику на данных
	// демо-набора (инцидент с поставщиком, договор этого поставщика, первая
	// валюта справочника) и проводит её. Проверяются дебетовое движение
	// регистра ВзаиморасчётыПоПретензиям с суммой требования в разрезе
	// измерений документа, устойчивость к повторному проведению и полная
	// очистка движений при отмене. В конце созданный документ помечается
	// на удаление, чтобы прогон был повторяемым.
	Провалов = 0;
	
	ИнцидентСсылка = НайтиИнцидентДляПретензии(Ложь);
	Если ИнцидентСсылка = Неопределено Тогда
		Лог.Добавить("ПРОВЕРКА: поиск инцидента для претензии - FAIL: в базе нет инцидента с поставщиком, у которого есть договор");
		Лог.Добавить("провалено проверок: 1");
		Лог.Добавить("ВЕРДИКТ: FAIL");
		Возврат;
	КонецЕсли;
	
	ДоговорСсылка = НайтиДоговорПоставщика(ИнцидентСсылка.Поставщик);
	ВалютаСсылка = НайтиПервуюВалюту();
	Если Не ЗначениеЗаполнено(ВалютаСсылка) Тогда
		Лог.Добавить("ПРОВЕРКА: поиск инцидента для претензии - FAIL: в справочнике нет ни одной валюты");
		Лог.Добавить("провалено проверок: 1");
		Лог.Добавить("ВЕРДИКТ: FAIL");
		Возврат;
	КонецЕсли;
	
	Лог.Добавить("ПРОВЕРКА: поиск инцидента для претензии - OK (" + Строка(ИнцидентСсылка)
		+ ", договор: " + Строка(ДоговорСсылка) + ", валюта: " + Строка(ВалютаСсылка) + ")");
	
	ПретензияСсылка = Неопределено;
	Результат = СоздатьПретензию(ИнцидентСсылка, ДоговорСсылка, ВалютаСсылка, 1000, Истина, ПретензияСсылка);
	Лог.Добавить("ПРОВЕРКА: создание и проведение претензии поставщику - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		УбратьДокумент(ПретензияСсылка);
		Лог.Добавить("провалено проверок: 1");
		Лог.Добавить("ВЕРДИКТ: FAIL");
		Возврат;
	КонецЕсли;
	
	Результат = ПроверитьДвижениеТребования(ПретензияСсылка);
	Лог.Добавить("ПРОВЕРКА: движение требования после проведения - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Провалов = Провалов + 1;
	КонецЕсли;
	
	Результат = ПровестиДокумент(ПретензияСсылка);
	Если СтрНайти(Результат, "FAIL") = 0 Тогда
		Результат = ПроверитьДвижениеТребования(ПретензияСсылка);
	КонецЕсли;
	Лог.Добавить("ПРОВЕРКА: повторное проведение не дублирует движения - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Провалов = Провалов + 1;
	КонецЕсли;
	
	Результат = ОтменитьПроведениеДокумента(ПретензияСсылка);
	КоличествоДвижений = КоличествоДвиженийНакопления("ВзаиморасчётыПоПретензиям", ПретензияСсылка);
	Если СтрНайти(Результат, "FAIL") = 0 Тогда
		Если КоличествоДвижений > 0 Тогда
			Результат = "FAIL: после отмены осталось движений - " + КоличествоДвижений;
		Иначе
			Результат = "OK (движений 0)";
		КонецЕсли;
	КонецЕсли;
	Лог.Добавить("ПРОВЕРКА: отмена проведения очищает движения - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Провалов = Провалов + 1;
	КонецЕсли;
	
	Результат = УбратьДокумент(ПретензияСсылка);
	Лог.Добавить("ПРОВЕРКА: пометка удаления созданной претензии - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Провалов = Провалов + 1;
	КонецЕсли;
	
	ЗаписатьВердикт(Лог, Провалов);
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьСценарийПроведенияАктаОКомпенсации(Лог)
	
	// Сценарий «post-compensation-act»: драйвер создаёт на данных демо-набора
	// претензию поставщику и акт о компенсации на её сумму и проводит акт.
	// Проверяются кредитовое движение удовлетворения претензии (сумма
	// взыскания с поставщика), приходные движения компенсаций по строкам
	// структуры, перевод связанного инцидента в статус «Урегулирован», KPI
	// «УрегулированИнцидент» ответственного с датой акта и временем обработки,
	// отсутствие дублей при повторном проведении и полная очистка при отмене:
	// движения и KPI удаляются, инцидент возвращается в статус «В работе».
	// Созданные документы помечаются на удаление, чтобы прогон был повторяемым.
	Провалов = 0;
	
	ИнцидентСсылка = НайтиИнцидентДляПретензии(Истина);
	Если ИнцидентСсылка = Неопределено Тогда
		Лог.Добавить("ПРОВЕРКА: поиск инцидента для акта - FAIL: в базе нет инцидента, проходящего собственные правила записи, с поставщиком и договором");
		Лог.Добавить("провалено проверок: 1");
		Лог.Добавить("ВЕРДИКТ: FAIL");
		Возврат;
	КонецЕсли;
	
	ДоговорСсылка = НайтиДоговорПоставщика(ИнцидентСсылка.Поставщик);
	ВалютаСсылка = НайтиПервуюВалюту();
	Если Не ЗначениеЗаполнено(ВалютаСсылка) Тогда
		Лог.Добавить("ПРОВЕРКА: поиск инцидента для акта - FAIL: в справочнике нет ни одной валюты");
		Лог.Добавить("провалено проверок: 1");
		Лог.Добавить("ВЕРДИКТ: FAIL");
		Возврат;
	КонецЕсли;
	
	Лог.Добавить("ПРОВЕРКА: поиск инцидента для акта - OK (" + Строка(ИнцидентСсылка) + ")");
	
	ПретензияСсылка = Неопределено;
	Результат = СоздатьПретензию(ИнцидентСсылка, ДоговорСсылка, ВалютаСсылка, 1000, Ложь, ПретензияСсылка);
	Лог.Добавить("ПРОВЕРКА: создание претензии поставщику для акта - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		УбратьДокумент(ПретензияСсылка);
		Лог.Добавить("провалено проверок: 1");
		Лог.Добавить("ВЕРДИКТ: FAIL");
		Возврат;
	КонецЕсли;
	
	АктСсылка = Неопределено;
	Результат = СоздатьИПровестиАкт(ПретензияСсылка, ИнцидентСсылка, ВалютаСсылка, АктСсылка);
	Лог.Добавить("ПРОВЕРКА: создание и проведение акта о компенсации - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		УбратьДокумент(АктСсылка);
		УбратьДокумент(ПретензияСсылка);
		Лог.Добавить("провалено проверок: 1");
		Лог.Добавить("ВЕРДИКТ: FAIL");
		Возврат;
	КонецЕсли;
	
	Результат = ПроверитьДвижениеУдовлетворения(АктСсылка);
	Лог.Добавить("ПРОВЕРКА: движение удовлетворения претензии после проведения - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Провалов = Провалов + 1;
	КонецЕсли;
	
	Результат = ПроверитьДвиженияКомпенсаций(АктСсылка);
	Лог.Добавить("ПРОВЕРКА: движения компенсаций по строкам структуры - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Провалов = Провалов + 1;
	КонецЕсли;
	
	Результат = ПроверитьТекущийСтатусИнцидента(ИнцидентСсылка, Перечисления.СтатусыИнцидента.Урегулирован);
	Лог.Добавить("ПРОВЕРКА: перевод инцидента в статус Урегулирован - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Провалов = Провалов + 1;
	КонецЕсли;
	
	Результат = ПроверитьKPIУрегулирования(АктСсылка, ОжидаемоеВремяОбработки(АктСсылка));
	Лог.Добавить("ПРОВЕРКА: KPI УрегулированИнцидент ответственного - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Провалов = Провалов + 1;
	КонецЕсли;
	
	Результат = ПровестиДокумент(АктСсылка);
	Если СтрНайти(Результат, "FAIL") = 0 Тогда
		Результат = ПроверитьДвиженияКомпенсаций(АктСсылка);
		Если СтрНайти(Результат, "FAIL") = 0 Тогда
			Результат = ПроверитьKPIУрегулирования(АктСсылка, ОжидаемоеВремяОбработки(АктСсылка));
		КонецЕсли;
	КонецЕсли;
	Лог.Добавить("ПРОВЕРКА: повторное проведение не дублирует движения и KPI - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Провалов = Провалов + 1;
	КонецЕсли;
	
	Результат = ОтменитьПроведениеДокумента(АктСсылка);
	Если СтрНайти(Результат, "FAIL") = 0 Тогда
		ДвиженийВзаиморасчёты = КоличествоДвиженийНакопления("ВзаиморасчётыПоПретензиям", АктСсылка);
		ДвиженийКомпенсации = КоличествоДвиженийНакопления("ШтрафыИКомпенсации", АктСсылка);
		ДвиженийKPI = КоличествоДвиженийНакопления("KPIОператоров", АктСсылка);
		Если ДвиженийВзаиморасчёты > 0 Или ДвиженийКомпенсации > 0 Или ДвиженийKPI > 0 Тогда
			Результат = "FAIL: после отмены осталось движений - взаиморасчёты " + ДвиженийВзаиморасчёты
				+ ", компенсации " + ДвиженийКомпенсации + ", KPI " + ДвиженийKPI;
		Иначе
			Результат = ПроверитьKPIСнята(АктСсылка);
			Если СтрНайти(Результат, "FAIL") = 0 Тогда
				Результат = "OK (движений 0, KPI снята)";
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Лог.Добавить("ПРОВЕРКА: отмена проведения очищает движения и KPI - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Провалов = Провалов + 1;
	КонецЕсли;
	
	Результат = ПроверитьТекущийСтатусИнцидента(ИнцидентСсылка, Перечисления.СтатусыИнцидента.ВРаботе);
	Лог.Добавить("ПРОВЕРКА: возврат инцидента в статус ВРаботе - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Провалов = Провалов + 1;
	КонецЕсли;
	
	Результат = УбратьДокумент(АктСсылка);
	Если СтрНайти(Результат, "FAIL") = 0 Тогда
		Результат = УбратьДокумент(ПретензияСсылка);
	КонецЕсли;
	Лог.Добавить("ПРОВЕРКА: пометка удаления созданных документов - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Провалов = Провалов + 1;
	КонецЕсли;
	
	ЗаписатьВердикт(Лог, Провалов);
	
КонецПроцедуры

&НаСервере
Функция НайтиИнцидентДляПретензии(ПроверятьПравилаЗаписи)
	
	// Ищется инцидент демо-набора с заполненным поставщиком, у которого есть
	// договор: претензия проходит правила записи только при совпадении
	// поставщика инцидента и владельца договора. Если ПроверятьПравилаЗаписи
	// установлена, инцидент обязан проходить ещё и собственные правила
	// записи и иметь ответственного с датой инцидента: сценарий акта
	// перезаписывает статус такого инцидента.
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Инциденты.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.Инцидент КАК Инциденты
		|ГДЕ
		|	Инциденты.ПометкаУдаления = ЛОЖЬ
		|УПОРЯДОЧИТЬ ПО
		|	Инциденты.Дата";
	
	Для Каждого Запись Из Запрос.Выполнить().Выгрузить() Цикл
		ИнцидентСсылка = Запись.Ссылка;
		
		Если Не ЗначениеЗаполнено(ИнцидентСсылка.Поставщик) Тогда
			Продолжить;
		КонецЕсли;
		Если НайтиДоговорПоставщика(ИнцидентСсылка.Поставщик) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПроверятьПравилаЗаписи Тогда
			Если Не ЗначениеЗаполнено(ИнцидентСсылка.Ответственный)
				Или Не ЗначениеЗаполнено(ИнцидентСсылка.ДатаИнцидента) Тогда
				Продолжить;
			КонецЕсли;
			
			ОбъектИнцидента = ИнцидентСсылка.ПолучитьОбъект();
			Если ОбъектИнцидента.ПравилаЗаписи(ОбъектИнцидента).Количество() > 0 Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Возврат ИнцидентСсылка;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Функция НайтиДоговорПоставщика(ПоставщикСсылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Договоры.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ДоговорыСПоставщиками КАК Договоры
		|ГДЕ
		|	Договоры.Владелец = &Поставщик
		|	И Договоры.ПометкаУдаления = ЛОЖЬ";
	Запрос.УстановитьПараметр("Поставщик", ПоставщикСсылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

