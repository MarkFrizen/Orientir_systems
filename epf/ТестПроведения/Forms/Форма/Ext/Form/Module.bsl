Функция НайтиНепроведённыйИнцидент()
	
	// Демо-набор используется как есть: сценарий ничего не создаёт, чтобы
	// прогон не засорял базу и был повторяемым. Инцидент обязан проходить
	// ПравилаЗаписи документа, иначе ПередЗаписью отклонит проведение.
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Инциденты.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.Инцидент КАК Инциденты
		|ГДЕ
		|	Инциденты.Проведен = ЛОЖЬ
		|	И Инциденты.ПометкаУдаления = ЛОЖЬ
		|УПОРЯДОЧИТЬ ПО
		|	Инциденты.Дата";
	
	Для Каждого Запись Из Запрос.Выполнить().Выгрузить() Цикл
		ИнцидентСсылка = Запись.Ссылка;
		
		ОбъектИнцидента = ИнцидентСсылка.ПолучитьОбъект();
		Если ОбъектИнцидента.ПравилаЗаписи(ОбъектИнцидента).Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		
