Функция ВремяЗаписиГрафикаПоСобытию(СобытиеСсылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	График.ДатаВремяНачалаUTC КАК ДатаВремяНачалаUTC
		|ИЗ
		|	РегистрСведений.ГрафикПеремещений КАК График
		|ГДЕ
		|	График.СобытиеМаршрута = &СобытиеМаршрута";
	Запрос.УстановитьПараметр("СобытиеМаршрута", СобытиеСсылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ДатаВремяНачалаUTC;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Функция ПроверитьНовыеВремена(КорректировкаСсылка)
	
	Для Каждого СтрокаИзменения Из КорректировкаСсылка.Изменения Цикл
		ВремяЗаписи = ВремяЗаписиГрафикаПоСобытию(СтрокаИзменения.СобытиеМаршрута);
		Если ВремяЗаписи <> СтрокаИзменения.НовоеВремяUTC Тогда
			Возврат "FAIL: время записи графика по событию " + Строка(СтрокаИзменения.СобытиеМаршрута)
				+ " - " + Формат(ВремяЗаписи, "ДФ=dd.MM.yyyy HH:mm:ss") + ", ожидалось "
				+ Формат(СтрокаИзменения.НовоеВремяUTC, "ДФ=dd.MM.yyyy HH:mm:ss");
		КонецЕсли;
		
		Если СтрокаИзменения.СобытиеМаршрута.ДатаВремяUTC <> СтрокаИзменения.НовоеВремяUTC Тогда
			Возврат "FAIL: время документа события " + Строка(СтрокаИзменения.СобытиеМаршрута)
				+ " не перенесено: " + Формат(СтрокаИзменения.СобытиеМаршрута.ДатаВремяUTC, "ДФ=dd.MM.yyyy HH:mm:ss");
		КонецЕсли;
	КонецЦикла;
	
	Возврат "OK (изменений: " + КорректировкаСсылка.Изменения.Количество() + ")";
	
КонецФункции

&НаСервере
Функция ПроверитьВосстановленныеВремена(КорректировкаСсылка, ВременаДо)
	
	Для Каждого СтрокаИзменения Из КорректировкаСсылка.Изменения Цикл
		ОжидаемоеВремя = ВременаДо.Получить(СтрокаИзменения.СобытиеМаршрута);
		Если ОжидаемоеВремя = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ВремяЗаписи = ВремяЗаписиГрафикаПоСобытию(СтрокаИзменения.СобытиеМаршрута);
		Если ВремяЗаписи <> ОжидаемоеВремя Тогда
			Возврат "FAIL: время записи графика по событию " + Строка(СтрокаИзменения.СобытиеМаршрута)
				+ " - " + Формат(ВремяЗаписи, "ДФ=dd.MM.yyyy HH:mm:ss") + ", ожидалось прежнее "
				+ Формат(ОжидаемоеВремя, "ДФ=dd.MM.yyyy HH:mm:ss");
		КонецЕсли;
		
		Если СтрокаИзменения.СобытиеМаршрута.ДатаВремяUTC <> ОжидаемоеВремя Тогда
			Возврат "FAIL: время документа события " + Строка(СтрокаИзменения.СобытиеМаршрута)
				+ " не восстановлено: " + Формат(СтрокаИзменения.СобытиеМаршрута.ДатаВремяUTC, "ДФ=dd.MM.yyyy HH:mm:ss")
				+ ", ожидалось " + Формат(ОжидаемоеВремя, "ДФ=dd.MM.yyyy HH:mm:ss");
		КонецЕсли;
	КонецЦикла;
	
	Возврат "OK";
	
КонецФункции

&НаСервере
Функция ПроверитьБуферыСобытий(ЛистСсылка)
	
	// Повторяет правило обработчика: буфер события - разница в минутах между
	// началом следующего события и окончанием текущего. Буфер последнего
	// события не определён и не проверяется.
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	События.Ссылка КАК Ссылка,
		|	События.ДатаВремяUTC КАК ДатаВремяUTC,
		|	События.ДлительностьМинут КАК ДлительностьМинут,
		|	События.БуферДоСледующегоМинут КАК БуферДоСледующегоМинут
		|ИЗ
		|	Документ.СобытиеМаршрута КАК События
		|ГДЕ
		|	События.МаршрутныйЛист = &МаршрутныйЛист
		|	И События.ПометкаУдаления = ЛОЖЬ
		|УПОРЯДОЧИТЬ ПО
		|	События.ДатаВремяUTC";
	Запрос.УстановитьПараметр("МаршрутныйЛист", ЛистСсылка);
	
	События = Запрос.Выполнить().Выгрузить();
	
	Для Индекс = 0 По События.Количество() - 2 Цикл
		Текущее = События[Индекс];
		Следующее = События[Индекс + 1];
		
		Окончание = Текущее.ДатаВремяUTC + Текущее.ДлительностьМинут * 60;
		ОжидаемыйБуфер = РаботаСДатамиИЧасовымиЗонами.РазницаВМинутах(Окончание, Следующее.ДатаВремяUTC);
		
		Если Текущее.БуферДоСледующегоМинут <> ОжидаемыйБуфер Тогда
			Возврат "FAIL: буфер события " + Строка(Текущее.Ссылка) + " - "
				+ Текущее.БуферДоСледующегоМинут + ", ожидался " + ОжидаемыйБуфер;
		КонецЕсли;
	КонецЦикла;
	
	Возврат "OK (проверено событий: " + События.Количество() + ")";
	
КонецФункции

