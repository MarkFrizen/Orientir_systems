&НаСервере
Функция СоздатьПретензию(ИнцидентСсылка, ДоговорСсылка, ВалютаСсылка, СуммаТребования, Проводить, ПретензияСсылка)
	
	// Сумма требования сопровождается согласием руководителя: сценарий не
	// зависит от текущего значения константы порога согласования.
	ПретензияСсылка = Неопределено;
	Попытка
		ОбъектПретензии = Документы.ПретензияПоставщику.СоздатьДокумент();
		ОбъектПретензии.Дата = ТекущаяДатаСеанса();
		ОбъектПретензии.Инцидент = ИнцидентСсылка;
		ОбъектПретензии.Поставщик = ИнцидентСсылка.Поставщик;
		ОбъектПретензии.Договор = ДоговорСсылка;
		ОбъектПретензии.Валюта = ВалютаСсылка;
		ОбъектПретензии.СуммаТребования = СуммаТребования;
		ОбъектПретензии.СогласованоРуководителем = Истина;
		ОбъектПретензии.Руководитель = НайтиПервогоСотрудника();
		ОбъектПретензии.Записать(?(Проводить, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись));
		ПретензияСсылка = ОбъектПретензии.Ссылка;
	Исключение
		Возврат "FAIL: " + ОписаниеОшибки();
	КонецПопытки;
	
	Если Проводить И ДокументПроведен(ПретензияСсылка) <> Истина Тогда
		Возврат "FAIL: документ не проведён - платформа отклонила запись";
	КонецЕсли;
	
	Возврат "OK (" + Строка(ПретензияСсылка) + ")";
	
КонецФункции

&НаСервере
Функция СоздатьИПровестиАкт(ПретензияСсылка, ИнцидентСсылка, ВалютаСсылка, АктСсылка)
	
	// Структура компенсации (60 + 40) равна сумме компенсации туристу,
	// взыскание с поставщика (50) не превышает сумму требования претензии:
	// документ проходит собственные правила записи. Дата акта берётся
	// началом дня: у реквизита нет временной части, а ожидаемое время
	// обработки KPI сценарий вычисляет по сохранённому значению.
	АктСсылка = Неопределено;
	Попытка
		ОбъектАкта = Документы.АктОКомпенсации.СоздатьДокумент();
		ОбъектАкта.Дата = ТекущаяДатаСеанса();
		ОбъектАкта.Претензия = ПретензияСсылка;
		ОбъектАкта.Инцидент = ИнцидентСсылка;
		ОбъектАкта.СуммаКомпенсацииТуристу = 100;
		ОбъектАкта.СуммаВзысканияСПоставщика = 50;
		ОбъектАкта.Валюта = ВалютаСсылка;
		ОбъектАкта.ДатаАкта = НачалоДня(ТекущаяДатаСеанса());
		
		СтрокаКомпенсации = ОбъектАкта.СтруктураКомпенсации.Добавить();
		СтрокаКомпенсации.ВидКомпенсации = Перечисления.ВидыКомпенсаций.Денежная;
		СтрокаКомпенсации.Сумма = 60;
		СтрокаКомпенсации.Описание = "Сценарий post-compensation-act: денежная компенсация";
		
		СтрокаКомпенсации = ОбъектАкта.СтруктураКомпенсации.Добавить();
		СтрокаКомпенсации.ВидКомпенсации = Перечисления.ВидыКомпенсаций.Бонус;
		СтрокаКомпенсации.Сумма = 40;
		СтрокаКомпенсации.Описание = "Сценарий post-compensation-act: бонус";
		
		ОбъектАкта.Записать(РежимЗаписиДокумента.Проведение);
		АктСсылка = ОбъектАкта.Ссылка;
	Исключение
		Возврат "FAIL: " + ОписаниеОшибки();
	КонецПопытки;
	
	Если ДокументПроведен(АктСсылка) <> Истина Тогда
		Возврат "FAIL: документ не проведён - платформа отклонила запись";
	КонецЕсли;
	
	Возврат "OK (" + Строка(АктСсылка) + ")";
	
КонецФункции

&НаСервере
Функция ПроверитьДвижениеТребования(ПретензияСсылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Взаиморасчёты.Период КАК Период,
		|	Взаиморасчёты.Претензия КАК Претензия,
		|	Взаиморасчёты.Поставщик КАК Поставщик,
		|	Взаиморасчёты.Договор КАК Договор,
		|	Взаиморасчёты.Валюта КАК Валюта,
		|	Взаиморасчёты.СуммаТребования КАК СуммаТребования,
		|	Взаиморасчёты.СуммаУдовлетворения КАК СуммаУдовлетворения
		|ИЗ
		|	РегистрНакопления.ВзаиморасчётыПоПретензиям КАК Взаиморасчёты
		|ГДЕ
		|	Взаиморасчёты.Регистратор = &Регистратор";
	Запрос.УстановитьПараметр("Регистратор", ПретензияСсылка);
	Движения = Запрос.Выполнить().Выгрузить();
	
	Если Движения.Количество() <> 1 Тогда
		Возврат "FAIL: движений " + Движения.Количество() + ", ожидалось 1";
	КонецЕсли;
	
	Движение = Движения.Получить(0);
	Если Движение.Претензия <> ПретензияСсылка Тогда
		Возврат "FAIL: измерение Претензия " + Строка(Движение.Претензия) + ", ожидался сам документ";
	КонецЕсли;
	Если Движение.Поставщик <> ПретензияСсылка.Поставщик Тогда
		Возврат "FAIL: поставщик " + Строка(Движение.Поставщик) + ", ожидался " + Строка(ПретензияСсылка.Поставщик);
	КонецЕсли;
	Если Движение.Договор <> ПретензияСсылка.Договор Тогда
		Возврат "FAIL: договор " + Строка(Движение.Договор) + ", ожидался " + Строка(ПретензияСсылка.Договор);
	КонецЕсли;
	Если Движение.Валюта <> ПретензияСсылка.Валюта Тогда
		Возврат "FAIL: валюта " + Строка(Движение.Валюта) + ", ожидалась " + Строка(ПретензияСсылка.Валюта);
	КонецЕсли;
	Если Движение.Период <> ПретензияСсылка.Дата Тогда
		Возврат "FAIL: период " + Формат(Движение.Период, "ДФ=dd.MM.yyyy HH:mm:ss")
			+ ", ожидалась дата документа " + Формат(ПретензияСсылка.Дата, "ДФ=dd.MM.yyyy HH:mm:ss");
	КонецЕсли;
	Если Движение.СуммаТребования <> ПретензияСсылка.СуммаТребования Тогда
		Возврат "FAIL: сумма требования " + Формат(Движение.СуммаТребования, "ЧДЦ=2")
			+ ", ожидалась " + Формат(ПретензияСсылка.СуммаТребования, "ЧДЦ=2");
	КонецЕсли;
	Если Движение.СуммаУдовлетворения <> 0 Тогда
		Возврат "FAIL: сумма удовлетворения " + Формат(Движение.СуммаУдовлетворения, "ЧДЦ=2") + ", ожидался 0";
	КонецЕсли;
	
	Возврат "OK (1 движение, сумма требования "
		+ Формат(Движение.СуммаТребования, "ЧДЦ=2") + ")";
	
КонецФункции

&НаСервере
Функция ПроверитьДвижениеУдовлетворения(АктСсылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Взаиморасчёты.Период КАК Период,
		|	Взаиморасчёты.Претензия КАК Претензия,
		|	Взаиморасчёты.Поставщик КАК Поставщик,
		|	Взаиморасчёты.Договор КАК Договор,
		|	Взаиморасчёты.Валюта КАК Валюта,
		|	Взаиморасчёты.СуммаТребования КАК СуммаТребования,
		|	Взаиморасчёты.СуммаУдовлетворения КАК СуммаУдовлетворения
		|ИЗ
		|	РегистрНакопления.ВзаиморасчётыПоПретензиям КАК Взаиморасчёты
		|ГДЕ
		|	Взаиморасчёты.Регистратор = &Регистратор";
	Запрос.УстановитьПараметр("Регистратор", АктСсылка);
	Движения = Запрос.Выполнить().Выгрузить();
	
	Если Движения.Количество() <> 1 Тогда
		Возврат "FAIL: движений " + Движения.Количество() + ", ожидалось 1";
	КонецЕсли;
	
	Движение = Движения.Получить(0);
	Если Движение.Претензия <> АктСсылка.Претензия Тогда
		Возврат "FAIL: претензия " + Строка(Движение.Претензия) + ", ожидалась " + Строка(АктСсылка.Претензия);
	КонецЕсли;
	Если Движение.Поставщик <> АктСсылка.Претензия.Поставщик Тогда
		Возврат "FAIL: поставщик " + Строка(Движение.Поставщик)
			+ ", ожидался " + Строка(АктСсылка.Претензия.Поставщик);
	КонецЕсли;
	Если Движение.Договор <> АктСсылка.Претензия.Договор Тогда
		Возврат "FAIL: договор " + Строка(Движение.Договор) + ", ожидался " + Строка(АктСсылка.Претензия.Договор);
	КонецЕсли;
	Если Движение.Валюта <> АктСсылка.Валюта Тогда
		Возврат "FAIL: валюта " + Строка(Движение.Валюта) + ", ожидалась " + Строка(АктСсылка.Валюта);
	КонецЕсли;
	Если Движение.Период <> АктСсылка.ДатаАкта Тогда
		Возврат "FAIL: период " + Формат(Движение.Период, "ДФ=dd.MM.yyyy")
			+ ", ожидалась дата акта " + Формат(АктСсылка.ДатаАкта, "ДФ=dd.MM.yyyy");
	КонецЕсли;
	Если Движение.СуммаУдовлетворения <> АктСсылка.СуммаВзысканияСПоставщика Тогда
		Возврат "FAIL: сумма удовлетворения " + Формат(Движение.СуммаУдовлетворения, "ЧДЦ=2")
			+ ", ожидалась сумма взыскания " + Формат(АктСсылка.СуммаВзысканияСПоставщика, "ЧДЦ=2");
	КонецЕсли;
	Если Движение.СуммаТребования <> 0 Тогда
		Возврат "FAIL: сумма требования " + Формат(Движение.СуммаТребования, "ЧДЦ=2") + ", ожидался 0";
	КонецЕсли;
	
	Возврат "OK (1 движение, сумма удовлетворения "
		+ Формат(Движение.СуммаУдовлетворения, "ЧДЦ=2") + ")";
	
КонецФункции

&НаСервере
Функция ПроверитьДвиженияКомпенсаций(АктСсылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Штрафы.Период КАК Период,
		|	Штрафы.Инцидент КАК Инцидент,
		|	Штрафы.Поставщик КАК Поставщик,
		|	Штрафы.ВидКомпенсации КАК ВидКомпенсации,
		|	Штрафы.Валюта КАК Валюта,
		|	Штрафы.СуммаКомпенсацииТуристу КАК СуммаКомпенсацииТуристу,
		|	Штрафы.СуммаВзысканияСПоставщика КАК СуммаВзысканияСПоставщика
		|ИЗ
		|	РегистрНакопления.ШтрафыИКомпенсации КАК Штрафы
		|ГДЕ
		|	Штрафы.Регистратор = &Регистратор";
	Запрос.УстановитьПараметр("Регистратор", АктСсылка);
	Движения = Запрос.Выполнить().Выгрузить();
	
	ОжидаемоеКоличество = АктСсылка.СтруктураКомпенсации.Количество();
	Если Движения.Количество() <> ОжидаемоеКоличество Тогда
		Возврат "FAIL: движений " + Движения.Количество() + ", ожидалось " + ОжидаемоеКоличество;
	КонецЕсли;
	
	Для Каждого СтрокаКомпенсации Из АктСсылка.СтруктураКомпенсации Цикл
		Движение = Движения.Найти(СтрокаКомпенсации.ВидКомпенсации, "ВидКомпенсации");
		Если Движение = Неопределено Тогда
			Возврат "FAIL: нет движения по виду компенсации " + Строка(СтрокаКомпенсации.ВидКомпенсации);
		КонецЕсли;
		Если Движение.Инцидент <> АктСсылка.Инцидент Тогда
			Возврат "FAIL: инцидент движения " + Строка(Движение.Инцидент)
				+ ", ожидался " + Строка(АктСсылка.Инцидент);
		КонецЕсли;
		Если Движение.Поставщик <> АктСсылка.Претензия.Поставщик Тогда
			Возврат "FAIL: поставщик движения " + Строка(Движение.Поставщик)
				+ ", ожидался " + Строка(АктСсылка.Претензия.Поставщик);
		КонецЕсли;
		Если Движение.Валюта <> АктСсылка.Валюта Тогда
			Возврат "FAIL: валюта движения " + Строка(Движение.Валюта)
				+ ", ожидалась " + Строка(АктСсылка.Валюта);
		КонецЕсли;
		Если Движение.Период <> АктСсылка.ДатаАкта Тогда
			Возврат "FAIL: период движения " + Формат(Движение.Период, "ДФ=dd.MM.yyyy")
				+ ", ожидалась дата акта " + Формат(АктСсылка.ДатаАкта, "ДФ=dd.MM.yyyy");
		КонецЕсли;
		Если Движение.СуммаКомпенсацииТуристу <> СтрокаКомпенсации.Сумма Тогда
			Возврат "FAIL: компенсация туристу по " + Строка(СтрокаКомпенсации.ВидКомпенсации) + " - "
				+ Формат(Движение.СуммаКомпенсацииТуристу, "ЧДЦ=2") + ", ожидалась "
				+ Формат(СтрокаКомпенсации.Сумма, "ЧДЦ=2");
		КонецЕсли;
		
		ОжидаемоеВзыскание = ОжидаемоеВзысканиеСтроки(АктСсылка, СтрокаКомпенсации.Сумма);
		Если Движение.СуммаВзысканияСПоставщика <> ОжидаемоеВзыскание Тогда
			Возврат "FAIL: взыскание с поставщика по " + Строка(СтрокаКомпенсации.ВидКомпенсации) + " - "
				+ Формат(Движение.СуммаВзысканияСПоставщика, "ЧДЦ=2") + ", ожидалось "
				+ Формат(ОжидаемоеВзыскание, "ЧДЦ=2");
		КонецЕсли;
	КонецЦикла;
	
	Возврат "OK (" + Движения.Количество() + " движений по строкам структуры компенсации)";
	
КонецФункции

&НаСервере
Функция ОжидаемоеВзысканиеСтроки(АктСсылка, СуммаСтроки)
	
	// Повторяет правило обработчика: взыскание с поставщика распределяется
	// между строками структуры пропорционально их суммам.
	Если АктСсылка.СуммаКомпенсацииТуристу <= 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат Окр(СуммаСтроки * АктСсылка.СуммаВзысканияСПоставщика / АктСсылка.СуммаКомпенсацииТуристу, 2);
	
КонецФункции

&НаСервере
Функция ОжидаемоеВремяОбработки(АктСсылка)
	
	// Повторяет правило обработчика: время обработки - разница между датой
	// акта и датой инцидента в минутах, не отрицательная.
	РазницаСекунд = АктСсылка.ДатаАкта - АктСсылка.Инцидент.ДатаИнцидента;
	Если РазницаСекунд <= 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат Цел(РазницаСекунд / 60);
	
КонецФункции

&НаСервере
Функция ПроверитьТекущийСтатусИнцидента(ИнцидентСсылка, ОжидаемыйСтатус)
	
	ФактическийСтатус = ИнцидентСсылка.Статус;
	Если ФактическийСтатус <> ОжидаемыйСтатус Тогда
		Возврат "FAIL: статус инцидента " + Строка(ФактическийСтатус)
			+ ", ожидался " + Строка(ОжидаемыйСтатус);
	КонецЕсли;
	
	Возврат "OK (" + Строка(ФактическийСтатус) + ")";
	
КонецФункции

&НаСервере
Функция ПроверитьKPIУрегулирования(АктСсылка, ОжидаемоеВремя)
	
	Количество = 0;
	Время = 0;
	СуммыKPIПоАкту(АктСсылка, Количество, Время);
	
	Если Количество <> 1 Тогда
		Возврат "FAIL: операций KPI " + Количество + ", ожидалась 1";
	КонецЕсли;
	Если Время <> ОжидаемоеВремя Тогда
		Возврат "FAIL: время обработки " + Время + " мин, ожидалось " + ОжидаемоеВремя + " мин";
	КонецЕсли;
	
	Возврат "OK (1 операция УрегулированИнцидент, время обработки " + Время + " мин)";
	
КонецФункции

&НаСервере
Функция ПроверитьKPIСнята(АктСсылка)
	
	Количество = 0;
	Время = 0;
	СуммыKPIПоАкту(АктСсылка, Количество, Время);
	
	Если Количество > 0 Тогда
		Возврат "FAIL: после отмены осталось операций KPI - " + Количество;
	КонецЕсли;
	
	Возврат "OK";
	
КонецФункции

&НаСервере
Процедура СуммыKPIПоАкту(АктСсылка, Количество, Время)
	
	// KPI ищется по срезу сотрудника, вида операции и даты акта: оборот
	// пишется общим модулем через менеджер записи, поэтому сценарий
	// не полагается на регистратора движения.
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	СУММА(KPI.Количество) КАК Количество,
		|	СУММА(KPI.ВремяОбработкиМинут) КАК ВремяОбработки
		|ИЗ
		|	РегистрНакопления.KPIОператоров КАК KPI
		|ГДЕ
		|	KPI.Сотрудник = &Сотрудник
		|	И KPI.ВидОперации = &ВидОперации
		|	И KPI.Период = &Период";
	Запрос.УстановитьПараметр("Сотрудник", АктСсылка.Инцидент.Ответственный);
	Запрос.УстановитьПараметр("ВидОперации", Перечисления.ВидыОперацийKPI.УрегулированИнцидент);
	Запрос.УстановитьПараметр("Период", АктСсылка.ДатаАкта);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Количество = ?(Выборка.Количество = NULL, 0, Выборка.Количество);
	Время = ?(Выборка.ВремяОбработки = NULL, 0, Выборка.ВремяОбработки);
	
КонецПроцедуры

&НаСервере
Функция КоличествоДвиженийНакопления(ИмяРегистра, РегистраторСсылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ РегистрНакопления." + ИмяРегистра + " КАК Движения
		|ГДЕ Движения.Регистратор = &Регистратор";
	Запрос.УстановитьПараметр("Регистратор", РегистраторСсылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.Количество;
	
КонецФункции

&НаСервере
Функция УбратьДокумент(ДокументСсылка)
	
	// Сценарии создают собственные документы и помечают их на удаление,
	// чтобы прогон не засорял базу и оставался повторяемым.
	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат "OK (документ не создавался)";
	КонецЕсли;
	
	Попытка
		ОбъектДокумента = ДокументСсылка.ПолучитьОбъект();
		ОбъектДокумента.ПометкаУдаления = Истина;
		ОбъектДокумента.Записать();
	Исключение
		Возврат "FAIL: " + ОписаниеОшибки();
	КонецПопытки;
	
	Возврат "OK (" + Строка(ДокументСсылка) + ")";
	
КонецФункции

// Проверяет по данным базы, что при проведении корректировки прежнее время
// событий действительно сохранилось в табличной части документа. Чтение идёт
// запросом, а не из объекта: иначе проверка увидела бы значения в памяти.
&НаСервере
Функция ПроверитьСохранениеСтарогоВремени(КорректировкаСсылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Изменения.СтароеВремяUTC КАК СтароеВремя
		|ИЗ
		|	Документ.КорректировкаМаршрута.Изменения КАК Изменения
		|ГДЕ
		|	Изменения.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", КорректировкаСсылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат "FAIL: в базе нет строк изменений";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Выборка.СтароеВремя) Тогда
		Возврат "FAIL: СтароеВремяUTC не сохранилось в базе";
	КонецЕсли;
	
	Возврат "OK";
	
КонецФункции

&НаСервере
Процедура ВыполнитьСценарийФормированияЗапросов(Лог)
	
	// Сценарий «proc-requests»: обработка ФормированиеЗапросовПоставщикам
	// создаёт заказы поставщикам по заявкам в статусе «В работе», у которых
	// есть услуги без заказа. Первый запуск не должен падать и обязан создать
	// хотя бы один заказ без ошибок; повторный запуск не создаёт дублей:
	// ноль новых заказов и все строки результата «Пропущен» с причиной.
	// Созданные заказы в конце помечаются на удаление и удаляются, чтобы
	// база осталась как была и прогон был повторяемым.
	Провалов = 0;
	
	ЗаказыДо = СнимокЗаказовПоставщику();
	
	ПервыйЗапуск = Неопределено;
	Попытка
		ПервыйЗапуск = ЗапуститьФормированиеЗапросов();
	Исключение
		Лог.Добавить("ПРОВЕРКА: первый запуск формирования запросов - FAIL: " + ОписаниеОшибки());
		Лог.Добавить("провалено проверок: 1");
		Лог.Добавить("ВЕРДИКТ: FAIL");
		Возврат;
	КонецПопытки;
	Лог.Добавить("ПРОВЕРКА: первый запуск формирования запросов - OK (без исключения)");
	
	Результат = ПроверитьПервыйЗапускФормирования(ПервыйЗапуск, ЗаказыДо);
	Лог.Добавить("ПРОВЕРКА: итоги первого запуска - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Провалов = Провалов + 1;
	КонецЕсли;
	
	НовыеЗаказы = НовыеЗаказыПоставщику(ЗаказыДо);
	ЗаказыПослеПервого = СнимокЗаказовПоставщику();
	
	ВторойЗапуск = Неопределено;
	Попытка
		ВторойЗапуск = ЗапуститьФормированиеЗапросов();
		Результат = ПроверитьПовторныйЗапускФормирования(ВторойЗапуск, ЗаказыПослеПервого);
	Исключение
		Результат = "FAIL: " + ОписаниеОшибки();
	КонецПопытки;
	Лог.Добавить("ПРОВЕРКА: повторный запуск не создаёт дубли - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Провалов = Провалов + 1;
	КонецЕсли;
	
	Результат = УдалитьСозданныеЗаказы(НовыеЗаказы, ЗаказыДо);
	Лог.Добавить("ПРОВЕРКА: очистка созданных заказов - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Провалов = Провалов + 1;
	КонецЕсли;
	
	ЗаписатьВердикт(Лог, Провалов);
	
КонецПроцедуры

&НаСервере
Функция ЗапуститьФормированиеЗапросов()
	
	Обработка = Обработки.ФормированиеЗапросовПоставщикам.Создать();
	Возврат Обработка.ВыполнитьОбработку(Новый Структура);
	
КонецФункции

&НаСервере
Функция СнимокЗаказовПоставщику()
	
	Снимок = Новый Соответствие;
	Запрос = Новый Запрос("ВЫБРАТЬ ЗаказПоставщику.Ссылка КАК Ссылка ИЗ Документ.ЗаказПоставщику КАК ЗаказПоставщику");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Снимок.Вставить(Выборка.Ссылка, Истина);
	КонецЦикла;
	
	Возврат Снимок;
	
КонецФункции

&НаСервере
Функция НовыеЗаказыПоставщику(СнимокДо)
	
	Новые = Новый Массив;
	СнимокПосле = СнимокЗаказовПоставщику();
	Для Каждого КлючИЗначение Из СнимокПосле Цикл
		Если СнимокДо.Получить(КлючИЗначение.Ключ) = Неопределено Тогда
			Новые.Добавить(КлючИЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Новые;
	
КонецФункции

&НаСервере
Функция ПроверитьПервыйЗапускФормирования(Отчёт, ЗаказыДо)
	
	Проверка = ПроверитьСтруктуруОтчёта(Отчёт);
	Если Проверка <> Неопределено Тогда
		Возврат Проверка;
	КонецЕсли;
	
	Если Отчёт.Итоги.Ошибок <> 0 Тогда
		Возврат "FAIL: первый запуск дал заявок с ошибками - " + Отчёт.Итоги.Ошибок
			+ "; причины: " + ПричиныОшибок(Отчёт.Результат);
	КонецЕсли;
	
	Если Отчёт.Итоги.Создано <= 0 Тогда
		Возврат "FAIL: первый запуск не создал ни одного заказа (в базе есть заявки в работе без заказов)";
	КонецЕсли;
	
	НовыхВБазе = НовыеЗаказыПоставщику(ЗаказыДо).Количество();
	Если НовыхВБазе <> Отчёт.Итоги.Создано Тогда
		Возврат "FAIL: итог «Создано» (" + Отчёт.Итоги.Создано
			+ ") не совпал с числом новых заказов в базе (" + НовыхВБазе + ")";
	КонецЕсли;
	
	Возврат "OK (создано заказов: " + Отчёт.Итоги.Создано
		+ ", пропущено заявок: " + Отчёт.Итоги.Пропущено + ")";
	
КонецФункции

&НаСервере
Функция ПроверитьПовторныйЗапускФормирования(Отчёт, ЗаказыПослеПервого)
	
	Проверка = ПроверитьСтруктуруОтчёта(Отчёт);
	Если Проверка <> Неопределено Тогда
		Возврат Проверка;
	КонецЕсли;
	
	Если Отчёт.Итоги.Создано <> 0 Тогда
		Возврат "FAIL: повторный запуск создал дубли заказов - " + Отчёт.Итоги.Создано;
	КонецЕсли;
	
	Если Отчёт.Итоги.Ошибок <> 0 Тогда
		Возврат "FAIL: повторный запуск дал заявки с ошибками - " + Отчёт.Итоги.Ошибок
			+ "; причины: " + ПричиныОшибок(Отчёт.Результат);
	КонецЕсли;
	
	Если Отчёт.Результат.Количество() = 0 Тогда
		Возврат "FAIL: повторный запуск вернул пустой результат";
	КонецЕсли;
	
	Для Каждого СтрокаОтчёта Из Отчёт.Результат Цикл
		Если СтрокаОтчёта.Состояние <> "Пропущен" Тогда
			Возврат "FAIL: заявка " + Строка(СтрокаОтчёта.Заявка)
				+ " в состоянии «" + СтрокаОтчёта.Состояние + "», ожидалось «Пропущен»";
		КонецЕсли;
		Если ПустаяСтрока(СтрокаОтчёта.Причина) Тогда
			Возврат "FAIL: у пропущенной заявки " + Строка(СтрокаОтчёта.Заявка) + " не заполнена причина";
		КонецЕсли;
	КонецЦикла;
	
	НовыхВБазе = НовыеЗаказыПоставщику(ЗаказыПослеПервого).Количество();
	Если НовыхВБазе <> 0 Тогда
		Возврат "FAIL: после повторного запуска в базе появилось новых заказов - " + НовыхВБазе;
	КонецЕсли;
	
	Возврат "OK (заявок в результате: " + Отчёт.Результат.Количество() + ", все пропущены с причиной)";
	
КонецФункции

&НаСервере
Функция ПроверитьСтруктуруОтчёта(Отчёт)
	
	Если ТипЗнч(Отчёт) <> Тип("Структура") Тогда
		Возврат "FAIL: обработка вернула не структуру, а " + Строка(ТипЗнч(Отчёт));
	КонецЕсли;
	Если Отчёт.Свойство("Результат") = Ложь Или ТипЗнч(Отчёт.Результат) <> Тип("ТаблицаЗначений") Тогда
		Возврат "FAIL: в отчёте нет таблицы значений «Результат»";
	КонецЕсли;
	Если Отчёт.Свойство("Итоги") = Ложь Или ТипЗнч(Отчёт.Итоги) <> Тип("Структура") Тогда
		Возврат "FAIL: в отчёте нет структуры «Итоги»";
	КонецЕсли;
	Для Каждого Ключ Из СтрРазделить("Создано,Пропущено,Ошибок", ",") Цикл
		Значение = Неопределено;
		Если Отчёт.Итоги.Свойство(Ключ, Значение) = Ложь Или ТипЗнч(Значение) <> Тип("Число") Тогда
			Возврат "FAIL: в итогах нет числового реквизита «" + Ключ + "»";
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Функция ПричиныОшибок(Результат)
	
	Причины = Новый Массив;
	Для Каждого СтрокаОтчёта Из Результат Цикл
		Если СтрокаОтчёта.Состояние = "Ошибка" Тогда
			Причины.Добавить(Строка(СтрокаОтчёта.Заявка) + ": " + СтрокаОтчёта.Причина);
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтрСоединить(Причины, "; ");
	
КонецФункции

&НаСервере
Функция УдалитьСозданныеЗаказы(НовыеЗаказы, ЗаказыДо)
	
	// Заказы создаются непроведёнными, поэтому удаляются напрямую: сначала
	// помечаются на удаление, затем удаляются из базы.
	Для Каждого ЗаказСсылка Из НовыеЗаказы Цикл
		Попытка
			ОбъектЗаказа = ЗаказСсылка.ПолучитьОбъект();
			ОбъектЗаказа.УстановитьПометкуУдаления(Истина);
			ОбъектЗаказа.Удалить();
		Исключение
			Возврат "FAIL: не удалось удалить заказ " + Строка(ЗаказСсылка) + ": " + ОписаниеОшибки();
		КонецПопытки;
	КонецЦикла;
	
	Остаток = НовыеЗаказыПоставщику(ЗаказыДо).Количество();
	Если Остаток <> 0 Тогда
		Возврат "FAIL: после очистки в базе осталось новых заказов - " + Остаток;
	КонецЕсли;
	
	Возврат "OK (удалено заказов: " + НовыеЗаказы.Количество() + ")";
	
КонецФункции

&НаСервере
Процедура ВыполнитьСценарийПересчётаТаймингов(Лог)
	
	// Сценарий «proc-timings»: обработка ПересчётТайминговМаршрутов
	// пересчитывает локальное время и буферы событий маршрутных листов.
	// Проверяются: структура результата, идемпотентность (повторный запуск
	// ничего не пересчитывает), искусственная накладка попадает в таблицу
	// накладок с величиной перекрытия, проведённые события без флага
	// «Изменять проведённые» не изменяются. Изменённые значения в конце
	// восстанавливаются по снимку «до», чтобы прогон был повторяемым.
	Провалов = 0;
	
	СнимокДо = СнимокТайминговСобытий();
	
	ПервыйЗапуск = Неопределено;
	Попытка
		Обработка = Обработки.ПересчётТайминговМаршрутов.Создать();
		ПервыйЗапуск = Обработка.ВыполнитьОбработку(Новый Структура);
	Исключение
		Лог.Добавить("ПРОВЕРКА: первый запуск пересчёта таймингов - FAIL: " + ОписаниеОшибки());
		Лог.Добавить("провалено проверок: 1");
		Лог.Добавить("ВЕРДИКТ: FAIL");
		Возврат;
	КонецПопытки;
	Лог.Добавить("ПРОВЕРКА: первый запуск пересчёта таймингов - OK (без исключения)");
	
	Результат = ПроверитьСтруктуруПересчётаТаймингов(ПервыйЗапуск);
	Лог.Добавить("ПРОВЕРКА: структура результата пересчёта - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Провалов = Провалов + 1;
	КонецЕсли;
	
	ВторойЗапуск = Неопределено;
	Попытка
		Обработка = Обработки.ПересчётТайминговМаршрутов.Создать();
		ВторойЗапуск = Обработка.ВыполнитьОбработку(Новый Структура);
		Если ВторойЗапуск.Пересчитано = 0 Тогда
			Результат = "OK (пересчитано: 0, пропущено: " + ВторойЗапуск.Пропущено + ")";
		Иначе
			Результат = "FAIL: повторный запуск снова пересчитал события - " + ВторойЗапуск.Пересчитано;
		КонецЕсли;
	Исключение
		Результат = "FAIL: " + ОписаниеОшибки();
	КонецПопытки;
	Лог.Добавить("ПРОВЕРКА: повторный запуск идемпотентен - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Провалов = Провалов + 1;
	КонецЕсли;
	
	Результат = ПроверитьВыявлениеНакладкиТаймингов();
	Лог.Добавить("ПРОВЕРКА: накладка попадает в результат - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Провалов = Провалов + 1;
	КонецЕсли;
	
	Результат = ВосстановитьТаймингиСобытий(СнимокДо);
	Лог.Добавить("ПРОВЕРКА: проведённые не изменены, тайминги восстановлены - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Провалов = Провалов + 1;
	КонецЕсли;
	
	ЗаписатьВердикт(Лог, Провалов);
	
КонецПроцедуры

&НаСервере
Функция СнимокТайминговСобытий()
	
	Снимок = Новый Соответствие;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	События.Ссылка КАК Ссылка,
		|	События.Проведен КАК Проведен,
		|	События.ЛокальноеВремя КАК ЛокальноеВремя,
		|	События.БуферДоСледующегоМинут КАК БуферДоСледующегоМинут
		|ИЗ
		|	Документ.СобытиеМаршрута КАК События
		|ГДЕ
		|	НЕ События.ПометкаУдаления";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Снимок.Вставить(Выборка.Ссылка, Новый Структура(
			"Проведен, ЛокальноеВремя, БуферДоСледующегоМинут",
			Выборка.Проведен, Выборка.ЛокальноеВремя, Выборка.БуферДоСледующегоМинут));
	КонецЦикла;
	
	Возврат Снимок;
	
КонецФункции

&НаСервере
Функция ПроверитьСтруктуруПересчётаТаймингов(Результат)
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат "FAIL: обработка вернула не структуру, а " + Строка(ТипЗнч(Результат));
	КонецЕсли;
	Для Каждого Ключ Из СтрРазделить("Пересчитано,Пропущено", ",") Цикл
		Значение = Неопределено;
		Если Результат.Свойство(Ключ, Значение) = Ложь Или ТипЗнч(Значение) <> Тип("Число") Тогда
			Возврат "FAIL: в результате нет числового реквизита «" + Ключ + "»";
		КонецЕсли;
	КонецЦикла;
	Если Результат.Свойство("Накладки") = Ложь Или ТипЗнч(Результат.Накладки) <> Тип("ТаблицаЗначений") Тогда
		Возврат "FAIL: в результате нет таблицы значений «Накладки»";
	КонецЕсли;
	Для Каждого Колонка Из СтрРазделить("Маршрут,Событие,ПерекрытиеМинут", ",") Цикл
		Если Результат.Накладки.Колонки.Найти(Колонка) = Неопределено Тогда
			Возврат "FAIL: в накладках нет колонки «" + Колонка + "»";
		КонецЕсли;
	КонецЦикла;
	
	Возврат "OK (пересчитано: " + Результат.Пересчитано + ", пропущено: " + Результат.Пропущено
		+ ", накладок: " + Результат.Накладки.Количество() + ")";
	
КонецФункции

&НаСервере
Функция ПроверитьВыявлениеНакладкиТаймингов()
	
	ДанныеЛиста = НайтиЛистДляПробыНакладки();
	Если ДанныеЛиста = Неопределено Тогда
		Возврат "FAIL: в базе нет непроведённого маршрутного листа минимум с двумя непроведёнными событиями";
	КонецЕсли;
	
	Первое = ДанныеЛиста.События[0];
	Второе = ДанныеЛиста.События[1];
	
	// Искусственная накладка: оба события начинаются в одно время UTC и
	// длятся по 60 минут - перекрытие равно 60 минутам при любом порядке.
	Попытка
		ОбъектПервого = Первое.Ссылка.ПолучитьОбъект();
		ОбъектПервого.ДлительностьМинут = 60;
		ОбъектПервого.Записать();
		ОбъектВторого = Второе.Ссылка.ПолучитьОбъект();
		ОбъектВторого.ДатаВремяUTC = Первое.ДатаВремяUTC;
		ОбъектВторого.ДлительностьМинут = 60;
		ОбъектВторого.Записать();
	Исключение
		Возврат "FAIL: не удалось подготовить накладку: " + ОписаниеОшибки();
	КонецПопытки;
	
	Запуск = Неопределено;
	МассивЛистов = Новый Массив;
	МассивЛистов.Добавить(ДанныеЛиста.Лист);
	Попытка
		Обработка = Обработки.ПересчётТайминговМаршрутов.Создать();
		Запуск = Обработка.ВыполнитьОбработку(
			Новый Структура("МаршрутныеЛисты", МассивЛистов));
	Исключение
		Возврат "FAIL: запуск на накладке упал: " + ОписаниеОшибки();
	КонецПопытки;
	
	НашласьНакладка = Ложь;
	Для Каждого СтрокаНакладки Из Запуск.Накладки Цикл
		Если СтрокаНакладки.Маршрут = ДанныеЛиста.Лист И СтрокаНакладки.ПерекрытиеМинут = 60 Тогда
			НашласьНакладка = Истина;
		КонецЕсли;
	КонецЦикла;
	
	// Вернуть исходные времена и длительности событий.
	Попытка
		ОбъектПервого = Первое.Ссылка.ПолучитьОбъект();
		ОбъектПервого.ДатаВремяUTC = Первое.ДатаВремяUTC;
		ОбъектПервого.ДлительностьМинут = Первое.ДлительностьМинут;
		ОбъектПервого.Записать();
		ОбъектВторого = Второе.Ссылка.ПолучитьОбъект();
		ОбъектВторого.ДатаВремяUTC = Второе.ДатаВремяUTC;
		ОбъектВторого.ДлительностьМинут = Второе.ДлительностьМинут;
		ОбъектВторого.Записать();
	Исключение
		Возврат "FAIL: не удалось восстановить события накладки: " + ОписаниеОшибки();
	КонецПопытки;
	
	Если Не НашласьНакладка Тогда
		Возврат "FAIL: накладка перекрытием 60 минут не попала в таблицу накладок";
	КонецЕсли;
	
	Возврат "OK (накладка найдена, перекрытие 60 минут)";
	
КонецФункции

&НаСервере
Функция НайтиЛистДляПробыНакладки()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	События.Ссылка КАК Ссылка,
		|	События.МаршрутныйЛист КАК МаршрутныйЛист,
		|	События.ДатаВремяUTC КАК ДатаВремяUTC,
		|	События.ДлительностьМинут КАК ДлительностьМинут
		|ИЗ
		|	Документ.СобытиеМаршрута КАК События
		|ГДЕ
		|	НЕ События.ПометкаУдаления
		|	И НЕ События.Проведен
		|	И НЕ События.МаршрутныйЛист.ПометкаУдаления
		|	И НЕ События.МаршрутныйЛист.Проведен
		|
		|УПОРЯДОЧИТЬ ПО События.МаршрутныйЛист, События.ДатаВремяUTC, События.Ссылка";
	
	ПоЛистам = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		События = ПоЛистам.Получить(Выборка.МаршрутныйЛист);
		Если События = Неопределено Тогда
			События = Новый Массив;
			ПоЛистам.Вставить(Выборка.МаршрутныйЛист, События);
		КонецЕсли;
		Если События.Количество() < 2 Тогда
			События.Добавить(Новый Структура("Ссылка, ДатаВремяUTC, ДлительностьМинут",
				Выборка.Ссылка, Выборка.ДатаВремяUTC, Выборка.ДлительностьМинут));
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого КлючИЗначение Из ПоЛистам Цикл
		Если КлючИЗначение.Значение.Количество() = 2 Тогда
			Возврат Новый Структура("Лист, События", КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Функция ВосстановитьТаймингиСобытий(СнимокДо)
	
	СнимокПосле = СнимокТайминговСобытий();
	Восстановлено = 0;
	Для Каждого КлючИЗначение Из СнимокДо Цикл
		Ссылка = КлючИЗначение.Ключ;
		ЗначенияДо = КлючИЗначение.Значение;
		ЗначенияПосле = СнимокПосле.Получить(Ссылка);
		Если ЗначенияПосле = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначенияПосле.ЛокальноеВремя = ЗначенияДо.ЛокальноеВремя
			И ЗначенияПосле.БуферДоСледующегоМинут = ЗначенияДо.БуферДоСледующегоМинут Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначенияДо.Проведен Тогда
			Возврат "FAIL: проведённое событие " + Строка(Ссылка)
				+ " изменено без флага «Изменять проведённые»";
		КонецЕсли;
		Попытка
			ОбъектСобытия = Ссылка.ПолучитьОбъект();
			ОбъектСобытия.ЛокальноеВремя = ЗначенияДо.ЛокальноеВремя;
			ОбъектСобытия.БуферДоСледующегоМинут = ЗначенияДо.БуферДоСледующегоМинут;
			ОбъектСобытия.Записать();
			Восстановлено = Восстановлено + 1;
		Исключение
			Возврат "FAIL: не удалось восстановить событие " + Строка(Ссылка) + ": " + ОписаниеОшибки();
		КонецПопытки;
	КонецЦикла;
	
	Возврат "OK (восстановлено событий: " + Восстановлено + ")";
	
КонецФункции

&НаСервере
Процедура ВыполнитьСценарийПроверкиПросрочек(Лог)
	
	// Сценарий «proc-overdue»: обработка ПросроченныеСрокиИSLA выявляет
	// просроченные сроки SLA запросов и подтверждения услуг. Проверяются:
	// структура результата, без флага задачи не создаются, с флагом число
	// новых задач в базе совпадает с итогом, повторный запуск не дублирует
	// задачи. Созданные задачи в конце убираются, чтобы прогон был
	// повторяемым.
	Провалов = 0;
	
	ЗадачиДо = СнимокЗадачИсполнителя();
	
	ПервыйЗапуск = Неопределено;
	Попытка
		Обработка = Обработки.ПросроченныеСрокиИSLA.Создать();
		ПервыйЗапуск = Обработка.ВыполнитьОбработку(Новый Структура);
	Исключение
		Лог.Добавить("ПРОВЕРКА: запуск выявления просрочек - FAIL: " + ОписаниеОшибки());
		Лог.Добавить("провалено проверок: 1");
		Лог.Добавить("ВЕРДИКТ: FAIL");
		Возврат;
	КонецПопытки;
	Лог.Добавить("ПРОВЕРКА: запуск выявления просрочек - OK (без исключения)");
	
	Результат = ПроверитьСтруктуруПросрочек(ПервыйЗапуск);
	Лог.Добавить("ПРОВЕРКА: структура результата просрочек - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Провалов = Провалов + 1;
	КонецЕсли;
	
	Результат = ЗапускСозданияЗадачПоПросрочкам(ЗадачиДо);
	Лог.Добавить("ПРОВЕРКА: создание задач по просрочкам - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Провалов = Провалов + 1;
	КонецЕсли;
	
	Результат = ЗапускПовтораСозданияЗадач();
	Лог.Добавить("ПРОВЕРКА: повторный запуск не дублирует задачи - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Провалов = Провалов + 1;
	КонецЕсли;
	
	Результат = УбратьСозданныеЗадачи(ЗадачиДо);
	Лог.Добавить("ПРОВЕРКА: очистка созданных задач - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Провалов = Провалов + 1;
	КонецЕсли;
	
	ЗаписатьВердикт(Лог, Провалов);
	
КонецПроцедуры

&НаСервере
Функция СнимокЗадачИсполнителя()
	
	Снимок = Новый Соответствие;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ЗадачаИсполнителя.Ссылка КАК Ссылка
		|ИЗ Задача.ЗадачаИсполнителя КАК ЗадачаИсполнителя
		|ГДЕ НЕ ЗадачаИсполнителя.ПометкаУдаления");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Снимок.Вставить(Выборка.Ссылка, Истина);
	КонецЦикла;
	
	Возврат Снимок;
	
КонецФункции

&НаСервере
Функция НовыеЗадачиИсполнителя(СнимокДо)
	
	Новые = Новый Массив;
	СнимокПосле = СнимокЗадачИсполнителя();
	Для Каждого КлючИЗначение Из СнимокПосле Цикл
		Если СнимокДо.Получить(КлючИЗначение.Ключ) = Неопределено Тогда
			Новые.Добавить(КлючИЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Новые;
	
КонецФункции

&НаСервере
Функция ПроверитьСтруктуруПросрочек(Результат)
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат "FAIL: обработка вернула не структуру, а " + Строка(ТипЗнч(Результат));
	КонецЕсли;
	Если Результат.Свойство("Просрочки") = Ложь Или ТипЗнч(Результат.Просрочки) <> Тип("ТаблицаЗначений") Тогда
		Возврат "FAIL: в результате нет таблицы значений «Просрочки»";
	КонецЕсли;
	Для Каждого Колонка Из СтрРазделить("Вид,Объект,Ответственный,ПросроченоНа", ",") Цикл
		Если Результат.Просрочки.Колонки.Найти(Колонка) = Неопределено Тогда
			Возврат "FAIL: в просрочках нет колонки «" + Колонка + "»";
		КонецЕсли;
	КонецЦикла;
	Значение = Неопределено;
	Если Результат.Свойство("СозданоЗадач", Значение) = Ложь Или ТипЗнч(Значение) <> Тип("Число") Тогда
		Возврат "FAIL: в результате нет числового реквизита «СозданоЗадач»";
	КонецЕсли;
	Если Результат.СозданоЗадач <> 0 Тогда
		Возврат "FAIL: без флага «Создавать задачи» создано задач - " + Результат.СозданоЗадач;
	КонецЕсли;
	Для Каждого СтрокаПросрочки Из Результат.Просрочки Цикл
		Если ПустаяСтрока(СтрокаПросрочки.Вид) Тогда
			Возврат "FAIL: у просрочки не заполнен вид";
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СтрокаПросрочки.Объект) Тогда
			Возврат "FAIL: у просрочки «" + СтрокаПросрочки.Вид + "» не заполнен объект";
		КонецЕсли;
		Если СтрокаПросрочки.ПросроченоНа <= 0 Тогда
			Возврат "FAIL: у просрочки «" + Строка(СтрокаПросрочки.Объект)
				+ "» неположительное время просрочки: " + СтрокаПросрочки.ПросроченоНа;
		КонецЕсли;
	КонецЦикла;
	
	Возврат "OK (просрочек: " + Результат.Просрочки.Количество() + ", создано задач: 0)";
	
КонецФункции

&НаСервере
Функция ЗапускСозданияЗадачПоПросрочкам(ЗадачиДо)
	
	Запуск = Неопределено;
	Попытка
		Обработка = Обработки.ПросроченныеСрокиИSLA.Создать();
		Запуск = Обработка.ВыполнитьОбработку(Новый Структура("СоздаватьЗадачи", Истина));
	Исключение
		Возврат "FAIL: " + ОписаниеОшибки();
	КонецПопытки;
	
	НовыхВБазе = НовыеЗадачиИсполнителя(ЗадачиДо).Количество();
	Если НовыхВБазе <> Запуск.СозданоЗадач Тогда
		Возврат "FAIL: итог «СозданоЗадач» (" + Запуск.СозданоЗадач
			+ ") не совпал с числом новых задач в базе (" + НовыхВБазе + ")";
	КонецЕсли;
	
	Возврат "OK (просрочек: " + Запуск.Просрочки.Количество()
		+ ", создано задач: " + Запуск.СозданоЗадач + ")";
	
КонецФункции

&НаСервере
Функция ЗапускПовтораСозданияЗадач()
	
	ЗадачиПередПовтором = СнимокЗадачИсполнителя();
	Запуск = Неопределено;
	Попытка
		Обработка = Обработки.ПросроченныеСрокиИSLA.Создать();
		Запуск = Обработка.ВыполнитьОбработку(Новый Структура("СоздаватьЗадачи", Истина));
	Исключение
		Возврат "FAIL: " + ОписаниеОшибки();
	КонецПопытки;
	
	Если Запуск.СозданоЗадач <> 0 Тогда
		Возврат "FAIL: повторный запуск создал дубли задач - " + Запуск.СозданоЗадач;
	КонецЕсли;
	НовыхВБазе = НовыеЗадачиИсполнителя(ЗадачиПередПовтором).Количество();
	Если НовыхВБазе <> 0 Тогда
		Возврат "FAIL: после повторного запуска в базе появилось новых задач - " + НовыхВБазе;
	КонецЕсли;
	
	Возврат "OK (дублей задач нет)";
	
КонецФункции

&НаСервере
Функция УбратьСозданныеЗадачи(ЗадачиДо)
	
	// Созданные задачи помечаются на удаление и удаляются; если удаление
	// запрещено (задачу удерживает процесс), достаточно пометки: снимок
	// задач отбирает только непомеченные.
	Новые = НовыеЗадачиИсполнителя(ЗадачиДо);
	Помечено = 0;
	Для Каждого ЗадачаСсылка Из Новые Цикл
		РезультатПометки = ПометитьЗадачуНаУдаление(ЗадачаСсылка);
		Если РезультатПометки <> "OK" Тогда
			Возврат "FAIL: не удалось пометить задачу " + Строка(ЗадачаСсылка)
				+ ": " + РезультатПометки;
		КонецЕсли;
		Попытка
			ОбъектЗадачи = ЗадачаСсылка.ПолучитьОбъект();
			ОбъектЗадачи.Удалить();
		Исключение
			// Задачу удерживает процесс - помеченной на удаление достаточно.
			Помечено = Помечено + 1;
		КонецПопытки;
	КонецЦикла;
	
	Остаток = НовыеЗадачиИсполнителя(ЗадачиДо).Количество();
	Если Остаток <> 0 Тогда
		Возврат "FAIL: после очистки в базе осталось новых задач - " + Остаток;
	КонецЕсли;
	
	Возврат "OK (убрано задач: " + Новые.Количество()
		+ ", из них только помечено: " + Помечено + ")";
	
КонецФункции

&НаСервере
Процедура ВыполнитьСценарийСводкиСтатусов(Лог)
	
	// Сценарий «proc-summary»: обработка СводкаСтатусов строит количества
	// объектов по статусам только на чтении. Проверяются: структура
	// результата, совпадение количеств с ручным подсчётом запросом, пустой
	// период даёт пустую таблицу без ошибки, выгрузка в файл повторяет
	// значения, число записей регистров сведений до и после одинаково.
	Провалов = 0;
	
	ДатаНачала = Дата(2000, 1, 1);
	ДатаОкончания = ТекущаяДатаСеанса();
	
	ЗаписиДо = КоличествоЗаписейРегистровСведений();
	
	Обработка = Обработки.СводкаСтатусов.Создать();
	Сводка = Неопределено;
	Попытка
		Сводка = Обработка.ВыполнитьОбработку(
			Новый Структура("ДатаНачала, ДатаОкончания", ДатаНачала, ДатаОкончания),
			Новый Структура);
	Исключение
		Лог.Добавить("ПРОВЕРКА: запуск сводки статусов - FAIL: " + ОписаниеОшибки());
		Лог.Добавить("провалено проверок: 1");
		Лог.Добавить("ВЕРДИКТ: FAIL");
		Возврат;
	КонецПопытки;
	Лог.Добавить("ПРОВЕРКА: запуск сводки статусов - OK (без исключения)");
	
	Результат = ПроверитьСтруктуруСводкиСтатусов(Сводка);
	Лог.Добавить("ПРОВЕРКА: структура сводки - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Провалов = Провалов + 1;
		ЗаписатьВердикт(Лог, Провалов);
		Возврат;
	КонецЕсли;
	
	Результат = СверитьСводкуСРучнымПодсчётом(Сводка, ДатаНачала, ДатаОкончания);
	Лог.Добавить("ПРОВЕРКА: количества совпадают с ручным подсчётом - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Провалов = Провалов + 1;
	КонецЕсли;
	
	ПустаяСводка = Неопределено;
	Попытка
		ПустаяСводка = Обработка.ВыполнитьОбработку(Новый Структура, Новый Структура);
		Если ПустаяСводка.Количество() = 0 Тогда
			Результат = "OK (пустой период дал пустую таблицу)";
		Иначе
			Результат = "FAIL: пустой период дал строк - " + ПустаяСводка.Количество();
		КонецЕсли;
	Исключение
		Результат = "FAIL: " + ОписаниеОшибки();
	КонецПопытки;
	Лог.Добавить("ПРОВЕРКА: пустой период - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Провалов = Провалов + 1;
	КонецЕсли;
	
	Результат = ПроверитьВыгрузкуСводкиВФайл(Обработка, Сводка);
	Лог.Добавить("ПРОВЕРКА: выгрузка в файл повторяет значения - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Провалов = Провалов + 1;
	КонецЕсли;
	
	ЗаписиПосле = КоличествоЗаписейРегистровСведений();
	Если ЗаписиПосле = ЗаписиДо Тогда
		Результат = "OK (записей регистров: " + ЗаписиПосле + ")";
	Иначе
		Результат = "FAIL: число записей регистров изменилось: было " + ЗаписиДо
			+ ", стало " + ЗаписиПосле;
	КонецЕсли;
	Лог.Добавить("ПРОВЕРКА: сводка не меняет данные - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Провалов = Провалов + 1;
	КонецЕсли;
	
	ЗаписатьВердикт(Лог, Провалов);
	
КонецПроцедуры

&НаСервере
Функция ПроверитьСтруктуруСводкиСтатусов(Сводка)
	
	Если ТипЗнч(Сводка) <> Тип("ТаблицаЗначений") Тогда
		Возврат "FAIL: обработка вернула не таблицу значений, а " + Строка(ТипЗнч(Сводка));
	КонецЕсли;
	Для Каждого Колонка Из СтрРазделить("Сущность,Статус,Количество", ",") Цикл
		Если Сводка.Колонки.Найти(Колонка) = Неопределено Тогда
			Возврат "FAIL: в сводке нет колонки «" + Колонка + "»";
		КонецЕсли;
	КонецЦикла;
	Для Каждого СтрокаСводки Из Сводка Цикл
		Если ПустаяСтрока(СтрокаСводки.Сущность) Тогда
			Возврат "FAIL: в сводке есть строка без сущности";
		КонецЕсли;
		Если СтрокаСводки.Количество < 0 Тогда
			Возврат "FAIL: отрицательное количество по «" + СтрокаСводки.Сущность + "»";
		КонецЕсли;
	КонецЦикла;
	
	Возврат "OK (строк сводки: " + Сводка.Количество() + ")";
	
КонецФункции

&НаСервере
Функция КоличествоЗаписейРегистровСведений()
	
	// Один запрос сразу по всем регистрам: создание запросов в цикле
	// недопустимо, а число записей - величина того же типа (Число).
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ
		|	РегистрСведений.СтатусыПодтверждений
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ
		|	РегистрСведений.ИсторияОбработокЗапросов
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ
		|	РегистрСведений.СтатусыИнцидентов
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ
		|	РегистрСведений.СрокиКонтроля";
	
	Всего = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Всего = Всего + Выборка.Количество;
	КонецЦикла;
	
	Возврат Всего;
	
КонецФункции

&НаСервере
Функция СверитьСводкуСРучнымПодсчётом(Сводка, ДатаНачала, ДатаОкончания)
	
	Ручная = РучнаяСводкаСтатусов(ДатаНачала, ДатаОкончания);
	Если ТипЗнч(Ручная) = Тип("Строка") Тогда
		Возврат Ручная;
	КонецЕсли;
	
	КлючиСводки = Новый Соответствие;
	Для Каждого СтрокаСводки Из Сводка Цикл
		Ключ = СтрокаСводки.Сущность + "|" + СтрокаСводки.Статус;
		Если КлючиСводки.Получить(Ключ) <> Неопределено Тогда
			Возврат "FAIL: в сводке есть дубль строки «" + Ключ + "»";
		КонецЕсли;
		КлючиСводки.Вставить(Ключ, Истина);
		Ожидание = Ручная.Получить(Ключ);
		Если Ожидание = Неопределено Тогда
			Возврат "FAIL: лишняя строка сводки «" + Ключ + "»";
		КонецЕсли;
		Если СтрокаСводки.Количество <> Ожидание Тогда
			Возврат "FAIL: по «" + Ключ + "» сводка дала " + СтрокаСводки.Количество
				+ ", ручной подсчёт - " + Ожидание;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого КлючИЗначение Из Ручная Цикл
		Если КлючиСводки.Получить(КлючИЗначение.Ключ) = Неопределено Тогда
			Возврат "FAIL: в сводке не хватает строки «" + КлючИЗначение.Ключ + "»";
		КонецЕсли;
	КонецЦикла;
	
	Возврат "OK (строк сводки: " + Сводка.Количество() + ")";
	
КонецФункции

&НаСервере
Функция РучнаяСводкаСтатусов(ДатаНачала, ДатаОкончания)
	
	// Подсчёт для сверки с обработкой: те же четыре источника и те же
	// условия отбора. Запросы не в цикле - каждый источник считается
	// отдельным вызовом помощника.
	Ручная = Новый Соответствие;
	
	Ошибка = ДобавитьРучнойПодсчёт(Ручная, "Заявки",
		"Справочник.ЗаявкиНаТур", "Статус", ДатаНачала, ДатаОкончания);
	Если Ошибка <> Неопределено Тогда
		Возврат Ошибка;
	КонецЕсли;
	
	Ошибка = ДобавитьРучнойПодсчёт(Ручная, "Подтверждения",
		"Документ.ПодтверждениеУслуги", "РезультатСверки", ДатаНачала, ДатаОкончания);
	Если Ошибка <> Неопределено Тогда
		Возврат Ошибка;
	КонецЕсли;
	
	Ошибка = ДобавитьРучнойПодсчёт(Ручная, "Инциденты",
		"Документ.Инцидент", "Статус", ДатаНачала, ДатаОкончания);
	Если Ошибка <> Неопределено Тогда
		Возврат Ошибка;
	КонецЕсли;
	
	Ошибка = ДобавитьРучнойПодсчёт(Ручная, "Претензии",
		"Документ.ПретензияПоставщику", "Статус", ДатаНачала, ДатаОкончания);
	Если Ошибка <> Неопределено Тогда
		Возврат Ошибка;
	КонецЕсли;
	
	Возврат Ручная;
	
КонецФункции

&НаСервере
Функция ДобавитьРучнойПодсчёт(Ручная, Сущность, Таблица, Поле, ДатаНачала, ДатаОкончания)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ОбъектыСводки." + Поле + " КАК Статус,
		|	КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ
		|	" + Таблица + " КАК ОбъектыСводки
		|ГДЕ
		|	НЕ ОбъектыСводки.ПометкаУдаления
		|	И ОбъектыСводки.Дата >= &ДатаНачала
		|	И ОбъектыСводки.Дата <= &ДатаОкончания
		|
		|СГРУППИРОВАТЬ ПО
		|	ОбъектыСводки." + Поле;
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));
	
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		Возврат "FAIL: ручной подсчёт по «" + Сущность
			+ "» не выполнился: " + ОписаниеОшибки();
	КонецПопытки;
	
	Пока Выборка.Следующий() Цикл
		Ручная.Вставить(Сущность + "|" + ПредставлениеСтатусаСводки(Выборка.Статус),
			Выборка.Количество);
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Функция ПредставлениеСтатусаСводки(Статус)
	
	Если Не ЗначениеЗаполнено(Статус) Тогда
		Возврат "(не указан)";
	КонецЕсли;
	
	Возврат Строка(Статус);
	
КонецФункции

&НаСервере
Функция ПроверитьВыгрузкуСводкиВФайл(Обработка, Сводка)
	
	ПутьФайла = ПолучитьИмяВременногоФайла("csv");
	Результат = СравнитьФайлВыгрузкиСоСводкой(Обработка, Сводка, ПутьФайла);
	
	Попытка
		УдалитьФайлы(ПутьФайла);
	Исключение
		// Временный файл останется в temp - на вердикт это не влияет.
		ПричинаНеудаления = ОписаниеОшибки();
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция СравнитьФайлВыгрузкиСоСводкой(Обработка, Сводка, ПутьФайла)
	
	Попытка
		Обработка.ВыгрузитьВФайл(Сводка, ПутьФайла);
	Исключение
		Возврат "FAIL: выгрузка в файл упала: " + ОписаниеОшибки();
	КонецПопытки;
	
	Содержимое = Неопределено;
	Попытка
		Чтение = Новый ЧтениеТекста(ПутьФайла, КодировкаТекста.UTF8);
		Содержимое = Чтение.Прочитать();
		Чтение.Закрыть();
	Исключение
		Возврат "FAIL: файл выгрузки не прочитался: " + ОписаниеОшибки();
	КонецПопытки;
	
	СтрокиФайла = Новый Массив;
	Для Каждого СтрокаФайла Из СтрРазделить(Содержимое, Символы.ПС, Истина) Цикл
		ОчищеннаяСтрока = СтрЗаменить(СтрокаФайла, Символы.ВК, "");
		Если Не ПустаяСтрока(ОчищеннаяСтрока) Тогда
			СтрокиФайла.Добавить(ОчищеннаяСтрока);
		КонецЕсли;
	КонецЦикла;
	
	Если СтрокиФайла.Количество() <> Сводка.Количество() + 1 Тогда
		Возврат "FAIL: в файле строк - " + СтрокиФайла.Количество()
			+ ", ожидалось - " + (Сводка.Количество() + 1)
			+ "; содержимое: " + СтрСоединить(СтрокиФайла, " / ");
	КонецЕсли;
	Если СтрокиФайла[0] <> "Сущность;Статус;Количество" Тогда
		Возврат "FAIL: заголовок файла «" + СтрокиФайла[0] + "» не совпал с ожидаемым";
	КонецЕсли;
	Для Индекс = 0 По Сводка.Количество() - 1 Цикл
		СтрокаСводки = Сводка.Получить(Индекс);
		Ожидание = СтрокаСводки.Сущность + ";" + СтрокаСводки.Статус + ";"
			+ Формат(СтрокаСводки.Количество, "ЧГ=0");
		Если СтрокиФайла[Индекс + 1] <> Ожидание Тогда
			Возврат "FAIL: строка файла «" + СтрокиФайла[Индекс + 1]
				+ "» не совпала с «" + Ожидание + "»";
		КонецЕсли;
	КонецЦикла;
	
	Возврат "OK (строк файла: " + СтрокиФайла.Количество() + ")";
	
КонецФункции

#КонецОбласти



