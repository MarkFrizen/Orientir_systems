#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// Runtime-ошибка серверного вызова не должна оставлять 1С висеть с
	// модальным диалогом: ошибка пишется в отчёт FAIL-вердиктом, после чего
	// система закрывается в любом случае. Ошибку компиляции самого модуля
	// формы это не ловит - её фиксирует таймаут раннера (run-driver.ps1).
	Попытка
		ВыполнитьСценарий(ПараметрЗапуска);
	Исключение
		ЗаписатьОтчетОСбоеНаКлиенте(ПараметрЗапуска, ОписаниеОшибки());
	КонецПопытки;
	
	ЗавершитьРаботуСистемы(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьОтчетОСбоеНаКлиенте(Параметр, ТекстОшибки)
	
	// Обёрнута в собственную Попытку: сбой записи отчёта (нет пути, нет
	// доступа к файлу) не должен приводить к новому клиентскому диалогу.
	Попытка
		
		Части = СтрРазделить(Параметр, "|");
		ПутьОтчёта = ?(Части.Количество() > 2, Части[2], "");
		Если ПустаяСтрока(ПутьОтчёта) Тогда
			Возврат;
		КонецЕсли;
		
		Файл = Новый ЗаписьТекста(ПутьОтчёта, "UTF-8");
		Файл.ЗаписатьСтроку("ПРОВЕРКА: выполнение сценария - FAIL (" + ТекстОшибки + ")");
		Файл.ЗаписатьСтроку("ВЕРДИКТ: FAIL");
		Файл.Закрыть();
		
	Исключение
		// Намеренно пусто: см. комментарий выше.
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ВыполнитьСценарий(Знач Параметр)
	
	Части = СтрРазделить(Параметр, "|");
	ИмяСценария = ?(Части.Количество() > 0, Части[0], "");
	ПутьФайла   = ?(Части.Количество() > 1, Части[1], "");
	ПутьОтчёта  = ?(Части.Количество() > 2, Части[2], "");
	
	Лог = Новый Массив;
	
	Если ИмяСценария = "selftest" Тогда
		ВыполнитьСамопроверку(Лог);
	ИначеЕсли ИмяСценария = "task-addressing" Тогда
		ВыполнитьСценарийАдресацииЗадач(Лог);
	Иначе
		Лог.Добавить("НЕИЗВЕСТНЫЙ СЦЕНАРИЙ: " + ИмяСценария);
		Лог.Добавить("ВЕРДИКТ: FAIL");
	КонецЕсли;
	
	ЗаписатьЛог(ПутьОтчёта, Лог);
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьСамопроверку(Лог)
	
	// Самопроверка драйвера: инфраструктура тестов проведения признаётся годной,
	// если конфигурация открывается, в метаданных девять документов и у каждого
	// есть модуль объекта. Каждая проверка пишет строку «ПРОВЕРКА: … - OK/FAIL»,
	// итог - строка «ВЕРДИКТ: PASS/FAIL», которую разбирает run-driver.ps1.
	Провалов = 0;
	
	Результат = ПроверитьОткрытиеКонфигурации();
	Лог.Добавить("ПРОВЕРКА: конфигурация открывается - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Провалов = Провалов + 1;
	КонецЕсли;
	
	Результат = ПроверитьКоличествоДокументов();
	Лог.Добавить("ПРОВЕРКА: документов в метаданных - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Провалов = Провалов + 1;
	КонецЕсли;
	
	Попытка
		Для Каждого ДокументМетаданные Из Метаданные.Документы Цикл
			Результат = ПроверитьМодульОбъектаДокумента(ДокументМетаданные.Имя);
			Лог.Добавить("ПРОВЕРКА: модуль объекта Документ." + ДокументМетаданные.Имя + " - " + Результат);
			Если СтрНайти(Результат, "FAIL") > 0 Тогда
				Провалов = Провалов + 1;
			КонецЕсли;
		КонецЦикла;
	Исключение
		Лог.Добавить("ПРОВЕРКА: обход документов метаданных - FAIL: " + ОписаниеОшибки());
		Провалов = Провалов + 1;
	КонецПопытки;
	
	Если Провалов > 0 Тогда
		Лог.Добавить("провалено проверок: " + Провалов);
		Лог.Добавить("ВЕРДИКТ: FAIL");
	Иначе
		Лог.Добавить("ВЕРДИКТ: PASS");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьСценарийАдресацииЗадач(Лог)
	
	// Сценарий «task-addressing»: общий модуль ЗадачиИсполнителям создаёт
	// задачу с адресацией через регистр АдресацияЗадач. Проверяются заполнение
	// реквизита адресации «Исполнитель» и наличие записи адресации в регистре,
	// затем задача помечается на удаление, чтобы прогон не засорял базу.
	// Пока модуля нет в конфигурации (красный прогон), обработка не
	// компилируется: драйвер завершается без отчёта, раннер фиксирует FAIL.
	Провалов = 0;
	
	Исполнитель = Неопределено;
	Попытка
		Исполнитель = ВыбратьИсполнителя();
		Результат = "OK (" + Строка(Исполнитель) + ")";
	Исключение
		Результат = "FAIL: " + ОписаниеОшибки();
	КонецПопытки;
	Лог.Добавить("ПРОВЕРКА: исполнитель для сценария - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Лог.Добавить("провалено проверок: 1");
		Лог.Добавить("ВЕРДИКТ: FAIL");
		Возврат;
	КонецЕсли;
	
	ЗадачаСсылка = Неопределено;
	Результат = ПроверитьСозданиеЗадачи(Исполнитель, ЗадачаСсылка);
	Лог.Добавить("ПРОВЕРКА: создание задачи - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Провалов = Провалов + 1;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЗадачаСсылка) Тогда
		
		Результат = ПроверитьРеквизитАдресации(ЗадачаСсылка, Исполнитель);
		Лог.Добавить("ПРОВЕРКА: реквизит адресации Исполнитель - " + Результат);
		Если СтрНайти(Результат, "FAIL") > 0 Тогда
			Провалов = Провалов + 1;
		КонецЕсли;
		
		Результат = ПроверитьЗаписьАдресации(Исполнитель);
		Лог.Добавить("ПРОВЕРКА: запись адресации в регистре - " + Результат);
		Если СтрНайти(Результат, "FAIL") > 0 Тогда
			Провалов = Провалов + 1;
		КонецЕсли;
		
		Результат = ПометитьЗадачуНаУдаление(ЗадачаСсылка);
		Лог.Добавить("ПРОВЕРКА: пометка удаления задачи - " + Результат);
		Если СтрНайти(Результат, "FAIL") > 0 Тогда
			Провалов = Провалов + 1;
		КонецЕсли;
		
	Иначе
		Лог.Добавить("ПРОВЕРКА: адресация и уборка - FAIL: задача не создана, проверки пропущены");
		Провалов = Провалов + 1;
	КонецЕсли;
	
	Если Провалов > 0 Тогда
		Лог.Добавить("провалено проверок: " + Провалов);
		Лог.Добавить("ВЕРДИКТ: FAIL");
	Иначе
		Лог.Добавить("ВЕРДИКТ: PASS");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ВыбратьИсполнителя()
	
	// Сценарий не плодит справочные данные: исполнитель берётся из справочника
	// Сотрудники, а при пустом справочнике создаётся один служебный элемент.
	Выборка = Справочники.Сотрудники.Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Сотрудник = Справочники.Сотрудники.СоздатьЭлемент();
	Сотрудник.Наименование = "Исполнитель сценария task-addressing";
	Сотрудник.Записать();
	
	Возврат Сотрудник.Ссылка;
	
КонецФункции

&НаСервере
Функция ПроверитьСозданиеЗадачи(Исполнитель, ЗадачаСсылка)
	
	Попытка
		ЗадачаСсылка = ЗадачиИсполнителям.СоздатьЗадачу("Задача сценария task-addressing", "", Исполнитель);
	Исключение
		ЗадачаСсылка = Неопределено;
		Возврат "FAIL: " + ОписаниеОшибки();
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(ЗадачаСсылка) Тогда
		ЗадачаСсылка = Неопределено;
		Возврат "FAIL: модуль вернул пустую ссылку";
	КонецЕсли;
	
	Возврат "OK (" + Строка(ЗадачаСсылка) + ")";
	
КонецФункции

&НаСервере
Функция ПроверитьРеквизитАдресации(ЗадачаСсылка, Исполнитель)
	
	Попытка
		Если ЗадачаСсылка.Исполнитель <> Исполнитель Тогда
			Возврат "FAIL: исполнитель задачи " + Строка(ЗадачаСсылка.Исполнитель) + ", ожидался " + Строка(Исполнитель);
		КонецЕсли;
	Исключение
		Возврат "FAIL: " + ОписаниеОшибки();
	КонецПопытки;
	
	Возврат "OK";
	
КонецФункции

&НаСервере
Функция ПроверитьЗаписьАдресации(Исполнитель)
	
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	АдресацияЗадач.Исполнитель КАК Исполнитель
			|ИЗ
			|	РегистрСведений.АдресацияЗадач КАК АдресацияЗадач
			|ГДЕ
			|	АдресацияЗадач.Исполнитель = &Исполнитель";
		Запрос.УстановитьПараметр("Исполнитель", Исполнитель);
		Если Запрос.Выполнить().Пустой() Тогда
			Возврат "FAIL: в регистре АдресацияЗадач нет записи исполнителя";
		КонецЕсли;
	Исключение
		Возврат "FAIL: " + ОписаниеОшибки();
	КонецПопытки;
	
	Возврат "OK";
	
КонецФункции

&НаСервере
Функция ПометитьЗадачуНаУдаление(ЗадачаСсылка)
	
	Попытка
		ОбъектЗадачи = ЗадачаСсылка.ПолучитьОбъект();
		ОбъектЗадачи.ПометкаУдаления = Истина;
		ОбъектЗадачи.Записать();
	Исключение
		Возврат "FAIL: " + ОписаниеОшибки();
	КонецПопытки;
	
	Возврат "OK";
	
КонецФункции

&НаСервере
Функция ПроверитьОткрытиеКонфигурации()
	
	// Проверка обёрнута в Попытку: любая непредвиденная ошибка должна попасть
	// в лог текстом, а не всплыть на клиенте диалогом «непредвиденная ошибка».
	Попытка
		
		ИмяКонфигурации = Метаданные.Имя;
		Если ПустаяСтрока(ИмяКонфигурации) Тогда
			Возврат "FAIL: имя конфигурации пусто";
		КонецЕсли;
		
		Возврат "OK (" + ИмяКонфигурации + ")";
		
	Исключение
		Возврат "FAIL: " + ОписаниеОшибки();
	КонецПопытки;
	
КонецФункции

&НаСервере
Функция ПроверитьКоличествоДокументов()
	
	Попытка
		
		КоличествоДокументов = Метаданные.Документы.Количество();
		Если КоличествоДокументов <> 9 Тогда
			Возврат "FAIL: документов " + КоличествоДокументов + ", ожидалось 9";
		КонецЕсли;
		
		Возврат "OK (9)";
		
	Исключение
		Возврат "FAIL: " + ОписаниеОшибки();
	КонецПопытки;
	
КонецФункции

&НаСервере
Функция ПроверитьМодульОбъектаДокумента(ИмяДокумента)
	
	// Во время выполнения текст модуля из метаданных недоступен, поэтому наличие
	// модуля объекта доказывается вызовом его экспортной функции ПравилаЗаписи:
	// у документа без модуля объекта метод не обнаружится. Менеджер документа
	// берётся через Вычислить по имени из метаданных: обход обязан пережить
	// добавление документа в конфигурацию без правки драйвера.
	Попытка
		МенеджерДокумента = Вычислить("Документы." + ИмяДокумента);
		ОбъектДокумента = МенеджерДокумента.СоздатьДокумент();
	Исключение
		Возврат "FAIL: не удалось создать объект документа: " + ОписаниеОшибки();
	КонецПопытки;
	
	Попытка
		// ПравилаЗаписи - чистая функция: пустой незаписанный документ она
		// только осматривает и возвращает массив нарушений.
		Нарушения = ОбъектДокумента.ПравилаЗаписи(ОбъектДокумента);
	Исключение
		Возврат "FAIL: " + ОписаниеОшибки();
	КонецПопытки;
	
	Если ТипЗнч(Нарушения) <> Тип("Массив") Тогда
		Возврат "FAIL: ПравилаЗаписи вернула не массив, а " + ТипЗнч(Нарушения);
	КонецЕсли;
	
	Возврат "OK";
	
КонецФункции

&НаСервере
Процедура ЗаписатьЛог(ПутьОтчёта, Лог)
	
	Если ПустаяСтрока(ПутьОтчёта) Тогда
		Возврат;
	КонецЕсли;
	
	Файл = Новый ЗаписьТекста(ПутьОтчёта, "UTF-8");
	Для Каждого СтрокаЛога Из Лог Цикл
		Файл.ЗаписатьСтроку(СтрокаЛога);
	КонецЦикла;
	Файл.Закрыть();
	
КонецПроцедуры

#КонецОбласти
