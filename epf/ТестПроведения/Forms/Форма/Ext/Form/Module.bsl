КонецФункции

&НаСервере
Функция ПроверитьСтатусИнцидента(ИнцидентСсылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Статусы.Период КАК Период,
		|	Статусы.Инцидент КАК Инцидент,
		|	Статусы.Статус КАК Статус,
		|	Статусы.Ответственный КАК Ответственный
		|ИЗ
		|	РегистрСведений.СтатусыИнцидентов КАК Статусы
		|ГДЕ
		|	Статусы.Регистратор = &Регистратор";
	Запрос.УстановитьПараметр("Регистратор", ИнцидентСсылка);
	Записи = Запрос.Выполнить().Выгрузить();
	
	Если Записи.Количество() <> 1 Тогда
		Возврат "FAIL: записей " + Записи.Количество() + ", ожидалась 1";
	КонецЕсли;
	
	Запись = Записи.Получить(0);
	Если Запись.Статус <> Перечисления.СтатусыИнцидента.Открыт Тогда
		Возврат "FAIL: статус " + Строка(Запись.Статус) + ", ожидался Открыт";
	КонецЕсли;
	Если Запись.Ответственный <> ИнцидентСсылка.Ответственный Тогда
		Возврат "FAIL: ответственный " + Строка(Запись.Ответственный)
			+ ", ожидался " + Строка(ИнцидентСсылка.Ответственный);
	КонецЕсли;
	Если Запись.Инцидент <> ИнцидентСсылка Тогда
		Возврат "FAIL: измерение Инцидент " + Строка(Запись.Инцидент) + ", ожидался сам документ";
	КонецЕсли;
	ОжидаемыйПериод = НачалоДня(ИнцидентСсылка.Дата);
	Если Запись.Период <> ОжидаемыйПериод Тогда
		Возврат "FAIL: период " + Формат(Запись.Период, "ДФ=dd.MM.yyyy")
			+ ", ожидалась дата документа " + Формат(ОжидаемыйПериод, "ДФ=dd.MM.yyyy");
	КонецЕсли;
	
	Возврат "OK (1 запись, статус Открыт, ответственный из документа)";
	
КонецФункции

