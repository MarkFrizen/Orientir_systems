#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// Runtime-ошибка серверного вызова не должна оставлять 1С висеть с
	// модальным диалогом: ошибка пишется в отчёт FAIL-вердиктом, после чего
	// система закрывается в любом случае. Ошибку компиляции самого модуля
	// формы это не ловит - её фиксирует таймаут раннера (run-driver.ps1).
	Попытка
		ВыполнитьСценарий(ПараметрЗапуска);
	Исключение
		ЗаписатьОтчетОСбоеНаКлиенте(ПараметрЗапуска, ОписаниеОшибки());
	КонецПопытки;
	
	ЗавершитьРаботуСистемы(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьОтчетОСбоеНаКлиенте(Параметр, ТекстОшибки)
	
	// Обёрнута в собственную Попытку: сбой записи отчёта (нет пути, нет
	// доступа к файлу) не должен приводить к новому клиентскому диалогу.
	Попытка
		
		Части = СтрРазделить(Параметр, "|");
		ПутьОтчёта = ?(Части.Количество() > 2, Части[2], "");
		Если ПустаяСтрока(ПутьОтчёта) Тогда
			Возврат;
		КонецЕсли;
		
		Файл = Новый ЗаписьТекста(ПутьОтчёта, "UTF-8");
		Файл.ЗаписатьСтроку("ПРОВЕРКА: выполнение сценария - FAIL (" + ТекстОшибки + ")");
		Файл.ЗаписатьСтроку("ВЕРДИКТ: FAIL");
		Файл.Закрыть();
		
	Исключение
		// Намеренно без действий: см. комментарий выше. Выход - штатное
		// завершение процедуры, отчёт уже не записать.
		Возврат;
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ВыполнитьСценарий(Знач Параметр)
	
	Части = СтрРазделить(Параметр, "|");
	ИмяСценария = ?(Части.Количество() > 0, Части[0], "");
	ПутьФайла   = ?(Части.Количество() > 1, Части[1], "");
	ПутьОтчёта  = ?(Части.Количество() > 2, Части[2], "");
	
	Лог = Новый Массив;
	
	Если ИмяСценария = "selftest" Тогда
		ВыполнитьСамопроверку(Лог);
	ИначеЕсли ИмяСценария = "task-addressing" Тогда
		ВыполнитьСценарийАдресацииЗадач(Лог);
	ИначеЕсли ИмяСценария = "post-order" Тогда
		ВыполнитьСценарийПроведенияЗаказа(Лог);
	ИначеЕсли ИмяСценария = "post-confirmation" Тогда
		ВыполнитьСценарийПроведенияПодтверждения(Лог);
	ИначеЕсли ИмяСценария = "post-route" Тогда
		ВыполнитьСценарийПроведенияМаршрутногоЛиста(Лог);
	ИначеЕсли ИмяСценария = "post-route-correction" Тогда
		ВыполнитьСценарийПроведенияКорректировкиМаршрута(Лог);
	ИначеЕсли ИмяСценария = "post-event" Тогда
		ВыполнитьСценарийПроведенияСобытияМаршрута(Лог);
	ИначеЕсли ИмяСценария = "post-tourist-request" Тогда
		ВыполнитьСценарийПроведенияЗаявкиТуриста(Лог);
	ИначеЕсли ИмяСценария = "post-incident" Тогда
		ВыполнитьСценарийПроведенияИнцидента(Лог);
	ИначеЕсли ИмяСценария = "post-claim" Тогда
		ВыполнитьСценарийПроведенияПретензии(Лог);
	ИначеЕсли ИмяСценария = "post-compensation-act" Тогда
		ВыполнитьСценарийПроведенияАктаОКомпенсации(Лог);
	ИначеЕсли ИмяСценария = "proc-requests" Тогда
		ВыполнитьСценарийФормированияЗапросов(Лог);
	ИначеЕсли ИмяСценария = "proc-timings" Тогда
		ВыполнитьСценарийПересчётаТаймингов(Лог);
	ИначеЕсли ИмяСценария = "proc-overdue" Тогда
		ВыполнитьСценарийПроверкиПросрочек(Лог);
	ИначеЕсли ИмяСценария = "proc-summary" Тогда
		ВыполнитьСценарийСводкиСтатусов(Лог);
	ИначеЕсли ИмяСценария = "lock-probe" Тогда
		ВыполнитьПробуБлокировки(Лог);
	Иначе
		Лог.Добавить("НЕИЗВЕСТНЫЙ СЦЕНАРИЙ: " + ИмяСценария);
		Лог.Добавить("ВЕРДИКТ: FAIL");
	КонецЕсли;
	
	ЗаписатьЛог(ПутьОтчёта, Лог);
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьСамопроверку(Лог)
	
	// Самопроверка драйвера: инфраструктура тестов проведения признаётся годной,
	// если конфигурация открывается, в метаданных девять документов и у каждого
	// есть модуль объекта. Каждая проверка пишет строку «ПРОВЕРКА: … - OK/FAIL»,
	// итог - строка «ВЕРДИКТ: PASS/FAIL», которую разбирает run-driver.ps1.
	Провалов = 0;
	
	Результат = ПроверитьОткрытиеКонфигурации();
	Лог.Добавить("ПРОВЕРКА: конфигурация открывается - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Провалов = Провалов + 1;
	КонецЕсли;
	
	Результат = ПроверитьКоличествоДокументов();
	Лог.Добавить("ПРОВЕРКА: документов в метаданных - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Провалов = Провалов + 1;
	КонецЕсли;
	
	Попытка
		Для Каждого ДокументМетаданные Из Метаданные.Документы Цикл
			Результат = ПроверитьМодульОбъектаДокумента(ДокументМетаданные.Имя);
			Лог.Добавить("ПРОВЕРКА: модуль объекта Документ." + ДокументМетаданные.Имя + " - " + Результат);
			Если СтрНайти(Результат, "FAIL") > 0 Тогда
				Провалов = Провалов + 1;
			КонецЕсли;
		КонецЦикла;
	Исключение
		Лог.Добавить("ПРОВЕРКА: обход документов метаданных - FAIL: " + ОписаниеОшибки());
		Провалов = Провалов + 1;
	КонецПопытки;
	
	Если Провалов > 0 Тогда
		Лог.Добавить("провалено проверок: " + Провалов);
		Лог.Добавить("ВЕРДИКТ: FAIL");
	Иначе
		Лог.Добавить("ВЕРДИКТ: PASS");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьСценарийАдресацииЗадач(Лог)
	
	// Сценарий «task-addressing»: общий модуль ЗадачиИсполнителям создаёт
	// задачу с адресацией через регистр АдресацияЗадач. Проверяются заполнение
	// реквизита адресации «Исполнитель» и наличие записи адресации в регистре,
	// затем задача помечается на удаление, чтобы прогон не засорял базу.
	// Пока модуля нет в конфигурации (красный прогон), обработка не
	// компилируется: драйвер завершается без отчёта, раннер фиксирует FAIL.
	Провалов = 0;
	
	Исполнитель = Неопределено;
	Попытка
		Исполнитель = ВыбратьИсполнителя();
		Результат = "OK (" + Строка(Исполнитель) + ")";
	Исключение
		Результат = "FAIL: " + ОписаниеОшибки();
	КонецПопытки;
	Лог.Добавить("ПРОВЕРКА: исполнитель для сценария - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Лог.Добавить("провалено проверок: 1");
		Лог.Добавить("ВЕРДИКТ: FAIL");
		Возврат;
	КонецЕсли;
	
	ЗадачаСсылка = Неопределено;
	Результат = ПроверитьСозданиеЗадачи(Исполнитель, ЗадачаСсылка);
	Лог.Добавить("ПРОВЕРКА: создание задачи - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Провалов = Провалов + 1;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЗадачаСсылка) Тогда
		
		Результат = ПроверитьРеквизитАдресации(ЗадачаСсылка, Исполнитель);
		Лог.Добавить("ПРОВЕРКА: реквизит адресации Исполнитель - " + Результат);
		Если СтрНайти(Результат, "FAIL") > 0 Тогда
			Провалов = Провалов + 1;
		КонецЕсли;
		
		Результат = ПроверитьЗаписьАдресации(Исполнитель);
		Лог.Добавить("ПРОВЕРКА: запись адресации в регистре - " + Результат);
		Если СтрНайти(Результат, "FAIL") > 0 Тогда
			Провалов = Провалов + 1;
		КонецЕсли;
		
		Результат = ПометитьЗадачуНаУдаление(ЗадачаСсылка);
		Лог.Добавить("ПРОВЕРКА: пометка удаления задачи - " + Результат);
		Если СтрНайти(Результат, "FAIL") > 0 Тогда
			Провалов = Провалов + 1;
		КонецЕсли;
		
	Иначе
		Лог.Добавить("ПРОВЕРКА: адресация и уборка - FAIL: задача не создана, проверки пропущены");
		Провалов = Провалов + 1;
	КонецЕсли;
	
	Если Провалов > 0 Тогда
		Лог.Добавить("провалено проверок: " + Провалов);
		Лог.Добавить("ВЕРДИКТ: FAIL");
	Иначе
		Лог.Добавить("ВЕРДИКТ: PASS");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ВыбратьИсполнителя()
	
	// Сценарий не плодит справочные данные: исполнитель берётся из справочника
	// Сотрудники, а при пустом справочнике создаётся один служебный элемент.
	Выборка = Справочники.Сотрудники.Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Сотрудник = Справочники.Сотрудники.СоздатьЭлемент();
	Сотрудник.Наименование = "Исполнитель сценария task-addressing";
	Сотрудник.Записать();
	
	Возврат Сотрудник.Ссылка;
	
КонецФункции

&НаСервере
Функция ПроверитьСозданиеЗадачи(Исполнитель, ЗадачаСсылка)
	
	Попытка
		ЗадачаСсылка = ЗадачиИсполнителям.СоздатьЗадачу("Задача сценария task-addressing", "", Исполнитель);
	Исключение
		ЗадачаСсылка = Неопределено;
		Возврат "FAIL: " + ОписаниеОшибки();
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(ЗадачаСсылка) Тогда
		ЗадачаСсылка = Неопределено;
		Возврат "FAIL: модуль вернул пустую ссылку";
	КонецЕсли;
	
	Возврат "OK (" + Строка(ЗадачаСсылка) + ")";
	
КонецФункции

&НаСервере
Функция ПроверитьРеквизитАдресации(ЗадачаСсылка, Исполнитель)
	
	Попытка
		Если ЗадачаСсылка.Исполнитель <> Исполнитель Тогда
			Возврат "FAIL: исполнитель задачи " + Строка(ЗадачаСсылка.Исполнитель) + ", ожидался " + Строка(Исполнитель);
		КонецЕсли;
	Исключение
		Возврат "FAIL: " + ОписаниеОшибки();
	КонецПопытки;
	
	Возврат "OK";
	
КонецФункции

&НаСервере
Функция ПроверитьЗаписьАдресации(Исполнитель)
	
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	АдресацияЗадач.Исполнитель КАК Исполнитель
			|ИЗ
			|	РегистрСведений.АдресацияЗадач КАК АдресацияЗадач
			|ГДЕ
			|	АдресацияЗадач.Исполнитель = &Исполнитель";
		Запрос.УстановитьПараметр("Исполнитель", Исполнитель);
		Если Запрос.Выполнить().Пустой() Тогда
			Возврат "FAIL: в регистре АдресацияЗадач нет записи исполнителя";
		КонецЕсли;
	Исключение
		Возврат "FAIL: " + ОписаниеОшибки();
	КонецПопытки;
	
	Возврат "OK";
	
КонецФункции

&НаСервере
Функция ПометитьЗадачуНаУдаление(ЗадачаСсылка)
	
	Попытка
		ОбъектЗадачи = ЗадачаСсылка.ПолучитьОбъект();
		ОбъектЗадачи.ПометкаУдаления = Истина;
		ОбъектЗадачи.Записать();
	Исключение
		Возврат "FAIL: " + ОписаниеОшибки();
	КонецПопытки;
	
	Возврат "OK";
	
КонецФункции

&НаСервере
Функция ПроверитьОткрытиеКонфигурации()
	
	// Проверка обёрнута в Попытку: любая непредвиденная ошибка должна попасть
	// в лог текстом, а не всплыть на клиенте диалогом «непредвиденная ошибка».
	Попытка
		
		ИмяКонфигурации = Метаданные.Имя;
		Если ПустаяСтрока(ИмяКонфигурации) Тогда
			Возврат "FAIL: имя конфигурации пусто";
		КонецЕсли;
		
		Возврат "OK (" + ИмяКонфигурации + ")";
		
	Исключение
		Возврат "FAIL: " + ОписаниеОшибки();
	КонецПопытки;
	
КонецФункции

&НаСервере
Функция ПроверитьКоличествоДокументов()
	
	Попытка
		
		КоличествоДокументов = Метаданные.Документы.Количество();
		Если КоличествоДокументов <> 9 Тогда
			Возврат "FAIL: документов " + КоличествоДокументов + ", ожидалось 9";
		КонецЕсли;
		
		Возврат "OK (9)";
		
	Исключение
		Возврат "FAIL: " + ОписаниеОшибки();
	КонецПопытки;
	
КонецФункции

&НаСервере
Функция ПроверитьМодульОбъектаДокумента(ИмяДокумента)
	
	// Во время выполнения текст модуля из метаданных недоступен, поэтому наличие
	// модуля объекта доказывается вызовом его экспортной функции ПравилаЗаписи:
	// у документа без модуля объекта метод не обнаружится. Менеджер документа
	// берётся через Вычислить по имени из метаданных: обход обязан пережить
	// добавление документа в конфигурацию без правки драйвера.
	Попытка
		МенеджерДокумента = Вычислить("Документы." + ИмяДокумента);
		ОбъектДокумента = МенеджерДокумента.СоздатьДокумент();
	Исключение
		Возврат "FAIL: не удалось создать объект документа: " + ОписаниеОшибки();
	КонецПопытки;
	
	Попытка
		// ПравилаЗаписи - чистая функция: пустой незаписанный документ она
		// только осматривает и возвращает массив нарушений.
		Нарушения = ОбъектДокумента.ПравилаЗаписи(ОбъектДокумента);
	Исключение
		Возврат "FAIL: " + ОписаниеОшибки();
	КонецПопытки;
	
	Если ТипЗнч(Нарушения) <> Тип("Массив") Тогда
		Возврат "FAIL: ПравилаЗаписи вернула не массив, а " + ТипЗнч(Нарушения);
	КонецЕсли;
	
	Возврат "OK";
	
КонецФункции

&НаСервере
Процедура ЗаписатьЛог(ПутьОтчёта, Лог)
	
	Если ПустаяСтрока(ПутьОтчёта) Тогда
		Возврат;
	КонецЕсли;
	
	Файл = Новый ЗаписьТекста(ПутьОтчёта, "UTF-8");
	Для Каждого СтрокаЛога Из Лог Цикл
		Файл.ЗаписатьСтроку(СтрокаЛога);
	КонецЦикла;
	Файл.Закрыть();
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьСценарийПроведенияЗаказа(Лог)
	
	// Сценарий «post-order»: документ ЗаказПоставщику при проведении пишет
	// по записи регистра СтатусыПодтверждений на каждую строку услуг со
	// статусом «Отправлен». Проверяются наличие движений, устойчивость к
	// повторному проведению и полная очистка регистра при отмене.
	// Документ берётся из демо-набора, в конце проведение всегда отменяется.
	Провалов = 0;
	
	
	ЗаказСсылка = НайтиНепроведённыйЗаказПоставщику();
	Если ЗаказСсылка = Неопределено Тогда
		Лог.Добавить("ПРОВЕРКА: поиск непроведённого заказа поставщику - FAIL: в базе нет непроведённого заказа с услугами");
		Лог.Добавить("провалено проверок: 1");
		Лог.Добавить("ВЕРДИКТ: FAIL");
		Возврат;
	КонецЕсли;
	
	ОжидаемоеКоличество = КоличествоУникальныхУслуг(ЗаказСсылка.Услуги);
	Лог.Добавить("ПРОВЕРКА: поиск непроведённого заказа поставщику - OK ("
		+ Строка(ЗаказСсылка) + ", движений ожидается: " + ОжидаемоеКоличество + ")");
	
	Результат = ПровестиДокумент(ЗаказСсылка);
	Если СтрНайти(Результат, "FAIL") = 0 И ДокументПроведен(ЗаказСсылка) = Ложь Тогда
		Результат = "FAIL: документ не проведён - платформа отклонила запись";
	КонецЕсли;
	Лог.Добавить("ПРОВЕРКА: проведение заказа поставщику - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Лог.Добавить("провалено проверок: 1");
		Лог.Добавить("ВЕРДИКТ: FAIL");
		Возврат;
	КонецЕсли;
	
	Результат = ПроверитьСтатусыОтправки(ЗаказСсылка, ОжидаемоеКоличество);
	Лог.Добавить("ПРОВЕРКА: движения статусов после проведения - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Провалов = Провалов + 1;
	КонецЕсли;
	
	Результат = ПровестиДокумент(ЗаказСсылка);
	Если СтрНайти(Результат, "FAIL") = 0 Тогда
		Результат = ПроверитьСтатусыОтправки(ЗаказСсылка, ОжидаемоеКоличество);
	КонецЕсли;
	Лог.Добавить("ПРОВЕРКА: повторное проведение не дублирует движения - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Провалов = Провалов + 1;
	КонецЕсли;
	
	Результат = ОтменитьПроведениеДокумента(ЗаказСсылка);
	КоличествоЗаписей = КоличествоЗаписейРегистра("СтатусыПодтверждений", ЗаказСсылка);
	Если СтрНайти(Результат, "FAIL") = 0 Тогда
		Если КоличествоЗаписей > 0 Тогда
			Результат = "FAIL: после отмены осталось записей - " + КоличествоЗаписей;
		Иначе
			Результат = "OK (записей 0)";
		КонецЕсли;
	КонецЕсли;
	Лог.Добавить("ПРОВЕРКА: отмена проведения очищает движения - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Провалов = Провалов + 1;
	КонецЕсли;
	
	ЗаписатьВердикт(Лог, Провалов);
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьСценарийПроведенияПодтверждения(Лог)
	
	// Сценарий «post-confirmation»: документ ПодтверждениеУслуги при проведении
	// пишет статус «Подтверждён» с датой документа и фактические параметры
	// услуг, а при полном подтверждении заказа переводит связанную заявку в
	// статус «Подтверждена». После отмены проведения движения исчезают, а
	// заявка, переведённая этим документом, возвращается в «В работе».
	Провалов = 0;
	
	ДокументСсылка = НайтиНепроведённоеПодтверждение();
	Если ДокументСсылка = Неопределено Тогда
		Лог.Добавить("ПРОВЕРКА: поиск непроведённого подтверждения услуги - FAIL: в базе нет непроведённого подтверждения с услугами");
		Лог.Добавить("провалено проверок: 1");
		Лог.Добавить("ВЕРДИКТ: FAIL");
		Возврат;
	КонецЕсли;
	
	ЗаказСсылка = ДокументСсылка.ЗаказПоставщику;
	ЗаявкаСсылка = Неопределено;
	Если ЗначениеЗаполнено(ЗаказСсылка) Тогда
		ЗаявкаСсылка = ЗаказСсылка.ЗаявкаНаТур;
		Если Не ЗначениеЗаполнено(ЗаявкаСсылка) Тогда
			ЗаявкаСсылка = Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	СтатусЗаявкиДо = Неопределено;
	Если ЗаявкаСсылка <> Неопределено Тогда
		СтатусЗаявкиДо = ЗаявкаСсылка.Статус;
	КонецЕсли;
	
	ОжидаемоеКоличество = КоличествоУникальныхУслуг(ДокументСсылка.ПодтверждённыеУслуги);
	Лог.Добавить("ПРОВЕРКА: поиск непроведённого подтверждения услуги - OK (" + Строка(ДокументСсылка)
		+ ", движений ожидается: " + ОжидаемоеКоличество + ")");
	
	Результат = ПровестиДокумент(ДокументСсылка);
	Если СтрНайти(Результат, "FAIL") = 0 И ДокументПроведен(ДокументСсылка) = Ложь Тогда
		Результат = "FAIL: документ не проведён - платформа отклонила запись";
	КонецЕсли;
	Лог.Добавить("ПРОВЕРКА: проведение подтверждения услуги - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Лог.Добавить("провалено проверок: 1");
		Лог.Добавить("ВЕРДИКТ: FAIL");
		Возврат;
	КонецЕсли;
	
	Результат = ПроверитьСтатусыПодтверждения(ДокументСсылка, ОжидаемоеКоличество);
	Лог.Добавить("ПРОВЕРКА: движения статусов после проведения - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Провалов = Провалов + 1;
	КонецЕсли;
	
	Результат = ПроверитьПараметрыУслуг(ДокументСсылка, ОжидаемоеКоличество);
	Лог.Добавить("ПРОВЕРКА: фактические параметры услуг в регистре - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Провалов = Провалов + 1;
	КонецЕсли;
	
	ВсеПодтверждены = ВсеУслугиЗаказаПодтверждены(ЗаказСсылка);
	СтатусЗаявкиПослеПроведения = Неопределено;
	Если ЗаявкаСсылка = Неопределено Тогда
		Лог.Добавить("ПРОВЕРКА: статус заявки после проведения - FAIL: у документа нет заказа с заявкой");
		Провалов = Провалов + 1;
	Иначе
		СтатусЗаявкиПослеПроведения = ЗаявкаСсылка.Статус;
		ОжидаемыйСтатус = ?(ВсеПодтверждены, Перечисления.СтатусыЗаявок.Подтверждена, СтатусЗаявкиДо);
		Если СтатусЗаявкиПослеПроведения = ОжидаемыйСтатус Тогда
			Лог.Добавить("ПРОВЕРКА: статус заявки после проведения - OK (" + Строка(СтатусЗаявкиПослеПроведения)
				+ ?(ВсеПодтверждены, "; подтверждены все услуги заказа", "; подтверждены не все услуги заказа") + ")");
		Иначе
			Лог.Добавить("ПРОВЕРКА: статус заявки после проведения - FAIL: " + Строка(СтатусЗаявкиПослеПроведения)
				+ ", ожидался " + Строка(ОжидаемыйСтатус));
			Провалов = Провалов + 1;
		КонецЕсли;
	КонецЕсли;
	
	Результат = ОтменитьПроведениеДокумента(ДокументСсылка);
	КоличествоСтатусов = КоличествоЗаписейРегистра("СтатусыПодтверждений", ДокументСсылка);
	КоличествоПараметров = КоличествоЗаписейРегистра("ПараметрыУслуг", ДокументСсылка);
	Если СтрНайти(Результат, "FAIL") = 0 Тогда
		Если КоличествоСтатусов > 0 Или КоличествоПараметров > 0 Тогда
			Результат = "FAIL: после отмены осталось статусов " + КоличествоСтатусов
				+ ", параметров " + КоличествоПараметров;
		Иначе
			Результат = "OK (записей 0)";
		КонецЕсли;
	КонецЕсли;
	Лог.Добавить("ПРОВЕРКА: отмена проведения очищает движения - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Провалов = Провалов + 1;
	КонецЕсли;
	
	Если ЗаявкаСсылка <> Неопределено Тогда
		ВсеПодтвержденыПослеОтмены = ВсеУслугиЗаказаПодтверждены(ЗаказСсылка);
		Если ВсеПодтвержденыПослеОтмены Тогда
			ОжидаемыйСтатус = Перечисления.СтатусыЗаявок.Подтверждена;
		ИначеЕсли СтатусЗаявкиПослеПроведения = Перечисления.СтатусыЗаявок.Подтверждена Тогда
			ОжидаемыйСтатус = Перечисления.СтатусыЗаявок.ВРаботе;
		Иначе
			ОжидаемыйСтатус = СтатусЗаявкиДо;
		КонецЕсли;
		
		ФактическийСтатус = ЗаявкаСсылка.Статус;
		Если ФактическийСтатус = ОжидаемыйСтатус Тогда
			Лог.Добавить("ПРОВЕРКА: возврат статуса заявки после отмены - OK (" + Строка(ФактическийСтатус) + ")");
		Иначе
			Лог.Добавить("ПРОВЕРКА: возврат статуса заявки после отмены - FAIL: " + Строка(ФактическийСтатус)
				+ ", ожидался " + Строка(ОжидаемыйСтатус));
			Провалов = Провалов + 1;
		КонецЕсли;
	Иначе
		Лог.Добавить("ПРОВЕРКА: возврат статуса заявки после отмены - FAIL: заявка не определена");
		Провалов = Провалов + 1;
	КонецЕсли;
	
	ЗаписатьВердикт(Лог, Провалов);
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьВердикт(Лог, Провалов)
	
	Если Провалов > 0 Тогда
		Лог.Добавить("провалено проверок: " + Провалов);
		Лог.Добавить("ВЕРДИКТ: FAIL");
	Иначе
		Лог.Добавить("ВЕРДИКТ: PASS");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция НайтиНепроведённыйЗаказПоставщику()
	
	// Демо-набор используется как есть: сценарий ничего не создаёт, чтобы
	// прогон не засорял базу и был повторяемым. Проведённость читается
	// запросом: у выборки документов это поле недоступно.
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Заказы.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ЗаказПоставщику КАК Заказы
		|ГДЕ
		|	Заказы.Проведен = ЛОЖЬ
		|	И Заказы.ПометкаУдаления = ЛОЖЬ
		|УПОРЯДОЧИТЬ ПО
		|	Заказы.Дата";
	
	Для Каждого Запись Из Запрос.Выполнить().Выгрузить() Цикл
		Если Запись.Ссылка.Услуги.Количество() > 0 Тогда
			Возврат Запись.Ссылка;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Функция НайтиНепроведённоеПодтверждение()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Подтверждения.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ПодтверждениеУслуги КАК Подтверждения
		|ГДЕ
		|	Подтверждения.Проведен = ЛОЖЬ
		|	И Подтверждения.ПометкаУдаления = ЛОЖЬ
		|УПОРЯДОЧИТЬ ПО
		|	Подтверждения.Дата";
	
	Для Каждого Запись Из Запрос.Выполнить().Выгрузить() Цикл
		Если Запись.Ссылка.ПодтверждённыеУслуги.Количество() > 0 Тогда
			Возврат Запись.Ссылка;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Функция ДокументПроведен(ДокументСсылка)
	
	// Признак проведения читается в Попытке: сам факт проведения проверяется
	// дополнительно к отсутствию ошибки записи, но сбой чтения не должен
	// подменять вердикт сценария текстом исключения.
	Попытка
		Возврат ДокументСсылка.Проведен;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

&НаСервере
Функция КоличествоУникальныхУслуг(СтрокиУслуг)
	
	// Запись регистра уникальна по измерениям (ЗаказПоставщику, Услуга),
	// поэтому две строки документа с одной и той же услугой дают одну запись.
	Уникальные = Новый Соответствие;
	Для Каждого СтрокаУслуги Из СтрокиУслуг Цикл
		Уникальные.Вставить(СтрокаУслуги.Услуга, Истина);
	КонецЦикла;
	
	Возврат Уникальные.Количество();
	
КонецФункции

&НаСервере
Функция ПровестиДокумент(ДокументСсылка)
	
	Попытка
		ОбъектДокумента = ДокументСсылка.ПолучитьОбъект();
		ОбъектДокумента.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Возврат "FAIL: " + ОписаниеОшибки();
	КонецПопытки;
	
	Возврат "OK";
	
КонецФункции

&НаСервере
Функция ОтменитьПроведениеДокумента(ДокументСсылка)
	
	Попытка
		ОбъектДокумента = ДокументСсылка.ПолучитьОбъект();
		ОбъектДокумента.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	Исключение
		Возврат "FAIL: " + ОписаниеОшибки();
	КонецПопытки;
	
	Возврат "OK";
	
КонецФункции

&НаСервере
Функция ПроверитьСтатусыОтправки(ЗаказСсылка, ОжидаемоеКоличество)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Статусы.Статус КАК Статус,
		|	Статусы.ДатаПодтверждения КАК ДатаПодтверждения
		|ИЗ
		|	РегистрСведений.СтатусыПодтверждений КАК Статусы
		|ГДЕ
		|	Статусы.Регистратор = &Регистратор";
	Запрос.УстановитьПараметр("Регистратор", ЗаказСсылка);
	ТаблицаЗаписей = Запрос.Выполнить().Выгрузить();
	
	Если ТаблицаЗаписей.Количество() <> ОжидаемоеКоличество Тогда
		Возврат "FAIL: записей " + ТаблицаЗаписей.Количество() + ", ожидалось " + ОжидаемоеКоличество;
	КонецЕсли;
	
	Для Каждого Запись Из ТаблицаЗаписей Цикл
		Если Запись.Статус <> Перечисления.СтатусыЗаказа.Отправлен Тогда
			Возврат "FAIL: статус " + Строка(Запись.Статус) + ", ожидался Отправлен";
		КонецЕсли;
		Если ЗначениеЗаполнено(Запись.ДатаПодтверждения) Тогда
			Возврат "FAIL: дата подтверждения заполнена: " + Формат(Запись.ДатаПодтверждения, "ДЛФ=DT");
		КонецЕсли;
	КонецЦикла;
	
	Возврат "OK (" + ТаблицаЗаписей.Количество() + " записей со статусом Отправлен)";
	
КонецФункции

&НаСервере
Функция ПроверитьСтатусыПодтверждения(ДокументСсылка, ОжидаемоеКоличество)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Статусы.Статус КАК Статус,
		|	Статусы.ДатаПодтверждения КАК ДатаПодтверждения
		|ИЗ
		|	РегистрСведений.СтатусыПодтверждений КАК Статусы
		|ГДЕ
		|	Статусы.Регистратор = &Регистратор";
	Запрос.УстановитьПараметр("Регистратор", ДокументСсылка);
	ТаблицаЗаписей = Запрос.Выполнить().Выгрузить();
	
	Если ТаблицаЗаписей.Количество() <> ОжидаемоеКоличество Тогда
		Возврат "FAIL: записей " + ТаблицаЗаписей.Количество() + ", ожидалось " + ОжидаемоеКоличество;
	КонецЕсли;
	
	Для Каждого Запись Из ТаблицаЗаписей Цикл
		Если Запись.Статус <> Перечисления.СтатусыЗаказа.Подтверждён Тогда
			Возврат "FAIL: статус " + Строка(Запись.Статус) + ", ожидался Подтверждён";
		КонецЕсли;
		Если Запись.ДатаПодтверждения <> ДокументСсылка.Дата Тогда
			Возврат "FAIL: дата подтверждения " + Формат(Запись.ДатаПодтверждения, "ДЛФ=DT")
				+ ", ожидалась дата документа " + Формат(ДокументСсылка.Дата, "ДЛФ=DT");
		КонецЕсли;
	КонецЦикла;
	
	Возврат "OK (" + ТаблицаЗаписей.Количество() + " записей со статусом Подтверждён)";
	
КонецФункции

&НаСервере
Функция ПроверитьПараметрыУслуг(ДокументСсылка, ОжидаемоеКоличество)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Параметры.Услуга КАК Услуга,
		|	Параметры.ТипНомера КАК ТипНомера,
		|	Параметры.ТипПитания КАК ТипПитания,
		|	Параметры.Количество КАК Количество
		|ИЗ
		|	РегистрСведений.ПараметрыУслуг КАК Параметры
		|ГДЕ
		|	Параметры.Регистратор = &Регистратор";
	Запрос.УстановитьПараметр("Регистратор", ДокументСсылка);
	ТаблицаЗаписей = Запрос.Выполнить().Выгрузить();
	
	Если ТаблицаЗаписей.Количество() <> ОжидаемоеКоличество Тогда
		Возврат "FAIL: записей " + ТаблицаЗаписей.Количество() + ", ожидалось " + ОжидаемоеКоличество;
	КонецЕсли;
	
	Для Каждого СтрокаУслуги Из ДокументСсылка.ПодтверждённыеУслуги Цикл
		ЗаписьРегистра = ТаблицаЗаписей.Найти(СтрокаУслуги.Услуга, "Услуга");
		Если ЗаписьРегистра = Неопределено Тогда
			Возврат "FAIL: нет записи параметров по услуге " + Строка(СтрокаУслуги.Услуга);
		КонецЕсли;
		Если ЗаписьРегистра.ТипНомера <> СтрокаУслуги.ТипНомераФакт Тогда
			Возврат "FAIL: тип номера по услуге " + Строка(СтрокаУслуги.Услуга) + " - "
				+ Строка(ЗаписьРегистра.ТипНомера) + ", ожидался " + Строка(СтрокаУслуги.ТипНомераФакт);
		КонецЕсли;
		Если ЗаписьРегистра.ТипПитания <> СтрокаУслуги.ТипПитанияФакт Тогда
			Возврат "FAIL: тип питания по услуге " + Строка(СтрокаУслуги.Услуга) + " - "
				+ Строка(ЗаписьРегистра.ТипПитания) + ", ожидался " + Строка(СтрокаУслуги.ТипПитанияФакт);
		КонецЕсли;
		Если ЗаписьРегистра.Количество <> СтрокаУслуги.Количество Тогда
			Возврат "FAIL: количество по услуге " + Строка(СтрокаУслуги.Услуга) + " - "
				+ ЗаписьРегистра.Количество + ", ожидалось " + СтрокаУслуги.Количество;
		КонецЕсли;
	КонецЦикла;
	
	Возврат "OK (" + ТаблицаЗаписей.Количество() + " записей)";
	
КонецФункции

&НаСервере
Функция КоличествоЗаписейРегистра(ИмяРегистра, РегистраторСсылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ РегистрСведений." + ИмяРегистра + " КАК Записи
		|ГДЕ Записи.Регистратор = &Регистратор";
	Запрос.УстановитьПараметр("Регистратор", РегистраторСсылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.Количество;
	
КонецФункции

&НаСервере
Функция ВсеУслугиЗаказаПодтверждены(ЗаказСсылка)
	
	// Повторяет правило общего модуля: услуга подтверждена, если по заказу
	// есть запись регистра со статусом «Подтверждён».
	Если Не ЗначениеЗаполнено(ЗаказСсылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ЗаказСсылка.Услуги.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Статусы.Услуга КАК Услуга
		|ИЗ
		|	РегистрСведений.СтатусыПодтверждений КАК Статусы
		|ГДЕ
		|	Статусы.ЗаказПоставщику = &ЗаказПоставщику
		|	И Статусы.Статус = &Статус";
	Запрос.УстановитьПараметр("ЗаказПоставщику", ЗаказСсылка);
	Запрос.УстановитьПараметр("Статус", Перечисления.СтатусыЗаказа.Подтверждён);
	
	Подтверждённые = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаЗаказа Из ЗаказСсылка.Услуги Цикл
		Если Подтверждённые.Найти(СтрокаЗаказа.Услуга, "Услуга") = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

// Диагностика блокировок: ставит разделяемую блокировку регистра внутри
// явной транзакции и фиксирует результат. Нужна, чтобы отделить проблему
// механизма блокировок от проблемы проведения документа.
&НаСервере
Процедура ВыполнитьПробуБлокировки(Лог)
	
	Провалов = 0;
	
	Попытка
		НачатьТранзакцию();
		Попытка
			Области = Новый Массив;
			Области.Добавить("РегистрСведений.СтатусыПодтверждений");
			ПроведениеДокументов.ЗаблокироватьРегистры(Области);
			Лог.Добавить("ПРОВЕРКА: блокировка регистра в транзакции - OK");
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			Лог.Добавить("ПРОВЕРКА: блокировка регистра в транзакции - FAIL: " + ОписаниеОшибки());
			Провалов = Провалов + 1;
		КонецПопытки;
	Исключение
		Лог.Добавить("ПРОВЕРКА: блокировка регистра в транзакции - FAIL: " + ОписаниеОшибки());
		Провалов = Провалов + 1;
	КонецПопытки;
	
	ЗаписатьВердикт(Лог, Провалов);
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьСценарийПроведенияМаршрутногоЛиста(Лог)
	
	// Сценарий «post-route»: документ МаршрутныйЛист при проведении пишет
	// в регистр сведений ГрафикПеремещений по записи на каждое связанное
	// событие маршрута (документ СобытиеМаршрута). Проверяются состав и
	// времена записей, устойчивость к повторному проведению и полная
	// очистка графика при отмене. Маршрутный лист берётся из демо-набора,
	// в конце проведение всегда отменяется.
	Провалов = 0;
	
	ЛистСсылка = НайтиНепроведённыйМаршрутныйЛист();
	Если ЛистСсылка = Неопределено Тогда
		Лог.Добавить("ПРОВЕРКА: поиск непроведённого маршрутного листа - FAIL: в базе нет непроведённого маршрутного листа с событиями");
		Лог.Добавить("провалено проверок: 1");
		Лог.Добавить("ВЕРДИКТ: FAIL");
		Возврат;
	КонецЕсли;
	
	ОжидаемоеКоличество = КоличествоСобытийМаршрута(ЛистСсылка);
	Лог.Добавить("ПРОВЕРКА: поиск непроведённого маршрутного листа - OK ("
		+ Строка(ЛистСсылка) + ", движений ожидается: " + ОжидаемоеКоличество + ")");
	
	Результат = ПровестиДокумент(ЛистСсылка);
	Если СтрНайти(Результат, "FAIL") = 0 И ДокументПроведен(ЛистСсылка) = Ложь Тогда
		Результат = "FAIL: документ не проведён - платформа отклонила запись";
	КонецЕсли;
	Лог.Добавить("ПРОВЕРКА: проведение маршрутного листа - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Лог.Добавить("провалено проверок: 1");
		Лог.Добавить("ВЕРДИКТ: FAIL");
		Возврат;
	КонецЕсли;
	
	Результат = ПроверитьДвиженияГрафика(ЛистСсылка, ОжидаемоеКоличество);
	Лог.Добавить("ПРОВЕРКА: движения графика перемещений после проведения - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Провалов = Провалов + 1;
	КонецЕсли;
	
	Результат = ПровестиДокумент(ЛистСсылка);
	Если СтрНайти(Результат, "FAIL") = 0 Тогда
		Результат = ПроверитьДвиженияГрафика(ЛистСсылка, ОжидаемоеКоличество);
	КонецЕсли;
	Лог.Добавить("ПРОВЕРКА: повторное проведение не дублирует движения - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Провалов = Провалов + 1;
	КонецЕсли;
	
	Результат = ОтменитьПроведениеДокумента(ЛистСсылка);
	КоличествоЗаписей = КоличествоЗаписейРегистра("ГрафикПеремещений", ЛистСсылка);
	Если СтрНайти(Результат, "FAIL") = 0 Тогда
		Если КоличествоЗаписей > 0 Тогда
			Результат = "FAIL: после отмены осталось записей - " + КоличествоЗаписей;
		Иначе
			Результат = "OK (записей 0)";
		КонецЕсли;
	КонецЕсли;
	Лог.Добавить("ПРОВЕРКА: отмена проведения очищает движения - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Провалов = Провалов + 1;
	КонецЕсли;
	
	ЗаписатьВердикт(Лог, Провалов);
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьСценарийПроведенияКорректировкиМаршрута(Лог)
	
	// Сценарий «post-route-correction»: документ КорректировкаМаршрута при
	// проведении заменяет времена изменённых событий в графике перемещений
	// и переносит новое время в документы событий, при отмене проведения
	// возвращает прежние времена. Проверяются времена записей регистра,
	// времена документов событий и пересчёт буферов между событиями.
	// Документы берутся из демо-набора, в конце состояние восстанавливается.
	Провалов = 0;
	
	КорректировкаСсылка = НайтиНепроведённуюКорректировку();
	Если КорректировкаСсылка = Неопределено Тогда
		Лог.Добавить("ПРОВЕРКА: поиск непроведённой корректировки маршрута - FAIL: в базе нет непроведённой согласованной корректировки с изменениями");
		Лог.Добавить("провалено проверок: 1");
		Лог.Добавить("ВЕРДИКТ: FAIL");
		Возврат;
	КонецЕсли;
	
	ЛистСсылка = КорректировкаСсылка.МаршрутныйЛист;
	ЛистБылПроведён = ДокументПроведен(ЛистСсылка) = Истина;
	
	// График перемещений строится маршрутным листом, поэтому лист проводится
	// (или перепроводится) в любом случае: записи графика обязаны содержать
	// все текущие события, иначе корректировке нечего менять.
	Результат = ПровестиДокумент(ЛистСсылка);
	Если СтрНайти(Результат, "FAIL") > 0 Или ДокументПроведен(ЛистСсылка) <> Истина Тогда
		Если Не ЛистБылПроведён Тогда
			ОтменитьПроведениеДокумента(ЛистСсылка);
		КонецЕсли;
		Лог.Добавить("ПРОВЕРКА: проведение маршрутного листа корректировки - FAIL: " + Результат);
		Лог.Добавить("провалено проверок: 1");
		Лог.Добавить("ВЕРДИКТ: FAIL");
		Возврат;
	КонецЕсли;
	Лог.Добавить("ПРОВЕРКА: поиск непроведённой корректировки маршрута - OK ("
		+ Строка(КорректировкаСсылка) + ", маршрутный лист: " + Строка(ЛистСсылка) + ")");
	
	// Прежние времена изменённых событий запоминаются до проведения:
	// по ним сверяется откат корректировки.
	ВременаДо = Новый Соответствие;
	Для Каждого СтрокаИзменения Из КорректировкаСсылка.Изменения Цикл
		ВременаДо.Вставить(СтрокаИзменения.СобытиеМаршрута,
			ВремяЗаписиГрафикаПоСобытию(СтрокаИзменения.СобытиеМаршрута));
	КонецЦикла;
	
	Результат = ПровестиДокумент(КорректировкаСсылка);
	Если СтрНайти(Результат, "FAIL") = 0 И ДокументПроведен(КорректировкаСсылка) = Ложь Тогда
		Результат = "FAIL: документ не проведён - платформа отклонила запись";
	КонецЕсли;
	Лог.Добавить("ПРОВЕРКА: проведение корректировки маршрута - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Провалов = Провалов + 1;
	КонецЕсли;
	
	Если СтрНайти(Результат, "FAIL") = 0 Тогда
		РезультатЗаписи = ПроверитьСохранениеСтарогоВремени(КорректировкаСсылка);
		Лог.Добавить("ПРОВЕРКА: прежнее время сохранено в базе - " + РезультатЗаписи);
		Если СтрНайти(РезультатЗаписи, "FAIL") > 0 Тогда
			Провалов = Провалов + 1;
		КонецЕсли;
	КонецЕсли;
	
	Если СтрНайти(Результат, "FAIL") = 0 Тогда
		
		Результат = ПроверитьНовыеВремена(КорректировкаСсылка);
		Лог.Добавить("ПРОВЕРКА: новые времена событий в графике и документах - " + Результат);
		Если СтрНайти(Результат, "FAIL") > 0 Тогда
			Провалов = Провалов + 1;
		КонецЕсли;
		
		Результат = ПроверитьБуферыСобытий(ЛистСсылка);
		Лог.Добавить("ПРОВЕРКА: пересчёт буферов между событиями - " + Результат);
		Если СтрНайти(Результат, "FAIL") > 0 Тогда
			Провалов = Провалов + 1;
		КонецЕсли;
		
	КонецЕсли;
	
	ОтменаРезультат = ОтменитьПроведениеДокумента(КорректировкаСсылка);
	Лог.Добавить("ПРОВЕРКА: отмена проведения корректировки - " + ОтменаРезультат);
	Если СтрНайти(ОтменаРезультат, "FAIL") > 0 Тогда
		Провалов = Провалов + 1;
	Иначе
		Результат = ПроверитьВосстановленныеВремена(КорректировкаСсылка, ВременаДо);
		Лог.Добавить("ПРОВЕРКА: отмена корректировки возвращает прежние времена - " + Результат);
		Если СтрНайти(Результат, "FAIL") > 0 Тогда
			Провалов = Провалов + 1;
		КонецЕсли;
	КонецЕсли;
	
	// Демо-набор возвращается в исходное состояние: если маршрутный лист
	// до сценария проведён не был, его проведение отменяется.
	Если Не ЛистБылПроведён Тогда
		ОтменитьПроведениеДокумента(ЛистСсылка);
	КонецЕсли;
	
	ЗаписатьВердикт(Лог, Провалов);
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьСценарийПроведенияСобытияМаршрута(Лог)
	
	// Сценарий «post-event»: событие маршрута проводится без движений
	// (решение D3) - график перемещений принадлежит маршрутному листу.
	// Проверяется, что проведение и отмена проведения события не меняют
	// число записей регистра ГрафикПеремещений и не создают записей
	// с регистратором-событием. Событие берётся из демо-набора, в конце
	// проведение отменяется.
	Провалов = 0;
	
	СобытиеСсылка = НайтиНепроведённоеСобытиеМаршрута();
	Если СобытиеСсылка = Неопределено Тогда
		Лог.Добавить("ПРОВЕРКА: поиск непроведённого события маршрута - FAIL: в базе нет непроведённого события маршрута");
		Лог.Добавить("провалено проверок: 1");
		Лог.Добавить("ВЕРДИКТ: FAIL");
		Возврат;
	КонецЕсли;
	
	ЗаписейДо = КоличествоЗаписейГрафикаВсего();
	Лог.Добавить("ПРОВЕРКА: поиск непроведённого события маршрута - OK ("
		+ Строка(СобытиеСсылка) + ", записей графика до: " + ЗаписейДо + ")");
	
	Результат = ПровестиДокумент(СобытиеСсылка);
	Если СтрНайти(Результат, "FAIL") = 0 И ДокументПроведен(СобытиеСсылка) = Ложь Тогда
		Результат = "FAIL: документ не проведён - платформа отклонила запись";
	КонецЕсли;
	Лог.Добавить("ПРОВЕРКА: проведение события маршрута - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Лог.Добавить("провалено проверок: 1");
		Лог.Добавить("ВЕРДИКТ: FAIL");
		Возврат;
	КонецЕсли;
	
	ЗаписейПосле = КоличествоЗаписейГрафикаВсего();
	СвоихДвижений = КоличествоЗаписейРегистра("ГрафикПеремещений", СобытиеСсылка);
	Если ЗаписейПосле <> ЗаписейДо Или СвоихДвижений > 0 Тогда
		Результат = "FAIL: записей графика было " + ЗаписейДо + ", стало " + ЗаписейПосле
			+ "; движений с регистратором-событием: " + СвоихДвижений;
	Иначе
		Результат = "OK (записей графика " + ЗаписейПосле + ", движений события 0)";
	КонецЕсли;
	Лог.Добавить("ПРОВЕРКА: проведение события не пишет движений графика - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Провалов = Провалов + 1;
	КонецЕсли;
	
	Результат = ОтменитьПроведениеДокумента(СобытиеСсылка);
	ЗаписейПослеОтмены = КоличествоЗаписейГрафикаВсего();
	Если СтрНайти(Результат, "FAIL") = 0 Тогда
		Если ЗаписейПослеОтмены <> ЗаписейДо Тогда
			Результат = "FAIL: записей графика было " + ЗаписейДо + ", после отмены " + ЗаписейПослеОтмены;
		Иначе
			Результат = "OK (записей графика " + ЗаписейПослеОтмены + ")";
		КонецЕсли;
	КонецЕсли;
	Лог.Добавить("ПРОВЕРКА: отмена проведения события не меняет график - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Провалов = Провалов + 1;
	КонецЕсли;
	
	ЗаписатьВердикт(Лог, Провалов);
	
КонецПроцедуры

&НаСервере
Функция НайтиНепроведённыйМаршрутныйЛист()
	
	// Демо-набор используется как есть: сценарий ничего не создаёт, чтобы
	// прогон не засорял базу и был повторяемым. Подходит только лист
	// с событиями: пустой график не доказал бы работу проведения.
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Листы.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.МаршрутныйЛист КАК Листы
		|ГДЕ
		|	Листы.Проведен = ЛОЖЬ
		|	И Листы.ПометкаУдаления = ЛОЖЬ
		|УПОРЯДОЧИТЬ ПО
		|	Листы.Дата";
	
	Для Каждого Запись Из Запрос.Выполнить().Выгрузить() Цикл
		Если КоличествоСобытийМаршрута(Запись.Ссылка) > 0 Тогда
			Возврат Запись.Ссылка;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Функция КоличествоСобытийМаршрута(ЛистСсылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ Документ.СобытиеМаршрута КАК События
		|ГДЕ События.МаршрутныйЛист = &МаршрутныйЛист
		|	И События.ПометкаУдаления = ЛОЖЬ";
	Запрос.УстановитьПараметр("МаршрутныйЛист", ЛистСсылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.Количество;
	
КонецФункции

&НаСервере
Функция ПроверитьДвиженияГрафика(ЛистСсылка, ОжидаемоеКоличество)
	
	// Сверяет записи графика с событиями маршрутного листа: по одной записи
	// на событие, время начала совпадает с плановым временем события,
	// длительность и окончание согласованы, период - начало дня даты листа.
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	График.СобытиеМаршрута КАК СобытиеМаршрута,
		|	График.Период КАК Период,
		|	График.ДатаВремяНачалаUTC КАК ДатаВремяНачалаUTC,
		|	График.ДатаВремяОкончанияUTC КАК ДатаВремяОкончанияUTC,
		|	График.ДлительностьМинут КАК ДлительностьМинут
		|ИЗ
		|	РегистрСведений.ГрафикПеремещений КАК График
		|ГДЕ
		|	График.Регистратор = &Регистратор";
	Запрос.УстановитьПараметр("Регистратор", ЛистСсылка);
	Записи = Запрос.Выполнить().Выгрузить();
	
	Если Записи.Количество() <> ОжидаемоеКоличество Тогда
		Возврат "FAIL: записей " + Записи.Количество() + ", ожидалось " + ОжидаемоеКоличество;
	КонецЕсли;
	
	ОжидаемыйПериод = НачалоДня(ЛистСсылка.Дата);
	ЗапросСобытий = Новый Запрос;
	ЗапросСобытий.Текст =
		"ВЫБРАТЬ
		|	События.Ссылка КАК Ссылка,
		|	События.ДатаВремяUTC КАК ДатаВремяUTC,
		|	События.ДлительностьМинут КАК ДлительностьМинут
		|ИЗ
		|	Документ.СобытиеМаршрута КАК События
		|ГДЕ
		|	События.МаршрутныйЛист = &МаршрутныйЛист
		|	И События.ПометкаУдаления = ЛОЖЬ";
	ЗапросСобытий.УстановитьПараметр("МаршрутныйЛист", ЛистСсылка);
	
	Для Каждого Событие Из ЗапросСобытий.Выполнить().Выгрузить() Цикл
		Запись = Записи.Найти(Событие.Ссылка, "СобытиеМаршрута");
		Если Запись = Неопределено Тогда
			Возврат "FAIL: нет записи графика по событию " + Строка(Событие.Ссылка);
		КонецЕсли;
		Если Запись.Период <> ОжидаемыйПериод Тогда
			Возврат "FAIL: период записи " + Формат(Запись.Период, "ДФ=dd.MM.yyyy")
				+ ", ожидался " + Формат(ОжидаемыйПериод, "ДФ=dd.MM.yyyy");
		КонецЕсли;
		Если Запись.ДатаВремяНачалаUTC <> Событие.ДатаВремяUTC Тогда
			Возврат "FAIL: время начала по событию " + Строка(Событие.Ссылка) + " - "
				+ Формат(Запись.ДатаВремяНачалаUTC, "ДФ=dd.MM.yyyy HH:mm:ss") + ", ожидалось "
				+ Формат(Событие.ДатаВремяUTC, "ДФ=dd.MM.yyyy HH:mm:ss");
		КонецЕсли;
		Если Запись.ДлительностьМинут <> Событие.ДлительностьМинут Тогда
			Возврат "FAIL: длительность по событию " + Строка(Событие.Ссылка) + " - "
				+ Запись.ДлительностьМинут + ", ожидалась " + Событие.ДлительностьМинут;
		КонецЕсли;
		ОжидаемоеОкончание = Событие.ДатаВремяUTC + Событие.ДлительностьМинут * 60;
		Если Запись.ДатаВремяОкончанияUTC <> ОжидаемоеОкончание Тогда
			Возврат "FAIL: время окончания по событию " + Строка(Событие.Ссылка) + " - "
				+ Формат(Запись.ДатаВремяОкончанияUTC, "ДФ=dd.MM.yyyy HH:mm:ss") + ", ожидалось "
				+ Формат(ОжидаемоеОкончание, "ДФ=dd.MM.yyyy HH:mm:ss");
		КонецЕсли;
	КонецЦикла;
	
	Возврат "OK (" + Записи.Количество() + " записей по событиям маршрута)";
	
КонецФункции

&НаСервере
Функция НайтиНепроведённуюКорректировку()
	
	// Подходит согласованная корректировка с заполненными изменениями, все
	// события которой принадлежат её маршрутному листу: только такую
	// проведение сможет применить к графику перемещений листа.
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Корректировки.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.КорректировкаМаршрута КАК Корректировки
		|ГДЕ
		|	Корректировки.Проведен = ЛОЖЬ
		|	И Корректировки.ПометкаУдаления = ЛОЖЬ
		|	И Корректировки.Согласовано = ИСТИНА
		|УПОРЯДОЧИТЬ ПО
		|	Корректировки.Дата";
	
	Для Каждого Запись Из Запрос.Выполнить().Выгрузить() Цикл
		Корректировка = Запись.Ссылка;
		Если Не ЗначениеЗаполнено(Корректировка.МаршрутныйЛист) Тогда
			Продолжить;
		КонецЕсли;
		Если Корректировка.Изменения.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Годна = Истина;
		Для Каждого СтрокаИзменения Из Корректировка.Изменения Цикл
			Если Не ЗначениеЗаполнено(СтрокаИзменения.СобытиеМаршрута)
				Или Не ЗначениеЗаполнено(СтрокаИзменения.НовоеВремяUTC) Тогда
				Годна = Ложь;
				Прервать;
			КонецЕсли;
			Если СтрокаИзменения.СобытиеМаршрута.МаршрутныйЛист <> Корректировка.МаршрутныйЛист Тогда
				Годна = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если Годна Тогда
			Возврат Корректировка;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

