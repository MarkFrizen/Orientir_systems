&НаСервере
Процедура ВыполнитьСценарийПроведенияЗаявкиТуриста(Лог)
	
	// Сценарий «post-tourist-request»: документ ЗаявкаТуристаНаМаршруте при
	// проведении пишет в регистр ИсторияОбработокЗапросов одну запись с
	// действием «Регистрация», инициатором запроса и датой документа, а при
	// критическом уровне критичности типа запроса создаёт ответственному
	// задачу эскалации. Проверяются состав записи, отсутствие дублей при
	// повторном проведении и полная очистка при отмене: запись истории
	// удаляется, невыполненная задача эскалации помечается на удаление.
	// Заявка берётся из демо-набора, в конце проведение всегда отменяется.
	Провалов = 0;
	
	ЗаявкаСсылка = НайтиНепроведённуюЗаявкуТуриста();
	Если ЗаявкаСсылка = Неопределено Тогда
		Лог.Добавить("ПРОВЕРКА: поиск непроведённой заявки туриста - FAIL: в базе нет непроведённой заявки, проходящей правила записи");
		Лог.Добавить("провалено проверок: 1");
		Лог.Добавить("ВЕРДИКТ: FAIL");
		Возврат;
	КонецЕсли;
	
	Критическая = ЗапросКритический(ЗаявкаСсылка);
	Лог.Добавить("ПРОВЕРКА: поиск непроведённой заявки туриста - OK (" + Строка(ЗаявкаСсылка)
		+ ?(Критическая, "; тип запроса критический", "; тип запроса некритический") + ")");
	
	Результат = ПровестиДокумент(ЗаявкаСсылка);
	Если СтрНайти(Результат, "FAIL") = 0 И ДокументПроведен(ЗаявкаСсылка) = Ложь Тогда
		Результат = "FAIL: документ не проведён - платформа отклонила запись";
	КонецЕсли;
	Лог.Добавить("ПРОВЕРКА: проведение заявки туриста - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Лог.Добавить("провалено проверок: 1");
		Лог.Добавить("ВЕРДИКТ: FAIL");
		Возврат;
	КонецЕсли;
	
	Результат = ПроверитьЗаписьИсторииОбработки(ЗаявкаСсылка);
	Лог.Добавить("ПРОВЕРКА: запись истории обработок после проведения - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Провалов = Провалов + 1;
	КонецЕсли;
	
	ЗадачДо = 0;
	Если Критическая Тогда
		ЗадачДо = КоличествоЗадачЭскалации(ЗаявкаСсылка);
		Если ЗадачДо = 0 Тогда
			Результат = "FAIL: задача эскалации критического запроса не создана";
		Иначе
			Результат = "OK (невыполненных задач эскалации: " + ЗадачДо + ")";
		КонецЕсли;
		Лог.Добавить("ПРОВЕРКА: задача эскалации после проведения - " + Результат);
		Если СтрНайти(Результат, "FAIL") > 0 Тогда
			Провалов = Провалов + 1;
		КонецЕсли;
	КонецЕсли;
	
	Результат = ПровестиДокумент(ЗаявкаСсылка);
	Если СтрНайти(Результат, "FAIL") = 0 Тогда
		Результат = ПроверитьЗаписьИсторииОбработки(ЗаявкаСсылка);
		Если СтрНайти(Результат, "FAIL") = 0 И Критическая Тогда
			ЗадачПосле = КоличествоЗадачЭскалации(ЗаявкаСсылка);
			Если ЗадачПосле <> ЗадачДо Тогда
				Результат = "FAIL: невыполненных задач эскалации стало " + ЗадачПосле + ", ожидалось " + ЗадачДо;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Лог.Добавить("ПРОВЕРКА: повторное проведение не дублирует движения и задачи - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Провалов = Провалов + 1;
	КонецЕсли;
	
	Результат = ОтменитьПроведениеДокумента(ЗаявкаСсылка);
	КоличествоЗаписей = КоличествоЗаписейРегистра("ИсторияОбработокЗапросов", ЗаявкаСсылка);
	Если СтрНайти(Результат, "FAIL") = 0 Тогда
		Если КоличествоЗаписей > 0 Тогда
			Результат = "FAIL: после отмены осталось записей истории - " + КоличествоЗаписей;
		ИначеЕсли Критическая И КоличествоЗадачЭскалации(ЗаявкаСсылка) > 0 Тогда
			Результат = "FAIL: после отмены остались невыполненные задачи эскалации";
		Иначе
			Результат = "OK (записей истории 0"
				+ ?(Критическая, ", задача эскалации снята", "") + ")";
		КонецЕсли;
	КонецЕсли;
	Лог.Добавить("ПРОВЕРКА: отмена проведения очищает историю и задачи - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Провалов = Провалов + 1;
	КонецЕсли;
	
	ЗаписатьВердикт(Лог, Провалов);
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьСценарийПроведенияИнцидента(Лог)
	
	// Сценарий «post-incident»: документ Инцидент при проведении пишет в
	// регистр СтатусыИнцидентов одну запись со статусом «Открыт»,
	// ответственным из документа и датой документа. Проверяются состав
	// записи, отсутствие дублей при повторном проведении и полная очистка
	// регистра при отмене. Инцидент берётся из демо-набора, в конце
	// проведение всегда отменяется.
	Провалов = 0;
	
	ИнцидентСсылка = НайтиНепроведённыйИнцидент();
	Если ИнцидентСсылка = Неопределено Тогда
		Лог.Добавить("ПРОВЕРКА: поиск непроведённого инцидента - FAIL: в базе нет непроведённого инцидента, проходящего правила записи");
		Лог.Добавить("провалено проверок: 1");
		Лог.Добавить("ВЕРДИКТ: FAIL");
		Возврат;
	КонецЕсли;
	Лог.Добавить("ПРОВЕРКА: поиск непроведённого инцидента - OK (" + Строка(ИнцидентСсылка) + ")");
	
	Результат = ПровестиДокумент(ИнцидентСсылка);
	Если СтрНайти(Результат, "FAIL") = 0 И ДокументПроведен(ИнцидентСсылка) = Ложь Тогда
		Результат = "FAIL: документ не проведён - платформа отклонила запись";
	КонецЕсли;
	Лог.Добавить("ПРОВЕРКА: проведение инцидента - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Лог.Добавить("провалено проверок: 1");
		Лог.Добавить("ВЕРДИКТ: FAIL");
		Возврат;
	КонецЕсли;
	
	Результат = ПроверитьСтатусИнцидента(ИнцидентСсылка);
	Лог.Добавить("ПРОВЕРКА: запись статуса после проведения - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Провалов = Провалов + 1;
	КонецЕсли;
	
	Результат = ПровестиДокумент(ИнцидентСсылка);
	Если СтрНайти(Результат, "FAIL") = 0 Тогда
		Результат = ПроверитьСтатусИнцидента(ИнцидентСсылка);
	КонецЕсли;
	Лог.Добавить("ПРОВЕРКА: повторное проведение не дублирует движения - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Провалов = Провалов + 1;
	КонецЕсли;
	
	Результат = ОтменитьПроведениеДокумента(ИнцидентСсылка);
	КоличествоЗаписей = КоличествоЗаписейРегистра("СтатусыИнцидентов", ИнцидентСсылка);
	Если СтрНайти(Результат, "FAIL") = 0 Тогда
		Если КоличествоЗаписей > 0 Тогда
			Результат = "FAIL: после отмены осталось записей - " + КоличествоЗаписей;
		Иначе
			Результат = "OK (записей 0)";
		КонецЕсли;
	КонецЕсли;
	Лог.Добавить("ПРОВЕРКА: отмена проведения очищает движения - " + Результат);
	Если СтрНайти(Результат, "FAIL") > 0 Тогда
		Провалов = Провалов + 1;
	КонецЕсли;
	
	ЗаписатьВердикт(Лог, Провалов);
	
КонецПроцедуры

&НаСервере
Функция НайтиНепроведённуюЗаявкуТуриста()
	
	// Демо-набор используется как есть: сценарий ничего не создаёт, чтобы
	// прогон не засорял базу и был повторяемым. В первую очередь ищется
	// заявка с критическим типом запроса: только она доказывает эскалацию.
	// Заявка обязана проходить ПравилаЗаписи документа, иначе ПередЗаписью
	// отклонит проведение и сценарий проверил бы не проведение, а правила.
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Заявки.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ЗаявкаТуристаНаМаршруте КАК Заявки
		|ГДЕ
		|	Заявки.Проведен = ЛОЖЬ
		|	И Заявки.ПометкаУдаления = ЛОЖЬ
		|УПОРЯДОЧИТЬ ПО
		|	Заявки.Дата";
	
	Резервная = Неопределено;
	Для Каждого Запись Из Запрос.Выполнить().Выгрузить() Цикл
		ЗаявкаСсылка = Запись.Ссылка;
		
		ОбъектЗаявки = ЗаявкаСсылка.ПолучитьОбъект();
		Если ОбъектЗаявки.ПравилаЗаписи(ОбъектЗаявки).Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗапросКритический(ЗаявкаСсылка) Тогда
			Возврат ЗаявкаСсылка;
		КонецЕсли;
		Если Резервная = Неопределено Тогда
			Резервная = ЗаявкаСсылка;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Резервная;
	
КонецФункции

&НаСервере
Функция ЗапросКритический(ЗаявкаСсылка)
	
	Попытка
		Возврат ЗначениеЗаполнено(ЗаявкаСсылка.ТипЗапроса)
			И ЗаявкаСсылка.ТипЗапроса.Критичность = Перечисления.УровниКритичности.Критический;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

&НаСервере
Функция ПроверитьЗаписьИсторииОбработки(ЗаявкаСсылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	История.Период КАК Период,
		|	История.ЗаявкаТуриста КАК ЗаявкаТуриста,
		|	История.Сотрудник КАК Сотрудник,
		|	История.Действие КАК Действие
		|ИЗ
		|	РегистрСведений.ИсторияОбработокЗапросов КАК История
		|ГДЕ
		|	История.Регистратор = &Регистратор";
	Запрос.УстановитьПараметр("Регистратор", ЗаявкаСсылка);
	Записи = Запрос.Выполнить().Выгрузить();
	
	Если Записи.Количество() <> 1 Тогда
		Возврат "FAIL: записей " + Записи.Количество() + ", ожидалась 1";
	КонецЕсли;
	
	Запись = Записи.Получить(0);
	Если Запись.Действие <> "Регистрация" Тогда
		Возврат "FAIL: действие """ + Строка(Запись.Действие) + """, ожидалось ""Регистрация""";
	КонецЕсли;
	Если Запись.Сотрудник <> ЗаявкаСсылка.Инициатор Тогда
		Возврат "FAIL: сотрудник " + Строка(Запись.Сотрудник)
			+ ", ожидался инициатор " + Строка(ЗаявкаСсылка.Инициатор);
	КонецЕсли;
	Если Запись.ЗаявкаТуриста <> ЗаявкаСсылка Тогда
		Возврат "FAIL: измерение ЗаявкаТуриста " + Строка(Запись.ЗаявкаТуриста)
			+ ", ожидался сам документ";
	КонецЕсли;
	ОжидаемыйПериод = НачалоДня(ЗаявкаСсылка.Дата);
	Если Запись.Период <> ОжидаемыйПериод Тогда
		Возврат "FAIL: период " + Формат(Запись.Период, "ДФ=dd.MM.yyyy")
			+ ", ожидалась дата документа " + Формат(ОжидаемыйПериод, "ДФ=dd.MM.yyyy");
	КонецЕсли;
	
	Возврат "OK (1 запись, действие Регистрация, сотрудник - инициатор)";
	
КонецФункции

&НаСервере
Функция КоличествоЗадачЭскалации(ЗаявкаСсылка)
	
	// Задачи эскалации не имеют реквизита-основания: общий модуль дописывает
	// представление основания в наименование задачи, поэтому задачи ищутся
	// по маркеру основания. Считаются только невыполненные и не помеченные
	// на удаление - именно их снимает отмена проведения.
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ
		|	Задача.ЗадачаИсполнителя КАК Задачи
		|ГДЕ
		|	Задачи.ПометкаУдаления = ЛОЖЬ
		|	И Задачи.Выполнена = ЛОЖЬ
		|	И Задачи.Наименование ПОДОБНО &Маска";
	Запрос.УстановитьПараметр("Маска", "%" + МаркерОснованияЗадачи(ЗаявкаСсылка) + "%");
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.Количество;
	
КонецФункции

&НаСервере
Функция МаркерОснованияЗадачи(ДокументСсылка)
	
	// Повторяет правило общего модуля ЗадачиИсполнителям: представление
	// объекта-основания дописывается в наименование задачи в скобках.
	Попытка
		ПредставлениеОснования = ДокументСсылка.Представление;
	Исключение
		ПредставлениеОснования = Строка(ДокументСсылка);
	КонецПопытки;
	
	Возврат "(основание: " + ПредставлениеОснования + ")";
	
КонецФункции

