Функция ПроверитьБуферыСобытий(ЛистСсылка)
	
	// Повторяет правило обработчика: буфер события - разница в минутах между
	// началом следующего события и окончанием текущего. Буфер последнего
	// события не определён и не проверяется.
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	События.Ссылка КАК Ссылка,
		|	События.ДатаВремяUTC КАК ДатаВремяUTC,
		|	События.ДлительностьМинут КАК ДлительностьМинут,
		|	События.БуферДоСледующегоМинут КАК БуферДоСледующегоМинут
		|ИЗ
		|	Документ.СобытиеМаршрута КАК События
		|ГДЕ
		|	События.МаршрутныйЛист = &МаршрутныйЛист
		|	И События.ПометкаУдаления = ЛОЖЬ
		|УПОРЯДОЧИТЬ ПО
		|	События.ДатаВремяUTC";
	Запрос.УстановитьПараметр("МаршрутныйЛист", ЛистСсылка);
	
	События = Запрос.Выполнить().Выгрузить();
	
	Для Индекс = 0 По События.Количество() - 2 Цикл
		Текущее = События[Индекс];
		Следующее = События[Индекс + 1];
		
		Окончание = Текущее.ДатаВремяUTC + Текущее.ДлительностьМинут * 60;
		ОжидаемыйБуфер = РаботаСДатамиИЧасовымиЗонами.РазницаВМинутах(Окончание, Следующее.ДатаВремяUTC);
		
		Если Текущее.БуферДоСледующегоМинут <> ОжидаемыйБуфер Тогда
			Возврат "FAIL: буфер события " + Строка(Текущее.Ссылка) + " - "
				+ Текущее.БуферДоСледующегоМинут + ", ожидался " + ОжидаемыйБуфер;
		КонецЕсли;
	КонецЦикла;
	
	Возврат "OK (проверено событий: " + События.Количество() + ")";
	
КонецФункции

