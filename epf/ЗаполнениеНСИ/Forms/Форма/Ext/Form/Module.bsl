	КлючСобытия.Вставить("ДатаВремяUTC", Дата(2026, 10, 10, 5, 30, 0));
	Событие = НайтиДокументПоКлючу("СобытиеМаршрута", КлючСобытия);
	
	Ключ = Новый Структура;
	Ключ.Вставить("МаршрутныйЛист", Лист);
	Ключ.Вставить("Дата", Дата(2026, 10, 9));
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("Дата", Дата(2026, 10, 9));
	Реквизиты.Вставить("Причина", "Задержка рейса");
	Реквизиты.Вставить("Инициатор", СсылкаПоНаименованию("Сотрудники", "Орлов П.С."));
	Реквизиты.Вставить("Согласовано", Истина);
	
	СтрокаТЧ = Новый Структура;
	СтрокаТЧ.Вставить("СобытиеМаршрута", Событие);
	СтрокаТЧ.Вставить("СтароеВремяUTC", Дата(2026, 10, 10, 5, 30, 0));
