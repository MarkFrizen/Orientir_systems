&НаСервере
Функция ЗаказПоКлючу(НомерЗаявки, ИмяПоставщика, Ожидание)
	
	Ключ = Новый Структура;
	Ключ.Вставить("ЗаявкаНаТур", СсылкаПоНаименованию("ЗаявкиНаТур", НомерЗаявки));
	Ключ.Вставить("Поставщик", СсылкаПоНаименованию("Поставщики", ИмяПоставщика));
	Ключ.Вставить("ДатаОжиданияПодтверждения", Ожидание);
	
	Возврат НайтиДокументПоКлючу("ЗаказПоставщику", Ключ);
	
КонецФункции

&НаСервере
Процедура СоздатьПодтверждение(Лог, ВходящийНомер, Заказ, ИмяПоставщика, Результат, Источник,
	Услуга, Объект, Начало, Окончание, Количество, ТипНомера, ТипПитания, Цена, Сумма)
	
	Ключ = Новый Структура("ВходящийНомер", ВходящийНомер);
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("Дата", Дата(2026, 9, 21));
	Реквизиты.Вставить("ЗаказПоставщику", Заказ);
	Реквизиты.Вставить("Поставщик", СсылкаПоНаименованию("Поставщики", ИмяПоставщика));
	Реквизиты.Вставить("РезультатСверки", Результат);
	Реквизиты.Вставить("Источник", Источник);
	
	СтрокаТЧ = Новый Структура;
	СтрокаТЧ.Вставить("Услуга", СсылкаПоНаименованию("НоменклатураУслуг", Услуга));
	СтрокаТЧ.Вставить("Объект", СсылкаПоНаименованию("ОбъектыГостеприимства", Объект));
	СтрокаТЧ.Вставить("ДатаНачала", Начало);
	СтрокаТЧ.Вставить("ДатаОкончания", Окончание);
	СтрокаТЧ.Вставить("Количество", Количество);
	СтрокаТЧ.Вставить("ТипНомераФакт", ТипНомера);
	СтрокаТЧ.Вставить("ТипПитанияФакт", ТипПитания);
	СтрокаТЧ.Вставить("Цена", Цена);
	СтрокаТЧ.Вставить("Сумма", Сумма);
	
	Строки = Новый Массив;
	Строки.Добавить(СтрокаТЧ);
	
	ОбеспечитьДокумент(Лог, "ПодтверждениеУслуги", Ключ, Реквизиты, "ПодтверждённыеУслуги", Строки);
	
КонецПроцедуры

