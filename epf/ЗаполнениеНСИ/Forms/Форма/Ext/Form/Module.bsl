Процедура ЛогироватьКоличествоДокументов(Лог)
	
	Виды = Новый Массив;
	Виды.Добавить("ЗаказПоставщику");
	Виды.Добавить("ПодтверждениеУслуги");
	Виды.Добавить("МаршрутныйЛист");
	Виды.Добавить("СобытиеМаршрута");
	Виды.Добавить("КорректировкаМаршрута");
	Виды.Добавить("ЗаявкаТуристаНаМаршруте");
	Виды.Добавить("Инцидент");
	Виды.Добавить("ПретензияПоставщику");
	Виды.Добавить("АктОКомпенсации");
	
	Для Каждого Вид Из Виды Цикл
		Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего, ЕСТЬNULL(СУММА(ВЫБОР КОГДА Т.Проведен ТОГДА 1 ИНАЧЕ 0 КОНЕЦ), 0) КАК Проведено ИЗ Документ." + Вид + " КАК Т");
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		Лог.Добавить("  " + Вид + ": " + Выборка.Всего + " (проведено: " + Формат(Выборка.Проведено, "ЧН=0") + ")");
