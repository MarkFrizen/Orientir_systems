&НаСервере
Процедура ЗаполнитьТипыЗапросов(Лог, Итоги)
	
	Лог.Добавить("--- Справочник: ТипыЗапросовТуристов ---");
	Данные = Новый Массив;
	Данные.Добавить(Новый Структура("Наименование, SLAЧасов, Критичность, ШаблонОтвета",
		"Медицинская помощь", 0.5, Перечисления.УровниКритичности.Критический,
		"Ваш запрос зарегистрирован как срочный. Дежурный медицинский координатор свяжется с вами в течение 30 минут."));
	Данные.Добавить(Новый Структура("Наименование, SLAЧасов, Критичность, ШаблонОтвета",
		"Диетическое питание", 2, Перечисления.УровниКритичности.Средний,
		"Ваш запрос передан службе питания отеля. Специалист подтвердит возможность организации меню в течение 2 часов."));
	Данные.Добавить(Новый Структура("Наименование, SLAЧасов, Критичность, ШаблонОтвета",
		"Бытовой вопрос", 4, Перечисления.УровниКритичности.Низкий,
		"Здравствуйте! Ваш запрос принят в работу. Ориентировочное время ответа — до 4 часов."));
	Данные.Добавить(Новый Структура("Наименование, SLAЧасов, Критичность, ШаблонОтвета",
		"Прочее", 24, Перечисления.УровниКритичности.Низкий,
		"Запрос зарегистрирован. Ответ поступит в течение 24 часов."));
	Данные.Добавить(Новый Структура("Наименование, SLAЧасов, Критичность, ШаблонОтвета",
		"Организация досуга", 12, Перечисления.УровниКритичности.Низкий,
		"Менеджер подберёт варианты экскурсий и развлечений и свяжется с вами в течение рабочего дня."));
	Данные.Добавить(Новый Структура("Наименование, SLAЧасов, Критичность, ШаблонОтвета",
		"Ранний заезд / поздний выезд", 8, Перечисления.УровниКритичности.Средний,
		"Запрос передан в службу размещения. Подтверждение поступит в течение 8 часов."));
	Для Каждого Строка Из Данные Цикл
		Обеспечить(Лог, Итоги, "ТипыЗапросовТуристов", Строка.Наименование, Неопределено, Неопределено,
			Новый Структура("SLAЧасов, Критичность, ШаблонОтвета", Строка.SLAЧасов, Строка.Критичность, Строка.ШаблонОтвета));
		Лог.Добавить("  " + Строка.Наименование + ": SLA " + Формат(Строка.SLAЧасов, "ЧДЦ=2") + " ч");
	КонецЦикла;
	
