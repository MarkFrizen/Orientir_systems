	Реквизиты.Вставить("Дата", Дата(2026, 10, 13));
	Реквизиты.Вставить("Поставщик", СсылкаПоНаименованию("Поставщики", "ООО «Глобал Трансфер»"));
	Реквизиты.Вставить("Договор", СсылкаПоНаименованию("ДоговорыСПоставщиками", "Д-2026/04"));
	Реквизиты.Вставить("СуммаТребования", 9000);
	Реквизиты.Вставить("Валюта", СсылкаПоНаименованию("Валюты", "Российский рубль"));
	Реквизиты.Вставить("Статус", Перечисления.СтатусыПретензии.Направлена);
	Реквизиты.Вставить("СогласованоРуководителем", Ложь);
	Реквизиты.Вставить("Руководитель", СсылкаПоНаименованию("Сотрудники", "Соколов В.А."));
	
	ОбеспечитьДокумент(Лог, "ПретензияПоставщику", Ключ, Реквизиты);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьАкты(Лог)
	
	Лог.Добавить("  -- АктОКомпенсации --");
	
	Инцидент = ИнцидентПоКлючу("З-2026/001", "Задержка трансфера", Дата(2026, 10, 10));
	Претензия = НайтиДокументПоКлючу("ПретензияПоставщику", Новый Структура("Инцидент", Инцидент));
	
	Ключ = Новый Структура("Претензия", Претензия);
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("Дата", Дата(2026, 10, 15));
	Реквизиты.Вставить("ДатаАкта", Дата(2026, 10, 15));
	Реквизиты.Вставить("Инцидент", Инцидент);
	Реквизиты.Вставить("СуммаКомпенсацииТуристу", 5000);
	Реквизиты.Вставить("СуммаВзысканияСПоставщика", 9000);
	Реквизиты.Вставить("Валюта", СсылкаПоНаименованию("Валюты", "Российский рубль"));
	
	СтрокаТЧ = Новый Структура;
	СтрокаТЧ.Вставить("ВидКомпенсации", Перечисления.ВидыКомпенсаций.Денежная);
	СтрокаТЧ.Вставить("Сумма", 5000);
	СтрокаТЧ.Вставить("Описание", "Компенсация за задержку трансфера");
	
	Строки = Новый Массив;
	Строки.Добавить(СтрокаТЧ);
	
	ОбеспечитьДокумент(Лог, "АктОКомпенсации", Ключ, Реквизиты, "СтруктураКомпенсации", Строки);
	
КонецПроцедуры

&НаСервере
Функция Обеспечить(Лог, Итоги, ИмяСправочника, Наименование, Родитель = Неопределено, Владелец = Неопределено, Реквизиты = Неопределено, ЭтоГруппа = Ложь)
	
	Менеджер = Справочники[ИмяСправочника];
	Ссылка = Менеджер.НайтиПоНаименованию(Наименование, Истина, Родитель, Владелец);
	
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Если Реквизиты <> Неопределено Тогда
			СуществующийОбъект = Ссылка.ПолучитьОбъект();
			ЗаполнитьРеквизиты(СуществующийОбъект, Реквизиты);
			СуществующийОбъект.Записать();
		КонецЕсли;
		Учесть(Итоги, ИмяСправочника, Ложь);
		Лог.Добавить("  = " + Наименование);
		Возврат Ссылка;
	КонецЕсли;
	
	Если ЭтоГруппа Тогда
		НовыйОбъект = Менеджер.СоздатьГруппу();
	Иначе
		НовыйОбъект = Менеджер.СоздатьЭлемент();
	КонецЕсли;
	НовыйОбъект.Наименование = Наименование;
	Если Родитель <> Неопределено Тогда
		НовыйОбъект.Родитель = Родитель;
	КонецЕсли;
	Если Владелец <> Неопределено Тогда
		НовыйОбъект.Владелец = Владелец;
	КонецЕсли;
	ЗаполнитьРеквизиты(НовыйОбъект, Реквизиты);
	НовыйОбъект.Записать();
	
	Учесть(Итоги, ИмяСправочника, Истина);
	Лог.Добавить("  + " + Наименование);
	Возврат НовыйОбъект.Ссылка;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьРеквизиты(ОбъектЗаписи, Реквизиты)
	
	Если Реквизиты = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого КлючИЗначение Из Реквизиты Цикл
		ОбъектЗаписи[КлючИЗначение.Ключ] = КлючИЗначение.Значение;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция СсылкаПоНаименованию(ИмяСправочника, Наименование)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник." + ИмяСправочника + " ГДЕ Наименование = &Наименование";
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	ВызватьИсключение "Не найден элемент справочника " + ИмяСправочника + ": " + Наименование;
	
КонецФункции

&НаСервере
Процедура Учесть(Итоги, Ключ, Создан)
	
	Счётчик = Неопределено;
	Для Каждого Строка Из Итоги Цикл
		Если Строка.Ключ = Ключ Тогда
			Счётчик = Строка;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Счётчик = Неопределено Тогда
		Счётчик = Новый Структура("Ключ, Создано, Обновлено", Ключ, 0, 0);
		Итоги.Добавить(Счётчик);
	КонецЕсли;
	
	Если Создан Тогда
		Счётчик.Создано = Счётчик.Создано + 1;
	Иначе
		Счётчик.Обновлено = Счётчик.Обновлено + 1;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПодвестиИтоги(Лог, Итоги)
	
	Лог.Добавить("");
	Лог.Добавить("=== Итоги по справочникам (создано / уже было) ===");
	Для Каждого Счётчик Из Итоги Цикл
		Лог.Добавить("  " + Счётчик.Ключ + ": " + Счётчик.Создано + " / " + Счётчик.Обновлено);
	КонецЦикла;
	
	Лог.Добавить("");
	Лог.Добавить("=== Контрольная сводка по базе ===");
	ИменаСправочников = СтрРазделить("СтраныМира,Валюты,ЕдиницыИзмерения,Пользователи,Сотрудники,ТипыЗапросовТуристов,ТипыИнцидентов,Поставщики,ДоговорыСПоставщиками,ОбъектыГостеприимства,НоменклатураУслуг,ТурыМаршруты,Туристы,ЗаявкиНаТур", ",", Ложь);
	Для Каждого ИмяСправочника Из ИменаСправочников Цикл
		Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего ИЗ Справочник." + ИмяСправочника);
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		Лог.Добавить("  " + ИмяСправочника + ": " + Выборка.Всего);
	КонецЦикла;
	Для Каждого ИмяРегистра Из СтрРазделить("СрокиКонтроля,НастройкиИнтеграций", ",", Ложь) Цикл
		Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего ИЗ РегистрСведений." + ИмяРегистра);
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		Лог.Добавить("  " + ИмяРегистра + ": " + Выборка.Всего);
	КонецЦикла;
	Лог.Добавить("  ПорогСогласованияРуководителем: " + Константы.ПорогСогласованияРуководителем.Получить());
	Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего ИЗ Справочник.ТурыМаршруты.СтандартныйНаборУслуг");
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Лог.Добавить("  ТурыМаршруты.СтандартныйНаборУслуг: " + Выборка.Всего);
	Лог.Добавить("");
	Лог.Добавить("=== Заполнение завершено ===");
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьЛог(ПутьЛога, Лог)
	
	Если ПустаяСтрока(ПутьЛога) Тогда
		ПутьЛога = КаталогВременныхФайлов() + "kursovaya-fill.log";
	КонецЕсли;
	
	Запись = Новый ЗаписьТекста(ПутьЛога, КодировкаТекста.UTF8);
	Для Каждого Строка Из Лог Цикл
		Запись.ЗаписатьСтроку(Строка);
	КонецЦикла;
	Запись.Закрыть();
	
КонецПроцедуры

#КонецОбласти
