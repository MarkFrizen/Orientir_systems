#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ВыполнитьЗаполнение(ПараметрЗапуска);
	ЗавершитьРаботуСистемы(Ложь);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ВыполнитьЗаполнение(ПутьЛога)
	
	Лог = Новый Массив;
	Итоги = Новый Массив;
	
	Лог.Добавить("=== Начальное заполнение данных, " + Формат(ТекущаяДата(), "ДЛФ=DT") + " ===");
	
	Блоки = Новый Массив;
	Блоки.Добавить("Страны");
	Блоки.Добавить("Валюты");
	Блоки.Добавить("ЕдиницыИзмерения");
	Блоки.Добавить("Пользователи");
	Блоки.Добавить("Сотрудники");
	Блоки.Добавить("ТипыЗапросов");
	Блоки.Добавить("ТипыИнцидентов");
	Блоки.Добавить("Поставщики");
	Блоки.Добавить("Договоры");
	Блоки.Добавить("ОбъектыГостеприимства");
	Блоки.Добавить("Номенклатура");
	Блоки.Добавить("Маршруты");
	Блоки.Добавить("Туристы");
	Блоки.Добавить("Заявки");
	Блоки.Добавить("СрокиКонтроля");
	Блоки.Добавить("НастройкиИнтеграций");
	Блоки.Добавить("Константа");
	Блоки.Добавить("Документы");
	
	Выполнено = 0;
	Ошибок = 0;
	
	Для Каждого ИмяБлока Из Блоки Цикл
		Попытка
			ВыполнитьБлок(ИмяБлока, Лог, Итоги);
			Выполнено = Выполнено + 1;
		Исключение
			Ошибок = Ошибок + 1;
			Лог.Добавить("");
			Лог.Добавить("ОШИБКА блока «" + ИмяБлока + "»: " + ОписаниеОшибки());
			Лог.Добавить("");
		КонецПопытки;
	КонецЦикла;
	
	Лог.Добавить("");
	Лог.Добавить("Блоков выполнено: " + Выполнено + " из " + Блоки.Количество() + ", ошибок: " + Ошибок);
	
	ПодвестиИтоги(Лог, Итоги);
	ЗаписатьЛог(ПутьЛога, Лог);
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьБлок(ИмяБлока, Лог, Итоги)
	
	Если ИмяБлока = "Страны" Тогда
		ЗаполнитьСтраны(Лог, Итоги);
	ИначеЕсли ИмяБлока = "Валюты" Тогда
		ЗаполнитьВалюты(Лог, Итоги);
	ИначеЕсли ИмяБлока = "ЕдиницыИзмерения" Тогда
		ЗаполнитьЕдиницыИзмерения(Лог, Итоги);
	ИначеЕсли ИмяБлока = "Пользователи" Тогда
		ЗаполнитьПользователей(Лог, Итоги);
	ИначеЕсли ИмяБлока = "Сотрудники" Тогда
		ЗаполнитьСотрудников(Лог, Итоги);
	ИначеЕсли ИмяБлока = "ТипыЗапросов" Тогда
		ЗаполнитьТипыЗапросов(Лог, Итоги);
	ИначеЕсли ИмяБлока = "ТипыИнцидентов" Тогда
		ЗаполнитьТипыИнцидентов(Лог, Итоги);
	ИначеЕсли ИмяБлока = "Поставщики" Тогда
		ЗаполнитьПоставщиков(Лог, Итоги);
	ИначеЕсли ИмяБлока = "Договоры" Тогда
		ЗаполнитьДоговоры(Лог, Итоги);
	ИначеЕсли ИмяБлока = "ОбъектыГостеприимства" Тогда
		ЗаполнитьОбъектыГостеприимства(Лог, Итоги);
	ИначеЕсли ИмяБлока = "Номенклатура" Тогда
		ЗаполнитьНоменклатуру(Лог, Итоги);
	ИначеЕсли ИмяБлока = "Маршруты" Тогда
		ЗаполнитьМаршруты(Лог, Итоги);
	ИначеЕсли ИмяБлока = "Туристы" Тогда
		ЗаполнитьТуристов(Лог, Итоги);
	ИначеЕсли ИмяБлока = "Заявки" Тогда
		ЗаполнитьЗаявки(Лог, Итоги);
	ИначеЕсли ИмяБлока = "СрокиКонтроля" Тогда
		ЗаполнитьСрокиКонтроля(Лог);
	ИначеЕсли ИмяБлока = "НастройкиИнтеграций" Тогда
		ЗаполнитьНастройкиИнтеграций(Лог);
	ИначеЕсли ИмяБлока = "Константа" Тогда
		ЗаполнитьКонстанту(Лог);
	ИначеЕсли ИмяБлока = "Документы" Тогда
		ЗаполнитьДокументы(Лог, Итоги);
	Иначе
		ВызватьИсключение "Неизвестный блок заполнения: " + ИмяБлока;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтраны(Лог, Итоги)
	
	Лог.Добавить("--- Справочник: СтраныМира ---");
	Для Каждого Наименование Из СтрРазделить("Турция,Египет,ОАЭ,Таиланд,Россия,Испания,Италия,Греция,Кипр,Тунис,Черногория,Вьетнам", ",", Ложь) Цикл
		Обеспечить(Лог, Итоги, "СтраныМира", Наименование);
	КонецЦикла;
	
КонецПроцедуры

