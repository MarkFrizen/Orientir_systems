#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ВыполнитьЗаполнение(ПараметрЗапуска);
	ЗавершитьРаботуСистемы(Ложь);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ВыполнитьЗаполнение(ПутьЛога)
	
	Лог = Новый Массив;
	Итоги = Новый Массив;
	
	Лог.Добавить("=== Начальное заполнение данных, " + Формат(ТекущаяДата(), "ДЛФ=DT") + " ===");
	
	Попытка
		ЗаполнитьСтраны(Лог, Итоги);
		ЗаполнитьВалюты(Лог, Итоги);
		ЗаполнитьЕдиницыИзмерения(Лог, Итоги);
		ЗаполнитьПользователей(Лог, Итоги);
		ЗаполнитьСотрудников(Лог, Итоги);
		ЗаполнитьТипыЗапросов(Лог, Итоги);
		ЗаполнитьТипыИнцидентов(Лог, Итоги);
		ЗаполнитьПоставщиков(Лог, Итоги);
		ЗаполнитьДоговоры(Лог, Итоги);
		ЗаполнитьОбъектыГостеприимства(Лог, Итоги);
		ЗаполнитьНоменклатуру(Лог, Итоги);
		ЗаполнитьМаршруты(Лог, Итоги);
		ЗаполнитьТуристов(Лог, Итоги);
		ЗаполнитьЗаявки(Лог, Итоги);
		ЗаполнитьСрокиКонтроля(Лог);
		ЗаполнитьНастройкиИнтеграций(Лог);
		ЗаполнитьКонстанту(Лог);
	Исключение
		Лог.Добавить("");
		Лог.Добавить("ОШИБКА: " + ОписаниеОшибки());
	КонецПопытки;
	
	ПодвестиИтоги(Лог, Итоги);
	ЗаписатьЛог(ПутьЛога, Лог);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтраны(Лог, Итоги)
	
	Лог.Добавить("--- Справочник: СтраныМира ---");
	Для Каждого Наименование Из СтрРазделить("Турция,Египет,ОАЭ,Таиланд,Россия", ",", Ложь) Цикл
		Обеспечить(Лог, Итоги, "СтраныМира", Наименование);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВалюты(Лог, Итоги)
	
	Лог.Добавить("--- Справочник: Валюты ---");
	Данные = Новый Массив;
	Данные.Добавить(Новый Структура("Код, Наименование", "RUB", "Российский рубль"));
	Данные.Добавить(Новый Структура("Код, Наименование", "USD", "Доллар США"));
	Данные.Добавить(Новый Структура("Код, Наименование", "EUR", "Евро"));
	Данные.Добавить(Новый Структура("Код, Наименование", "TRY", "Турецкая лира"));
	Данные.Добавить(Новый Структура("Код, Наименование", "AED", "Дирхам ОАЭ"));
	Для Каждого Строка Из Данные Цикл
		Обеспечить(Лог, Итоги, "Валюты", Строка.Наименование, Неопределено, Неопределено, Новый Структура("Код", Строка.Код));
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
