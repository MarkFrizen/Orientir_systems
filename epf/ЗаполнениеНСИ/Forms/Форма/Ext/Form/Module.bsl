&НаСервере
Процедура СоздатьСобытие(Лог, Лист, Момент, Тип, Объект, Поставщик, Длительность, Буфер)
	
	Ключ = Новый Структура;
	Ключ.Вставить("МаршрутныйЛист", Лист);
	Ключ.Вставить("ТипСобытия", Тип);
	Ключ.Вставить("ДатаВремяUTC", Момент);
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("Дата", Момент);
	Реквизиты.Вставить("ЛокальноеВремя", Момент);
	Реквизиты.Вставить("Объект", СсылкаПоНаименованию("ОбъектыГостеприимства", Объект));
	Реквизиты.Вставить("Поставщик", СсылкаПоНаименованию("Поставщики", Поставщик));
	Реквизиты.Вставить("ДлительностьМинут", Длительность);
	Реквизиты.Вставить("БуферДоСледующегоМинут", Буфер);
	Реквизиты.Вставить("Комментарий", "Демо-набор");
	
	ОбеспечитьДокумент(Лог, "СобытиеМаршрута", Ключ, Реквизиты);
	
КонецПроцедуры

