&НаСервере
Функция НайтиДокументПоКлючу(ИмяДокумента, ПоляКлюча)
	
	Запрос = Новый Запрос;
	Условия = Новый Массив;
	Индекс = 0;
	Для Каждого ПолеКлюча Из ПоляКлюча Цикл
		ИмяПараметра = "П" + Строка(Индекс);
		Условия.Добавить("Т." + ПолеКлюча.Ключ + " = &" + ИмяПараметра);
		Запрос.УстановитьПараметр(ИмяПараметра, ПолеКлюча.Значение);
		Индекс = Индекс + 1;
	КонецЦикла;
	
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка КАК Ссылка ИЗ Документ." + ИмяДокумента + " КАК Т ГДЕ Т.ПометкаУдаления = ЛОЖЬ И "
		+ СтрСоединить(Условия, " И ") + " УПОРЯДОЧИТЬ ПО Т.Ссылка";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Функция ОбеспечитьДокумент(Лог, ИмяДокумента, ПоляКлюча, Реквизиты, ИмяТЧ = "", СтрокиТЧ = Неопределено)
	
	Существующий = НайтиДокументПоКлючу(ИмяДокумента, ПоляКлюча);
	
	Если Существующий <> Неопределено Тогда
		ДокументОбъект = Существующий.ПолучитьОбъект();
	Иначе
		ДокументОбъект = Документы[ИмяДокумента].СоздатьДокумент();
	КонецЕсли;
	
	Для Каждого ПолеКлюча Из ПоляКлюча Цикл
		ДокументОбъект[ПолеКлюча.Ключ] = ПолеКлюча.Значение;
	КонецЦикла;
	ЗаполнитьРеквизиты(ДокументОбъект, Реквизиты);
	
	Если ИмяТЧ <> "" И СтрокиТЧ <> Неопределено Тогда
		ДокументОбъект[ИмяТЧ].Очистить();
		Для Каждого СтрокаДанных Из СтрокиТЧ Цикл
			НоваяСтрока = ДокументОбъект[ИмяТЧ].Добавить();
			Для Каждого ПолеСтроки Из СтрокаДанных Цикл
				НоваяСтрока[ПолеСтроки.Ключ] = ПолеСтроки.Значение;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	ДокументОбъект.Записать();
	
	Если Существующий <> Неопределено Тогда
		Лог.Добавить("  = " + ИмяДокумента + " " + Строка(ДокументОбъект.Ссылка));
		Возврат Существующий;
	Иначе
		Лог.Добавить("  + " + ИмяДокумента + " " + Строка(ДокументОбъект.Ссылка));
	КонецЕсли;
	
	Возврат ДокументОбъект.Ссылка;
	
КонецФункции

