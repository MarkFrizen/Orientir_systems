&НаСервере
Функция УслугиМаршрута(Описание)
	
	Услуги = Новый Массив;
	Для Каждого Часть Из СтрРазделить(Описание, "|", Ложь) Цикл
		Поля = СтрРазделить(Часть, ";", Ложь);
		Услуги.Добавить(Новый Структура("Услуга, Количество, Поставщик",
			Поля[0], Число(Поля[1]), Поля[2]));
	КонецЦикла;
	Возврат Услуги;
	
КонецФункции

