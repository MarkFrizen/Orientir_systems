	Строки = Новый Массив;
	Строки.Добавить(СтрокаТЧ);
	
	ОбеспечитьДокумент(Лог, "КорректировкаМаршрута", Ключ, Реквизиты, "Изменения", Строки);
	
КонецПроцедуры

&НаСервере
Процедура СоздатьЗапросТуриста(Лог, Лист, Турист, ТипЗапроса, Текст, Классификация, СрокSLA, Статус, Ответственный, История)
	
	Ключ = Новый Структура;
	Ключ.Вставить("МаршрутныйЛист", Лист);
	Ключ.Вставить("ТекстЗапроса", Текст);
	
	ДатаДокумента = Дата(Год(СрокSLA), Месяц(СрокSLA), День(СрокSLA), Час(СрокSLA) - 2, Минута(СрокSLA), Секунда(СрокSLA));
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("Дата", ДатаДокумента);
	Реквизиты.Вставить("Турист", СсылкаПоНаименованию("Туристы", Турист));
	Реквизиты.Вставить("ТипЗапроса", СсылкаПоНаименованию("ТипыЗапросовТуристов", ТипЗапроса));
	Реквизиты.Вставить("КлассификацияИИ", Классификация);
	Реквизиты.Вставить("СрокSLA", СрокSLA);
	Реквизиты.Вставить("Статус", Статус);
	Реквизиты.Вставить("Инициатор", СсылкаПоНаименованию("Сотрудники", "Ахметов Р.И."));
	Реквизиты.Вставить("Ответственный", СсылкаПоНаименованию("Сотрудники", Ответственный));
	
	ОбеспечитьДокумент(Лог, "ЗаявкаТуристаНаМаршруте", Ключ, Реквизиты, "ИсторияОбработки", История);
	
КонецПроцедуры

