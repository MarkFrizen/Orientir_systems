		"Хургада 8 ночей", "Египет", "Египет", "Хургада", 8,
		УслугиМаршрута("Номер Standard;8;ООО «Клео Тур»|Питание HB;8;ООО «Клео Тур»|Трансфер аэропорт-отель;2;ООО «Глобал Трансфер»")));
	Маршруты.Добавить(Новый Структура("Наименование, Группа, Страна, Курорт, ПродолжительностьДней, Услуги",
		"Дубай 6 ночей", "ОАЭ", "ОАЭ", "Дубай", 6,
		УслугиМаршрута("Номер Deluxe;6;ООО «Ривьера Резорт»|Трансфер аэропорт-отель;2;ООО «Глобал Трансфер»")));
	Маршруты.Добавить(Новый Структура("Наименование, Группа, Страна, Курорт, ПродолжительностьДней, Услуги",
		"Пхукет 10 ночей", "Таиланд", "Таиланд", "Пхукет", 10,
		УслугиМаршрута("Номер Deluxe;10;ООО «Клео Тур»|Трансфер аэропорт-отель;2;ООО «Глобал Трансфер»|Страховка базовая;1;ООО «Гарант-Полис»")));
	
	Для Каждого Строка Из Маршруты Цикл
		Группа = СсылкаПоНаименованию("ТурыМаршруты", Строка.Группа);
		Реквизиты = Новый Структура("Страна, Курорт, ПродолжительностьДней",
			СсылкаПоНаименованию("СтраныМира", Строка.Страна), Строка.Курорт, Строка.ПродолжительностьДней);
		Ссылка = Обеспечить(Лог, Итоги, "ТурыМаршруты", Строка.Наименование, Группа, Неопределено, Реквизиты);
		
		ОбъектМаршрута = Ссылка.ПолучитьОбъект();
		ОбъектМаршрута.СтандартныйНаборУслуг.Очистить();
		Для Каждого СтрокаУслуги Из Строка.Услуги Цикл
			НоваяСтрока = ОбъектМаршрута.СтандартныйНаборУслуг.Добавить();
			НоваяСтрока.Услуга = СсылкаПоНаименованию("НоменклатураУслуг", СтрокаУслуги.Услуга);
			НоваяСтрока.Количество = СтрокаУслуги.Количество;
			НоваяСтрока.Поставщик = СсылкаПоНаименованию("Поставщики", СтрокаУслуги.Поставщик);
		КонецЦикла;
		ОбъектМаршрута.Записать();
	КонецЦикла;
	
КонецПроцедуры

