&НаСервере
Функция СоздатьЗаказ(Лог, НомерЗаявки, ИмяПоставщика, НомерДоговора, Ожидание,
	Услуга, Объект, Начало, Окончание, Количество, ТипНомера, ТипПитания, Цена, Сумма)
	
	Ключ = Новый Структура;
	Ключ.Вставить("ЗаявкаНаТур", СсылкаПоНаименованию("ЗаявкиНаТур", НомерЗаявки));
	Ключ.Вставить("Поставщик", СсылкаПоНаименованию("Поставщики", ИмяПоставщика));
	Ключ.Вставить("ДатаОжиданияПодтверждения", Ожидание);
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("Дата", Ожидание);
	Реквизиты.Вставить("Договор", СсылкаПоНаименованию("ДоговорыСПоставщиками", НомерДоговора));
	Реквизиты.Вставить("Статус", Перечисления.СтатусыЗаказа.Отправлен);
	Реквизиты.Вставить("Ответственный", СсылкаПоНаименованию("Сотрудники", "Козлова М.А."));
	Реквизиты.Вставить("Комментарий", "Демо-набор");
	
	СтрокаТЧ = Новый Структура;
	СтрокаТЧ.Вставить("Услуга", СсылкаПоНаименованию("НоменклатураУслуг", Услуга));
	СтрокаТЧ.Вставить("Объект", СсылкаПоНаименованию("ОбъектыГостеприимства", Объект));
	СтрокаТЧ.Вставить("ДатаНачала", Начало);
	СтрокаТЧ.Вставить("ДатаОкончания", Окончание);
	СтрокаТЧ.Вставить("Количество", Количество);
	СтрокаТЧ.Вставить("ТипНомера", ТипНомера);
	СтрокаТЧ.Вставить("ТипПитания", ТипПитания);
	СтрокаТЧ.Вставить("Цена", Цена);
	СтрокаТЧ.Вставить("Сумма", Сумма);
	
	Строки = Новый Массив;
	Строки.Добавить(СтрокаТЧ);
	
	Возврат ОбеспечитьДокумент(Лог, "ЗаказПоставщику", Ключ, Реквизиты, "Услуги", Строки);
	
