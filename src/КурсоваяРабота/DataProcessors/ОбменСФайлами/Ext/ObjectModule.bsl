#Область ПрограммныйИнтерфейс

Функция НовыйОтчёт() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ВсегоСтрок", 0);
	Результат.Вставить("Загружено", 0);
	Результат.Вставить("Отклонено", 0);
	Результат.Вставить("Вердикт", "");
	// Путь файла данных попадает в текстовый отчёт: без него отчёт не говорит,
	// что именно загружали, и два прогона подряд невозможно различить по логу.
	Результат.Вставить("ПутьФайла", "");
	Результат.Вставить("Предупреждения", Новый Массив);
	
	ТаблицаОшибок = Новый ТаблицаЗначений;
	ТаблицаОшибок.Колонки.Добавить("Строка",    Новый ОписаниеТипов("Число"));
	ТаблицаОшибок.Колонки.Добавить("Уровень",   Новый ОписаниеТипов("Строка"));
	ТаблицаОшибок.Колонки.Добавить("Объект",    Новый ОписаниеТипов("Строка"));
	ТаблицаОшибок.Колонки.Добавить("Сообщение", Новый ОписаниеТипов("Строка"));
	Результат.Вставить("Ошибки", ТаблицаОшибок);
	
	Возврат Результат;
	
КонецФункции

// Вердикт обработки по счётчикам отчёта. Считается только по счётчикам, а не по
// наличию ошибок в таблице: предупреждения и отказы по отдельным строкам - разные вещи.
//
// Параметры:
//  Отчёт - Структура - результат НовыйОтчёт().
//
// Возвращаемое значение:
//  Строка - "PASS", "ЧАСТИЧНО" или "FAIL".
//
Функция ВердиктОтчёта(Отчёт) Экспорт
	
	// Пустой файл - не ошибка: загружать было нечего, и отклонять тоже нечего.
	Если Отчёт.ВсегоСтрок = 0 Тогда
		Возврат "PASS";
	КонецЕсли;
	
	Если Отчёт.Отклонено = 0 Тогда
		Возврат "PASS";
	КонецЕсли;
	
	// Ни одной записанной строки при непустом файле: файл не подошёл целиком.
	Если Отчёт.Загружено = 0 Тогда
		Возврат "FAIL";
	КонецЕсли;
	
	// Часть строк принята, часть отклонена: файл обработан не полностью.
	Возврат "ЧАСТИЧНО";
	
КонецФункции

// Пишет текстовый отчёт о загрузке: шапка с путём файла данных и датой, счётчики,
// по строке на каждую ошибку и вердикт последней строкой. Вердикт в файле
// вычисляется тем же методом, что и вердикт отчёта: разойтись они не могут.
//
// Параметры:
//  ПутьОтчёта - Строка - путь текстового файла. Пустая строка означает «отчёт не
//               нужен»: путь по умолчанию вычисляет вызывающий, обработка каталог
//               не угадывает.
//  Отчёт      - Структура - результат НовыйОтчёт().
//
Процедура ЗаписатьОтчёт(ПутьОтчёта, Отчёт) Экспорт
	
	Если ПустаяСтрока(ПутьОтчёта) Тогда
		Возврат;
	КонецЕсли;
	
	// Маркер спецификации задан явно: отчёт должен открываться блокнотом как UTF-8,
	// иначе кириллица в причинах ошибок превращается в мусор.
	ТекстовыйФайл = Новый ЗаписьТекста(ПутьОтчёта, "UTF-8", Истина);
	
	ПутьДанных = ?(Отчёт.Свойство("ПутьФайла"), Отчёт.ПутьФайла, "");
	
	// Заголовок нейтрален: тем же отчётом пользуется и загрузка заказов, а шапка
	// с названием конкретного объекта вводила бы в заблуждение.
	ТекстовыйФайл.ЗаписатьСтроку("ОТЧЁТ ОБ ОБМЕНЕ");
	ТекстовыйФайл.ЗаписатьСтроку("Файл данных: " + ПутьДанных);
	ТекстовыйФайл.ЗаписатьСтроку("Дата: " + Формат(ТекущаяДатаСеанса(), "ДФ='dd.MM.yyyy HH:mm:ss'"));
	ТекстовыйФайл.ЗаписатьСтроку("Всего строк: " + Отчёт.ВсегоСтрок);
	ТекстовыйФайл.ЗаписатьСтроку("Загружено: " + Отчёт.Загружено);
	ТекстовыйФайл.ЗаписатьСтроку("Отклонено: " + Отчёт.Отклонено);
	
	Для Каждого СтрокаОшибки Из Отчёт.Ошибки Цикл
		ТекстовыйФайл.ЗаписатьСтроку("СТРОКА " + СтрокаОшибки.Строка + ": " + СтрокаОшибки.Сообщение);
	КонецЦикла;
	
	ТекстовыйФайл.ЗаписатьСтроку("ВЕРДИКТ: " + ВердиктОтчёта(Отчёт));
	
	ТекстовыйФайл.Закрыть();
	
КонецПроцедуры

// Состав и порядок колонок файла номенклатуры услуг.
// Один список на выгрузку и загрузку: иначе выгруженный файл может перестать
// проходить собственную проверку заголовка.
//
// Возвращаемое значение:
//  Массив - имена колонок в порядке следования в файле.
//
Функция ОбязательныеКолонкиНоменклатуры() Экспорт
	
	Колонки = Новый Массив;
	Колонки.Добавить("Код");
	Колонки.Добавить("Наименование");
	Колонки.Добавить("ЭтоГруппа");
	Колонки.Добавить("Родитель");
	Колонки.Добавить("ВидУслуги");
	Колонки.Добавить("Единица");
	Колонки.Добавить("БазоваяЦена");
	Колонки.Добавить("Валюта");
	
	Возврат Колонки;
	
КонецФункции

// Состав и порядок колонок файла заказов поставщику.
// Один список на выгрузку и проверку: заголовок файла и проверка драйвера
// не могут разойтись, если берут имена из одного места.
//
// Возвращаемое значение:
//  Массив - имена колонок в порядке следования в файле.
//
Функция КолонкиЗаказов() Экспорт
	
	Колонки = Новый Массив;
	Колонки.Добавить("Номер");
	Колонки.Добавить("Дата");
	Колонки.Добавить("ЗаявкаНаТур");
	Колонки.Добавить("Поставщик");
	Колонки.Добавить("Договор");
	Колонки.Добавить("ДатаОжиданияПодтверждения");
	Колонки.Добавить("Статус");
	Колонки.Добавить("Комментарий");
	Колонки.Добавить("Ответственный");
	Колонки.Добавить("Услуга");
	Колонки.Добавить("Объект");
	Колонки.Добавить("ДатаНачала");
	Колонки.Добавить("ДатаОкончания");
	Колонки.Добавить("Количество");
	Колонки.Добавить("ТипНомера");
	Колонки.Добавить("ТипПитания");
	Колонки.Добавить("Цена");
	Колонки.Добавить("Сумма");
	Колонки.Добавить("ДополнительныеПараметры");
	
	Возврат Колонки;
	
КонецФункции

Функция ВыгрузитьНоменклатуру(ПутьФайла, Отчёт = Неопределено) Экспорт
	
	Результат = ?(Отчёт = Неопределено, НовыйОтчёт(), Отчёт);
	
	Колонки = ОбязательныеКолонкиНоменклатуры();
	
	Строки = Новый Массив;
	
	Выборка = Справочники.НоменклатураУслуг.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		СтрокаДанных = Новый Массив;
		СтрокаДанных.Добавить(Выборка.Код);
		СтрокаДанных.Добавить(Выборка.Наименование);
		СтрокаДанных.Добавить(?(Выборка.ЭтоГруппа, "Истина", "Ложь"));
		СтрокаДанных.Добавить(ПредставлениеРодителя(Выборка.Родитель));
		СтрокаДанных.Добавить(Строка(Выборка.ВидУслуги));
		СтрокаДанных.Добавить(Строка(Выборка.Единица));
		СтрокаДанных.Добавить(ОбменCSV.СформироватьЧисло(Выборка.БазоваяЦена));
		СтрокаДанных.Добавить(Строка(Выборка.Валюта));
		Строки.Добавить(СтрокаДанных);
		
	КонецЦикла;
	
	ОбменCSV.ЗаписатьФайл(ПутьФайла, Колонки, Строки);
	
	Результат.ВсегоСтрок = Строки.Количество();
	Результат.Загружено  = Строки.Количество();
	Результат.ПутьФайла  = ПутьФайла;
	Результат.Вердикт    = ВердиктОтчёта(Результат);
	
	Возврат Результат;
	
КонецФункции

// Выгружает заказы поставщику за период в плоский файл: одна строка файла -
// одна строка табличной части «Услуги», реквизиты шапки повторяются в каждой
// строке своего документа. Плоский вид выбран потому, что заказ без строк
// услуги не несёт данных, а строка без шапки не читается.
//
// Параметры:
//  ПутьФайла - Строка - путь файла выгрузки.
//  ПериодС   - Дата   - начало периода отбора по дате документа (включительно).
//  ПериодПо  - Дата   - конец периода отбора по дате документа (включительно).
//  Отчёт     - Структура, Неопределено - результат НовыйОтчёт(); при
//              Неопределено создаётся новый.
//
// Возвращаемое значение:
//  Структура - результат НовыйОтчёт(): ВсегоСтрок и Загружено равны числу
//              выгруженных строк, ПутьФайла и Вердикт заполнены.
//
Функция ВыгрузитьЗаказы(ПутьФайла, ПериодС, ПериодПо, Отчёт = Неопределено) Экспорт
	
	Результат = ?(Отчёт = Неопределено, НовыйОтчёт(), Отчёт);
	
	Колонки = КолонкиЗаказов();
	
	// СуммаДокумента не выгружается: она вычисляется по строкам услуги и в файле
	// была бы вторым, независимым источником того же итога.
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЗаказПоставщику.Номер КАК Номер,
		|	ЗаказПоставщику.Дата КАК Дата,
		|	ЗаказПоставщику.ЗаявкаНаТур КАК ЗаявкаНаТур,
		|	ЗаказПоставщику.Поставщик КАК Поставщик,
		|	ЗаказПоставщику.Договор КАК Договор,
		|	ЗаказПоставщику.ДатаОжиданияПодтверждения КАК ДатаОжиданияПодтверждения,
		|	ЗаказПоставщику.Статус КАК Статус,
		|	ЗаказПоставщику.Комментарий КАК Комментарий,
		|	ЗаказПоставщику.Ответственный КАК Ответственный,
		|	ЗаказПоставщикуУслуги.Услуга КАК Услуга,
		|	ЗаказПоставщикуУслуги.Объект КАК Объект,
		|	ЗаказПоставщикуУслуги.ДатаНачала КАК ДатаНачала,
		|	ЗаказПоставщикуУслуги.ДатаОкончания КАК ДатаОкончания,
		|	ЗаказПоставщикуУслуги.Количество КАК Количество,
		|	ЗаказПоставщикуУслуги.ТипНомера КАК ТипНомера,
		|	ЗаказПоставщикуУслуги.ТипПитания КАК ТипПитания,
		|	ЗаказПоставщикуУслуги.Цена КАК Цена,
		|	ЗаказПоставщикуУслуги.Сумма КАК Сумма,
		|	ЗаказПоставщикуУслуги.ДополнительныеПараметры КАК ДополнительныеПараметры
		|ИЗ
		|	Документ.ЗаказПоставщику КАК ЗаказПоставщику
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику.Услуги КАК ЗаказПоставщикуУслуги
		|		ПО ЗаказПоставщику.Ссылка = ЗаказПоставщикуУслуги.Ссылка
		|ГДЕ
		|	ЗаказПоставщику.Дата МЕЖДУ &ПериодС И &ПериодПо
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЗаказПоставщику.Номер,
		|	ЗаказПоставщикуУслуги.НомерСтроки";
	Запрос.УстановитьПараметр("ПериодС",  ПериодС);
	Запрос.УстановитьПараметр("ПериодПо", ПериодПо);
	
	Строки = Новый Массив;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		СтрокаДанных = Новый Массив;
		// Шапка повторяется в каждой строке своего документа: файл плоский,
		// и восстановить принадлежность строки иначе было бы нечем.
		СтрокаДанных.Добавить(Выборка.Номер);
		СтрокаДанных.Добавить(ДатаДляФайла(Выборка.Дата));
		СтрокаДанных.Добавить(Строка(Выборка.ЗаявкаНаТур));
		СтрокаДанных.Добавить(Строка(Выборка.Поставщик));
		СтрокаДанных.Добавить(Строка(Выборка.Договор));
		СтрокаДанных.Добавить(ДатаДляФайла(Выборка.ДатаОжиданияПодтверждения));
		// Статус - значение перечисления: в файл идёт его представление,
		// по нему же значение находится при обратной загрузке.
		СтрокаДанных.Добавить(Строка(Выборка.Статус));
		СтрокаДанных.Добавить(Выборка.Комментарий);
		СтрокаДанных.Добавить(Строка(Выборка.Ответственный));
		
		СтрокаДанных.Добавить(Строка(Выборка.Услуга));
		СтрокаДанных.Добавить(Строка(Выборка.Объект));
		СтрокаДанных.Добавить(ДатаДляФайла(Выборка.ДатаНачала));
		СтрокаДанных.Добавить(ДатаДляФайла(Выборка.ДатаОкончания));
		СтрокаДанных.Добавить(ОбменCSV.СформироватьЧисло(Выборка.Количество));
		СтрокаДанных.Добавить(Строка(Выборка.ТипНомера));
		СтрокаДанных.Добавить(Строка(Выборка.ТипПитания));
		СтрокаДанных.Добавить(ОбменCSV.СформироватьЧисло(Выборка.Цена));
		СтрокаДанных.Добавить(ОбменCSV.СформироватьЧисло(Выборка.Сумма));
		СтрокаДанных.Добавить(Строка(Выборка.ДополнительныеПараметры));
		
		Строки.Добавить(СтрокаДанных);
		
	КонецЦикла;
	
	ОбменCSV.ЗаписатьФайл(ПутьФайла, Колонки, Строки);
	
	Результат.ВсегоСтрок = Строки.Количество();
	Результат.Загружено  = Строки.Количество();
	Результат.ПутьФайла  = ПутьФайла;
	Результат.Вердикт    = ВердиктОтчёта(Результат);
	
	Возврат Результат;
	
КонецФункции

// Загружает заказы поставщику из плоского файла: строки с одинаковыми номером
// и датой собираются в один документ, а реквизиты шапки берутся из первой строки
// группы. Файл плоский, поэтому шапка повторяется в каждой строке своего
// документа, и различие шапок внутри группы - признак испорченного файла,
// а не повод выбрать одну из них.
//
// Суммы не читаются: и сумма строки, и сумма документа пересчитываются по
// количеству и цене. Колонка «Сумма» файла - снимок прежнего расчёта, и второй
// независимый источник того же итога сделал бы документ противоречивым.
//
// Параметры:
//  ПутьФайла - Строка - путь файла заказов.
//  Отчёт     - Структура, Неопределено - результат НовыйОтчёт(); при
//              Неопределено создаётся новый.
//
// Возвращаемое значение:
//  Структура - результат НовыйОтчёт(). ВсегоСтрок - число строк файла,
//              Загружено - число записанных документов, Отклонено - число
//              отклонённых документов: строка файла без документа данных
//              не несёт, поэтому загруженной не считается.
//
Функция ЗагрузитьЗаказы(ПутьФайла, Отчёт = Неопределено) Экспорт
	
	Результат = ?(Отчёт = Неопределено, НовыйОтчёт(), Отчёт);
	
	Обязательные = КолонкиЗаказов();
	Прочитанное  = ОбменCSV.ПрочитатьФайл(ПутьФайла);
	КолонкиФайла = Прочитанное.Заголовок;
	СтрокиФайла  = Прочитанное.Строки;
	
	Результат.ВсегоСтрок = СтрокиФайла.Количество();
	Результат.ПутьФайла  = ПутьФайла;
	
	// Заголовок проверяется до обработки строк: без обязательной колонки разбор
	// невозможен, и записывать документы нельзя даже частично.
	Если Не ПроверитьЗаголовокЗаказа(КолонкиФайла, Результат) Тогда
		Результат.Вердикт = "FAIL";
		Возврат Результат;
	КонецЕсли;
	
	Индексы        = СтруктураИндексовКолонок(КолонкиФайла, Обязательные);
	ОжидаемыхПолей = КолонкиФайла.Количество();
	НомерСтроки    = 0;
	
	// Строки, прошедшие разбор. Отклонённая строка в группу не попадает, но номер
	// её документа запоминается отдельно: документ с ошибочной строкой не пишется
	// целиком, иначе он потерял бы часть услуг без следа в базе.
	Принятые        = Новый Массив;
	НомераСОшибками = Новый Соответствие;
	
	Для Каждого ПоляСтроки Из СтрокиФайла Цикл
		
		НомерСтроки = НомерСтроки + 1;
		
		// Номер документа читается первым: по нему строка относится к документу,
		// и без него ошибочную строку не к чему привязать.
		НомерДокумента = ТекстКолонки(ПоляСтроки, Индексы, "Номер");
		
		Если ПоляСтроки.Количество() < ОжидаемыхПолей Тогда
			ОшибкиСтроки = Новый Массив;
			ОшибкиСтроки.Добавить("Строка " + НомерСтроки + ": ожидалось " + ОжидаемыхПолей
				+ " полей, получено " + ПоляСтроки.Количество());
		Иначе
			// Типы проверяются до разрешения ссылок: пока значение поля не
			// приведено к своему типу, искать по нему нечего.
			ОшибкиСтроки = ПроверитьСтрокуЗаказа(ПоляСтроки, Индексы, НомерСтроки);
		КонецЕсли;
		
		Если ОшибкиСтроки.Количество() > 0 Тогда
			Для Каждого ТекстОшибки Из ОшибкиСтроки Цикл
				ДобавитьСообщение(Результат, НомерСтроки, "Ошибка", НомерДокумента, ТекстОшибки);
			КонецЦикла;
			ЗапомнитьНомерСОшибкой(НомераСОшибками, НомерДокумента, НомерСтроки);
			Продолжить;
		КонецЕсли;
		
		Принятые.Добавить(Новый Структура("НомерСтроки, Поля", НомерСтроки, ПоляСтроки));
		
	КонецЦикла;
	
	КонфликтыДат = НомераСРазнымиДатами(Принятые, Индексы);
	Группы       = СгруппироватьСтрокиЗаказов(Принятые, Индексы);
	
	// Отклонённые документы считаются до записи: один документ - одна запись
	// в отчёте, сколько бы ошибочных строк в нём ни было.
	СообщитьОбОшибочныхДокументах(НомераСОшибками, Результат);
	СообщитьОКонфликтахДат(КонфликтыДат, Результат);
	
	Для Каждого ПараГруппы Из Группы Цикл
		
		СтрокиГруппы = ПараГруппы.Значение;
		НомерГруппы  = СтрокиГруппы[0].Номер;
		
		// Номер отклонён целиком: его строки второй раз в отчёт не попадают.
		Если НомераСОшибками.Получить(НомерГруппы) <> Неопределено
			Или КонфликтыДат.Получить(НомерГруппы) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗаписатьДокументЗаказа(СтрокиГруппы, Индексы, Результат) Тогда
			Результат.Загружено = Результат.Загружено + 1;
		Иначе
			Результат.Отклонено = Результат.Отклонено + 1;
		КонецЕсли;
		
	КонецЦикла;
	
	Результат.Вердикт = ВердиктОтчёта(Результат);
	
	Возврат Результат;
	
КонецФункции

Функция ЗагрузитьНоменклатуру(ПутьФайла, Отчёт = Неопределено) Экспорт
	
	Результат = ?(Отчёт = Неопределено, НовыйОтчёт(), Отчёт);
	
	Обязательные = ОбязательныеКолонкиНоменклатуры();
	Прочитанное  = ОбменCSV.ПрочитатьФайл(ПутьФайла);
	КолонкиФайла = Прочитанное.Заголовок;
	СтрокиФайла  = Прочитанное.Строки;
	
	Результат.ВсегоСтрок = СтрокиФайла.Количество();
	Результат.ПутьФайла  = ПутьФайла;
	
	// Заголовок проверяется до обработки строк: без обязательной колонки
	// разбор данных невозможен, и писать в справочник нельзя даже частично.
	ЕстьПропущенные = Ложь;
	Для Каждого ИмяКолонки Из Обязательные Цикл
		Если ПозицияКолонки(КолонкиФайла, ИмяКолонки) < 0 Тогда
			ЕстьПропущенные = Истина;
			ДобавитьСообщение(Результат, 0, "Ошибка", "",
				"Отсутствует обязательная колонка """ + ИмяКолонки + """");
		КонецЕсли;
	КонецЦикла;
	
	Если ЕстьПропущенные Тогда
		Результат.Вердикт = "FAIL";
		Возврат Результат;
	КонецЕсли;
	
	// Лишние колонки не мешают: значения читаются по именам обязательных.
	Для Каждого ИмяКолонки Из КолонкиФайла Цикл
		Если ПозицияКолонки(Обязательные, ИмяКолонки) < 0 Тогда
			ТекстПредупреждения = "Колонка """ + ИмяКолонки + """ проигнорирована";
			Результат.Предупреждения.Добавить(ТекстПредупреждения);
			ДобавитьСообщение(Результат, 0, "Предупреждение", "", ТекстПредупреждения);
		КонецЕсли;
	КонецЦикла;
	
	ОжидаемыхПолей = КолонкиФайла.Количество();
	НомерСтроки    = 0;
	
	// Номера полей берём из заголовка файла, а не из списка обязательных колонок:
	// порядок колонок в файле может не совпадать с порядком в списке.
	ИндексыКолонок = Новый Структура;
	Для Каждого ИмяКолонки Из Обязательные Цикл
		ИндексыКолонок.Вставить(ИмяКолонки, ПозицияКолонки(КолонкиФайла, ИмяКолонки));
	КонецЦикла;
	
	// Коды строк, прошедших разбор, и их номера. Позиция элемента в Кодах равна
	// номеру строки минус один: отклонённая строка оставляет пустую ячейку и не
	// может «занять» код чужой строки. Решение по уникальности принимается после
	// цикла: один запрос требует всех кодов сразу.
	Коды           = Новый Массив;
	ПринятыеСтроки = Новый Массив;
	
	// Группы, объявленные в этом же файле: в базе их ещё нет, но ссылка на такую
	// группу в строке файла корректна - свою строку группа записывает раньше
	// вложенной, поэтому поиск по базе при разборе её не находит.
	ГруппыИзФайла = ИменаГруппИзФайла(СтрокиФайла, ИндексыКолонок);
	
	Для Каждого ПоляСтроки Из СтрокиФайла Цикл
		
		НомерСтроки = НомерСтроки + 1;
		Коды.Добавить("");
		
		Если ПоляСтроки.Количество() < ОжидаемыхПолей Тогда
			Результат.Отклонено = Результат.Отклонено + 1;
			ДобавитьСообщение(Результат, НомерСтроки, "Ошибка", "",
				"Строка " + НомерСтроки + ": ожидалось " + ОжидаемыхПолей + " полей, получено " + ПоляСтроки.Количество());
			Продолжить;
		КонецЕсли;
		
		// Типы проверяются до разрешения ссылок: если само значение поля не является
		// числом или булевым, ссылку не из чего построить, и сообщение об ошибке
		// должно указывать на значение, а не на несуществующий реквизит.
		ОшибкиТипов = ПроверитьТипыСтроки(ПоляСтроки, ИндексыКолонок, НомерСтроки);
		Если ОшибкиТипов.Количество() > 0 Тогда
			Результат.Отклонено = Результат.Отклонено + 1;
			Для Каждого ТекстОшибки Из ОшибкиТипов Цикл
				ДобавитьСообщение(Результат, НомерСтроки, "Ошибка", "", ТекстОшибки);
			КонецЦикла;
			Продолжить;
		КонецЕсли;
		
		// Ссылки разрешаются после проверки типов: пока значение не приведено
		// к своему типу, искать по нему нечего.
		ОшибкиСсылок = ПроверитьСсылкиСтроки(ПоляСтроки, ИндексыКолонок, НомерСтроки, ГруппыИзФайла);
		Если ОшибкиСсылок.Количество() > 0 Тогда
			Результат.Отклонено = Результат.Отклонено + 1;
			Для Каждого ТекстОшибки Из ОшибкиСсылок Цикл
				ДобавитьСообщение(Результат, НомерСтроки, "Ошибка", "", ТекстОшибки);
			КонецЦикла;
			Продолжить;
		КонецЕсли;
		
		// Строка прошла разбор: код запоминается, а допуск к записи проверяется
		// после цикла, когда известны коды всех строк файла. Поля записи готовятся
		// здесь же: после проверки уникальности исходная строка уже не нужна.
		КодСтроки = СокрЛП(Строка(ПоляСтроки[ИндексыКолонок["Код"]]));
		Коды[НомерСтроки - 1] = КодСтроки;
		ПринятыеСтроки.Добавить(Новый Структура("НомерСтроки, Код, Данные",
			НомерСтроки, КодСтроки, ДанныеСтрокиДляЗаписи(ПоляСтроки, ИндексыКолонок, НомерСтроки)));
		
	КонецЦикла;
	
	// Проверка уникальности идёт последней: строка, не прошедшая разбор, не должна
	// «занимать» код и отклонять тем самым чужую корректную строку.
	Уникальность = ПроверитьУникальностьКодов(Коды);
	
	Для Каждого ПринятаяСтрока Из ПринятыеСтроки Цикл
		
		ТекстНарушения = ТекстНарушенияУникальности(Уникальность, ПринятаяСтрока);
		Если Не ПустаяСтрока(ТекстНарушения) Тогда
			Результат.Отклонено = Результат.Отклонено + 1;
			ДобавитьСообщение(Результат, ПринятаяСтрока.НомерСтроки, "Ошибка", "", ТекстНарушения);
			Продолжить;
		КонецЕсли;
		
		// Строка прошла все проверки до записи: она пишется в справочник.
		// «Загружено» - число реально записанных элементов, а не число
		// допустимых строк: отказ правил записи объекта тоже отклоняет строку.
		Если ЗаписатьЭлементНоменклатуры(ПринятаяСтрока.Данные, Результат) Тогда
			Результат.Загружено = Результат.Загружено + 1;
		Иначе
			Результат.Отклонено = Результат.Отклонено + 1;
		КонецЕсли;
		
	КонецЦикла;
	
	// Вердикт считается отдельным методом: тот же расчёт повторяет ЗаписатьОтчёт,
	// и две копии правила рано или поздно разошлись бы.
	Результат.Вердикт = ВердиктОтчёта(Результат);
	
	Возврат Результат;
	
КонецФункции

// Записывает элемент номенклатуры услуг, применяя правила записи объекта.
// Правила проверяются до записи: отказ ПередЗаписью не сообщает, какое именно
// правило нарушено, и строка осталась бы в отчёте без причины.
//
// Параметры:
//  Данные - Структура - поля создаваемого элемента: Код, Наименование (Строка),
//           ЭтоГруппа (Булево), РодительТекст (Строка) и Родитель
//           (СправочникСсылка.НоменклатураУслуг), ВидУслуги
//           (ПеречислениеСсылка.ВидыУслуг), Единица (СправочникСсылка.ЕдиницыИзмерения),
//           БазоваяЦена (Число), Валюта (СправочникСсылка.Валюты), НомерСтроки (Число).
//           Незаполненная ссылка передаётся как Неопределено. Родитель по
//           РодительТекст ищется повторно при записи: группа из того же файла
//           появляется в базе только к моменту записи своей строки.
//  Отчёт  - Структура - результат НовыйОтчёт(); пополняется сообщением об отказе.
//
// Возвращаемое значение:
//  Булево - Истина, если элемент записан; Ложь, если запись отклонена.
//
Функция ЗаписатьЭлементНоменклатуры(Данные, Отчёт) Экспорт
	
	НомерСтроки = Данные.НомерСтроки;
	
	// Справочник создаёт элемент методом СоздатьЭлемент: метода Создать у менеджера
	// справочника нет, и вызов Создать() падает на «Метод объекта не обнаружен».
	// Группа создаётся парным методом СоздатьГруппу: признак группы у справочника
	// выставляется именно так, а не присваиванием ЭтоГруппа.
	Если Данные.ЭтоГруппа Тогда
		Объект = Справочники.НоменклатураУслуг.СоздатьГруппу();
	Иначе
		Объект = Справочники.НоменклатураУслуг.СоздатьЭлемент();
	КонецЕсли;
	Объект.Код          = Данные.Код;
	Объект.Наименование = Данные.Наименование;
	
	// Незаполненные ссылки не присваиваются: реквизиту ссылочного типа нельзя
	// присвоить Неопределено, а создать объект платформа уже дала с пустыми ссылками.
	СсылкаРодителя = Данные.Родитель;
	Если Не ЗначениеЗаполнено(СсылкаРодителя) И Не ПустаяСтрока(Данные.РодительТекст) Тогда
		// Группа, объявленная в этом же файле, при разборе ещё не существовала:
		// искать её нужно здесь, после записи её собственной строки.
		НайденныйРодитель = НайтиСсылкуПоПредставлению("НоменклатураУслуг", Данные.РодительТекст, Истина);
		Если Не НайденныйРодитель.Успех Тогда
			ДобавитьСообщение(Отчёт, НомерСтроки, "Ошибка", "",
				"Строка " + НомерСтроки + ", колонка ""Родитель"": """ + Данные.РодительТекст + """ "
				+ НайденныйРодитель.ТекстОшибки);
			Возврат Ложь;
		КонецЕсли;
		СсылкаРодителя = НайденныйРодитель.Ссылка;
	КонецЕсли;
	Если ЗначениеЗаполнено(СсылкаРодителя) Тогда
		Объект.Родитель = СсылкаРодителя;
	КонецЕсли;
	
	// У группы нет услуги: цена, вид услуги, единица и валюта - реквизиты позиции.
	// Записывать их группе нельзя вообще: платформа отвечает «Реквизит недоступен
	// для группы». Правила записи справочника сами пропускают группы.
	Если Не Данные.ЭтоГруппа Тогда
		Объект.БазоваяЦена = Данные.БазоваяЦена;
		Если ЗначениеЗаполнено(Данные.ВидУслуги) Тогда
			Объект.ВидУслуги = Данные.ВидУслуги;
		КонецЕсли;
		Если ЗначениеЗаполнено(Данные.Единица) Тогда
			Объект.Единица = Данные.Единица;
		КонецЕсли;
		Если ЗначениеЗаполнено(Данные.Валюта) Тогда
			Объект.Валюта = Данные.Валюта;
		КонецЕсли;
	КонецЕсли;
	
	Нарушения = Объект.ПравилаЗаписи(Объект);
	Если Нарушения.Количество() > 0 Тогда
		Для Каждого ТекстНарушения Из Нарушения Цикл
			ДобавитьСообщение(Отчёт, НомерСтроки, "Ошибка", "",
				"Строка " + НомерСтроки + ": " + ТекстНарушения);
		КонецЦикла;
		Возврат Ложь;
	КонецЕсли;
	
	// ОбменДанными.Загрузка не выставляется: элемент обязан пройти те же проверки,
	// что и введённый вручную. Транзакция на один элемент: отказ по одной строке
	// не должен откатывать уже записанные строки файла.
	НачатьТранзакцию();
	Попытка
		Объект.Записать();
		Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
			ВызватьИсключение "Запись отклонена правилами объекта";
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ДобавитьСообщение(Отчёт, НомерСтроки, "Ошибка", "",
			"Строка " + НомерСтроки + ": " + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции

// Ищет единственный элемент справочника по наименованию.
// Наименование - то единственное представление ссылки, которое есть в файле,
// поэтому поиск идёт запросом, а не обходом Выбрать(): на большом справочнике
// обход дал бы ту же ошибку, но заметно позже.
//
// Параметры:
//  ИмяСправочника - Строка - имя справочника метаданных, например "НоменклатураУслуг".
//  Значение       - Строка - наименование так, как оно записано в файле.
//  ТолькоГруппы    - Булево - Истина, если искать только среди групп (ЭтоГруппа = Истина).
//
// Возвращаемое значение:
//  Структура - Ссылка (Неопределено при неуспехе), Успех (Булево),
//              ТекстОшибки (Строка, пустая при успехе).
//
Функция НайтиСсылкуПоПредставлению(ИмяСправочника, Значение, ТолькоГруппы = Ложь) Экспорт
	
	Результат = Новый Структура("Ссылка, Успех, ТекстОшибки", Неопределено, Ложь, "");
	
	// Поле ЭтоГруппа есть только у иерархических справочников, поэтому условие
	// по группам добавляется в текст запроса, а не задаётся параметром:
	// обращение к отсутствующему полю платформа отвергает на разборе запроса.
	ТекстУсловия = "";
	Если ТолькоГруппы = Истина Тогда
		ТекстУсловия = "
			|	И ЭтоГруппа = ИСТИНА";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Ссылка КАК Ссылка
		|ИЗ
		|	Справочник." + ИмяСправочника + "
		|ГДЕ
		|	Наименование = &Значение" + ТекстУсловия;
	Запрос.УстановитьПараметр("Значение", Значение);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Найденные = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Найденные.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Если Найденные.Количество() = 0 Тогда
		Результат.ТекстОшибки = "не найдено в справочнике """ + ИмяСправочника + """";
	ИначеЕсли Найденные.Количество() > 1 Тогда
		// Две записи с одинаковым наименованием: выбрать за человека нельзя.
		Результат.ТекстОшибки = "неоднозначная ссылка, найдено " + Найденные.Количество() + " вариантов";
	Иначе
		Результат.Ссылка = Найденные[0];
		Результат.Успех  = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Ищет договор поставщика по наименованию в пределах этого поставщика.
//
// Договоры разных поставщиков могут называться одинаково, поэтому поиск по
// одному наименованию разрешил бы заказу сослаться на чужой договор. Найденный
// у другого владельца договор - это не «не найдено»: файл ссылается на
// существующий договор, и человеку нужно сказать именно об этом.
//
// Параметры:
//  Поставщик - СправочникСсылка.Поставщики - владелец искомого договора.
//  Значение  - Строка - наименование так, как оно записано в файле.
//
// Возвращаемое значение:
//  Структура - Ссылка (Неопределено при неуспехе), Успех (Булево),
//              ТекстОшибки (Строка, пустая при успехе).
//
Функция НайтиДоговорПоставщика(Поставщик, Значение) Экспорт
	
	Возврат НайтиОбъектВладельца("ДоговорыСПоставщиками", "Договор", Поставщик, Значение);
	
КонецФункции

// Ищет объект гостеприимства поставщика по наименованию в пределах этого
// поставщика. Правило то же, что и у договора: чужой объект - отдельный,
// называемый вслух случай, а не молчаливое «не найдено».
//
// Параметры:
//  Поставщик - СправочникСсылка.Поставщики - владелец искомого объекта.
//  Значение  - Строка - наименование так, как оно записано в файле.
//
// Возвращаемое значение:
//  Структура - Ссылка (Неопределено при неуспехе), Успех (Булево),
//              ТекстОшибки (Строка, пустая при успехе).
//
Функция НайтиОбъектПоставщика(Поставщик, Значение) Экспорт
	
	Возврат НайтиОбъектВладельца("ОбъектыГостеприимства", "Объект", Поставщик, Значение);
	
КонецФункции

// Ищет значение перечисления по его представлению.
//
// Параметры:
//  ИмяПеречисления - Строка - имя перечисления метаданных, например "ВидыУслуг".
//  Значение        - Строка - представление значения так, как оно записано в файле.
//
// Возвращаемое значение:
//  Структура - Ссылка (Неопределено при неуспехе), Успех (Булево),
//              ТекстОшибки (Строка, пустая при успехе).
//
Функция НайтиПеречисление(ИмяПеречисления, Значение) Экспорт
	
	Результат = Новый Структура("Ссылка, Успех, ТекстОшибки", Неопределено, Ложь, "");
	
	ПеречислениеМетаданных = Метаданные.Перечисления.Найти(ИмяПеречисления);
	Если ПеречислениеМетаданных = Неопределено Тогда
		Результат.ТекстОшибки = "перечисление """ + ИмяПеречисления + """ отсутствует в конфигурации";
		Возврат Результат;
	КонецЕсли;
	
	// Свойство объекта метаданных перечисления называется ЗначенияПеречисления:
	// у Перечисления в конфигураторе ветка «Значения», но в коде имя другое.
	КоллекцияЗначений = ПеречислениеМетаданных.ЗначенияПеречисления;
	
	Для Каждого ЗначениеМетаданных Из КоллекцияЗначений Цикл
		
		// Сравнение и по представлению, и по имени: представление значения может
		// быть переопределено в конфигурации, а в файле пишется именно оно.
		Если Строка(ЗначениеМетаданных) = Значение Или ЗначениеМетаданных.Имя = Значение Тогда
			// В два шага: 1С не применяет [] к результату [].
			Перечисление = Перечисления[ИмяПеречисления];
			Результат.Ссылка = Перечисление[ЗначениеМетаданных.Имя];
			Результат.Успех  = Истина;
			Возврат Результат;
		КонецЕсли;
		
	КонецЦикла;
	
	Результат.ТекстОшибки = "не найдено в перечислении """ + ИмяПеречисления + """";
	
	Возврат Результат;
	
КонецФункции

// Проверяет коды строк файла на уникальность внутри файла и на отсутствие в базе.
// Один запрос на все коды: по запросу на строку обработка большого файла
// упиралась бы в число обращений к базе, а не в объём данных.
//
// Параметры:
//  Коды - Массив - коды в порядке следования строк файла; позиция элемента
//                  совпадает с номером строки минус один. Пустая строка
//                  означает отклонённую ранее строку и не проверяется.
//
// Возвращаемое значение:
//  Структура - Дубли (Соответствие: код -> номер первого вхождения)
//              Существующие (Соответствие: код -> количество элементов в базе)
//              Повторы (Соответствие: код -> Массив всех номеров строк с этим кодом).
//
Функция ПроверитьУникальностьКодов(Коды) Экспорт
	
	Результат = Новый Структура("Дубли, Существующие, Повторы");
	// Соответствие, а не Структура: ключом служит произвольный код из файла,
	// а имя свойства в Структуре не может начинаться с цифры.
	Результат.Дубли        = Новый Соответствие;
	Результат.Существующие = Новый Соответствие;
	Результат.Повторы      = Новый Соответствие;
	
	ВсеВхождения    = Новый Соответствие;
	КодыДляЗапроса  = Новый Массив;
	
	Для Индекс = 0 По Коды.Количество() - 1 Цикл
		
		КодСтроки = СокрЛП(Строка(Коды[Индекс]));
		Если ПустаяСтрока(КодСтроки) Тогда
			Продолжить;
		КонецЕсли;
		
		НомераСтрок = ВсеВхождения.Получить(КодСтроки);
		Если НомераСтрок = Неопределено Тогда
			НомераСтрок = Новый Массив;
			ВсеВхождения.Вставить(КодСтроки, НомераСтрок);
			// В запрос код попадает один раз: КОЛИЧЕСТВО(*) считает элементы
			// справочника, а не вхождения в файл.
			КодыДляЗапроса.Добавить(КодСтроки);
		КонецЕсли;
		НомераСтрок.Добавить(Индекс + 1);
		
	КонецЦикла;
	
	// Дублем считается код, который встретился больше одного раза. Отклоняются
	// все его строки, а не только вторая: по файлу нельзя понять, какая из них
	// верна, и выбрать за человека одну - значит записать случайные данные.
	Для Каждого Вхождения Из ВсеВхождения Цикл
		Если Вхождения.Значение.Количество() > 1 Тогда
			Результат.Дубли.Вставить(Вхождения.Ключ, Вхождения.Значение[0]);
			Результат.Повторы.Вставить(Вхождения.Ключ, Вхождения.Значение);
		КонецЕсли;
	КонецЦикла;
	
	Если КодыДляЗапроса.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Код КАК Код,
		|	КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ
		|	Справочник.НоменклатураУслуг
		|ГДЕ
		|	Код В (&Коды)
		|СГРУППИРОВАТЬ ПО
		|	Код";
	Запрос.УстановитьПараметр("Коды", КодыДляЗапроса);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		// Ключ приводится к той же форме, что и код из файла: иначе код
		// с выравнивающими пробелами не нашёлся бы в Соответствии.
		Результат.Существующие.Вставить(СокрЛП(Строка(Выборка.Код)), Выборка.Количество);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Ищет элемент подчинённого справочника по наименованию и владельцу.
//
// Запрос идёт по одному наименованию, без условия по владельцу: только так
// видно разницу между «такого нет» и «такое есть, но у другого поставщика».
// Разделение по владельцу делается в коде - два запроса дали бы ту же картину,
// но потребовали бы внятно объяснить, почему второго не нашлось.
//
// Параметры:
//  ИмяСправочника - Строка - имя подчинённого справочника метаданных.
//  ИмяПонятия     - Строка - как назвать предмет в сообщении: "Договор", "Объект".
//  Поставщик      - СправочникСсылка.Поставщики - ожидаемый владелец.
//  Значение       - Строка - наименование так, как оно записано в файле.
//
// Возвращаемое значение:
//  Структура - Ссылка (Неопределено при неуспехе), Успех (Булево),
//              ТекстОшибки (Строка, пустая при успехе).
//
Функция НайтиОбъектВладельца(ИмяСправочника, ИмяПонятия, Поставщик, Значение)
	
	Результат = Новый Структура("Ссылка, Успех, ТекстОшибки", Неопределено, Ложь, "");
	
	// Без владельца сузить поиск нечем: сравнение с пустой ссылкой нашло бы
	// только осиротевшие записи и выдало бы чужой договор за свой.
	Если Не ЗначениеЗаполнено(Поставщик) Тогда
		Результат.ТекстОшибки = ИмяПонятия + " """ + Значение + """ не найден: не указан поставщик";
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Ссылка КАК Ссылка,
		|	Владелец КАК Владелец
		|ИЗ
		|	Справочник." + ИмяСправочника + "
		|ГДЕ
		|	Наименование = &Значение";
	Запрос.УстановитьПараметр("Значение", Значение);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Свои  = Новый Массив;
	Чужие = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Если Выборка.Владелец = Поставщик Тогда
			Свои.Добавить(Выборка.Ссылка);
		Иначе
			Чужие.Добавить(Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;
	
	Если Свои.Количество() = 1 Тогда
		Результат.Ссылка = Свои[0];
		Результат.Успех  = Истина;
	ИначеЕсли Свои.Количество() > 1 Тогда
		// Две записи с одинаковым наименованием у одного владельца: выбрать
		// за человека нельзя, и угадывание было бы хуже ошибки.
		Результат.ТекстОшибки = "неоднозначная ссылка, найдено " + Свои.Количество() + " вариантов";
	ИначеЕсли Чужие.Количество() > 0 Тогда
		Результат.ТекстОшибки = ИмяПонятия + " """ + Значение + """ принадлежит другому поставщику";
	Иначе
		Результат.ТекстОшибки = "не найдено в справочнике """ + ИмяСправочника + """";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Приводит дату к тексту файла. Пустая дата пишется пустой строкой, а не
// «0001-01-01»: незаполненный реквизит должен читаться обратно как незаполненный.
//
// Параметры:
//  Значение - Дата - значение реквизита.
//
// Возвращаемое значение:
//  Строка - дата в формате ОбменCSV.СформироватьДату или пустая строка.
//
Функция ДатаДляФайла(Значение)
	
	Возврат ?(ЗначениеЗаполнено(Значение), ОбменCSV.СформироватьДату(Значение), "");
	
КонецФункции

// Возвращает номер колонки в массиве имён или -1, если колонки нет.
Функция ПозицияКолонки(Колонки, Имя)
	
	Для Индекс = 0 По Колонки.Количество() - 1 Цикл
		Если Колонки[Индекс] = Имя Тогда
			Возврат Индекс;
		КонецЕсли;
	КонецЦикла;
	
	Возврат -1;
	
КонецФункции

// Возвращает текст значения колонки строки или пустую строку, если колонки нет.
Функция ТекстКолонки(Поля, Индексы, ИмяКолонки)
	
	Индекс = Индексы[ИмяКолонки];
	Если Индекс < 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат СокрЛП(Строка(Поля[Индекс]));
	
КонецФункции

// Собирает наименования групп, объявленных в загружаемом файле.
// Нужен проверке ссылок: родитель из этого же файла существует в файле, но не
// в базе, и без такого списка строка отвергалась бы как «ссылка не найдена».
//
// Параметры:
//  СтрокиФайла - Массив - строки файла в порядке следования.
//  Индексы     - Структура - имя колонки -> номер поля в строке; -1, если колонки нет.
//
// Возвращаемое значение:
//  Соответствие - наименование группы -> Истина.
//
Функция ИменаГруппИзФайла(СтрокиФайла, Индексы)
	
	Имена = Новый Соответствие;
	
	ИндексГруппы = Индексы["ЭтоГруппа"];
	Если ИндексГруппы < 0 Тогда
		Возврат Имена;
	КонецЕсли;
	
	Для Каждого ПоляСтроки Из СтрокиФайла Цикл
		
		// Короткая строка ещё не проверена и в список попасть не должна.
		Если ПоляСтроки.Количество() <= ИндексГруппы Тогда
			Продолжить;
		КонецЕсли;
		
		Приведение = ОбменCSV.ПривестиКБулеву(ПоляСтроки[ИндексГруппы]);
		Если Не Приведение.Успех Или Не Приведение.Значение Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяГруппы = ТекстКолонки(ПоляСтроки, Индексы, "Наименование");
		Если Не ПустаяСтрока(ИмяГруппы) Тогда
			Имена.Вставить(ИмяГруппы, Истина);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Имена;
	
КонецФункции

// Собирает поля записи из строки файла. Значения приводятся тем же способом,
// каким их проверяли: иначе проверка и запись могли бы понять одно и то же
// значение по-разному. Пустая ячейка ссылки означает «не заполнено».
//
// Параметры:
//  Поля        - Массив - значения полей строки.
//  Индексы     - Структура - имя колонки -> номер поля в строке; -1, если колонки нет.
//  НомерСтроки - Число - номер строки данных для сообщений об отказе записи.
//
// Возвращаемое значение:
//  Структура - поля создаваемого элемента; см. ЗаписатьЭлементНоменклатуры.
//
Функция ДанныеСтрокиДляЗаписи(Поля, Индексы, НомерСтроки)
	
	Данные = Новый Структура;
	Данные.Вставить("НомерСтроки",  НомерСтроки);
	Данные.Вставить("Код",          ТекстКолонки(Поля, Индексы, "Код"));
	Данные.Вставить("Наименование", ТекстКолонки(Поля, Индексы, "Наименование"));
	Данные.Вставить("БазоваяЦена",  ОбменCSV.ПривестиКЧислу(Поля[Индексы["БазоваяЦена"]]).Значение);
	
	// Ссылки разрешаются повторно, но тем же поиском, каким их проверяли:
	// строка дошла до записи только потому, что поиск нашёл единственный объект.
	// Текст родителя сохраняется и при неудачном поиске: группу из этого же файла
	// при разборе ещё не видно, и искать её придётся при записи строки.
	РодительТекст = ТекстКолонки(Поля, Индексы, "Родитель");
	Данные.Вставить("РодительТекст", РодительТекст);
	Данные.Вставить("Родитель", ?(ПустаяСтрока(РодительТекст), Неопределено,
		НайтиСсылкуПоПредставлению("НоменклатураУслуг", РодительТекст, Истина).Ссылка));
	
	// Признак группы приводится тем же способом, каким его проверяли; пустая
	// ячейка означает обычную позицию.
	ПриведениеГруппы = ОбменCSV.ПривестиКБулеву(ТекстКолонки(Поля, Индексы, "ЭтоГруппа"));
	Данные.Вставить("ЭтоГруппа", ?(ПриведениеГруппы.Успех, ПриведениеГруппы.Значение, Ложь));
	
	ВидУслугиТекст = ТекстКолонки(Поля, Индексы, "ВидУслуги");
	Данные.Вставить("ВидУслуги", ?(ПустаяСтрока(ВидУслугиТекст), Неопределено,
		НайтиПеречисление("ВидыУслуг", ВидУслугиТекст).Ссылка));
	
	ЕдиницаТекст = ТекстКолонки(Поля, Индексы, "Единица");
	Данные.Вставить("Единица", ?(ПустаяСтрока(ЕдиницаТекст), Неопределено,
		НайтиСсылкуПоПредставлению("ЕдиницыИзмерения", ЕдиницаТекст, Ложь).Ссылка));
	
	ВалютаТекст = ТекстКолонки(Поля, Индексы, "Валюта");
	Данные.Вставить("Валюта", ?(ПустаяСтрока(ВалютаТекст), Неопределено,
		НайтиСсылкуПоПредставлению("Валюты", ВалютаТекст, Ложь).Ссылка));
	
	Возврат Данные;
	
КонецФункции

// Проверяет, что значения типизированных колонок строки приводятся к своим типам.
// Проверка не отвергает значения, допустимые по типу но недопустимые по смыслу
// (например, отрицательную цену): это дело правил записи, а не разбора.
//
// Параметры:
//  Поля        - Массив - значения полей строки в порядке следования в файле.
//  Индексы     - Структура - имя колонки -> номер поля в строке; -1, если колонки нет.
//  НомерСтроки - Число - номер строки данных для текста сообщения.
//
// Возвращаемое значение:
//  Массив - тексты ошибок по соглашению
//           «Строка N, колонка "<имя>": <суть>, получено "<значение>"».
//
Функция ПроверитьТипыСтроки(Поля, Индексы, НомерСтроки)
	
	Ошибки = Новый Массив;
	
	ДобавитьОшибкуТипа(Ошибки, Поля, Индексы, "БазоваяЦена", НомерСтроки, Ложь);
	ДобавитьОшибкуТипа(Ошибки, Поля, Индексы, "ЭтоГруппа", НомерСтроки, Истина);
	
	Возврат Ошибки;
	
КонецФункции

// Приводит значение одной колонки к ожидаемому типу и, если не удалось,
// дописывает сообщение об ошибке в переданный массив.
//
// Параметры:
//  Ошибки      - Массив - накопитель текстов ошибок.
//  Поля        - Массив - значения полей строки.
//  Индексы     - Структура - имя колонки -> номер поля в строке.
//  ИмяКолонки  - Строка - имя проверяемой колонки.
//  НомерСтроки - Число - номер строки данных.
//  ЭтоБулево   - Булево - Истина, если ожидается булево, иначе число.
//
Процедура ДобавитьОшибкуТипа(Ошибки, Поля, Индексы, ИмяКолонки, НомерСтроки, ЭтоБулево)
	
	Индекс = Индексы[ИмяКолонки];
	Если Индекс < 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЗначениеПоля = Поля[Индекс];
	
	Если ЭтоБулево Тогда
		Приведение = ОбменCSV.ПривестиКБулеву(ЗначениеПоля);
	Иначе
		Приведение = ОбменCSV.ПривестиКЧислу(ЗначениеПоля);
	КонецЕсли;
	
	Если Приведение.Успех Тогда
		Возврат;
	КонецЕсли;
	
	СутьОшибки = ?(ЭтоБулево, "не удалось привести к булеву", "не удалось привести к числу");
	
	Ошибки.Добавить("Строка " + НомерСтроки + ", колонка """ + ИмяКолонки + """: "
		+ СутьОшибки + ", получено """ + Строка(ЗначениеПоля) + """");
	
КонецПроцедуры

// Проверяет, что ссылочные колонки строки разрешаются в существующие объекты.
// Пустое значение не ищется: незаполненная ссылка - не ошибка разбора,
// а для Родителя пустая строка вообще означает верхний уровень.
//
// Параметры:
//  Поля        - Массив - значения полей строки в порядке следования в файле.
//  Индексы     - Структура - имя колонки -> номер поля в строке; -1, если колонки нет.
//  НомерСтроки - Число - номер строки данных для текста сообщения.
//  ГруппыИзФайла - Соответствие, Неопределено - наименования групп, объявленных
//                  в этом же файле: ссылка на них корректна, хотя в базе их ещё нет.
//
// Возвращаемое значение:
//  Массив - тексты ошибок по соглашению «Строка N, колонка "<имя>": <суть>».
//
Функция ПроверитьСсылкиСтроки(Поля, Индексы, НомерСтроки, ГруппыИзФайла = Неопределено)
	
	Ошибки = Новый Массив;
	
	ДобавитьОшибкуПеречисления(Ошибки, Поля, Индексы, "ВидУслуги", "ВидыУслуг", НомерСтроки);
	ДобавитьОшибкуСправочника(Ошибки, Поля, Индексы, "Единица", "ЕдиницыИзмерения", НомерСтроки, Ложь);
	ДобавитьОшибкуСправочника(Ошибки, Поля, Индексы, "Валюта", "Валюты", НомерСтроки, Ложь);
	// Родитель ищется только среди групп: позиция родителем быть не может.
	// Группа, объявленная в этом же файле, при разборе ещё отсутствует в базе:
	// её запись идёт раньше вложенной строки, поэтому ссылку проверять нечем.
	ИмяРодителя = ТекстКолонки(Поля, Индексы, "Родитель");
	Если Не ПустаяСтрока(ИмяРодителя) И ГруппыИзФайла <> Неопределено
		И ГруппыИзФайла.Получить(ИмяРодителя) <> Неопределено Тогда
		// Ссылка появится к моменту записи строки и будет разрешена там же.
	Иначе
		ДобавитьОшибкуСправочника(Ошибки, Поля, Индексы, "Родитель", "НоменклатураУслуг", НомерСтроки, Истина);
	КонецЕсли;
	
	Возврат Ошибки;
	
КонецФункции

// Проверяет одну ссылочную колонку по справочнику и дописывает ошибку в накопитель.
//
// Параметры:
//  Ошибки         - Массив - накопитель текстов ошибок.
//  Поля           - Массив - значения полей строки.
//  Индексы        - Структура - имя колонки -> номер поля в строке.
//  ИмяКолонки     - Строка - имя проверяемой колонки.
//  ИмяСправочника - Строка - имя справочника, в котором ищется значение.
//  НомерСтроки    - Число - номер строки данных.
//  ТолькоГруппы   - Булево - Истина, если допустимы только группы справочника.
//
Процедура ДобавитьОшибкуСправочника(Ошибки, Поля, Индексы, ИмяКолонки, ИмяСправочника, НомерСтроки, ТолькоГруппы)
	
	Индекс = Индексы[ИмяКолонки];
	Если Индекс < 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЗначениеПоля = СокрЛП(Строка(Поля[Индекс]));
	Если ПустаяСтрока(ЗначениеПоля) Тогда
		Возврат;
	КонецЕсли;
	
	Найденное = НайтиСсылкуПоПредставлению(ИмяСправочника, ЗначениеПоля, ТолькоГруппы);
	Если Найденное.Успех Тогда
		Возврат;
	КонецЕсли;
	
	Ошибки.Добавить("Строка " + НомерСтроки + ", колонка """ + ИмяКолонки + """: """
		+ ЗначениеПоля + """ " + Найденное.ТекстОшибки);
	
КонецПроцедуры

// Проверяет одну колонку-перечисление и дописывает ошибку в накопитель.
//
// Параметры:
//  Ошибки          - Массив - накопитель текстов ошибок.
//  Поля            - Массив - значения полей строки.
//  Индексы         - Структура - имя колонки -> номер поля в строке.
//  ИмяКолонки      - Строка - имя проверяемой колонки.
//  ИмяПеречисления - Строка - имя перечисления, в котором ищется значение.
//  НомерСтроки     - Число - номер строки данных.
//
Процедура ДобавитьОшибкуПеречисления(Ошибки, Поля, Индексы, ИмяКолонки, ИмяПеречисления, НомерСтроки)
	
	Индекс = Индексы[ИмяКолонки];
	Если Индекс < 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЗначениеПоля = СокрЛП(Строка(Поля[Индекс]));
	Если ПустаяСтрока(ЗначениеПоля) Тогда
		Возврат;
	КонецЕсли;
	
	Найденное = НайтиПеречисление(ИмяПеречисления, ЗначениеПоля);
	Если Найденное.Успех Тогда
		Возврат;
	КонецЕсли;
	
	Ошибки.Добавить("Строка " + НомерСтроки + ", колонка """ + ИмяКолонки + """: """
		+ ЗначениеПоля + """ " + Найденное.ТекстОшибки);
	
КонецПроцедуры

// Возвращает текст нарушения уникальности кода для строки, прошедшей разбор.
// Порядок проверок важен: дубль внутри файла сообщается раньше, чем наличие
// в базе, потому что именно разбор файла решает, можно ли им пользоваться.
//
// Параметры:
//  Уникальность   - Структура - результат ПроверитьУникальностьКодов.
//  ПринятаяСтрока - Структура - НомерСтроки и Код проверяемой строки.
//
// Возвращаемое значение:
//  Строка - текст ошибки; пустая строка, если код допустим.
//
Функция ТекстНарушенияУникальности(Уникальность, ПринятаяСтрока)
	
	НомераСтрок = Уникальность.Повторы.Получить(ПринятаяСтрока.Код);
	Если НомераСтрок <> Неопределено Тогда
		// Отклоняются обе строки: какая из них верна, из файла не следует.
		// Первая отсылает к повтору, остальные - к первому вхождению.
		Если ПринятаяСтрока.НомерСтроки = НомераСтрок[0] Тогда
			Возврат "Строка " + ПринятаяСтрока.НомерСтроки + ": код """ + ПринятаяСтрока.Код
				+ """ повторяется в строке " + НомераСтрок[1];
		КонецЕсли;
		Возврат "Строка " + ПринятаяСтрока.НомерСтроки + ": код """ + ПринятаяСтрока.Код
			+ """ уже встречался в строке " + НомераСтрок[0];
	КонецЕсли;
	
	КоличествоВБазе = Уникальность.Существующие.Получить(ПринятаяСтрока.Код);
	Если КоличествоВБазе = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Если КоличествоВБазе > 1 Тогда
		// Код перестал быть идентификатором: выбрать, к какому элементу
		// относится строка, нельзя, поэтому строка отклоняется.
		Возврат "Строка " + ПринятаяСтрока.НомерСтроки + ": код """ + ПринятаяСтрока.Код
			+ """ неоднозначен, в базе " + КоличествоВБазе + " элементов";
	КонецЕсли;
	
	Возврат "Строка " + ПринятаяСтрока.НомерСтроки + ": элемент с кодом """ + ПринятаяСтрока.Код
		+ """ уже существует";
	
КонецФункции

Процедура ДобавитьСообщение(Отчёт, НомерСтроки, Уровень, Объект, Текст)
	
	СтрокаОшибки = Отчёт.Ошибки.Добавить();
	СтрокаОшибки.Строка    = НомерСтроки;
	СтрокаОшибки.Уровень   = Уровень;
	СтрокаОшибки.Объект    = Объект;
	СтрокаОшибки.Сообщение = Текст;
	
КонецПроцедуры

Функция ПредставлениеРодителя(Родитель)
	
	Если Не ЗначениеЗаполнено(Родитель) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Родитель.Наименование;
	
КонецФункции

// Возвращает номера полей обязательных колонок по заголовку файла.
// Номера берутся у заголовка, а не у списка обязательных колонок: порядок
// колонок в файле может не совпадать с порядком в списке.
//
// Параметры:
//  КолонкиФайла - Массив - имена колонок в порядке следования в файле.
//  Обязательные - Массив - имена обязательных колонок.
//
// Возвращаемое значение:
//  Структура - имя колонки -> номер поля в строке; -1, если колонки нет.
//
Функция СтруктураИндексовКолонок(КолонкиФайла, Обязательные)
	
	Индексы = Новый Структура;
	Для Каждого ИмяКолонки Из Обязательные Цикл
		Индексы.Вставить(ИмяКолонки, ПозицияКолонки(КолонкиФайла, ИмяКолонки));
	КонецЦикла;
	
	Возврат Индексы;
	
КонецФункции

// Проверяет заголовок файла заказов и пополняет отчёт сообщениями о колонках:
// отсутствующая обязательная колонка - ошибка, лишняя - предупреждение.
//
// Параметры:
//  КолонкиФайла - Массив - имена колонок в порядке следования в файле.
//  Отчёт        - Структура - результат НовыйОтчёт(); пополняется сообщениями.
//
// Возвращаемое значение:
//  Булево - Истина, если все обязательные колонки на месте.
//
Функция ПроверитьЗаголовокЗаказа(КолонкиФайла, Отчёт)
	
	Обязательные    = КолонкиЗаказов();
	ЕстьПропущенные = Ложь;
	
	Для Каждого ИмяКолонки Из Обязательные Цикл
		Если ПозицияКолонки(КолонкиФайла, ИмяКолонки) < 0 Тогда
			ЕстьПропущенные = Истина;
			ДобавитьСообщение(Отчёт, 0, "Ошибка", "",
				"Отсутствует обязательная колонка """ + ИмяКолонки + """");
		КонецЕсли;
	КонецЦикла;
	
	// Лишние колонки не мешают: значения читаются по именам обязательных,
	// но файл, собранный не этой обработкой, стоит отметить в отчёте.
	Для Каждого ИмяКолонки Из КолонкиФайла Цикл
		Если ПозицияКолонки(Обязательные, ИмяКолонки) >= 0 Тогда
			Продолжить;
		КонецЕсли;
		ТекстПредупреждения = "Колонка """ + ИмяКолонки + """ проигнорирована";
		Отчёт.Предупреждения.Добавить(ТекстПредупреждения);
		ДобавитьСообщение(Отчёт, 0, "Предупреждение", "", ТекстПредупреждения);
	КонецЦикла;
	
	Возврат Не ЕстьПропущенные;
	
КонецФункции

// Сообщает об отчёте по документам, у которых есть строки, не прошедшие разбор.
// Документ с ошибочной строкой не пишется целиком: записать его без части услуг
// значит потерять данные молча.
//
// Параметры:
//  НомераСОшибками - Соответствие - номер документа -> массив номеров ошибочных строк.
//  Отчёт           - Структура - результат НовыйОтчёт(); пополняется сообщениями.
//
Процедура СообщитьОбОшибочныхДокументах(НомераСОшибками, Отчёт)
	
	Для Каждого НомерСОшибкой Из НомераСОшибками Цикл
		
		Отчёт.Отклонено = Отчёт.Отклонено + 1;
		НомераОшибочныхСтрок = НомерСОшибкой.Значение;
		
		Если ПустаяСтрока(НомерСОшибкой.Ключ) Тогда
			ДобавитьСообщение(Отчёт, НомераОшибочныхСтрок[0], "Ошибка", "",
				"Документ не записан: в строке " + НомераОшибочныхСтрок[0] + " не прочитан номер документа");
		Иначе
			ДобавитьСообщение(Отчёт, НомераОшибочныхСтрок[0], "Ошибка", НомерСОшибкой.Ключ,
				"Документ """ + НомерСОшибкой.Ключ + """ не записан: в файле "
				+ НомераОшибочныхСтрок.Количество() + " ошибочных строк");
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Сообщает о номерах, которые встретились в файле с разными датами.
// Ошибка относится ко всему номеру: какая из дат верна, из файла не следует,
// а два документа с одним номером записать нельзя.
//
// Параметры:
//  КонфликтыДат - Соответствие - результат НомераСРазнымиДатами.
//  Отчёт        - Структура - результат НовыйОтчёт(); пополняется сообщениями.
//
Процедура СообщитьОКонфликтахДат(КонфликтыДат, Отчёт)
	
	Для Каждого КонфликтДат Из КонфликтыДат Цикл
		
		Отчёт.Отклонено = Отчёт.Отклонено + 1;
		ДанныеКонфликта = КонфликтДат.Значение;
		ДобавитьСообщение(Отчёт, ДанныеКонфликта.НомерСтроки, "Ошибка", КонфликтДат.Ключ,
			"Номер """ + КонфликтДат.Ключ + """ встречается с разными датами ("
			+ ДанныеКонфликта.ПерваяДата + " и " + ДанныеКонфликта.ВтораяДата + ")");
		
	КонецЦикла;
	
КонецПроцедуры

// Проверяет строку файла заказов: типы значений, даты и разрешимость ссылок.
// Проверка не отвергает значения, допустимые по типу, но недопустимые по смыслу
// (пустой ответственный, отрицательная цена): это дело правил записи документа,
// которые срабатывают при Записать().
//
// Параметры:
//  Поля        - Массив - значения полей строки в порядке следования в файле.
//  Индексы     - Структура - имя колонки -> номер поля в строке; -1, если колонки нет.
//  НомерСтроки - Число - номер строки данных для текста сообщения.
//
// Возвращаемое значение:
//  Массив - тексты ошибок по соглашению
//           «Строка N, колонка "<имя>": <суть>, получено "<значение>"».
//
Функция ПроверитьСтрокуЗаказа(Поля, Индексы, НомерСтроки)
	
	Ошибки = Новый Массив;
	
	// Номер и дата - ключ группировки: без них строку не к чему отнести.
	Если ПустаяСтрока(ТекстКолонки(Поля, Индексы, "Номер")) Тогда
		Ошибки.Добавить("Строка " + НомерСтроки + ", колонка ""Номер"": номер документа не заполнен");
	КонецЕсли;
	ДобавитьОшибкуДаты(Ошибки, Поля, Индексы, "Дата", НомерСтроки, Истина);
	ДобавитьОшибкуДаты(Ошибки, Поля, Индексы, "ДатаОжиданияПодтверждения", НомерСтроки, Ложь);
	ДобавитьОшибкуДаты(Ошибки, Поля, Индексы, "ДатаНачала", НомерСтроки, Ложь);
	ДобавитьОшибкуДаты(Ошибки, Поля, Индексы, "ДатаОкончания", НомерСтроки, Ложь);
	
	// Количество и цена - единственный источник суммы: колонка «Сумма» из файла
	// игнорируется, поэтому и проверять её незачем.
	ДобавитьОшибкуТипа(Ошибки, Поля, Индексы, "Количество", НомерСтроки, Ложь);
	ДобавитьОшибкуТипа(Ошибки, Поля, Индексы, "Цена", НомерСтроки, Ложь);
	
	ДобавитьОшибкуПеречисления(Ошибки, Поля, Индексы, "Статус", "СтатусыЗаказа", НомерСтроки);
	ДобавитьОшибкуСправочника(Ошибки, Поля, Индексы, "ЗаявкаНаТур", "ЗаявкиНаТур", НомерСтроки, Ложь);
	ДобавитьОшибкуСправочника(Ошибки, Поля, Индексы, "Поставщик", "Поставщики", НомерСтроки, Ложь);
	ДобавитьОшибкуСправочника(Ошибки, Поля, Индексы, "Договор", "ДоговорыСПоставщиками", НомерСтроки, Ложь);
	ДобавитьОшибкуСправочника(Ошибки, Поля, Индексы, "Ответственный", "Сотрудники", НомерСтроки, Ложь);
	ДобавитьОшибкуСправочника(Ошибки, Поля, Индексы, "Услуга", "НоменклатураУслуг", НомерСтроки, Ложь);
	ДобавитьОшибкуСправочника(Ошибки, Поля, Индексы, "Объект", "ОбъектыГостеприимства", НомерСтроки, Ложь);
	
	Возврат Ошибки;
	
КонецФункции

// Проверяет одну колонку-дату и дописывает ошибку в накопитель.
//
// Параметры:
//  Ошибки      - Массив - накопитель текстов ошибок.
//  Поля        - Массив - значения полей строки.
//  Индексы     - Структура - имя колонки -> номер поля в строке.
//  ИмяКолонки  - Строка - имя проверяемой колонки.
//  НомерСтроки - Число - номер строки данных.
//  Обязательна - Булево - Истина, если пустая дата считается ошибкой.
//
Процедура ДобавитьОшибкуДаты(Ошибки, Поля, Индексы, ИмяКолонки, НомерСтроки, Обязательна)
	
	Индекс = Индексы[ИмяКолонки];
	Если Индекс < 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТекстЗначения = СокрЛП(Строка(Поля[Индекс]));
	
	Если ПустаяСтрока(ТекстЗначения) Тогда
		Если Обязательна Тогда
			Ошибки.Добавить("Строка " + НомерСтроки + ", колонка """ + ИмяКолонки
				+ """: не заполнено обязательное значение");
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если ОбменCSV.ПривестиКДате(ТекстЗначения).Успех Тогда
		Возврат;
	КонецЕсли;
	
	Ошибки.Добавить("Строка " + НомерСтроки + ", колонка """ + ИмяКолонки
		+ """: не удалось привести к дате, получено """ + ТекстЗначения + """");
	
КонецПроцедуры

// Запоминает номер строки, не прошедшей разбор, за её документом.
//
// Параметры:
//  НомераСОшибками - Соответствие - номер документа -> массив номеров строк.
//  НомерДокумента  - Строка - номер документа из строки; пустая строка, если не прочитан.
//  НомерСтроки     - Число - номер строки данных.
//
Процедура ЗапомнитьНомерСОшибкой(НомераСОшибками, НомерДокумента, НомерСтроки)
	
	НомераСтрок = НомераСОшибками.Получить(НомерДокумента);
	Если НомераСтрок = Неопределено Тогда
		НомераСтрок = Новый Массив;
		НомераСОшибками.Вставить(НомерДокумента, НомераСтрок);
	КонецЕсли;
	
	НомераСтрок.Добавить(НомерСтроки);
	
КонецПроцедуры

// Возвращает дату документа строки в формате файла ГГГГ-ММ-ДД.
// Пустая строка означает, что дата не прочитана: такие строки до группировки
// не доходят, их отсеивает разбор.
//
// Параметры:
//  Поля    - Массив - значения полей строки.
//  Индексы - Структура - имя колонки -> номер поля в строке.
//
// Возвращаемое значение:
//  Строка - дата в формате ОбменCSV.СформироватьДату или пустая строка.
//
Функция ТекстДатыСтроки(Поля, Индексы)
	
	Индекс = Индексы["Дата"];
	Если Индекс < 0 Или Индекс >= Поля.Количество() Тогда
		Возврат "";
	КонецЕсли;
	
	Приведение = ОбменCSV.ПривестиКДате(Поля[Индекс]);
	Если Не Приведение.Успех Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат ОбменCSV.СформироватьДату(Приведение.Значение);
	
КонецФункции

// Находит номера документов, которые встречаются в файле с разными датами.
// Такой номер отклоняется целиком: номер уникален только внутри года, но два
// документа с одним номером и разными датами - разные документы, и какой из
// них имел в виду файл, из файла не следует.
//
// Параметры:
//  Строки  - Массив - структуры разобранных строк: НомерСтроки и Поля.
//  Индексы - Структура - имя колонки -> номер поля в строке.
//
// Возвращаемое значение:
//  Соответствие - номер документа -> Структура("ПерваяДата, ВтораяДата, НомерСтроки"):
//                 даты в формате файла и номер строки первого расхождения.
//
Функция НомераСРазнымиДатами(Строки, Индексы)
	
	Результат    = Новый Соответствие;
	ПервыеДаты   = Новый Соответствие;
	
	Для Каждого СтрокаЗаказа Из Строки Цикл
		
		Поля           = СтрокаЗаказа.Поля;
		НомерДокумента = ТекстКолонки(Поля, Индексы, "Номер");
		ТекстДаты      = ТекстДатыСтроки(Поля, Индексы);
		
		Если ПустаяСтрока(НомерДокумента) Или ПустаяСтрока(ТекстДаты) Тогда
			// Такие строки отсеяны разбором: без номера и даты группировать нечего.
			Продолжить;
		КонецЕсли;
		
		Первая = ПервыеДаты.Получить(НомерДокумента);
		Если Первая = Неопределено Тогда
			ПервыеДаты.Вставить(НомерДокумента,
				Новый Структура("ТекстДаты, НомерСтроки", ТекстДаты, СтрокаЗаказа.НомерСтроки));
			Продолжить;
		КонецЕсли;
		
		Если Первая.ТекстДаты = ТекстДаты Тогда
			Продолжить;
		КонецЕсли;
		
		// Первое расхождение и есть ошибка номера: третью дату перечислять
		// незачем, документ по этому номеру всё равно не пишется.
		Если Результат.Получить(НомерДокумента) = Неопределено Тогда
			Результат.Вставить(НомерДокумента, Новый Структура("ПерваяДата, ВтораяДата, НомерСтроки",
				Первая.ТекстДаты, ТекстДаты, СтрокаЗаказа.НомерСтроки));
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Группирует разобранные строки файла в документы по ключу «номер|дата».
// Ключ включает дату, потому что номер документа уникален только внутри года.
//
// Параметры:
//  Строки  - Массив - структуры разобранных строк: НомерСтроки и Поля.
//  Индексы - Структура - имя колонки -> номер поля в строке.
//
// Возвращаемое значение:
//  Соответствие - "Номер|ГГГГ-ММ-ДД" -> Массив структур
//                 ("НомерСтроки, Номер, Дата, Поля") в порядке следования строк файла.
//
Функция СгруппироватьСтрокиЗаказов(Строки, Индексы) Экспорт
	
	Группы = Новый Соответствие;
	
	Для Каждого СтрокаЗаказа Из Строки Цикл
		
		Поля           = СтрокаЗаказа.Поля;
		НомерДокумента = ТекстКолонки(Поля, Индексы, "Номер");
		ТекстДаты      = ТекстДатыСтроки(Поля, Индексы);
		
		Если ПустаяСтрока(НомерДокумента) Или ПустаяСтрока(ТекстДаты) Тогда
			Продолжить;
		КонецЕсли;
		
		Ключ = НомерДокумента + "|" + ТекстДаты;
		
		СтрокиГруппы = Группы.Получить(Ключ);
		Если СтрокиГруппы = Неопределено Тогда
			СтрокиГруппы = Новый Массив;
			Группы.Вставить(Ключ, СтрокиГруппы);
		КонецЕсли;
		
		СтрокиГруппы.Добавить(Новый Структура("НомерСтроки, Номер, Дата, Поля",
			СтрокаЗаказа.НомерСтроки, НомерДокумента,
			ОбменCSV.ПривестиКДате(Поля[Индексы["Дата"]]).Значение, Поля));
		
	КонецЦикла;
	
	Возврат Группы;
	
КонецФункции

// Собирает документ заказа из всех строк одной группы и записывает его.
// Шапка берётся из первой строки группы: файл плоский, и каждая строка
// документа несёт одну и ту же шапку.
//
// Параметры:
//  СтрокиГруппы - Массив - структуры строк группы: НомерСтроки, Номер, Дата, Поля.
//  Индексы      - Структура - имя колонки -> номер поля в строке.
//  Отчёт        - Структура - результат НовыйОтчёт(); пополняется сообщением об отказе.
//
// Возвращаемое значение:
//  Булево - Истина, если документ записан.
//
Функция ЗаписатьДокументЗаказа(СтрокиГруппы, Индексы, Отчёт)
	
	ПерваяСтрока = СтрокиГруппы[0];
	НомерСтроки  = ПерваяСтрока.НомерСтроки;
	ПоляШапки    = ПерваяСтрока.Поля;
	
	Объект = Документы.ЗаказПоставщику.СоздатьДокумент();
	Объект.Номер = ПерваяСтрока.Номер;
	Объект.Дата  = ПерваяСтрока.Дата;
	
	// Незаполненные ссылки не присваиваются: реквизиту ссылочного типа нельзя
	// присвоить Неопределено, а созданный документ уже имеет пустые ссылки.
	Заявка = СсылкаПоТексту("ЗаявкиНаТур", ПоляШапки, Индексы, "ЗаявкаНаТур");
	Если Заявка <> Неопределено Тогда
		Объект.ЗаявкаНаТур = Заявка;
	КонецЕсли;
	
	// Поставщик разрешается первым: договор и объекты ищутся в его пределах,
	// и без него сузить поиск нечем.
	ТекстПоставщика = ТекстКолонки(ПоляШапки, Индексы, "Поставщик");
	ПоставщикЗаказа = СсылкаПоТексту("Поставщики", ПоляШапки, Индексы, "Поставщик");
	Если ПоставщикЗаказа <> Неопределено Тогда
		Объект.Поставщик = ПоставщикЗаказа;
	ИначеЕсли Не ПустаяСтрока(ТекстПоставщика) Тогда
		// Поставщик указан, но в базе его нет: молча оставить реквизит пустым
		// значило бы отдать причину отказа правилам записи документа.
		ДобавитьСообщение(Отчёт, НомерСтроки, "Ошибка", ПерваяСтрока.Номер,
			"Документ """ + ПерваяСтрока.Номер + """ не записан, строка " + НомерСтроки
			+ ", колонка ""Поставщик"": """ + ТекстПоставщика + """ не найдено в справочнике ""Поставщики""");
		Возврат Ложь;
	КонецЕсли;
	
	// Договор ищется в пределах выбранного поставщика: одноимённый договор
	// другого поставщика этому заказу не принадлежит.
	ТекстДоговора = ТекстКолонки(ПоляШапки, Индексы, "Договор");
	Если Не ПустаяСтрока(ТекстДоговора) Тогда
		НайденныйДоговор = НайтиДоговорПоставщика(ПоставщикЗаказа, ТекстДоговора);
		Если Не НайденныйДоговор.Успех Тогда
			ДобавитьСообщение(Отчёт, НомерСтроки, "Ошибка", ПерваяСтрока.Номер,
				"Документ """ + ПерваяСтрока.Номер + """ не записан, строка " + НомерСтроки
				+ ", колонка ""Договор"": " + НайденныйДоговор.ТекстОшибки);
			Возврат Ложь;
		КонецЕсли;
		Объект.Договор = НайденныйДоговор.Ссылка;
	КонецЕсли;
	
	ОтветственныйЗаказа = СсылкаПоТексту("Сотрудники", ПоляШапки, Индексы, "Ответственный");
	Если ОтветственныйЗаказа <> Неопределено Тогда
		Объект.Ответственный = ОтветственныйЗаказа;
	КонецЕсли;
	
	СтатусЗаказа = ПеречислениеПоТексту("СтатусыЗаказа", ПоляШапки, Индексы, "Статус");
	Если СтатусЗаказа <> Неопределено Тогда
		Объект.Статус = СтатусЗаказа;
	КонецЕсли;
	
	ДатаОжиданияЗаказа = ДатаПоТексту(ПоляШапки, Индексы, "ДатаОжиданияПодтверждения");
	Если ДатаОжиданияЗаказа <> Неопределено Тогда
		Объект.ДатаОжиданияПодтверждения = ДатаОжиданияЗаказа;
	КонецЕсли;
	
	Объект.Комментарий = ТекстКолонки(ПоляШапки, Индексы, "Комментарий");
	
	Для Каждого СтрокаГруппы Из СтрокиГруппы Цикл
		
		ПоляСтроки    = СтрокаГруппы.Поля;
		СтрокаТаблицы = Объект.Услуги.Добавить();
		
		// Услуга, указанная в файле, но не найденная в справочнике, - это отказ
		// с номером строки: оставить её пустой значило бы отдать причину
		// правилам записи, и отчёт назвал бы строку табличной части, а не файла.
		ТекстУслуги    = ТекстКолонки(ПоляСтроки, Индексы, "Услуга");
		УслугаСтроки   = СсылкаПоТексту("НоменклатураУслуг", ПоляСтроки, Индексы, "Услуга");
		Если УслугаСтроки <> Неопределено Тогда
			СтрокаТаблицы.Услуга = УслугаСтроки;
		ИначеЕсли Не ПустаяСтрока(ТекстУслуги) Тогда
			ДобавитьСообщение(Отчёт, СтрокаГруппы.НомерСтроки, "Ошибка", ПерваяСтрока.Номер,
				"Документ """ + ПерваяСтрока.Номер + """ не записан, строка " + СтрокаГруппы.НомерСтроки
				+ ", колонка ""Услуга"": """ + ТекстУслуги + """ не найдено в справочнике ""НоменклатураУслуг""");
			Возврат Ложь;
		КонецЕсли;
		
		// Объект тоже ищется в пределах поставщика заказа: чужой объект
		// сделал бы строку противоречивой.
		ТекстОбъекта = ТекстКолонки(ПоляСтроки, Индексы, "Объект");
		Если Не ПустаяСтрока(ТекстОбъекта) Тогда
			НайденныйОбъект = НайтиОбъектПоставщика(ПоставщикЗаказа, ТекстОбъекта);
			Если Не НайденныйОбъект.Успех Тогда
				ДобавитьСообщение(Отчёт, СтрокаГруппы.НомерСтроки, "Ошибка", ПерваяСтрока.Номер,
					"Документ """ + ПерваяСтрока.Номер + """ не записан, строка " + СтрокаГруппы.НомерСтроки
					+ ", колонка ""Объект"": " + НайденныйОбъект.ТекстОшибки);
				Возврат Ложь;
			КонецЕсли;
			СтрокаТаблицы.Объект = НайденныйОбъект.Ссылка;
		КонецЕсли;
		
		ДатаНачалаСтроки = ДатаПоТексту(ПоляСтроки, Индексы, "ДатаНачала");
		Если ДатаНачалаСтроки <> Неопределено Тогда
			СтрокаТаблицы.ДатаНачала = ДатаНачалаСтроки;
		КонецЕсли;
		
		ДатаОкончанияСтроки = ДатаПоТексту(ПоляСтроки, Индексы, "ДатаОкончания");
		Если ДатаОкончанияСтроки <> Неопределено Тогда
			СтрокаТаблицы.ДатаОкончания = ДатаОкончанияСтроки;
		КонецЕсли;
		
		СтрокаТаблицы.ТипНомера               = ТекстКолонки(ПоляСтроки, Индексы, "ТипНомера");
		СтрокаТаблицы.ТипПитания              = ТекстКолонки(ПоляСтроки, Индексы, "ТипПитания");
		СтрокаТаблицы.ДополнительныеПараметры = ТекстКолонки(ПоляСтроки, Индексы, "ДополнительныеПараметры");
		
		КоличествоУслуги = ОбменCSV.ПривестиКЧислу(ПоляСтроки[Индексы["Количество"]]).Значение;
		ЦенаУслуги       = ОбменCSV.ПривестиКЧислу(ПоляСтроки[Индексы["Цена"]]).Значение;
		
		СтрокаТаблицы.Количество = КоличествоУслуги;
		СтрокаТаблицы.Цена       = ЦенаУслуги;
		// Значение колонки «Сумма» из файла игнорируется: сумма строки считается
		// по количеству и цене, иначе файл мог бы принести противоречивый итог.
		СтрокаТаблицы.Сумма = РасчётКомпенсаций.РассчитатьСуммуСтроки(КоличествоУслуги, ЦенаУслуги);
		
	КонецЦикла;
	
	Объект.СуммаДокумента = РасчётКомпенсаций.СуммаТабличнойЧасти(Объект.Услуги);
	
	// Правила записи проверяются до транзакции: отказ должен попасть в отчёт
	// с номером документа, а не превратиться в молчаливую пустую ссылку.
	Нарушения = Объект.ПравилаЗаписи(Объект);
	Если Нарушения.Количество() > 0 Тогда
		Для Каждого ТекстНарушения Из Нарушения Цикл
			ДобавитьСообщение(Отчёт, НомерСтроки, "Ошибка", ПерваяСтрока.Номер,
				"Документ """ + ПерваяСтрока.Номер + """ не записан: " + ТекстНарушения);
		КонецЦикла;
		Возврат Ложь;
	КонецЕсли;
	
	// Запись без проведения: проведение требует данных, которых в файле нет,
	// и частично проведённый заказ хуже непроведённого. Транзакция на документ:
	// отказ по одному документу не должен откатывать уже записанные документы.
	НачатьТранзакцию();
	Попытка
		Объект.Записать();
		// Отказ в ПередЗаписью не бросает исключение: платформа просто оставляет
		// ссылку пустой. Без этой проверки отчёт объявил бы документ записанным.
		Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
			ВызватьИсключение "Запись отклонена правилами объекта";
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ДобавитьСообщение(Отчёт, НомерСтроки, "Ошибка", ПерваяСтрока.Номер,
			"Документ """ + ПерваяСтрока.Номер + """ не записан: " + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции

// Возвращает ссылку справочника по представлению из колонки строки.
// Пустое значение и ненайденное представление дают Неопределено: вызывающий
// не присваивает такое значение реквизиту, а оставляет его пустым.
//
// Параметры:
//  ИмяСправочника - Строка - имя справочника метаданных.
//  Поля           - Массив - значения полей строки.
//  Индексы        - Структура - имя колонки -> номер поля в строке.
//  ИмяКолонки     - Строка - имя читаемой колонки.
//
// Возвращаемое значение:
//  СправочникСсылка, Неопределено - найденная ссылка или Неопределено.
//
Функция СсылкаПоТексту(ИмяСправочника, Поля, Индексы, ИмяКолонки)
	
	ТекстЗначения = ТекстКолонки(Поля, Индексы, ИмяКолонки);
	Если ПустаяСтрока(ТекстЗначения) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Найденное = НайтиСсылкуПоПредставлению(ИмяСправочника, ТекстЗначения, Ложь);
	
	Возврат ?(Найденное.Успех, Найденное.Ссылка, Неопределено);
	
КонецФункции

// Возвращает значение перечисления по представлению из колонки строки.
//
// Параметры:
//  ИмяПеречисления - Строка - имя перечисления метаданных.
//  Поля            - Массив - значения полей строки.
//  Индексы         - Структура - имя колонки -> номер поля в строке.
//  ИмяКолонки      - Строка - имя читаемой колонки.
//
// Возвращаемое значение:
//  ПеречислениеСсылка, Неопределено - найденное значение или Неопределено.
//
Функция ПеречислениеПоТексту(ИмяПеречисления, Поля, Индексы, ИмяКолонки)
	
	ТекстЗначения = ТекстКолонки(Поля, Индексы, ИмяКолонки);
	Если ПустаяСтрока(ТекстЗначения) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Найденное = НайтиПеречисление(ИмяПеречисления, ТекстЗначения);
	
	Возврат ?(Найденное.Успех, Найденное.Ссылка, Неопределено);
	
КонецФункции

// Возвращает дату из колонки строки.
//
// Параметры:
//  Поля       - Массив - значения полей строки.
//  Индексы    - Структура - имя колонки -> номер поля в строке.
//  ИмяКолонки - Строка - имя читаемой колонки.
//
// Возвращаемое значение:
//  Дата, Неопределено - прочитанная дата; Неопределено для пустого значения.
//
Функция ДатаПоТексту(Поля, Индексы, ИмяКолонки)
	
	Индекс = Индексы[ИмяКолонки];
	Если Индекс < 0 Или Индекс >= Поля.Количество() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Приведение = ОбменCSV.ПривестиКДате(Поля[Индекс]);
	Если Не Приведение.Успех Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Приведение.Значение;
	
КонецФункции

#КонецОбласти
