#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыбратьФайл(Команда)
	
	// Путь выбирается всегда в режиме сохранения: файл обмена создаёт выгрузка,
	// а загрузка читает уже существующий файл, который можно набрать руками в поле.
	ДиалогФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	ДиалогФайла.Заголовок     = "Файл обмена";
	ДиалогФайла.Фильтр        = "CSV файлы (*.csv)|*.csv|Все файлы (*.*)|*.*";
	ДиалогФайла.Расширение    = "csv";
	Если ЗначениеЗаполнено(ПутьФайла) Тогда
		ДиалогФайла.ПолноеИмяФайла = ПутьФайла;
	КонецЕсли;
	
	Если Не ДиалогФайла.Выбрать() Тогда
		// Диалог отменён: прежде записанный путь остаётся, иначе отмена стёрла бы
		// выбор, сделанный в прошлый раз.
		Возврат;
	КонецЕсли;
	
	Если Не ПустаяСтрока(ДиалогФайла.ПолноеИмяФайла) Тогда
		ПутьФайла = ДиалогФайла.ПолноеИмяФайла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьНоменклатуру(Команда)
	
	Если Не ПроверитьПутьФайла() Тогда
		Возврат;
	КонецЕсли;
	
	РезультатОбмена = ВыгрузитьНоменклатуруНаСервере(ПутьФайла);
	ПоказатьРезультат(РезультатОбмена);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьЗаказы(Команда)
	
	Если Не ПроверитьПутьФайла() Тогда
		Возврат;
	КонецЕсли;
	
	Если ПериодС > ПериодПо Тогда
		ПоказатьПредупреждение(, "Дата начала периода позже даты окончания");
		Возврат;
	КонецЕсли;
	
	РезультатОбмена = ВыгрузитьЗаказыНаСервере(ПутьФайла, ПериодС, ПериодПо);
	ПоказатьРезультат(РезультатОбмена);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьНоменклатуру(Команда)
	
	Если Не ПроверитьПутьФайла() Тогда
		Возврат;
	КонецЕсли;
	
	РезультатОбмена = ЗагрузитьНоменклатуруНаСервере(ПутьФайла);
	ПоказатьРезультат(РезультатОбмена);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьЗаказы(Команда)
	
	Если Не ПроверитьПутьФайла() Тогда
		Возврат;
	КонецЕсли;
	
	РезультатОбмена = ЗагрузитьЗаказыНаСервере(ПутьФайла);
	ПоказатьРезультат(РезультатОбмена);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиОповещений

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Переносит отчёт обмена в таблицу формы и сообщает пользователю итог.
//
// Параметры:
//  ОтчётОбмена - Структура - результат метода обработки НовыйОтчёт().
//
&НаСервере
Процедура ПоказатьРезультат(Знач ОтчётОбмена)
	
	// Таблица очищается целиком: строки прошлого обмена описывают другой файл,
	// и вперемешку со свежими они читались бы как один результат.
	ТаблицаРезультата.Очистить();
	
	Для Каждого СтрокаОшибки Из ОтчётОбмена.Ошибки Цикл
		НоваяСтрока = ТаблицаРезультата.Добавить();
		НоваяСтрока.Строка    = СтрокаОшибки.Строка;
		НоваяСтрока.Уровень   = СтрокаОшибки.Уровень;
		НоваяСтрока.Объект    = СтрокаОшибки.Объект;
		НоваяСтрока.Сообщение = СтрокаОшибки.Сообщение;
	КонецЦикла;
	
	// Вердикт считает обработка: то же правило пишется в текстовый отчёт, и две
	// копии расчёта рано или поздно разошлись бы.
	Вердикт = Обработки.ОбменСФайлами.Создать().ВердиктОтчёта(ОтчётОбмена);
	
	ТекстИтога = "Записано: " + ОтчётОбмена.Загружено + ", отклонено: " + ОтчётОбмена.Отклонено;
	Сообщить(ТекстИтога);
	
КонецПроцедуры

// Проверяет, что путь файла обмена задан, и предупреждает пользователя, если нет.
//
// Возвращаемое значение:
//  Булево - Истина, если путь заполнен; Ложь, если пользователь предупреждён.
//
&НаКлиенте
Функция ПроверитьПутьФайла()
	
	Если ЗначениеЗаполнено(ПутьФайла) Тогда
		Возврат Истина;
	КонецЕсли;
	
	ПоказатьПредупреждение(, "Выберите файл");
	Возврат Ложь;
	
КонецФункции

&НаСервере
Функция ВыгрузитьНоменклатуруНаСервере(Знач ПутьВыгрузки)
	
	ОбработкаОбмена = Обработки.ОбменСФайлами.Создать();
	Возврат ОбработкаОбмена.ВыгрузитьНоменклатуру(ПутьВыгрузки);
	
КонецФункции

&НаСервере
Функция ВыгрузитьЗаказыНаСервере(Знач ПутьВыгрузки, Знач НачалоПериода, Знач КонецПериода)
	
	ОбработкаОбмена = Обработки.ОбменСФайлами.Создать();
	Возврат ОбработкаОбмена.ВыгрузитьЗаказы(ПутьВыгрузки, НачалоПериода, КонецПериода);
	
КонецФункции

&НаСервере
Функция ЗагрузитьНоменклатуруНаСервере(Знач ПутьЗагрузки)
	
	ОбработкаОбмена = Обработки.ОбменСФайлами.Создать();
	Возврат ОбработкаОбмена.ЗагрузитьНоменклатуру(ПутьЗагрузки);
	
КонецФункции

&НаСервере
Функция ЗагрузитьЗаказыНаСервере(Знач ПутьЗагрузки)
	
	ОбработкаОбмена = Обработки.ОбменСФайлами.Создать();
	Возврат ОбработкаОбмена.ЗагрузитьЗаказы(ПутьЗагрузки);
	
КонецФункции

#КонецОбласти
