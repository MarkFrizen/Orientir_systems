#Область ОбработчикиКоманд

&НаКлиенте
Процедура ВыполнитьПроверку(Команда)
	
	Сводка = ВыполнитьПроверкуНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ВыполнитьПроверкуНаСервере()
	
	ПараметрыВыполнения = Новый Структура;
	ПараметрыВыполнения.Вставить("СоздаватьЗадачи", СоздаватьЗадачи);
	
	РезультатВыполнения = Объект.ВыполнитьОбработку(ПараметрыВыполнения);
	
	Просрочки.Очистить();
	Для Каждого СтрокаПросрочки Из РезультатВыполнения.Просрочки Цикл
		НоваяСтрока = Просрочки.Добавить();
		НоваяСтрока.Вид = СтрокаПросрочки.Вид;
		НоваяСтрока.Объект = СтрокаПросрочки.Объект;
		НоваяСтрока.Ответственный = СтрокаПросрочки.Ответственный;
		НоваяСтрока.ПросроченоНа = СтрокаПросрочки.ПросроченоНа;
	КонецЦикла;
	
	Возврат "Просрочек: " + РезультатВыполнения.Просрочки.Количество()
		+ ", создано задач: " + РезультатВыполнения.СозданоЗадач;
	
КонецФункции

#КонецОбласти
