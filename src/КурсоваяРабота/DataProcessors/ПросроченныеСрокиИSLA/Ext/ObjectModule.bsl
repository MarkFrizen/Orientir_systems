#Область ПрограммныйИнтерфейс

// Выявляет просроченные сроки: SLA открытых запросов туристов и контрольные
// сроки подтверждения услуг по заказам поставщикам.
//
// Проверяются два вида сроков. Первый - срок SLA запросов туристов на
// маршруте (документы ЗаявкаТуристаНаМаршруте в незакрытых статусах): срок
// считается просроченным, если он наступил раньше даты отсчёта. Второй -
// контрольный срок подтверждения услуги (общий модуль КонтрольСроков):
// услуга заказа поставщику считается просроченной, если по ней нет записи
// регистра СтатусыПодтверждений со статусом «Подтверждён», а контрольная
// дата, вычисленная по виду услуги от даты начала оказания, уже прошла.
// При установленном флаге «Создавать задачи» на каждую просрочку создаётся
// задача ответственному через общий модуль ЗадачиИсполнителям; повторный
// запуск не дублирует задачи: открытая задача по тому же основанию
// пропускается.
//
// Параметры:
//  ПараметрыВыполнения - Структура - необязательные ключи:
//   * ДатаОтсчёта     - Дата   - момент проверки (пусто - текущая дата сеанса);
//   * СоздаватьЗадачи - Булево - создавать задачи ответственным;
//   * Объекты         - Массив - ссылки документов ЗаявкаТуристаНаМаршруте
//                                и ЗаказПоставщику для проверки, пусто - все.
//
// Возвращаемое значение:
//  Структура - результат проверки:
//   * Просрочки     - ТаблицаЗначений - колонки Вид, Объект, Ответственный,
//                                        ПросроченоНа (минут);
//   * СозданоЗадач  - Число - число созданных задач.
//
Функция ВыполнитьОбработку(ПараметрыВыполнения = Неопределено) Экспорт
	
	Параметры = НормализоватьПараметры(ПараметрыВыполнения);
	
	Просрочки = Новый ТаблицаЗначений;
	Просрочки.Колонки.Добавить("Вид");
	Просрочки.Колонки.Добавить("Объект");
	Просрочки.Колонки.Добавить("Ответственный");
	Просрочки.Колонки.Добавить("ПросроченоНа");
	
	СобратьПросрочкиSLA(Параметры, Просрочки);
	СобратьПросрочкиПодтверждений(Параметры, Просрочки);
	
	СозданоЗадач = 0;
	Если Параметры.СоздаватьЗадачи Тогда
		СозданоЗадач = СоздатьЗадачиПоПросрочкам(Просрочки);
	КонецЕсли;
	
	Возврат Новый Структура("Просрочки, СозданоЗадач", Просрочки, СозданоЗадач);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает структуру параметров с значениями по умолчанию для незаполненных.
//
// Параметры:
//  ПараметрыВыполнения - Структура, Неопределено - произвольные параметры вызова.
//
// Возвращаемое значение:
//  Структура - нормализованные параметры выполнения.
//
Функция НормализоватьПараметры(ПараметрыВыполнения)
	
	Параметры = Новый Структура;
	Параметры.Вставить("ДатаОтсчёта", ТекущаяДатаСеанса());
	Параметры.Вставить("СоздаватьЗадачи", Ложь);
	Параметры.Вставить("Объекты", Новый Массив);
	
	Если ТипЗнч(ПараметрыВыполнения) = Тип("Структура") Тогда
		Значение = Неопределено;
		Если ПараметрыВыполнения.Свойство("ДатаОтсчёта", Значение) И ЗначениеЗаполнено(Значение) Тогда
			Параметры.ДатаОтсчёта = Значение;
		КонецЕсли;
		Если ПараметрыВыполнения.Свойство("СоздаватьЗадачи", Значение) Тогда
			Параметры.СоздаватьЗадачи = Булево(Значение);
		КонецЕсли;
		Если ПараметрыВыполнения.Свойство("Объекты", Значение) И ТипЗнч(Значение) = Тип("Массив") Тогда
			Параметры.Объекты = Значение;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Параметры;
	
КонецФункции

// Собирает просрочки сроков SLA открытых запросов туристов.
//
// Параметры:
//  Параметры - Структура - нормализованные параметры выполнения.
//  Просрочки - ТаблицаЗначений - пополняемая таблица просрочек.
//
Процедура СобратьПросрочкиSLA(Параметры, Просрочки)
	
	ОткрытыеСтатусы = Новый СписокЗначений;
	ОткрытыеСтатусы.Добавить(Перечисления.СтатусыЗапроса.Новый);
	ОткрытыеСтатусы.Добавить(Перечисления.СтатусыЗапроса.ВРаботе);
	ОткрытыеСтатусы.Добавить(Перечисления.СтатусыЗапроса.ОжидаетПоставщика);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЗапросыТуристов.Ссылка КАК Ссылка,
		|	ЗапросыТуристов.СрокSLA КАК СрокSLA,
		|	ЗапросыТуристов.Ответственный КАК Ответственный
		|ИЗ
		|	Документ.ЗаявкаТуристаНаМаршруте КАК ЗапросыТуристов
		|ГДЕ
		|	НЕ ЗапросыТуристов.ПометкаУдаления
		|	И ЗапросыТуристов.Статус В (&ОткрытыеСтатусы)
		|	И ЗапросыТуристов.СрокSLA <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		|	И ЗапросыТуристов.СрокSLA < &ДатаОтсчёта
|	И (НЕ &ОграничитьПоОбъектам ИЛИ ЗапросыТуристов.Ссылка В (&Объекты))
		|
		|УПОРЯДОЧИТЬ ПО ЗапросыТуристов.СрокSLA, ЗапросыТуристов.Ссылка";
	Запрос.УстановитьПараметр("ОткрытыеСтатусы", ОткрытыеСтатусы);
	Запрос.УстановитьПараметр("ДатаОтсчёта", Параметры.ДатаОтсчёта);
	УстановитьФильтрПоОбъектам(Запрос, Параметры);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДобавитьПросрочку(Просрочки, "SLA запроса туриста", Выборка.Ссылка,
			Выборка.Ответственный, МинутыПросрочки(Выборка.СрокSLA, Параметры.ДатаОтсчёта));
	КонецЦикла;
	
КонецПроцедуры

// Собирает просрочки контрольных сроков подтверждения услуг по заказам.
//
// Параметры:
//  Параметры - Структура - нормализованные параметры выполнения.
//  Просрочки - ТаблицаЗначений - пополняемая таблица просрочек.
//
Процедура СобратьПросрочкиПодтверждений(Параметры, Просрочки)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЗаказыПоставщикам.Ссылка КАК Заказ,
		|	ЗаказыПоставщикам.Ответственный КАК Ответственный,
		|	ЗаказыУслуги.Услуга КАК Услуга,
		|	ЗаказыУслуги.ДатаНачала КАК ДатаНачала,
		|	НоменклатураУслуг.ВидУслуги КАК ВидУслуги
		|ИЗ
		|	Документ.ЗаказПоставщику КАК ЗаказыПоставщикам
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику.Услуги КАК ЗаказыУслуги
		|		ПО ЗаказыУслуги.Ссылка = ЗаказыПоставщикам.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НоменклатураУслуг КАК НоменклатураУслуг
		|		ПО НоменклатураУслуг.Ссылка = ЗаказыУслуги.Услуга
		|ГДЕ
		|	НЕ ЗаказыПоставщикам.ПометкаУдаления
		|	И ЗаказыПоставщикам.Статус <> &СтатусОтклонён
|	И (НЕ &ОграничитьПоОбъектам ИЛИ ЗаказыПоставщикам.Ссылка В (&Объекты))
		|
		|УПОРЯДОЧИТЬ ПО ЗаказыПоставщикам.Дата, ЗаказыПоставщикам.Ссылка, ЗаказыУслуги.НомерСтроки";
	Запрос.УстановитьПараметр("СтатусОтклонён", Перечисления.СтатусыЗаказа.Отклонён);
	УстановитьФильтрПоОбъектам(Запрос, Параметры);
	
	ПодтверждённыеУслуги = ПодтверждённыеУслугиЗаказов();
	СрокиПоВидамУслуг = Новый Соответствие;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если Не ЗначениеЗаполнено(Выборка.Услуга) Или Не ЗначениеЗаполнено(Выборка.ДатаНачала) Тогда
			Продолжить;
		КонецЕсли;
		
		ПодтвержденияЗаказа = ПодтверждённыеУслуги.Получить(Выборка.Заказ);
		Если ПодтвержденияЗаказа <> Неопределено
			И ПодтвержденияЗаказа.Получить(Выборка.Услуга) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СрокДней = Неопределено;
		КэшСрока = СрокиПоВидамУслуг.Получить(Выборка.ВидУслуги);
		Если КэшСрока = Неопределено Тогда
			СрокДней = КонтрольСроков.КонтрольныйСрок(Выборка.ВидУслуги);
			СрокиПоВидамУслуг.Вставить(Выборка.ВидУслуги, Новый Структура("Срок", СрокДней));
		Иначе
			СрокДней = КэшСрока.Срок;
		КонецЕсли;
		
		Если СрокДней = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		КонтрольнаяДата = Выборка.ДатаНачала - СрокДней * 86400;
		Если КонтрольнаяДата >= Параметры.ДатаОтсчёта Тогда
			Продолжить;
		КонецЕсли;
		
		ДобавитьПросрочку(Просрочки, "Подтверждение услуги " + Строка(Выборка.Услуга),
			Выборка.Заказ, Выборка.Ответственный,
			МинутыПросрочки(КонтрольнаяДата, Параметры.ДатаОтсчёта));
	КонецЦикла;
	
КонецПроцедуры

// Устанавливает параметр-фильтр по списку проверяемых объектов.
//
// Параметры:
//  Запрос     - Запрос - подготавливаемый запрос.
//  Параметры  - Структура - нормализованные параметры выполнения.
//
Процедура УстановитьФильтрПоОбъектам(Запрос, Параметры)
	
	Запрос.УстановитьПараметр("ОграничитьПоОбъектам", Параметры.Объекты.Количество() > 0);
	Запрос.УстановитьПараметр("Объекты", Параметры.Объекты);
	
КонецПроцедуры

// Возвращает набор услуг, подтверждённых записями регистра статусов.
//
// Возвращаемое значение:
//  Соответствие - ключ ссылка заказа поставщику, значение соответствие
//                 (ключ ссылка услуги, значение Истина).
//
Функция ПодтверждённыеУслугиЗаказов()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	СтатусыПодтверждений.ЗаказПоставщику КАК Заказ,
		|	СтатусыПодтверждений.Услуга КАК Услуга
		|ИЗ
		|	РегистрСведений.СтатусыПодтверждений КАК СтатусыПодтверждений
		|ГДЕ
		|	СтатусыПодтверждений.Статус = &СтатусПодтверждён";
	Запрос.УстановитьПараметр("СтатусПодтверждён", Перечисления.СтатусыЗаказа.Подтверждён);
	
	Подтверждения = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		УслугиЗаказа = Подтверждения.Получить(Выборка.Заказ);
		Если УслугиЗаказа = Неопределено Тогда
			УслугиЗаказа = Новый Соответствие;
			Подтверждения.Вставить(Выборка.Заказ, УслугиЗаказа);
		КонецЕсли;
		УслугиЗаказа.Вставить(Выборка.Услуга, Истина);
	КонецЦикла;
	
	Возврат Подтверждения;
	
КонецФункции

// Добавляет строку в таблицу просрочек.
//
// Параметры:
//  Просрочки     - ТаблицаЗначений - таблица просрочек.
//  Вид           - Строка - вид просроченного срока.
//  Объект        - ЛюбаяСсылка - объект с просроченным сроком.
//  Ответственный - СправочникСсылка.Сотрудники - ответственный за объект.
//  ПросроченоНа  - Число - величина просрочки в минутах.
//
Процедура ДобавитьПросрочку(Просрочки, Вид, Объект, Ответственный, ПросроченоНа)
	
	НоваяСтрока = Просрочки.Добавить();
	НоваяСтрока.Вид = Вид;
	НоваяСтрока.Объект = Объект;
	НоваяСтрока.Ответственный = Ответственный;
	НоваяСтрока.ПросроченоНа = ПросроченоНа;
	
КонецПроцедуры

// Возвращает целое число минут между крайним сроком и датой отсчёта.
//
// Параметры:
//  КрайнийСрок - Дата - момент, до которого обязательство должно быть исполнено.
//  ДатаОтсчёта - Дата - момент проверки.
//
// Возвращаемое значение:
//  Число - минуты просрочки.
//
Функция МинутыПросрочки(КрайнийСрок, ДатаОтсчёта)
	
	Возврат Окр(РаботаСДатамиИЧасовымиЗонами.РазницаВМинутах(КрайнийСрок, ДатаОтсчёта), 0);
	
КонецФункции

// Создаёт задачи ответственным по строкам таблицы просрочек.
//
// Открытая (не выполненная и не помеченная на удаление) задача по тому же
// основанию считается уже созданной: повторный запуск обработки не дублирует
// задачи. Строки без ответственного пропускаются - адресовать задачу некому.
//
// Параметры:
//  Просрочки - ТаблицаЗначений - строки просрочек.
//
// Возвращаемое значение:
//  Число - количество созданных задач.
//
Функция СоздатьЗадачиПоПросрочкам(Просрочки)
	
	Создано = 0;
	Для Каждого СтрокаПросрочки Из Просрочки Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаПросрочки.Ответственный) Тогда
			Продолжить;
		КонецЕсли;
		
		ТекстЗадачи = Лев("Просрочен срок: " + СтрокаПросрочки.Вид + " " + ПредставлениеОбъекта(СтрокаПросрочки.Объект), 100);
		
		Если ЕстьОткрытаяЗадачаПоТексту(ТекстЗадачи) Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			ЗадачиИсполнителям.СоздатьЗадачу(
				ТекстЗадачи,
				"Просрочено на " + СтрокаПросрочки.ПросроченоНа + " мин.",
				СтрокаПросрочки.Ответственный);
			Создано = Создано + 1;
		Исключение
			// Ошибка создания одной задачи не прерывает обработку остальных.
			Продолжить;
		КонецПопытки;
	КонецЦикла;
	
	Возврат Создано;
	
КонецФункции

// Проверяет наличие открытой задачи по объекту-основанию.
//
// Общий модуль ЗадачиИсполнителям дописывает представление основания
// в наименование задачи, поэтому задачи ищутся по маркеру основания.
//
// Параметры:
//  Объект - ЛюбаяСсылка - объект-основание задачи.
//
// Возвращаемое значение:
//  Булево - Истина, если открытая задача по объекту уже есть.
//
Функция ЕстьОткрытаяЗадачаПоТексту(ТекстЗадачи)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЗадачиИсполнителя.Ссылка КАК Ссылка
		|ИЗ
		|	Задача.ЗадачаИсполнителя КАК ЗадачиИсполнителя
		|ГДЕ
		|	НЕ ЗадачиИсполнителя.ПометкаУдаления
		|	И НЕ ЗадачиИсполнителя.Выполнена
		|	И ЗадачиИсполнителя.Наименование ПОДОБНО &ШаблонТекста";
	Запрос.УстановитьПараметр("ШаблонТекста", ТекстЗадачи + "%");
	
	Возврат Запрос.Выполнить().Выбрать().Следующий();
	
КонецФункции

// Читаемое представление объекта-основания для наименования задачи.
Функция ПредставлениеОбъекта(Объект)
	
	Попытка
		Возврат Объект.Представление;
	Исключение
		Возврат Строка(Объект);
	КонецПопытки;
	
КонецФункции

// Возвращает маркер объекта-основания в наименовании задачи.
//
// Повторяет правило общего модуля ЗадачиИсполнителям: представление
// объекта-основания дописывается в наименование задачи в скобках.
//
// Параметры:
//  Объект - ЛюбаяСсылка - объект-основание задачи.
//
// Возвращаемое значение:
//  Строка - текст маркера основания.
//
Функция МаркерОснованияЗадачи(Объект)
	
	Попытка
		ПредставлениеОснования = Объект.Представление;
	Исключение
		ПредставлениеОснования = Строка(Объект);
	КонецПопытки;
	
	Возврат "(основание: " + ПредставлениеОснования + ")";
	
КонецФункции

#КонецОбласти



