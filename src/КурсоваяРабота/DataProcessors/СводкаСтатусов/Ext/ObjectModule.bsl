#Область ПрограммныйИнтерфейс

// Строит сводку количеств объектов по статусам: заявки на тур, подтверждения
// услуг, инциденты и претензии поставщикам.
//
// Обработка только читает данные: ни документы, ни движения регистров не
// изменяются. Пустой период (обе даты не заполнены) даёт пустую таблицу.
//
// Параметры:
//  Период - Структура - необязательные ключи:
//   * ДатаНачала    - Дата - начало периода отбора по дате объекта;
//   * ДатаОкончания - Дата - конец периода отбора по дате объекта.
//  Отбор - Структура - необязательные ключи:
//   * Поставщик - СправочникСсылка.Поставщики - отбор подтверждений и
//                                               претензий по поставщику;
//   * Сущности  - Массив - строки «Заявки», «Подтверждения», «Инциденты»,
//                          «Претензии»; пусто - все сущности.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Сущность, Статус, Количество.
//
Функция ВыполнитьОбработку(Период = Неопределено, Отбор = Неопределено) Экспорт
	
	Сводка = Новый ТаблицаЗначений;
	Сводка.Колонки.Добавить("Сущность");
	Сводка.Колонки.Добавить("Статус");
	Сводка.Колонки.Добавить("Количество");
	
	ПараметрыПериода = НормализоватьПериод(Период);
	Если Не ПараметрыПериода.ПериодЗадан Тогда
		Возврат Сводка;
	КонецЕсли;
	
	ПараметрыОтбора = НормализоватьОтбор(Отбор);
	
	ЗначенияПараметров = Новый Структура;
	Если ПараметрыОтбора.Поставщик <> Неопределено Тогда
		ЗначенияПараметров.Вставить("Поставщик", ПараметрыОтбора.Поставщик);
	КонецЕсли;
	
	Если ВходитВОтбор(ПараметрыОтбора, "Заявки") Тогда
		ДобавитьСводку(Сводка, "Заявки",
			"Справочник.ЗаявкиНаТур КАК ОбъектыСводки",
			"ОбъектыСводки.Статус", ПараметрыПериода, "", Новый Структура);
	КонецЕсли;
	
	Если ВходитВОтбор(ПараметрыОтбора, "Подтверждения") Тогда
		ДобавитьСводку(Сводка, "Подтверждения",
			"Документ.ПодтверждениеУслуги КАК ОбъектыСводки",
			"ОбъектыСводки.РезультатСверки", ПараметрыПериода,
			УсловиеОтбораПоПоставщику(ПараметрыОтбора), ЗначенияПараметров);
	КонецЕсли;
	
	Если ВходитВОтбор(ПараметрыОтбора, "Инциденты") Тогда
		ДобавитьСводку(Сводка, "Инциденты",
			"Документ.Инцидент КАК ОбъектыСводки",
			"ОбъектыСводки.Статус", ПараметрыПериода, "", Новый Структура);
	КонецЕсли;
	
	Если ВходитВОтбор(ПараметрыОтбора, "Претензии") Тогда
		ДобавитьСводку(Сводка, "Претензии",
			"Документ.ПретензияПоставщику КАК ОбъектыСводки",
			"ОбъектыСводки.Статус", ПараметрыПериода,
			УсловиеОтбораПоПоставщику(ПараметрыОтбора), ЗначенияПараметров);
	КонецЕсли;
	
	Возврат Сводка;
	
КонецФункции

// Выгружает таблицу сводки в файл формата CSV (разделитель «;», кодировка
// UTF-8, первая строка - заголовок колонок).
//
// Параметры:
//  Таблица   - ТаблицаЗначений - сводка, построенная ВыполнитьОбработку.
//  ПутьФайла - Строка - путь создаваемого файла.
//
Процедура ВыгрузитьВФайл(Таблица, ПутьФайла) Экспорт
	
	Запись = Новый ЗаписьТекста(ПутьФайла, КодировкаТекста.UTF8);
	Запись.ЗаписатьСтроку("Сущность;Статус;Количество");
	Для Каждого СтрокаСводки Из Таблица Цикл
		Запись.ЗаписатьСтроку(СтрокаСводки.Сущность + ";"
			+ СтрокаСводки.Статус + ";"
			+ Формат(СтрокаСводки.Количество, "ЧГ=0"));
	КонецЦикла;
	Запись.Закрыть();
	
КонецПроцедуры

// Возвращает сальдо взаиморасчётов по претензии: сумма требования минус
// сумма удовлетворения. Сальдо считается по движениям регистра накопления
// ВзаиморасчётыПоПретензиям, а не по реквизитам документов: отмена
// проведения акта о компенсации снимает движение удовлетворения, и сальдо
// снова равно сумме требования.
//
// Обработка только читает данные: движения регистров не изменяются.
//
// Параметры:
//  ПретензияСсылка - ДокументСсылка.ПретензияПоставщику - претензия,
//      по которой считается сальдо.
//
// Возвращаемое значение:
//  Число - сальдо претензии; 0 для пустой ссылки и претензии без движений.
//
Функция СальдоПоПретензии(ПретензияСсылка) Экспорт
	
	Если Не ЗначениеЗаполнено(ПретензияСсылка) Тогда
		Возврат 0;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(Взаиморасчёты.СуммаТребованияОборот), 0) КАК СуммаТребования,
		|	ЕСТЬNULL(СУММА(Взаиморасчёты.СуммаУдовлетворенияОборот), 0) КАК СуммаУдовлетворения
		|ИЗ
		|	РегистрНакопления.ВзаиморасчётыПоПретензиям.Обороты(, , , Претензия = &Претензия) КАК Взаиморасчёты";
	Запрос.УстановитьПараметр("Претензия", ПретензияСсылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.СуммаТребования - Выборка.СуммаУдовлетворения;
	
КонецФункции

// Строит KPI сотрудников по оборотам регистра накопления KPIОператоров:
// количество операций и суммарное время обработки в разрезе сотрудника
// и вида операции. Обработка только читает данные.
//
// Параметры:
//  Период - Структура - необязательные ключи:
//   * ДатаНачала    - Дата - начало периода отбора оборотов;
//   * ДатаОкончания - Дата - конец периода отбора оборотов.
//     Незаполнённые границы не ограничивают период.
//  Сотрудник - СправочникСсылка.Сотрудники, Неопределено - отбор по
//      сотруднику; Неопределено - KPI всех сотрудников.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Сотрудник, ВидОперации, Количество,
//      ВремяОбработкиМинут. По сотруднику без операций за период
//      возвращается одна строка с нулями и пометкой «нет операций».
//
Функция KPIСотрудников(Период, Сотрудник = Неопределено) Экспорт
	
	KPI = Новый ТаблицаЗначений;
	KPI.Колонки.Добавить("Сотрудник");
	KPI.Колонки.Добавить("ВидОперации");
	KPI.Колонки.Добавить("Количество");
	KPI.Колонки.Добавить("ВремяОбработкиМинут");
	
	ПараметрыПериода = НормализоватьПериодОборотов(Период);
	СотрудникЗадан = ЗначениеЗаполнено(Сотрудник);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	KPIОбороты.Сотрудник КАК Сотрудник,
		|	KPIОбороты.ВидОперации КАК ВидОперации,
		|	СУММА(KPIОбороты.КоличествоОборот) КАК Количество,
		|	СУММА(KPIОбороты.ВремяОбработкиМинутОборот) КАК ВремяОбработкиМинут
		|ИЗ
		|	РегистрНакопления.KPIОператоров.Обороты(&ДатаНачала, &ДатаОкончания, , "
			+ УсловиеОтбораПоСотруднику(СотрудникЗадан) + ") КАК KPIОбороты
		|
		|СГРУППИРОВАТЬ ПО
		|	KPIОбороты.Сотрудник,
		|	KPIОбороты.ВидОперации
		|
		|УПОРЯДОЧИТЬ ПО
		|	Сотрудник, ВидОперации";
	
	Запрос.УстановитьПараметр("ДатаНачала", ПараметрыПериода.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ПараметрыПериода.ДатаОкончания);
	Если СотрудникЗадан Тогда
		Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = KPI.Добавить();
		НоваяСтрока.Сотрудник = Выборка.Сотрудник;
		НоваяСтрока.ВидОперации = Строка(Выборка.ВидОперации);
		НоваяСтрока.Количество = Выборка.Количество;
		НоваяСтрока.ВремяОбработкиМинут = Выборка.ВремяОбработкиМинут;
	КонецЦикла;
	
	Если СотрудникЗадан И KPI.Количество() = 0 Тогда
		НоваяСтрока = KPI.Добавить();
		НоваяСтрока.Сотрудник = Сотрудник;
		НоваяСтрока.ВидОперации = "нет операций";
		НоваяСтрока.Количество = 0;
		НоваяСтрока.ВремяОбработкиМинут = 0;
	КонецЕсли;
	
	Возврат KPI;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Нормализует параметры периода.
//
// Параметры:
//  Период - Структура, Неопределено - произвольные параметры периода.
//
// Возвращаемое значение:
//  Структура - ключи ДатаНачала, ДатаОкончания, ПериодЗадан (Булево).
//
Функция НормализоватьПериод(Период)
	
	Параметры = Новый Структура;
	Параметры.Вставить("ДатаНачала", Дата(1, 1, 1));
	Параметры.Вставить("ДатаОкончания", Дата(1, 1, 1));
	Параметры.Вставить("ПериодЗадан", Ложь);
	
	Если ТипЗнч(Период) = Тип("Структура") Тогда
		Значение = Неопределено;
		Если Период.Свойство("ДатаНачала", Значение) И ЗначениеЗаполнено(Значение) Тогда
			Параметры.ДатаНачала = Значение;
			Параметры.ПериодЗадан = Истина;
		КонецЕсли;
		Если Период.Свойство("ДатаОкончания", Значение) И ЗначениеЗаполнено(Значение) Тогда
			Параметры.ДатаОкончания = Значение;
			Параметры.ПериодЗадан = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Параметры;
	
КонецФункции

// Нормализует параметры отбора.
//
// Параметры:
//  Отбор - Структура, Неопределено - произвольные параметры отбора.
//
// Возвращаемое значение:
//  Структура - ключи Поставщик, Сущности (Массив).
//
Функция НормализоватьОтбор(Отбор)
	
	Параметры = Новый Структура;
	Параметры.Вставить("Поставщик", Неопределено);
	Параметры.Вставить("Сущности", Новый Массив);
	
	Если ТипЗнч(Отбор) = Тип("Структура") Тогда
		Значение = Неопределено;
		Если Отбор.Свойство("Поставщик", Значение) И ЗначениеЗаполнено(Значение) Тогда
			Параметры.Поставщик = Значение;
		КонецЕсли;
		Если Отбор.Свойство("Сущности", Значение) И ТипЗнч(Значение) = Тип("Массив") Тогда
			Параметры.Сущности = Значение;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Параметры;
	
КонецФункции

// Проверяет, входит ли сущность в отбор.
//
// Параметры:
//  ПараметрыОтбора - Структура - нормализованные параметры отбора.
//  ИмяСущности     - Строка - имя проверяемой сущности.
//
// Возвращаемое значение:
//  Булево - Истина, если сущность нужно включать в сводку.
//
Функция ВходитВОтбор(ПараметрыОтбора, ИмяСущности)
	
	Если ПараметрыОтбора.Сущности.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат ПараметрыОтбора.Сущности.Найти(ИмяСущности) <> Неопределено;
	
КонецФункции

// Возвращает дополнительное условие запроса по поставщику.
//
// Параметры:
//  ПараметрыОтбора - Структура - нормализованные параметры отбора.
//
// Возвращаемое значение:
//  Строка - текст условия запроса; пустая строка, если отбор не задан.
//
Функция УсловиеОтбораПоПоставщику(ПараметрыОтбора)
	
	Если ПараметрыОтбора.Поставщик = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат " И ОбъектыСводки.Поставщик = &Поставщик";
	
КонецФункции

// Выполняет запрос группировки по статусу и добавляет строки в сводку.
//
// Параметры:
//  Сводка          - ТаблицаЗначений - пополняемая таблица сводки.
//  ИмяСущности     - Строка - имя сущности сводки.
//  ТекстТаблицы    - Строка - секция ИЗ запроса (таблица с алиасом ОбъектыСводки).
//  ПолеСтатуса     - Строка - имя поля статуса в запросе.
//  ПараметрыПериода - Структура - нормализованные параметры периода.
//  ДопУсловие      - Строка - дополнительное условие секции ГДЕ.
//  ЗначенияПараметров - Структура - значения параметров доп. условия.
//
Процедура ДобавитьСводку(Сводка, ИмяСущности, ТекстТаблицы, ПолеСтатуса, ПараметрыПериода, ДопУсловие, ЗначенияПараметров)
	
	Условия = Новый Массив;
	Условия.Добавить("НЕ ОбъектыСводки.ПометкаУдаления");
	Если ЗначениеЗаполнено(ПараметрыПериода.ДатаНачала) Тогда
		Условия.Добавить("ОбъектыСводки.Дата >= &ДатаНачала");
	КонецЕсли;
	Если ЗначениеЗаполнено(ПараметрыПериода.ДатаОкончания) Тогда
		Условия.Добавить("ОбъектыСводки.Дата <= &ДатаОкончания");
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	" + ПолеСтатуса + " КАК Статус,
		|	КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ
		|	" + ТекстТаблицы + "
		|ГДЕ
		|	" + СтрСоединить(Условия, "
		|	И ") + ДопУсловие + "
		|
		|СГРУППИРОВАТЬ ПО
		|	" + ПолеСтатуса;
	
	Запрос.УстановитьПараметр("ДатаНачала", ПараметрыПериода.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ПараметрыПериода.ДатаОкончания));
	Для Каждого ЗначениеПараметра Из ЗначенияПараметров Цикл
		Запрос.УстановитьПараметр(ЗначениеПараметра.Ключ, ЗначениеПараметра.Значение);
	КонецЦикла;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Сводка.Добавить();
		НоваяСтрока.Сущность = ИмяСущности;
		НоваяСтрока.Статус = ПредставлениеСтатуса(Выборка.Статус);
		НоваяСтрока.Количество = Выборка.Количество;
	КонецЦикла;
	
КонецПроцедуры

// Нормализует параметры периода отбора оборотов регистра накопления.
//
// Параметры:
//  Период - Структура, Неопределено - произвольные параметры периода.
//
// Возвращаемое значение:
//  Структура - ключи ДатаНачала, ДатаОкончания; пустая дата означает,
//  что граница периода не ограничивает отбор оборотов.
//
Функция НормализоватьПериодОборотов(Период)
	
	Параметры = Новый Структура;
	Параметры.Вставить("ДатаНачала", Дата(1, 1, 1));
	Параметры.Вставить("ДатаОкончания", Дата(1, 1, 1));
	
	Если ТипЗнч(Период) = Тип("Структура") Тогда
		Значение = Неопределено;
		Если Период.Свойство("ДатаНачала", Значение) И ЗначениеЗаполнено(Значение) Тогда
			Параметры.ДатаНачала = НачалоДня(Значение);
		КонецЕсли;
		Если Период.Свойство("ДатаОкончания", Значение) И ЗначениеЗаполнено(Значение) Тогда
			Параметры.ДатаОкончания = КонецДня(Значение);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Параметры;
	
КонецФункции

// Возвращает условие отбора оборотов по сотруднику для виртуальной таблицы.
//
// Параметры:
//  СотрудникЗадан - Булево - признак заданного отбора по сотруднику.
//
// Возвращаемое значение:
//  Строка - текст условия отбора; пустая строка, если отбор не задан.
//
Функция УсловиеОтбораПоСотруднику(СотрудникЗадан)
	
	Если Не СотрудникЗадан Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат "Сотрудник = &Сотрудник";
	
КонецФункции

// Возвращает строковое представление значения статуса.
//
// Параметры:
//  Статус - ПеречислениеСсылка, Неопределено - значение статуса.
//
// Возвращаемое значение:
//  Строка - представление статуса; «(не указан)» для пустого значения.
//
Функция ПредставлениеСтатуса(Статус)
	
	Если Не ЗначениеЗаполнено(Статус) Тогда
		Возврат "(не указан)";
	КонецЕсли;
	
	Возврат Строка(Статус);
	
КонецФункции

#КонецОбласти

