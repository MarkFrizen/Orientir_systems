#Область ПрограммныйИнтерфейс

// Формирует заказы поставщикам по заявкам на тур в статусе «В работе».
//
// По каждой заявке услуги берутся из стандартного набора услуг её маршрута;
// услуги, по которым у заявки уже есть заказ поставщику (не помеченный на
// удаление), пропускаются. Оставшиеся услуги группируются по поставщикам,
// и на каждую группу создаётся отдельный заказ. Каждый заказ пишется в
// собственной транзакции: ошибка одной заявки не мешает обработке остальных.
//
// Параметры:
//  ПараметрыВыполнения - Структура - необязательные ключи:
//   * ДатаНачала       - Дата   - начало периода отбора заявок (по дате заявки);
//   * ДатаОкончания    - Дата   - конец периода отбора заявок (по дате заявки);
//   * Заявки           - Массив - ссылки справочника ЗаявкиНаТур, пусто - все;
//   * ТолькоБезЗаказов - Булево - пропускать заявки, у которых уже есть заказы.
//
// Возвращаемое значение:
//  Структура - результат формирования:
//   * Результат - ТаблицаЗначений - колонки Заявка, Состояние, Причина;
//   * Итоги     - Структура       - Создано, Пропущено, Ошибок (числа).
//
Функция ВыполнитьОбработку(ПараметрыВыполнения = Неопределено) Экспорт
	
	Параметры = НормализоватьПараметры(ПараметрыВыполнения);
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Заявка");
	Результат.Колонки.Добавить("Состояние");
	Результат.Колонки.Добавить("Причина");
	
	Итоги = Новый Структура("Создано, Пропущено, Ошибок", 0, 0, 0);
	
	Заявки = ОтобратьЗаявки(Параметры);
	УслугиПоМаршрутам = УслугиМаршрутов(Заявки);
	ЗаказыПоЗаявкам = СуществующиеЗаказы(Заявки);
	
	Пока Заявки.Следующий() Цикл
		ОбработатьЗаявку(Заявки, Параметры, УслугиПоМаршрутам, ЗаказыПоЗаявкам, Результат, Итоги);
	КонецЦикла;
	
	Возврат Новый Структура("Результат, Итоги", Результат, Итоги);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает структуру параметров с значениями по умолчанию для незаполненных.
//
// Параметры:
//  ПараметрыВыполнения - Структура, Неопределено - произвольные параметры вызова.
//
// Возвращаемое значение:
//  Структура - нормализованные параметры выполнения.
//
Функция НормализоватьПараметры(ПараметрыВыполнения)
	
	Параметры = Новый Структура;
	Параметры.Вставить("ДатаНачала", Дата(1, 1, 1));
	Параметры.Вставить("ДатаОкончания", Дата(1, 1, 1));
	Параметры.Вставить("Заявки", Новый Массив);
	Параметры.Вставить("ТолькоБезЗаказов", Ложь);
	
	Если ТипЗнч(ПараметрыВыполнения) = Тип("Структура") Тогда
		Значение = Неопределено;
		Если ПараметрыВыполнения.Свойство("ДатаНачала", Значение) И ЗначениеЗаполнено(Значение) Тогда
			Параметры.ДатаНачала = Значение;
		КонецЕсли;
		Если ПараметрыВыполнения.Свойство("ДатаОкончания", Значение) И ЗначениеЗаполнено(Значение) Тогда
			Параметры.ДатаОкончания = Значение;
		КонецЕсли;
		Если ПараметрыВыполнения.Свойство("Заявки", Значение) И ТипЗнч(Значение) = Тип("Массив") Тогда
			Параметры.Заявки = Значение;
		КонецЕсли;
		Если ПараметрыВыполнения.Свойство("ТолькоБезЗаказов", Значение) Тогда
			Параметры.ТолькоБезЗаказов = Булево(Значение);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Параметры;
	
КонецФункции

// Отбирает заявки на тур в статусе «В работе» с учётом периода и списка заявок.
//
// Параметры:
//  Параметры - Структура - нормализованные параметры выполнения.
//
// Возвращаемое значение:
//  ВыборкаЗапроса - заявки с полями Ссылка, ДатаНачала, ДатаОкончания, Маршрут, Ответственный.
//
Функция ОтобратьЗаявки(Параметры)
	
	// Условия периода и списка заявок добавляются в текст запроса только когда
	// параметры заданы: логическое «ИЛИ» в секции ГДЕ ухудшает план запроса.
	Условия = Новый Массив;
	Условия.Добавить("НЕ ЗаявкиНаТур.ПометкаУдаления");
	Условия.Добавить("ЗаявкиНаТур.Статус = &Статус");
	
	Если ЗначениеЗаполнено(Параметры.ДатаНачала) Тогда
		Условия.Добавить("ЗаявкиНаТур.Дата >= &ДатаНачала");
	КонецЕсли;
	Если ЗначениеЗаполнено(Параметры.ДатаОкончания) Тогда
		Условия.Добавить("ЗаявкиНаТур.Дата <= &ДатаОкончания");
	КонецЕсли;
	Если Параметры.Заявки.Количество() > 0 Тогда
		Условия.Добавить("ЗаявкиНаТур.Ссылка В (&СписокЗаявок)");
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЗаявкиНаТур.Ссылка КАК Ссылка,
		|	ЗаявкиНаТур.ДатаНачала КАК ДатаНачала,
		|	ЗаявкиНаТур.ДатаОкончания КАК ДатаОкончания,
		|	ЗаявкиНаТур.Маршрут КАК Маршрут,
		|	ЗаявкиНаТур.Ответственный КАК Ответственный
		|ИЗ
		|	Справочник.ЗаявкиНаТур КАК ЗаявкиНаТур
		|ГДЕ
		|	" + СтрСоединить(Условия, "
		|	И ") + "
		|
		|УПОРЯДОЧИТЬ ПО ЗаявкиНаТур.Дата, ЗаявкиНаТур.Ссылка";
	
	Запрос.УстановитьПараметр("Статус", Перечисления.СтатусыЗаявок.ВРаботе);
	Запрос.УстановитьПараметр("ДатаНачала", Параметры.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(Параметры.ДатаОкончания));
	Запрос.УстановитьПараметр("СписокЗаявок", Параметры.Заявки);
	
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции

// Возвращает услуги стандартных наборов маршрутов отобранных заявок.
//
// Параметры:
//  Заявки - ВыборкаЗапроса - строки заявок с полем Маршрут.
//
// Возвращаемое значение:
//  Соответствие - ключ ссылка маршрута, значение таблица значений
//                 (Услуга, Цена, Количество, Поставщик).
//
Функция УслугиМаршрутов(Заявки)
	
	Маршруты = Новый Массив;
	Пока Заявки.Следующий() Цикл
		Если ЗначениеЗаполнено(Заявки.Маршрут) Тогда
			Маршруты.Добавить(Заявки.Маршрут);
		КонецЕсли;
	КонецЦикла;
	Заявки.Сбросить();
	
	УслугиПоМаршрутам = Новый Соответствие;
	Если Маршруты.Количество() = 0 Тогда
		Возврат УслугиПоМаршрутам;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	СтандартныйНаборУслуг.Ссылка КАК Маршрут,
		|	СтандартныйНаборУслуг.Услуга КАК Услуга,
		|	НоменклатураУслуг.БазоваяЦена КАК Цена,
		|	СтандартныйНаборУслуг.Количество КАК Количество,
		|	СтандартныйНаборУслуг.Поставщик КАК Поставщик
		|ИЗ
		|	Справочник.ТурыМаршруты.СтандартныйНаборУслуг КАК СтандартныйНаборУслуг
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НоменклатураУслуг КАК НоменклатураУслуг
		|		ПО НоменклатураУслуг.Ссылка = СтандартныйНаборУслуг.Услуга
		|ГДЕ
		|	СтандартныйНаборУслуг.Ссылка В (&Маршруты)
		|
		|УПОРЯДОЧИТЬ ПО СтандартныйНаборУслуг.НомерСтроки";
	Запрос.УстановитьПараметр("Маршруты", Маршруты);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Услуги = УслугиПоМаршрутам.Получить(Выборка.Маршрут);
		Если Услуги = Неопределено Тогда
			Услуги = Новый ТаблицаЗначений;
			Услуги.Колонки.Добавить("Услуга");
			Услуги.Колонки.Добавить("Цена");
			Услуги.Колонки.Добавить("Количество");
			Услуги.Колонки.Добавить("Поставщик");
			УслугиПоМаршрутам.Вставить(Выборка.Маршрут, Услуги);
		КонецЕсли;
		СтрокаУслуги = Услуги.Добавить();
		СтрокаУслуги.Услуга = Выборка.Услуга;
		СтрокаУслуги.Цена = Выборка.Цена;
		СтрокаУслуги.Количество = Выборка.Количество;
		СтрокаУслуги.Поставщик = Выборка.Поставщик;
	КонецЦикла;
	
	Возврат УслугиПоМаршрутам;
	
КонецФункции

// Возвращает набор услуг, по которым у заявок уже есть заказы поставщикам.
//
// Параметры:
//  Заявки - ВыборкаЗапроса - строки заявок с полем Ссылка.
//
// Возвращаемое значение:
//  Соответствие - ключ ссылка заявки, значение соответствие
//                 (ключ ссылка услуги, значение Истина).
//
Функция СуществующиеЗаказы(Заявки)
	
	СсылкиЗаявок = Новый Массив;
	Пока Заявки.Следующий() Цикл
		СсылкиЗаявок.Добавить(Заявки.Ссылка);
	КонецЦикла;
	Заявки.Сбросить();
	
	ЗаказыПоЗаявкам = Новый Соответствие;
	Если СсылкиЗаявок.Количество() = 0 Тогда
		Возврат ЗаказыПоЗаявкам;
	КонецЕсли;
	
	// Помеченные на удаление заказы не учитываются: они не действуют,
	// и обработка должна уметь создать заказ заново.
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЗаказПоставщику.ЗаявкаНаТур КАК Заявка,
		|	ЗаказПоставщикуУслуги.Услуга КАК Услуга
		|ИЗ
		|	Документ.ЗаказПоставщику КАК ЗаказПоставщику
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику.Услуги КАК ЗаказПоставщикуУслуги
		|		ПО ЗаказПоставщикуУслуги.Ссылка = ЗаказПоставщику.Ссылка
		|ГДЕ
		|	НЕ ЗаказПоставщику.ПометкаУдаления
		|	И ЗаказПоставщику.ЗаявкаНаТур В (&Заявки)";
	Запрос.УстановитьПараметр("Заявки", СсылкиЗаявок);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Услуги = ЗаказыПоЗаявкам.Получить(Выборка.Заявка);
		Если Услуги = Неопределено Тогда
			Услуги = Новый Соответствие;
			ЗаказыПоЗаявкам.Вставить(Выборка.Заявка, Услуги);
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.Услуга) Тогда
			Услуги.Вставить(Выборка.Услуга, Истина);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ЗаказыПоЗаявкам;
	
КонецФункции

// Обрабатывает одну заявку: добавляет строку результата и обновляет итоги.
//
// Параметры:
//  Заявки            - ВыборкаЗапроса  - текущая строка выборки заявок.
//  Параметры         - Структура       - нормализованные параметры выполнения.
//  УслугиПоМаршрутам - Соответствие    - услуги маршрутов.
//  ЗаказыПоЗаявкам   - Соответствие    - заказанные услуги по заявкам.
//  Результат         - ТаблицаЗначений - пополняемая таблица результата.
//  Итоги             - Структура       - счётчики Создано, Пропущено, Ошибок.
//
Процедура ОбработатьЗаявку(Заявки, Параметры, УслугиПоМаршрутам, ЗаказыПоЗаявкам, Результат, Итоги)
	
	ЗаявкаСсылка = Заявки.Ссылка;
	
	УслугиМаршрута = УслугиПоМаршрутам.Получить(Заявки.Маршрут);
	Если УслугиМаршрута = Неопределено Или УслугиМаршрута.Количество() = 0 Тогда
		ДобавитьСтрокуРезультата(Результат, Итоги, ЗаявкаСсылка, "Пропущен",
			"В стандартном наборе услуг маршрута нет услуг.");
		Возврат;
	КонецЕсли;
	
	ЗаказанныеУслуги = ЗаказыПоЗаявкам.Получить(ЗаявкаСсылка);
	Если ЗаказанныеУслуги = Неопределено Тогда
		ЗаказанныеУслуги = Новый Соответствие;
	КонецЕсли;
	
	Если Параметры.ТолькоБезЗаказов И ЗаказанныеУслуги.Количество() > 0 Тогда
		ДобавитьСтрокуРезультата(Результат, Итоги, ЗаявкаСсылка, "Пропущен",
			"По заявке уже есть заказы поставщикам (режим «только без заказов»).");
		Возврат;
	КонецЕсли;
	
	НовыеУслуги = УслугиБезЗаказанных(УслугиМаршрута, ЗаказанныеУслуги);
	Если НовыеУслуги.Количество() = 0 Тогда
		ДобавитьСтрокуРезультата(Результат, Итоги, ЗаявкаСсылка, "Пропущен",
			"Все услуги маршрута уже заказаны поставщикам.");
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Заявки.Ответственный) Тогда
		ДобавитьСтрокуРезультата(Результат, Итоги, ЗаявкаСсылка, "Ошибка",
			"У заявки не указан ответственный.");
		Возврат;
	КонецЕсли;
	
	ВыполнениеПоЗаявке = СоздатьЗаказыПоУслугам(Заявки, НовыеУслуги);
	
	Если ВыполнениеПоЗаявке.Ошибки.Количество() > 0 Тогда
		Причина = СтрСоединить(ВыполнениеПоЗаявке.Ошибки, " ");
		Если ВыполнениеПоЗаявке.Создано > 0 Тогда
			Причина = "Создано заказов: " + ВыполнениеПоЗаявке.Создано + ". Ошибки: " + Причина;
		КонецЕсли;
		ДобавитьСтрокуРезультата(Результат, Итоги, ЗаявкаСсылка, "Ошибка", Причина);
	Иначе
		ДобавитьСтрокуРезультата(Результат, Итоги, ЗаявкаСсылка, "Создан",
			"Создано заказов: " + ВыполнениеПоЗаявке.Создано
				+ " (" + СтрСоединить(ВыполнениеПоЗаявке.Представления, ", ") + ").");
	КонецЕсли;
	
	Итоги.Создано = Итоги.Создано + ВыполнениеПоЗаявке.Создано;
	
КонецПроцедуры

// Возвращает строки услуг маршрута, по которым у заявки ещё нет заказов.
//
// Параметры:
//  УслугиМаршрута     - ТаблицаЗначений - услуги стандартного набора маршрута.
//  ЗаказанныеУслуги   - Соответствие    - услуги действующих заказов заявки.
//
// Возвращаемое значение:
//  ТаблицаЗначений - услуги, требующие заказа.
//
Функция УслугиБезЗаказанных(УслугиМаршрута, ЗаказанныеУслуги)
	
	НовыеУслуги = УслугиМаршрута.Скопировать();
	
	Индекс = 0;
	Пока Индекс < НовыеУслуги.Количество() Цикл
		Если ЗаказанныеУслуги.Получить(НовыеУслуги.Получить(Индекс).Услуга) <> Неопределено Тогда
			НовыеУслуги.Удалить(Индекс);
		Иначе
			Индекс = Индекс + 1;
		КонецЕсли;
	КонецЦикла;
	
	Возврат НовыеУслуги;
	
КонецФункции

// Создаёт заказы по группам услуг, распределённым по поставщикам.
//
// Параметры:
//  Заявки      - ВыборкаЗапроса  - текущая строка выборки заявок.
//  НовыеУслуги - ТаблицаЗначений - услуги, требующие заказа.
//
// Возвращаемое значение:
//  Структура - Создано (число), Представления (массив строк), Ошибки (массив строк).
//
Функция СоздатьЗаказыПоУслугам(Заявки, НовыеУслуги)
	
	Выполнение = Новый Структура;
	Выполнение.Вставить("Создано", 0);
	Выполнение.Вставить("Представления", Новый Массив);
	Выполнение.Вставить("Ошибки", Новый Массив);
	
	Для Каждого Группа Из СгруппироватьПоПоставщикам(НовыеУслуги) Цикл
		Поставщик = Группа.Ключ;
		Если Не ЗначениеЗаполнено(Поставщик) Тогда
			Выполнение.Ошибки.Добавить("В стандартном наборе услуг есть услуги без поставщика.");
			Продолжить;
		КонецЕсли;
		
		Попытка
			ЗаказСсылка = СоздатьЗаказПоУслугам(Заявки, Поставщик, Группа.Значение);
			Выполнение.Создано = Выполнение.Создано + 1;
			Выполнение.Представления.Добавить(Строка(ЗаказСсылка));
		Исключение
			Выполнение.Ошибки.Добавить("Поставщик " + Строка(Поставщик) + ": " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;
	
	Возврат Выполнение;
	
КонецФункции

// Группирует строки услуг по поставщикам с сохранением порядка.
//
// Параметры:
//  НовыеУслуги - ТаблицаЗначений - строки услуг маршрута.
//
// Возвращаемое значение:
//  Соответствие - ключ поставщик, значение массив строк таблицы услуг.
//
Функция СгруппироватьПоПоставщикам(НовыеУслуги)
	
	Группы = Новый Соответствие;
	Для Каждого СтрокаУслуги Из НовыеУслуги Цикл
		УслугиГруппы = Группы.Получить(СтрокаУслуги.Поставщик);
		Если УслугиГруппы = Неопределено Тогда
			УслугиГруппы = Новый Массив;
			Группы.Вставить(СтрокаУслуги.Поставщик, УслугиГруппы);
		КонецЕсли;
		УслугиГруппы.Добавить(СтрокаУслуги);
	КонецЦикла;
	
	Возврат Группы;
	
КонецФункции

// Создаёт и записывает заказ поставщику в собственной транзакции.
//
// Параметры:
//  Заявки    - ВыборкаЗапроса - данные заявки.
//  Поставщик - СправочникСсылка.Поставщики - получатель заказа.
//  Услуги    - Массив - строки таблицы услуг маршрута этого поставщика.
//
// Возвращаемое значение:
//  ДокументСсылка.ЗаказПоставщику - ссылка созданного заказа.
//
Функция СоздатьЗаказПоУслугам(Заявки, Поставщик, Услуги)
	
	Договор = НайтиДоговорПоставщика(Поставщик);
	Если Договор = Неопределено Тогда
		ВызватьИсключение "не найден действующий договор поставщика.";
	КонецЕсли;
	
	ОбъектУслуги = НайтиОбъектПоставщика(Поставщик);
	Если ОбъектУслуги = Неопределено Тогда
		ВызватьИсключение "не найден объект оказания услуг поставщика.";
	КонецЕсли;
	
	Заказ = Документы.ЗаказПоставщику.СоздатьДокумент();
	ЗаполнитьЗаказ(Заказ, Заявки, Поставщик, Договор, ОбъектУслуги, Услуги);
	
	НачатьТранзакцию();
	Попытка
		Нарушения = Заказ.ПравилаЗаписи(Заказ);
		Если Нарушения.Количество() > 0 Тогда
			ВызватьИсключение СтрСоединить(Нарушения, " ");
		КонецЕсли;
		
		Заказ.Записать();
		
		// ПередЗаписью может отклонить запись без исключения: для нового
		// документа это видно по незаполненной ссылке.
		Если Не ЗначениеЗаполнено(Заказ.Ссылка) Тогда
			ВызватьИсключение "документ не записан: запись отклонена правилами документа.";
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение ОписаниеОшибки();
	КонецПопытки;
	
	Возврат Заказ.Ссылка;
	
КонецФункции

// Заполняет реквизиты и табличную часть нового заказа поставщику.
//
// Параметры:
//  Заказ         - ДокументОбъект.ЗаказПоставщику - заполняемый документ.
//  Заявки        - ВыборкаЗапроса - данные заявки.
//  Поставщик     - СправочникСсылка.Поставщики - получатель заказа.
//  Договор       - СправочникСсылка.ДоговорыСПоставщиками - договор поставщика.
//  ОбъектУслуги  - СправочникСсылка.ОбъектыГостеприимства - объект оказания услуг.
//  Услуги        - Массив - строки таблицы услуг маршрута этого поставщика.
//
Процедура ЗаполнитьЗаказ(Заказ, Заявки, Поставщик, Договор, ОбъектУслуги, Услуги)
	
	Заказ.Дата = НачалоДня(ТекущаяДатаСеанса());
	Заказ.ЗаявкаНаТур = Заявки.Ссылка;
	Заказ.Поставщик = Поставщик;
	Заказ.Договор = Договор;
	Заказ.Статус = Перечисления.СтатусыЗаказа.Отправлен;
	Заказ.Ответственный = Заявки.Ответственный;
	Заказ.Комментарий = "Создан обработкой «Формирование запросов поставщикам».";
	
	// Правила записи требуют, чтобы дата ожидания подтверждения не была позже
	// начала первой услуги: берём ближайшую из двух дат.
	ДатаОжидания = НачалоДня(ТекущаяДатаСеанса());
	Если Заявки.ДатаНачала < ДатаОжидания Тогда
		ДатаОжидания = Заявки.ДатаНачала;
	КонецЕсли;
	Заказ.ДатаОжиданияПодтверждения = ДатаОжидания;
	
	СуммаДокумента = 0;
	Для Каждого СтрокаУслуги Из Услуги Цикл
		НоваяСтрока = Заказ.Услуги.Добавить();
		НоваяСтрока.Услуга = СтрокаУслуги.Услуга;
		НоваяСтрока.Объект = ОбъектУслуги;
		НоваяСтрока.ДатаНачала = Заявки.ДатаНачала;
		НоваяСтрока.ДатаОкончания = Заявки.ДатаОкончания;
		НоваяСтрока.Количество = СтрокаУслуги.Количество;
		НоваяСтрока.Цена = СтрокаУслуги.Цена;
		НоваяСтрока.Сумма = Окр(СтрокаУслуги.Цена * СтрокаУслуги.Количество, 2);
		СуммаДокумента = СуммаДокумента + НоваяСтрока.Сумма;
	КонецЦикла;
	Заказ.СуммаДокумента = Окр(СуммаДокумента, 2);
	
КонецПроцедуры

// Возвращает первый действующий договор поставщика.
//
// Параметры:
//  Поставщик - СправочникСсылка.Поставщики - владелец договора.
//
// Возвращаемое значение:
//  СправочникСсылка.ДоговорыСПоставщиками - ссылка договора;
//  Неопределено - если договоров нет.
//
Функция НайтиДоговорПоставщика(Поставщик)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ДоговорыСПоставщиками.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ДоговорыСПоставщиками КАК ДоговорыСПоставщиками
		|ГДЕ
		|	НЕ ДоговорыСПоставщиками.ПометкаУдаления
		|	И ДоговорыСПоставщиками.Владелец = &Поставщик
		|
		|УПОРЯДОЧИТЬ ПО ДоговорыСПоставщиками.Номер";
	Запрос.УстановитьПараметр("Поставщик", Поставщик);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

// Возвращает первый объект оказания услуг поставщика.
//
// Параметры:
//  Поставщик - СправочникСсылка.Поставщики - владелец объекта.
//
// Возвращаемое значение:
//  СправочникСсылка.ОбъектыГостеприимства - ссылка объекта;
//  Неопределено - если объектов нет.
//
Функция НайтиОбъектПоставщика(Поставщик)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ОбъектыГостеприимства.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ОбъектыГостеприимства КАК ОбъектыГостеприимства
		|ГДЕ
		|	НЕ ОбъектыГостеприимства.ПометкаУдаления
		|	И ОбъектыГостеприимства.Владелец = &Поставщик
		|
		|УПОРЯДОЧИТЬ ПО ОбъектыГостеприимства.Наименование";
	Запрос.УстановитьПараметр("Поставщик", Поставщик);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

// Добавляет строку в таблицу результата и увеличивает соответствующий итог.
//
// Параметры:
//  Результат - ТаблицаЗначений - таблица результата.
//  Итоги     - Структура       - счётчики Создано, Пропущено, Ошибок.
//  Заявка    - СправочникСсылка.ЗаявкиНаТур - заявка строки.
//  Состояние - Строка - «Создан», «Пропущен» или «Ошибка».
//  Причина   - Строка - пояснение к состоянию.
//
Процедура ДобавитьСтрокуРезультата(Результат, Итоги, Заявка, Состояние, Причина)
	
	НоваяСтрока = Результат.Добавить();
	НоваяСтрока.Заявка = Заявка;
	НоваяСтрока.Состояние = Состояние;
	НоваяСтрока.Причина = Причина;
	
	Если Состояние = "Пропущен" Тогда
		Итоги.Пропущено = Итоги.Пропущено + 1;
	ИначеЕсли Состояние = "Ошибка" Тогда
		Итоги.Ошибок = Итоги.Ошибок + 1;
	Иначе
		// Состояние «Создан»: счётчик созданных заказов ведёт вызывающий код.
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти



