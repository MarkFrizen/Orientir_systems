#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Период по умолчанию - текущий месяц; пустой список заявок означает
	// «все заявки в работе».
	ДатаНачала = НачалоМесяца(ТекущаяДатаСеанса());
	ДатаОкончания = КонецМесяца(ТекущаяДатаСеанса());
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКоманд

&НаКлиенте
Процедура ВыполнитьФормирование(Команда)
	
	Сводка = ВыполнитьФормированиеНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ВыполнитьФормированиеНаСервере()
	
	СписокЗаявок = Новый Массив;
	Для Каждого СтрокаСписка Из Заявки Цикл
		Если ЗначениеЗаполнено(СтрокаСписка.Заявка) Тогда
			СписокЗаявок.Добавить(СтрокаСписка.Заявка);
		КонецЕсли;
	КонецЦикла;
	
	ПараметрыВыполнения = Новый Структура;
	ПараметрыВыполнения.Вставить("ДатаНачала", ДатаНачала);
	ПараметрыВыполнения.Вставить("ДатаОкончания", ДатаОкончания);
	ПараметрыВыполнения.Вставить("Заявки", СписокЗаявок);
	ПараметрыВыполнения.Вставить("ТолькоБезЗаказов", ТолькоБезЗаказов);
	
	РезультатВыполнения = Объект.Выполнить(ПараметрыВыполнения);
	
	Результат.Очистить();
	Для Каждого СтрокаРезультата Из РезультатВыполнения.Результат Цикл
		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.ЗаявкаРезультата = СтрокаРезультата.Заявка;
		НоваяСтрока.Состояние = СтрокаРезультата.Состояние;
		НоваяСтрока.Причина = СтрокаРезультата.Причина;
	КонецЦикла;
	
	Итоги = РезультатВыполнения.Итоги;
	Возврат "Создано заказов: " + Итоги.Создано
		+ ", пропущено заявок: " + Итоги.Пропущено
		+ ", с ошибками: " + Итоги.Ошибок;
	
КонецФункции

#КонецОбласти
