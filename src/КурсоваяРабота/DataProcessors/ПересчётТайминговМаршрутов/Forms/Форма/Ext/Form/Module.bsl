#Область ОбработчикиКоманд

&НаКлиенте
Процедура ВыполнитьПересчёт(Команда)
	
	Сводка = ВыполнитьПересчётНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ВыполнитьПересчётНаСервере()
	
	СписокЛистов = Новый Массив;
	Для Каждого СтрокаСписка Из МаршрутныеЛисты Цикл
		Если ЗначениеЗаполнено(СтрокаСписка.МаршрутныйЛист) Тогда
			СписокЛистов.Добавить(СтрокаСписка.МаршрутныйЛист);
		КонецЕсли;
	КонецЦикла;
	
	ПараметрыВыполнения = Новый Структура;
	ПараметрыВыполнения.Вставить("МаршрутныеЛисты", СписокЛистов);
	ПараметрыВыполнения.Вставить("ИзменятьПроведённые", ИзменятьПроведённые);
	
	РезультатВыполнения = Объект.ВыполнитьОбработку(ПараметрыВыполнения);
	
	Накладки.Очистить();
	Для Каждого СтрокаНакладки Из РезультатВыполнения.Накладки Цикл
		НоваяСтрока = Накладки.Добавить();
		НоваяСтрока.Маршрут = СтрокаНакладки.Маршрут;
		НоваяСтрока.Событие = СтрокаНакладки.Событие;
		НоваяСтрока.ПерекрытиеМинут = СтрокаНакладки.ПерекрытиеМинут;
	КонецЦикла;
	
	Возврат "Пересчитано событий: " + РезультатВыполнения.Пересчитано
		+ ", пропущено: " + РезультатВыполнения.Пропущено
		+ ", накладок: " + РезультатВыполнения.Накладки.Количество();
	
КонецФункции

#КонецОбласти
