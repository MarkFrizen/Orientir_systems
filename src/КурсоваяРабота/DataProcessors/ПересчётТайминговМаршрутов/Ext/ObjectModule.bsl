#Область ПрограммныйИнтерфейс

// Пересчитывает локальное время и буферы между событиями маршрутных листов.
//
// По каждому маршрутному листу события упорядочиваются по времени UTC:
// локальное время события пересчитывается из времени UTC через часовой пояс
// его объекта, буфер до следующего события - разница в минутах между
// окончанием текущего события и началом следующего (у последнего события
// буфер равен нулю). Отрицательный буфер означает накладку: события
// перекрываются по времени, величина перекрытия попадает в таблицу накладок.
// Проведённые события изменяются только при явно установленном флаге
// «Изменять проведённые»; без флага они пропускаются, но накладки по ним
// всё равно выявляются.
//
// Параметры:
//  ПараметрыВыполнения - Структура - необязательные ключи:
//   * МаршрутныеЛисты     - Массив - ссылки документов МаршрутныйЛист,
//                                    пусто - все листы;
//   * ИзменятьПроведённые - Булево - пересчитывать проведённые события.
//
// Возвращаемое значение:
//  Структура - результат пересчёта:
//   * Пересчитано - Число          - число изменённых событий;
//   * Пропущено   - Число          - число пропущенных событий (проведённые
//                                     без флага, события без часового пояса
//                                     объекта и уже актуальные значения);
//   * Накладки    - ТаблицаЗначений - колонки Маршрут, Событие,
//                                     ПерекрытиеМинут.
//
Функция ВыполнитьОбработку(ПараметрыВыполнения = Неопределено) Экспорт
	
	Если Не ПравоДоступа("Изменение", Метаданные.Документы.СобытиеМаршрута) Тогда
		ВызватьИсключение "Недостаточно прав для пересчёта таймингов маршрутов.";
	КонецЕсли;
	
	Параметры = НормализоватьПараметры(ПараметрыВыполнения);
	
	Накладки = Новый ТаблицаЗначений;
	Накладки.Колонки.Добавить("Маршрут");
	Накладки.Колонки.Добавить("Событие");
	Накладки.Колонки.Добавить("ПерекрытиеМинут");
	
	Итоги = Новый Структура("Пересчитано, Пропущено", 0, 0);
	
	СобытияПоЛистам = СобытияМаршрутныхЛистов(Параметры);
	Для Каждого ЭлементСписка Из СобытияПоЛистам Цикл
		ПересчитатьСобытияЛиста(ЭлементСписка.Значение, Параметры, Накладки, Итоги);
	КонецЦикла;
	
	Возврат Новый Структура("Пересчитано, Пропущено, Накладки",
		Итоги.Пересчитано, Итоги.Пропущено, Накладки);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает структуру параметров с значениями по умолчанию для незаполненных.
//
// Параметры:
//  ПараметрыВыполнения - Структура, Неопределено - произвольные параметры вызова.
//
// Возвращаемое значение:
//  Структура - нормализованные параметры выполнения.
//
Функция НормализоватьПараметры(ПараметрыВыполнения)
	
	Параметры = Новый Структура;
	Параметры.Вставить("МаршрутныеЛисты", Новый Массив);
	Параметры.Вставить("ИзменятьПроведённые", Ложь);
	
	Если ТипЗнч(ПараметрыВыполнения) = Тип("Структура") Тогда
		Значение = Неопределено;
		Если ПараметрыВыполнения.Свойство("МаршрутныеЛисты", Значение) И ТипЗнч(Значение) = Тип("Массив") Тогда
			Параметры.МаршрутныеЛисты = Значение;
		КонецЕсли;
		Если ПараметрыВыполнения.Свойство("ИзменятьПроведённые", Значение) Тогда
			Параметры.ИзменятьПроведённые = Булево(Значение);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Параметры;
	
КонецФункции

// Отбирает события маршрутных листов, сгруппированные по листам.
//
// Параметры:
//  Параметры - Структура - нормализованные параметры выполнения.
//
// Возвращаемое значение:
//  Соответствие - ключ ссылка маршрутного листа, значение массив строк
//                 таблицы значений событий в порядке времени UTC.
//
Функция СобытияМаршрутныхЛистов(Параметры)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	События.Ссылка КАК Ссылка,
		|	События.МаршрутныйЛист КАК МаршрутныйЛист,
		|	События.Проведен КАК Проведен,
		|	События.ДатаВремяUTC КАК ДатаВремяUTC,
		|	События.ДлительностьМинут КАК ДлительностьМинут,
		|	События.ЛокальноеВремя КАК ЛокальноеВремя,
		|	События.БуферДоСледующегоМинут КАК БуферДоСледующегоМинут,
		|	ЕСТЬNULL(ОбъектыГостеприимства.ЧасоваяЗона, """") КАК ЧасоваяЗона
		|ИЗ
		|	Документ.СобытиеМаршрута КАК События
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ОбъектыГостеприимства КАК ОбъектыГостеприимства
		|		ПО ОбъектыГостеприимства.Ссылка = События.Объект
		|ГДЕ
		|	НЕ События.ПометкаУдаления
		|	И НЕ События.МаршрутныйЛист.ПометкаУдаления
		|	И (НЕ &ОграничитьПоЛистам ИЛИ События.МаршрутныйЛист В (&МаршрутныеЛисты))
		|
		|УПОРЯДОЧИТЬ ПО События.МаршрутныйЛист, События.ДатаВремяUTC, События.Ссылка";
	
	Запрос.УстановитьПараметр("ОграничитьПоЛистам", Параметры.МаршрутныеЛисты.Количество() > 0);
	Запрос.УстановитьПараметр("МаршрутныеЛисты", Параметры.МаршрутныеЛисты);
	
	СобытияПоЛистам = Новый Соответствие;
	Для Каждого СтрокаСобытия Из Запрос.Выполнить().Выгрузить() Цикл
		События = СобытияПоЛистам.Получить(СтрокаСобытия.МаршрутныйЛист);
		Если События = Неопределено Тогда
			События = Новый Массив;
			СобытияПоЛистам.Вставить(СтрокаСобытия.МаршрутныйЛист, События);
		КонецЕсли;
		События.Добавить(СтрокаСобытия);
	КонецЦикла;
	
	Возврат СобытияПоЛистам;
	
КонецФункции

// Пересчитывает локальное время и буферы событий одного маршрутного листа.
//
// Параметры:
//  События  - Массив - строки таблицы значений событий листа по времени UTC.
//  Параметры - Структура - нормализованные параметры выполнения.
//  Накладки - ТаблицаЗначений - пополняемая таблица накладок.
//  Итоги    - Структура - счётчики Пересчитано, Пропущено.
//
Процедура ПересчитатьСобытияЛиста(События, Параметры, Накладки, Итоги)
	
	Для Индекс = 0 По События.Количество() - 1 Цикл
		Событие = События[Индекс];
		
		// Буфер до следующего события; у последнего события следующего нет,
		// его буфер принимается равным нулю.
		Если Индекс < События.Количество() - 1 Тогда
			Окончание = Событие.ДатаВремяUTC + Событие.ДлительностьМинут * 60;
			НовыйБуфер = Окр(РаботаСДатамиИЧасовымиЗонами.РазницаВМинутах(Окончание,
				События[Индекс + 1].ДатаВремяUTC), 0);
		Иначе
			НовыйБуфер = 0;
		КонецЕсли;
		
		Если НовыйБуфер < 0 Тогда
			ДобавитьНакладку(Накладки, Событие, -НовыйБуфер);
		КонецЕсли;
		
		НовоеЛокальноеВремя = РаботаСДатамиИЧасовымиЗонами.ПеревестиВЛокальноеВремя(
			Событие.ДатаВремяUTC, Событие.ЧасоваяЗона);
		
		Если Событие.Проведен И Не Параметры.ИзменятьПроведённые Тогда
			Итоги.Пропущено = Итоги.Пропущено + 1;
			Продолжить;
		КонецЕсли;
		
		Если НовоеЛокальноеВремя = Неопределено Тогда
			// Часовой пояс объекта не распознан: локальное время пересчитать
			// нельзя, событие пропускается целиком.
			Итоги.Пропущено = Итоги.Пропущено + 1;
			Продолжить;
		КонецЕсли;
		
		Если Событие.ЛокальноеВремя = НовоеЛокальноеВремя
			И Событие.БуферДоСледующегоМинут = НовыйБуфер Тогда
			Итоги.Пропущено = Итоги.Пропущено + 1;
			Продолжить;
		КонецЕсли;
		
		Если ЗаписатьСобытие(Событие, НовоеЛокальноеВремя, НовыйБуфер) Тогда
			Итоги.Пересчитано = Итоги.Пересчитано + 1;
		Иначе
			Итоги.Пропущено = Итоги.Пропущено + 1;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Записывает пересчитанные значения в документ события маршрута.
//
// Проведённое событие записывается в режиме проведения: проведение события
// движений не формирует (решение D3), поэтому перепроведение безопасно и
// сохраняет признак проведённости документа.
//
// Параметры:
//  Событие              - Строка таблицы значений - данные события.
//  НовоеЛокальноеВремя  - Дата - пересчитанное локальное время.
//  НовыйБуфер           - Число - пересчитанный буфер до следующего события.
//
// Возвращаемое значение:
//  Булево - Истина при успешной записи документа.
//
Функция ЗаписатьСобытие(Событие, НовоеЛокальноеВремя, НовыйБуфер)
	
	Попытка
		ОбъектСобытия = Событие.Ссылка.ПолучитьОбъект();
		ОбъектСобытия.ЛокальноеВремя = НовоеЛокальноеВремя;
		ОбъектСобытия.БуферДоСледующегоМинут = НовыйБуфер;
		
		Если Событие.Проведен Тогда
			ОбъектСобытия.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			ОбъектСобытия.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;
		
		// ПередЗаписью может отклонить запись без исключения, а объект в памяти
		// останется изменённым: факт записи проверяется перечитыванием значения
		// из базы по ссылке документа.
		Если Событие.Ссылка.ЛокальноеВремя <> НовоеЛокальноеВремя Тогда
			Возврат Ложь;
		КонецЕсли;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции

// Добавляет строку в таблицу накладок маршрута.
//
// Параметры:
//  Накладки            - ТаблицаЗначений - таблица накладок.
//  Событие             - Строка таблицы значений - перекрываемое событие.
//  ПерекрытиеМинут     - Число - величина перекрытия в минутах.
//
Процедура ДобавитьНакладку(Накладки, Событие, ПерекрытиеМинут)
	
	НоваяСтрока = Накладки.Добавить();
	НоваяСтрока.Маршрут = Событие.МаршрутныйЛист;
	НоваяСтрока.Событие = Событие.Ссылка;
	НоваяСтрока.ПерекрытиеМинут = ПерекрытиеМинут;
	
КонецПроцедуры

#КонецОбласти


