#Область ПрограммныйИнтерфейс

// Возвращает перечень нарушений, мешающих записи подтверждения услуги.
//
// Параметры:
//  Объект - ДокументОбъект.ПодтверждениеУслуги - записываемый документ.
//
// Возвращаемое значение:
//  Массив - тексты нарушений; пустой массив, если нарушений нет.
//
Функция ПравилаЗаписи(Объект) Экспорт
	
	Нарушения = Новый Массив;
	
	Если НЕ ЗначениеЗаполнено(Объект.ЗаказПоставщику) Тогда
		Нарушения.Добавить("Не заполнен заказ поставщику. Выберите заказ, на который пришло подтверждение.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Поставщик) Тогда
		Нарушения.Добавить("Не заполнен поставщик. Выберите поставщика, приславшего подтверждение.");
	КонецЕсли;
	
	Если Объект.ПодтверждённыеУслуги.Количество() = 0 Тогда
		Нарушения.Добавить("Табличная часть ""Подтверждённые услуги"" пуста. Добавьте хотя бы одну услугу.");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ЗаказПоставщику) И ЗначениеЗаполнено(Объект.Поставщик) Тогда
		Если Объект.ЗаказПоставщику.Поставщик <> Объект.Поставщик Тогда
			Нарушения.Добавить("Поставщик подтверждения (" + Объект.Поставщик
				+ ") не совпадает с поставщиком заказа (" + Объект.ЗаказПоставщику.Поставщик + ").");
		КонецЕсли;
	КонецЕсли;
	
	КлючиЗаказа = Новый Соответствие;
	Если ЗначениеЗаполнено(Объект.ЗаказПоставщику) Тогда
		Для Каждого СтрокаЗаказа Из Объект.ЗаказПоставщику.Услуги Цикл
			Ключ = Строка(СтрокаЗаказа.Услуга) + "|" + Строка(СтрокаЗаказа.Объект);
			КлючиЗаказа.Вставить(Ключ, Истина);
		КонецЦикла;
	КонецЕсли;
	
	НомерСтроки = 0;
	Для Каждого Строка Из Объект.ПодтверждённыеУслуги Цикл
		НомерСтроки = НомерСтроки + 1;
		
		Если НЕ ЗначениеЗаполнено(Строка.Услуга) Тогда
			Нарушения.Добавить("Строка " + НомерСтроки + ": не выбрана услуга.");
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Строка.Объект) Тогда
			Нарушения.Добавить("Строка " + НомерСтроки + ": не выбран объект оказания услуги.");
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Строка.ДатаНачала) Тогда
			Нарушения.Добавить("Строка " + НомерСтроки + ": не заполнена дата начала услуги.");
		КонецЕсли;
		Если Строка.Количество <= 0 Тогда
			Нарушения.Добавить("Строка " + НомерСтроки + ": количество должно быть больше нуля.");
		КонецЕсли;
		Если Строка.Цена < 0 Или Строка.Сумма < 0 Тогда
			Нарушения.Добавить("Строка " + НомерСтроки + ": цена и сумма не могут быть отрицательными.");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Объект.ЗаказПоставщику)
			И ЗначениеЗаполнено(Строка.Услуга) И ЗначениеЗаполнено(Строка.Объект) Тогда
			Ключ = Строка(Строка.Услуга) + "|" + Строка(Строка.Объект);
			Если КлючиЗаказа.Получить(Ключ) = Неопределено Тогда
				Нарушения.Добавить("Строка " + НомерСтроки + ": услуга " + Строка.Услуга
					+ " по объекту " + Строка.Объект + " отсутствует в заказе поставщику.");
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если Объект.ПодтверждённыеУслуги.Количество() > 0 И Объект.СуммаДокумента <> Неопределено Тогда
		СуммаСтрок = РасчётКомпенсаций.СуммаТабличнойЧасти(Объект.ПодтверждённыеУслуги);
		Если Объект.СуммаДокумента <> СуммаСтрок Тогда
			Нарушения.Добавить("Сумма документа (" + Формат(Объект.СуммаДокумента, "ЧДЦ=2")
				+ ") не равна сумме строк (" + Формат(СуммаСтрок, "ЧДЦ=2") + "). Пересчитайте суммы.");
		КонецЕсли;
	КонецЕсли;
	
	Возврат Нарушения;
	
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

// Публикует нарушения правил записи и отклоняет запись документа.
//
// Вызывается платформой при любой записи, включая программную.
//
// Параметры:
//  Отказ - Булево - устанавливается в Истина при найденных нарушениях.
//  РежимЗаписи - РежимЗаписиДокумента - режим записи.
//  РежимПроведения - РежимПроведенияДокумента - режим проведения.
//
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Текст Из ПравилаЗаписи(ЭтотОбъект) Цикл
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = Текст;
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЦикла;
	
КонецПроцедуры

// Формирует движения документа при проведении.
//
// По каждой подтверждённой строке записываются статус «Подтверждён» с датой
// документа и фактические параметры услуги (тип номера, тип питания,
// количество). Движения предыдущего проведения удаляются, чтобы повторное
// проведение не накапливало дубли.
//
// После записи проверяется полнота подтверждения заказа: если подтверждены
// все его услуги, связанная заявка переводится в статус «Подтверждена».
//
// Параметры:
//  Отказ - Булево - признак отказа от проведения.
//  РежимПроведения - РежимПроведенияДокумента - режим проведения.
//
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеДокументов.ЗаблокироватьРегистры(РегистрыБлокировки());
	УдалитьДвижения();
	
	НаборСтатусов = РегистрыСведений.СтатусыПодтверждений.СоздатьНаборЗаписей();
	НаборСтатусов.Отбор.Регистратор.Установить(ЭтотОбъект.Ссылка);
	
	НаборПараметров = РегистрыСведений.ПараметрыУслуг.СоздатьНаборЗаписей();
	НаборПараметров.Отбор.Регистратор.Установить(ЭтотОбъект.Ссылка);
	
	Для Каждого СтрокаУслуги Из ЭтотОбъект.ПодтверждённыеУслуги Цикл
		
		Статус = НаборСтатусов.Добавить();
		Статус.Период = НачалоДня(ЭтотОбъект.Дата);
		Статус.ЗаказПоставщику = ЭтотОбъект.ЗаказПоставщику;
		Статус.Услуга = СтрокаУслуги.Услуга;
		Статус.Статус = Перечисления.СтатусыЗаказа.Подтверждён;
		Статус.ДатаПодтверждения = ЭтотОбъект.Дата;
		
		Параметры = НаборПараметров.Добавить();
		Параметры.Период = НачалоДня(ЭтотОбъект.Дата);
		Параметры.ЗаказПоставщику = ЭтотОбъект.ЗаказПоставщику;
		Параметры.Услуга = СтрокаУслуги.Услуга;
		Параметры.ТипНомера = СтрокаУслуги.ТипНомераФакт;
		Параметры.ТипПитания = СтрокаУслуги.ТипПитанияФакт;
		Параметры.Количество = СтрокаУслуги.Количество;
		
	КонецЦикла;
	
	НаборСтатусов.Записать(Истина);
	НаборПараметров.Записать(Истина);
	ЗаписатьKPI();
	
	Заявка = ЗаявкаЗаказа();
	Если Не ЗначениеЗаполнено(Заявка) Тогда
		Возврат;
	КонецЕсли;
	
	Если ВсеУслугиЗаказаПодтверждены(ЭтотОбъект.ЗаказПоставщику) Тогда
		УстановитьСтатусЗаявки(Заявка, Перечисления.СтатусыЗаявок.Подтверждена);
	КонецЕсли;
	
КонецПроцедуры

// Удаляет движения отменяемого проведения и снимает подтверждение заявки.
//
// Если после удаления движений хотя бы одна услуга заказа осталась без
// подтверждения, заявка возвращается в статус «В работе»: полностью
// подтверждённой она больше не является.
//
// Параметры:
//  Отказ - Булево - признак отказа от отмены проведения.
//
Процедура ОбработкаУдаленияПроведения(Отказ)
	
	УдалитьДвижения();
	
	Заявка = ЗаявкаЗаказа();
	Если Не ЗначениеЗаполнено(Заявка) Тогда
		Возврат;
	КонецЕсли;
	
	Если ВсеУслугиЗаказаПодтверждены(ЭтотОбъект.ЗаказПоставщику) Тогда
		Возврат;
	КонецЕсли;
	
	// Снимаем только собственный перевод заявки: статусы «Новая», «Завершена»
	// и «Отменена» выставляет не проведение, и отмена его не касается.
	Если Заявка.Статус <> Перечисления.СтатусыЗаявок.Подтверждена Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьСтатусЗаявки(Заявка, Перечисления.СтатусыЗаявок.ВРаботе);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Удаляет движения документа в регистрах статусов и параметров услуг.
//
// Регистры сведений не очищаются платформой при повторном проведении, поэтому
// прежние наборы записей снимаются вручную: набор с отбором по регистратору,
// записанный в режиме замещения, удаляет все строки этого документа.
//
Процедура УдалитьДвижения()
	
	НаборСтатусов = РегистрыСведений.СтатусыПодтверждений.СоздатьНаборЗаписей();
	НаборСтатусов.Отбор.Регистратор.Установить(ЭтотОбъект.Ссылка);
	НаборСтатусов.Записать(Истина);
	
	НаборПараметров = РегистрыСведений.ПараметрыУслуг.СоздатьНаборЗаписей();
	НаборПараметров.Отбор.Регистратор.Установить(ЭтотОбъект.Ссылка);
	НаборПараметров.Записать(Истина);
	
	НаборKPI = РегистрыНакопления.KPIОператоров.СоздатьНаборЗаписей();
	НаборKPI.Отбор.Регистратор.Установить(ЭтотОбъект.Ссылка);
	НаборKPI.Записать(Истина);
	
КонецПроцедуры

// Возвращает области блокировки, которые захватывает проведение.
//
// Блокируются оба регистра движения: статус и параметры услуги образуют
// единое целое, частично записанный набор исказил бы данные для смежных
// обработок.
//
// Возвращаемое значение:
//  Массив - имена областей блокировки.
//
Функция РегистрыБлокировки()
	
	МассивРегистров = Новый Массив;
	МассивРегистров.Добавить("РегистрСведений.СтатусыПодтверждений");
	МассивРегистров.Добавить("РегистрСведений.ПараметрыУслуг");
	МассивРегистров.Добавить("РегистрНакопления.KPIОператоров");
	
	Возврат МассивРегистров;
	
КонецФункции

// Возвращает измерения записи регистров для строки подтверждённых услуг.
//
// Параметры:
//  СтрокаУслуги - СтрокаТабличнойЧасти - строка табличной части
//       «Подтверждённые услуги».
//
// Возвращаемое значение:
//  Структура - измерения регистров: ЗаказПоставщику, Услуга.
//
Функция ОтборЗаписи(СтрокаУслуги)
	
	Отбор = Новый Структура;
	Отбор.Вставить("ЗаказПоставщику", ЭтотОбъект.ЗаказПоставщику);
	Отбор.Вставить("Услуга", СтрокаУслуги.Услуга);
	
	Возврат Отбор;
	
КонецФункции

// Возвращает реквизиты записи статуса «Подтверждён».
//
// Возвращаемое значение:
//  Структура - реквизиты регистра: Статус, ДатаПодтверждения.
//
Функция ПоляСтатуса()
	
	ПоляЗаписи = Новый Структура;
	ПоляЗаписи.Вставить("Статус", Перечисления.СтатусыЗаказа.Подтверждён);
	ПоляЗаписи.Вставить("ДатаПодтверждения", ЭтотОбъект.Дата);
	
	Возврат ПоляЗаписи;
	
КонецФункции

// Возвращает фактические параметры услуги для регистра ПараметрыУслуг.
//
// Параметры:
//  СтрокаУслуги - СтрокаТабличнойЧасти - строка табличной части
//       «Подтверждённые услуги».
//
// Возвращаемое значение:
//  Структура - реквизиты регистра: ТипНомера, ТипПитания, Количество.
//
Функция ПоляПараметров(СтрокаУслуги)
	
	ПоляЗаписи = Новый Структура;
	ПоляЗаписи.Вставить("ТипНомера", СтрокаУслуги.ТипНомераФакт);
	ПоляЗаписи.Вставить("ТипПитания", СтрокаУслуги.ТипПитанияФакт);
	ПоляЗаписи.Вставить("Количество", СтрокаУслуги.Количество);
	
	Возврат ПоляЗаписи;
	
КонецФункции

// Возвращает заявку на тур, по которой оформлен заказ.
//
// Возвращаемое значение:
//  СправочникСсылка.ЗаявкиНаТур, Неопределено - заявка заказа; Неопределено,
//       если заказ не заполнен или у заказа нет заявки.
//
Функция ЗаявкаЗаказа()
	
	Если Не ЗначениеЗаполнено(ЭтотОбъект.ЗаказПоставщику) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Заявка = ЭтотОбъект.ЗаказПоставщику.ЗаявкаНаТур;
	Если Не ЗначениеЗаполнено(Заявка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Заявка;
	
КонецФункции

// Проверяет, подтверждены ли все услуги заказа.
//
// Услуга считается подтверждённой, если по заказу есть запись регистра
// СтатусыПодтверждений со статусом «Подтверждён». Записи разных документов
// подтверждения складываются: заказ может подтверждаться по частям.
//
// Параметры:
//  Заказ - ДокументСсылка.ЗаказПоставщику - проверяемый заказ.
//
// Возвращаемое значение:
//  Булево - Истина, если каждая услуга заказа имеет подтверждение.
//
Функция ВсеУслугиЗаказаПодтверждены(Заказ)
	
	Если Не ЗначениеЗаполнено(Заказ) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Заказ.Услуги.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Статусы.Услуга КАК Услуга
		|ИЗ
		|	РегистрСведений.СтатусыПодтверждений КАК Статусы
		|ГДЕ
		|	Статусы.ЗаказПоставщику = &ЗаказПоставщику
		|	И Статусы.Статус = &Статус";
	Запрос.УстановитьПараметр("ЗаказПоставщику", Заказ);
	Запрос.УстановитьПараметр("Статус", Перечисления.СтатусыЗаказа.Подтверждён);
	
	Подтверждённые = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаЗаказа Из Заказ.Услуги Цикл
		Если Подтверждённые.Найти(СтрокаЗаказа.Услуга, "Услуга") = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

// Записывает заявке новый статус, если он отличается от текущего.
//
// Запись выполняется только при реальном изменении: лишняя запись справочника
// переводила бы заявку в изменённое состояние без необходимости.
//
// Параметры:
//  Заявка - СправочникСсылка.ЗаявкиНаТур - изменяемая заявка.
//  Статус - ПеречислениеСсылка.СтатусыЗаявок - устанавливаемый статус.
//
Процедура УстановитьСтатусЗаявки(Заявка, Статус)
	
	Если Заявка.Статус = Статус Тогда
		Возврат;
	КонецЕсли;
	
	ОбъектЗаявки = Заявка.ПолучитьОбъект();
	ОбъектЗаявки.Статус = Статус;
	ОбъектЗаявки.Записать();
	
КонецПроцедуры

// Регистрирует оборот KPI «ОбработанаЗаявка».
//
// Подтверждение услуги - выполненная работа ответственного сотрудника
// заказа, поэтому сотрудник берётся из заказа, а время обработки -
// разница между датой документа и моментом проведения. Оборот пишется
// собственным набором записей с отбором по регистратору: повторное
// проведение замещает прежний оборот, отмена проведения снимает его
// вместе с остальными движениями. Ввести оборот вручную невозможно:
// регистр подчинён регистратору, а его список скрыт из интерфейса.
//
Процедура ЗаписатьKPI()
	
	Сотрудник = Неопределено;
	Если ЗначениеЗаполнено(ЭтотОбъект.ЗаказПоставщику) Тогда
		Сотрудник = ЭтотОбъект.ЗаказПоставщику.Ответственный;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Сотрудник) Тогда
		Возврат;
	КонецЕсли;
	
	НаборЗаписей = РегистрыНакопления.KPIОператоров.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(ЭтотОбъект.Ссылка);
	
	Движение = НаборЗаписей.Добавить();
	Движение.Период = ЭтотОбъект.Дата;
	Движение.Сотрудник = Сотрудник;
	Движение.ВидОперации = Перечисления.ВидыОперацийKPI.ОбработанаЗаявка;
	Движение.Количество = 1;
	Движение.ВремяОбработкиМинут = Макс(0, Окр((ТекущаяДатаСеанса() - ЭтотОбъект.Дата) / 60, 0));
	
	НаборЗаписей.Записать(Истина);
	
КонецПроцедуры

#КонецОбласти
