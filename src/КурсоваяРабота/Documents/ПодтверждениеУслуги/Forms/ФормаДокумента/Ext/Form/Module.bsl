#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("Основание")
		И ТипЗнч(Параметры.Основание) = Тип("ДокументСсылка.ЗаказПоставщику")
		И НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ЗаполнитьПоОснованию(Параметры.Основание);
	КонецЕсли;

	ОбновитьДоступностьКоманд();

КонецПроцедуры

&НаКлиенте
Процедура ОбновлениеОтображения()

	ОбновитьДоступностьКоманд();

КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, РежимЗаписи)

	Если НЕ ПроверитьЗаполнение() Тогда
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ЗаказПоставщикуПриИзменении(Элемент)

	ОбновитьДоступностьКоманд();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОткрытьЗаказ(Команда)

	Если ЗначениеЗаполнено(Объект.ЗаказПоставщику) Тогда
		ОткрытьФорму("Документ.ЗаказПоставщику.Форма.ФормаДокумента", Новый Структура("Ключ", Объект.ЗаказПоставщику));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьСверку(Команда)

	// TODO этап 4
	Сообщить("Сверка будет реализована на этапе 4.");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиОповещений

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбновитьДоступностьКоманд()

	Элементы.ОткрытьЗаказ.Доступность = ЗначениеЗаполнено(Объект.ЗаказПоставщику);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоОснованию(Основание)

	Заказ = Основание.ПолучитьОбъект();
	Объект.ЗаказПоставщику = Основание;
	Объект.Поставщик = Заказ.Поставщик;
	Объект.ПодтверждённыеУслуги.Очистить();
	Для Каждого СтрокаЗаказа Из Заказ.Услуги Цикл
		НоваяСтрока = Объект.ПодтверждённыеУслуги.Добавить();
		НоваяСтрока.Услуга = СтрокаЗаказа.Услуга;
		НоваяСтрока.Объект = СтрокаЗаказа.Объект;
		НоваяСтрока.ДатаНачала = СтрокаЗаказа.ДатаНачала;
		НоваяСтрока.ДатаОкончания = СтрокаЗаказа.ДатаОкончания;
		НоваяСтрока.Количество = СтрокаЗаказа.Количество;
		НоваяСтрока.Цена = СтрокаЗаказа.Цена;
		НоваяСтрока.Сумма = СтрокаЗаказа.Сумма;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти