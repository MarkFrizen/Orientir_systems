#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("Основание")
		И ТипЗнч(Параметры.Основание) = Тип("ДокументСсылка.ЗаказПоставщику")
		И НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ЗаполнитьПоОснованию(Параметры.Основание);
	КонецЕсли;

	ОбновитьДоступностьКоманд();

КонецПроцедуры

&НаКлиенте
Процедура ОбновлениеОтображения()

	ОбновитьДоступностьКоманд();

КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, РежимЗаписи)
	
	Если НЕ ПроверитьЗаполнение() Тогда
		Отказ = Истина;
	КонецЕсли;
	
	ПересчитатьИтог();
	
	Для Каждого Текст Из ПроверитьПравила() Цикл
		Сообщить(Текст);
		Отказ = Истина;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ЗаказПоставщикуПриИзменении(Элемент)

	ОбновитьДоступностьКоманд();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОткрытьЗаказ(Команда)

	Если ЗначениеЗаполнено(Объект.ЗаказПоставщику) Тогда
		ОткрытьФорму("Документ.ЗаказПоставщику.Форма.ФормаДокумента", Новый Структура("Ключ", Объект.ЗаказПоставщику));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьСверку(Команда)
	
	Расхождения = СверкаНаСервере();
	Если Расхождения.Количество() = 0 Тогда
		Сообщить("Все услуги совпадают с заказом. Результат сверки: " + Объект.РезультатСверки + ".");
	Иначе
		Для Каждого Текст Из Расхождения Цикл
			Сообщить(Текст);
		КонецЦикла;
		Сообщить("Результат сверки: " + Объект.РезультатСверки + ". Расхождений: " + Расхождения.Количество() + ".");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиОповещений

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПересчитатьИтог()
	
	Объект.СуммаДокумента = РасчётКомпенсаций.СуммаТабличнойЧасти(Объект.ПодтверждённыеУслуги);
	
КонецПроцедуры

&НаСервере
Функция СверкаНаСервере()
	
	Расхождения = Новый Массив;
	
	Если НЕ ЗначениеЗаполнено(Объект.ЗаказПоставщику) Тогда
		Расхождения.Добавить("Не выбран заказ поставщику - сверять не с чем.");
		Объект.РезультатСверки = Перечисления.РезультатыСверки.ЕстьРасхождения;
		Возврат Расхождения;
	КонецЕсли;
	
	Заказ = Объект.ЗаказПоставщику.ПолучитьОбъект();
	СтрокиЗаказа = Новый Соответствие;
	Для Каждого СтрокаЗаказа Из Заказ.Услуги Цикл
		Ключ = Строка(СтрокаЗаказа.Услуга) + "|" + Строка(СтрокаЗаказа.Объект);
		СтрокиЗаказа.Вставить(Ключ, СтрокаЗаказа);
	КонецЦикла;
	
	НомерСтроки = 0;
	Для Каждого Строка Из Объект.ПодтверждённыеУслуги Цикл
		НомерСтроки = НомерСтроки + 1;
		Ключ = Строка(Строка.Услуга) + "|" + Строка(Строка.Объект);
		СтрокаЗаказа = СтрокиЗаказа.Получить(Ключ);
		
		Если СтрокаЗаказа = Неопределено Тогда
			Расхождения.Добавить("Строка " + НомерСтроки + ": услуга " + Строка.Услуга
				+ " по объекту " + Строка.Объект + " не найдена в заказе.");
			Продолжить;
		КонецЕсли;
		
		Если Строка.ТипНомераФакт <> СтрокаЗаказа.ТипНомера Тогда
			Расхождения.Добавить("Строка " + НомерСтроки + ": тип номера """ + Строка.ТипНомераФакт
				+ """ вместо """ + СтрокаЗаказа.ТипНомера + """.");
		КонецЕсли;
		Если Строка.ТипПитанияФакт <> СтрокаЗаказа.ТипПитания Тогда
			Расхождения.Добавить("Строка " + НомерСтроки + ": тип питания """ + Строка.ТипПитанияФакт
				+ """ вместо """ + СтрокаЗаказа.ТипПитания + """.");
		КонецЕсли;
		Если Строка.ДатаНачала <> СтрокаЗаказа.ДатаНачала Тогда
			Расхождения.Добавить("Строка " + НомерСтроки + ": дата начала "
				+ Формат(Строка.ДатаНачала, "ДЛФ=D") + " вместо "
				+ Формат(СтрокаЗаказа.ДатаНачала, "ДЛФ=D") + ".");
		КонецЕсли;
		Если Строка.Количество <> СтрокаЗаказа.Количество Тогда
			Расхождения.Добавить("Строка " + НомерСтроки + ": количество " + Строка.Количество
				+ " вместо " + СтрокаЗаказа.Количество + ".");
		КонецЕсли;
	КонецЦикла;
	
	Если Расхождения.Количество() = 0 Тогда
		Объект.РезультатСверки = Перечисления.РезультатыСверки.Совпадает;
	Иначе
		Объект.РезультатСверки = Перечисления.РезультатыСверки.ЕстьРасхождения;
	КонецЕсли;
	
	Возврат Расхождения;
	
КонецФункции

&НаСервере
Процедура ОбновитьДоступностьКоманд()

	Элементы.ОткрытьЗаказ.Доступность = ЗначениеЗаполнено(Объект.ЗаказПоставщику);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоОснованию(Основание)

	Заказ = Основание.ПолучитьОбъект();
	Объект.ЗаказПоставщику = Основание;
	Объект.Поставщик = Заказ.Поставщик;
	Объект.ПодтверждённыеУслуги.Очистить();
	Для Каждого СтрокаЗаказа Из Заказ.Услуги Цикл
		НоваяСтрока = Объект.ПодтверждённыеУслуги.Добавить();
		НоваяСтрока.Услуга = СтрокаЗаказа.Услуга;
		НоваяСтрока.Объект = СтрокаЗаказа.Объект;
		НоваяСтрока.ДатаНачала = СтрокаЗаказа.ДатаНачала;
		НоваяСтрока.ДатаОкончания = СтрокаЗаказа.ДатаОкончания;
		НоваяСтрока.Количество = СтрокаЗаказа.Количество;
		НоваяСтрока.Цена = СтрокаЗаказа.Цена;
		НоваяСтрока.Сумма = СтрокаЗаказа.Сумма;
	КонецЦикла;
	
	ПересчитатьИтог();
	
КонецПроцедуры

&НаСервере
Функция ПроверитьПравила()
	
	Возврат Объект.ПравилаЗаписи(Объект);
	
КонецФункции

#КонецОбласти