#Область ПрограммныйИнтерфейс

// Возвращает перечень нарушений, мешающих записи претензии поставщику.
//
// Параметры:
//  Объект - ДокументОбъект.ПретензияПоставщику - записываемый документ.
//
// Возвращаемое значение:
//  Массив - тексты нарушений; пустой массив, если нарушений нет.
//
Функция ПравилаЗаписи(Объект) Экспорт
	
	Нарушения = Новый Массив;
	
	Если НЕ ЗначениеЗаполнено(Объект.Инцидент) Тогда
		Нарушения.Добавить("Не заполнен инцидент. Выберите инцидент, по которому выставляется претензия.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Поставщик) Тогда
		Нарушения.Добавить("Не заполнен поставщик. Выберите поставщика, к которому предъявляется претензия.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Договор) Тогда
		Нарушения.Добавить("Не заполнен договор. Выберите договор, по условиям которого рассчитывается претензия.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Валюта) Тогда
		Нарушения.Добавить("Не заполнена валюта претензии.");
	КонецЕсли;
	
	Если Объект.СуммаТребования <= 0 Тогда
		Нарушения.Добавить("Сумма требования должна быть больше нуля.");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Инцидент) И ЗначениеЗаполнено(Объект.Поставщик) Тогда
		Если Объект.Инцидент.Поставщик <> Объект.Поставщик Тогда
			Нарушения.Добавить("Поставщик претензии (" + Объект.Поставщик
				+ ") не совпадает с поставщиком инцидента (" + Объект.Инцидент.Поставщик + ").");
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Договор) И ЗначениеЗаполнено(Объект.Поставщик) Тогда
		Если Объект.Договор.Владелец <> Объект.Поставщик Тогда
			Нарушения.Добавить("Договор " + Объект.Договор + " принадлежит другому поставщику.");
		КонецЕсли;
	КонецЕсли;
	
	Если Объект.СуммаТребования > 0 И НЕ Объект.СогласованоРуководителем Тогда
		Если РасчётКомпенсаций.ТребуетсяСогласованиеРуководителем(Объект.СуммаТребования) Тогда
			Порог = Константы.ПорогСогласованияРуководителем.Получить();
			Нарушения.Добавить("Сумма требования (" + Формат(Объект.СуммаТребования, "ЧДЦ=2")
				+ ") превышает порог согласования (" + Формат(Порог, "ЧДЦ=2")
				+ "). Требуется согласование руководителем.");
		КонецЕсли;
	КонецЕсли;
	
	Возврат Нарушения;
	
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

// Публикует нарушения правил записи и отклоняет запись документа.
//
// Вызывается платформой при любой записи, включая программную.
//
// Параметры:
//  Отказ - Булево - устанавливается в Истина при найденных нарушениях.
//  РежимЗаписи - РежимЗаписиДокумента - режим записи.
//  РежимПроведения - РежимПроведенияДокумента - режим проведения.
//
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Текст Из ПравилаЗаписи(ЭтотОбъект) Цикл
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = Текст;
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЦикла;
	
КонецПроцедуры

// Формирует движения документа при проведении.
//
// Проведение регистрирует требование к поставщику: в регистр
// ВзаиморасчётыПоПретензиям пишется одно движение с суммой
// требования в разрезе измерений претензия, поставщик, договор и валюта.
// Движения прежнего проведения удаляются, чтобы повторное проведение
// не накапливало дубли.
//
// Параметры:
//  Отказ - Булево - признак отказа от проведения.
//  РежимПроведения - РежимПроведенияДокумента - режим проведения.
//
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеДокументов.ЗаблокироватьРегистры(РегистрыБлокировки());
	УдалитьДвижения();
	
	НаборЗаписей = РегистрыНакопления.ВзаиморасчётыПоПретензиям.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(ЭтотОбъект.Ссылка);
	
	Движение = НаборЗаписей.Добавить();
	Движение.Период = ЭтотОбъект.Дата;
	Движение.Претензия = ЭтотОбъект.Ссылка;
	Движение.Поставщик = ЭтотОбъект.Поставщик;
	Движение.Договор = ЭтотОбъект.Договор;
	Движение.Валюта = ЭтотОбъект.Валюта;
	Движение.СуммаТребования = ЭтотОбъект.СуммаТребования;
	Движение.СуммаУдовлетворения = 0;
	
	НаборЗаписей.Записать(Истина);
	
КонецПроцедуры

// Удаляет движения отменяемого проведения.
//
// Зарегистрированное проведение требования снимается: претензия больше
// не считается заявленной этим документом.
//
// Параметры:
//  Отказ - Булево - признак отказа от отмены проведения.
//
Процедура ОбработкаУдаленияПроведения(Отказ)
	
	УдалитьДвижения();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Удаляет движения документа в регистре взаиморасчётов по претензиям.
//
// Прежний набор движений снимается вручную: набор с отбором по
// регистратору, записанный в режиме замещения, удаляет все движения
// этого документа.
//
Процедура УдалитьДвижения()
	
	НаборЗаписей = РегистрыНакопления.ВзаиморасчётыПоПретензиям.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(ЭтотОбъект.Ссылка);
	НаборЗаписей.Записать(Истина);
	
КонецПроцедуры

// Возвращает области блокировки, которые захватывает проведение.
//
// Возвращаемое значение:
//  Массив - имена областей блокировки.
//
Функция РегистрыБлокировки()
	
	МассивРегистров = Новый Массив;
	МассивРегистров.Добавить("РегистрНакопления.ВзаиморасчётыПоПретензиям");
	
	Возврат МассивРегистров;
	
КонецФункции

#КонецОбласти
