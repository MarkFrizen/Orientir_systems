#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОткрытьИнцидент(Команда)

	Если ЗначениеЗаполнено(Объект.Инцидент) Тогда
		ОткрытьЗначение(Объект.Инцидент);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьДоговор(Команда)

	Если ЗначениеЗаполнено(Объект.Договор) Тогда
		ОткрытьЗначение(Объект.Договор);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СоздатьАкт(Команда)

	ПараметрыФормы = Новый Структура("Основание", Объект.Ссылка);
	ОткрытьФорму("Документ.АктОКомпенсации.ФормаДокумента", ПараметрыФормы);

КонецПроцедуры

