#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("Основание")
		И ТипЗнч(Параметры.Основание) = Тип("ДокументСсылка.Инцидент")
		И НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ЗаполнитьПоОснованию(Параметры.Основание);
	КонецЕсли;

	ПорогСогласования = Константы.ПорогСогласованияРуководителем.Получить();

	ОбновитьДоступностьКоманд();

КонецПроцедуры

&НаКлиенте
Процедура ОбновлениеОтображения()

	ОбновитьДоступностьКоманд();

КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, РежимЗаписи)
	
	Если НЕ ПроверитьЗаполнение() Тогда
		Отказ = Истина;
	КонецЕсли;
	
	Для Каждого Текст Из ПроверитьПравила() Цикл
		Сообщить(Текст);
		Отказ = Истина;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ДоговорПриИзменении(Элемент)

	ОбновитьДоступностьКоманд();

КонецПроцедуры

&НаКлиенте
Процедура ИнцидентПриИзменении(Элемент)

	ОбновитьДоступностьКоманд();

КонецПроцедуры

&НаКлиенте
Процедура СсылкаПриИзменении(Элемент)

	ОбновитьДоступностьКоманд();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОткрытьИнцидент(Команда)

	Если ЗначениеЗаполнено(Объект.Инцидент) Тогда
		ОткрытьФорму("Документ.Инцидент.Форма.ФормаДокумента", Новый Структура("Ключ", Объект.Инцидент));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьДоговор(Команда)

	Если ЗначениеЗаполнено(Объект.Договор) Тогда
		ОткрытьФорму("Справочник.ДоговорыСПоставщиками.Форма.ФормаЭлемента", Новый Структура("Ключ", Объект.Договор));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СоздатьАкт(Команда)

	ПараметрыФормы = Новый Структура("Основание", Объект.Ссылка);
	ОткрытьФорму("Документ.АктОКомпенсации.Форма.ФормаДокумента", ПараметрыФормы);

КонецПроцедуры

&НаКлиенте
Процедура РассчитатьКомпенсацию(Команда)
	
	Результат = РассчитатьКомпенсациюНаСервере();
	Если Результат.ПричинаОтказа <> "" Тогда
		Сообщить("Расчёт невозможен: " + Результат.ПричинаОтказа + ".");
		Возврат;
	КонецЕсли;
	
	Текст = "Рассчитана компенсация: " + Формат(Результат.Сумма, "ЧДЦ=2")
		+ " (исходная расчётная: " + Формат(Результат.ИсходнаяСумма, "ЧДЦ=2") + ")";
	Если Результат.ОграниченаМаксимумом Тогда
		Текст = Текст + ", ограничена максимальной компенсацией договора";
	КонецЕсли;
	Если Результат.ТребуетсяСогласование Тогда
		Текст = Текст + ". Требуется согласование руководителем.";
	КонецЕсли;
	Сообщить(Текст);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиОповещений

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция РассчитатьКомпенсациюНаСервере()
	
	ПустойРезультат = Новый Структура("Сумма, ИсходнаяСумма, ОграниченаМаксимумом, "
		+ "ТребуетсяСогласование, ПричинаОтказа", 0, 0, Ложь, Ложь, "");
	
	Если НЕ ЗначениеЗаполнено(Объект.Договор) Тогда
		ПустойРезультат.ПричинаОтказа = "Не выбран договор";
		Возврат ПустойРезультат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Инцидент) Тогда
		ПустойРезультат.ПричинаОтказа = "Не выбран инцидент";
		Возврат ПустойРезультат;
	КонецЕсли;
	
	Базовая = БазоваяСтоимостьИнцидента();
	Если Базовая = 0 Тогда
		ПустойРезультат.ПричинаОтказа = "Не найден заказ поставщику по инциденту";
		Возврат ПустойРезультат;
	КонецЕсли;
	
	Результат = РасчётКомпенсаций.РассчитатьКомпенсацию(Объект.Договор, Базовая, 1);
	Если Результат.ПричинаОтказа = "" Тогда
		Объект.СуммаТребования = Результат.Сумма;
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция БазоваяСтоимостьИнцидента()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Услуги.Сумма КАК Сумма
		|ИЗ
		|	Документ.ЗаказПоставщику.Услуги КАК Услуги
		|ГДЕ
		|	Услуги.Ссылка.ЗаявкаНаТур = &ЗаявкаНаТур
		|	И Услуги.Ссылка.Поставщик = &Поставщик
		|	И Услуги.Объект = &Объект
		|УПОРЯДОЧИТЬ ПО
		|	Услуги.Сумма УБЫВ";
	Запрос.УстановитьПараметр("ЗаявкаНаТур", Объект.Инцидент.ЗаявкаНаТур);
	Запрос.УстановитьПараметр("Поставщик", Объект.Инцидент.Поставщик);
	Запрос.УстановитьПараметр("Объект", Объект.Инцидент.Объект);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Сумма;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

&НаСервере
Процедура ОбновитьДоступностьКоманд()

	Элементы.ОткрытьИнцидент.Доступность = ЗначениеЗаполнено(Объект.Инцидент);
	Элементы.ОткрытьДоговор.Доступность = ЗначениеЗаполнено(Объект.Договор);
	Элементы.СоздатьАкт.Доступность = ПравоДоступа("Добавление", Метаданные.Документы.АктОКомпенсации) И ЗначениеЗаполнено(Объект.Ссылка);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоОснованию(Основание)

	ИнцидентОбъект = Основание.ПолучитьОбъект();
	Объект.Инцидент = Основание;
	Объект.Поставщик = ИнцидентОбъект.Поставщик;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1 Договоры.Ссылка КАК Договор
		|ИЗ Справочник.ДоговорыСПоставщиками КАК Договоры
		|ГДЕ Договоры.Владелец = &Поставщик
		|	И Договоры.ДатаОкончания >= &ТекущаяДата
		|УПОРЯДОЧИТЬ ПО Договоры.ДатаОкончания УБЫВ";
	Запрос.УстановитьПараметр("Поставщик", ИнцидентОбъект.Поставщик);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Объект.Договор = Выборка.Договор;
		Если ЗначениеЗаполнено(Объект.Договор.МаксимальнаяКомпенсация) Тогда
			Объект.СуммаТребования = Объект.Договор.МаксимальнаяКомпенсация;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПроверитьПравила()
	
	Возврат Объект.ПравилаЗаписи(Объект);
	
КонецФункции

#КонецОбласти