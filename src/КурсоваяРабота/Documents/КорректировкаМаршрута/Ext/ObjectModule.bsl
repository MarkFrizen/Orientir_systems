#Область ПрограммныйИнтерфейс

// Возвращает перечень нарушений, мешающих записи корректировки маршрута.
//
// Параметры:
//  Объект - ДокументОбъект.КорректировкаМаршрута - записываемый документ.
//
// Возвращаемое значение:
//  Массив - тексты нарушений; пустой массив, если нарушений нет.
//
Функция ПравилаЗаписи(Объект) Экспорт
	
	Нарушения = Новый Массив;
	
	Если НЕ ЗначениеЗаполнено(Объект.МаршрутныйЛист) Тогда
		Нарушения.Добавить("Не заполнен маршрутный лист, который корректируется.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Причина) Тогда
		Нарушения.Добавить("Не заполнена причина корректировки. Опишите, из-за чего меняется маршрут.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Инициатор) Тогда
		Нарушения.Добавить("Не заполнен инициатор корректировки.");
	КонецЕсли;
	
	Если Объект.Изменения.Количество() = 0 Тогда
		Нарушения.Добавить("Табличная часть ""Изменения"" пуста. Добавьте хотя бы одно изменение.");
	КонецЕсли;
	
	НомерСтроки = 0;
	Для Каждого Строка Из Объект.Изменения Цикл
		НомерСтроки = НомерСтроки + 1;
		Если НЕ ЗначениеЗаполнено(Строка.СобытиеМаршрута) Тогда
			Нарушения.Добавить("Строка " + НомерСтроки + ": не выбрано событие маршрута.");
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Строка.НовоеВремяUTC) Тогда
			Нарушения.Добавить("Строка " + НомерСтроки + ": не заполнено новое время события.");
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ Объект.Согласовано Тогда
		Нарушения.Добавить("Корректировка не согласована. Перед записью установите признак согласования.");
	КонецЕсли;
	
	Возврат Нарушения;
	
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

// Публикует нарушения правил записи и отклоняет запись документа.
//
// Параметры:
//  Отказ - Булево - устанавливается в Истина при найденных нарушениях.
//  ПроверяемыеРеквизиты - Массив - реквизиты, проверяемые платформой.
//
Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Для Каждого Текст Из ПравилаЗаписи(ЭтотОбъект) Цикл
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = Текст;
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
