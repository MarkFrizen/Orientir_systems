#Область ПрограммныйИнтерфейс

// Возвращает перечень нарушений, мешающих записи корректировки маршрута.
//
// Параметры:
//  Объект - ДокументОбъект.КорректировкаМаршрута - записываемый документ.
//
// Возвращаемое значение:
//  Массив - тексты нарушений; пустой массив, если нарушений нет.
//
Функция ПравилаЗаписи(Объект) Экспорт
	
	Нарушения = Новый Массив;
	
	Если НЕ ЗначениеЗаполнено(Объект.МаршрутныйЛист) Тогда
		Нарушения.Добавить("Не заполнен маршрутный лист, который корректируется.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Причина) Тогда
		Нарушения.Добавить("Не заполнена причина корректировки. Опишите, из-за чего меняется маршрут.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Инициатор) Тогда
		Нарушения.Добавить("Не заполнен инициатор корректировки.");
	КонецЕсли;
	
	Если Объект.Изменения.Количество() = 0 Тогда
		Нарушения.Добавить("Табличная часть ""Изменения"" пуста. Добавьте хотя бы одно изменение.");
	КонецЕсли;
	
	НомерСтроки = 0;
	Для Каждого Строка Из Объект.Изменения Цикл
		НомерСтроки = НомерСтроки + 1;
		Если НЕ ЗначениеЗаполнено(Строка.СобытиеМаршрута) Тогда
			Нарушения.Добавить("Строка " + НомерСтроки + ": не выбрано событие маршрута.");
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Строка.НовоеВремяUTC) Тогда
			Нарушения.Добавить("Строка " + НомерСтроки + ": не заполнено новое время события.");
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ Объект.Согласовано Тогда
		Нарушения.Добавить("Корректировка не согласована. Перед записью установите признак согласования.");
	КонецЕсли;
	
	Возврат Нарушения;
	
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

// Публикует нарушения правил записи и отклоняет запись документа.
//
// Вызывается платформой при любой записи, включая программную.
//
// Параметры:
//  Отказ - Булево - устанавливается в Истина при найденных нарушениях.
//  РежимЗаписи - РежимЗаписиДокумента - режим записи.
//  РежимПроведения - РежимПроведенияДокумента - режим проведения.
//
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Текст Из ПравилаЗаписи(ЭтотОбъект) Цикл
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = Текст;
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЦикла;
	
КонецПроцедуры

// Применяет корректировку при проведении.
//
// Согласованность корректировки уже проверена в ПередЗаписью (ПравилаЗаписи):
// проведение идёт через запись документа, поэтому отдельной проверки здесь
// не нужно. Проведение заменяет времена изменённых событий в графике
// перемещений маршрутного листа, переносит новое время в сами документы
// событий и пересчитывает их локальное время и буферы между событиями.
// Прежнее время каждой строки сохраняется в реквизите СтароеВремяUTC -
// по нему отмена проведения возвращает маршрут в исходное состояние.
//
// Параметры:
//  Отказ - Булево - признак отказа от проведения.
//  РежимПроведения - РежимПроведенияДокумента - режим проведения.
//
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеДокументов.ЗаблокироватьРегистры(РегистрыБлокировки());
	
	Если Не ПрименитьИзмененияВГрафике(Отказ) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаИзменения Из ЭтотОбъект.Изменения Цикл
		УстановитьВремяСобытия(СтрокаИзменения.СобытиеМаршрута, СтрокаИзменения.НовоеВремяUTC);
	КонецЦикла;
	
	ПересчитатьБуферыСобытий();
	
КонецПроцедуры

// Откатывает корректировку при отмене проведения.
//
// Времена записей графика и документов событий возвращаются к значениям
// СтароеВремяUTC, сохранённым при проведении, локальное время и буферы
// пересчитываются заново.
//
// Параметры:
//  Отказ - Булево - признак отказа от отмены проведения.
//
Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеДокументов.ЗаблокироватьРегистры(РегистрыБлокировки());
	
	НаборЗаписей = ПрочитатьГрафикМаршрутногоЛиста();
	Для Каждого СтрокаИзменения Из ЭтотОбъект.Изменения Цикл
		Если Не ЗначениеЗаполнено(СтрокаИзменения.СтароеВремяUTC) Тогда
			Продолжить;
		КонецЕсли;
		
		Запись = НайтиЗаписьГрафика(НаборЗаписей, СтрокаИзменения.СобытиеМаршрута);
		Если Запись = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Запись.ДатаВремяНачалаUTC = СтрокаИзменения.СтароеВремяUTC;
		Запись.ДатаВремяОкончанияUTC = СтрокаИзменения.СтароеВремяUTC + Запись.ДлительностьМинут * 60;
	КонецЦикла;
	НаборЗаписей.Записать(Истина);
	
	Для Каждого СтрокаИзменения Из ЭтотОбъект.Изменения Цикл
		УстановитьВремяСобытия(СтрокаИзменения.СобытиеМаршрута, СтрокаИзменения.СтароеВремяUTC);
	КонецЦикла;
	
	ПересчитатьБуферыСобытий();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает области блокировки, которые захватывает проведение.
//
// Возвращаемое значение:
//  Массив - имена областей блокировки.
//
Функция РегистрыБлокировки()
	
	МассивРегистров = Новый Массив;
	МассивРегистров.Добавить("РегистрСведений.ГрафикПеремещений");
	
	Возврат МассивРегистров;
	
КонецФункции

// Читает набор записей графика перемещений корректируемого маршрутного листа.
//
// Регистратором записей графика остаётся маршрутный лист, поэтому набор
// читается с отбором по его ссылке - именно он замещается при записи.
//
// Возвращаемое значение:
//  РегистрСведенийНаборЗаписей.ГрафикПеремещений - прочитанный набор.
//
Функция ПрочитатьГрафикМаршрутногоЛиста()
	
	НаборЗаписей = РегистрыСведений.ГрафикПеремещений.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(ЭтотОбъект.МаршрутныйЛист);
	НаборЗаписей.Прочитать();
	
	Возврат НаборЗаписей;
	
КонецФункции

// Ищет в наборе запись графика по событию маршрута.
//
// Параметры:
//  НаборЗаписей - РегистрСведенийНаборЗаписей.ГрафикПеремещений - набор записей графика.
//  СобытиеСсылка - ДокументСсылка.СобытиеМаршрута - искомое событие.
//
// Возвращаемое значение:
//  РегистрСведенийЗапись.ГрафикПеремещений, Неопределено - найденная запись.
//
Функция НайтиЗаписьГрафика(НаборЗаписей, СобытиеСсылка)
	
	Для Каждого Запись Из НаборЗаписей Цикл
		Если Запись.СобытиеМаршрута = СобытиеСсылка Тогда
			Возврат Запись;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

// Заменяет времена изменённых событий в графике перемещений.
//
// Перед заменой сохраняет прежнее время начала в реквизите СтароеВремяUTC
// строки изменения: это опора отката при отмене проведения. Если записи
// события в графике нет (маршрутный лист не проведён), проведение
// отклоняется - корректировать нечего.
//
// Параметры:
//  Отказ - Булево - устанавливается в Истина при отсутствии записей графика.
//
// Возвращаемое значение:
//  Булево - Истина, если изменения применены к набору записей.
//
Функция ПрименитьИзмененияВГрафике(Отказ)
	
	НаборЗаписей = ПрочитатьГрафикМаршрутногоЛиста();
	
	Для Каждого СтрокаИзменения Из ЭтотОбъект.Изменения Цикл
		Запись = НайтиЗаписьГрафика(НаборЗаписей, СтрокаИзменения.СобытиеМаршрута);
		Если Запись = Неопределено Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "В графике перемещений нет записи события """
				+ Строка(СтрокаИзменения.СобытиеМаршрута)
				+ """. Маршрутный лист должен быть проведён до корректировки.";
			Сообщение.Сообщить();
			Отказ = Истина;
			Возврат Ложь;
		КонецЕсли;
		
		СтрокаИзменения.СтароеВремяUTC = Запись.ДатаВремяНачалаUTC;
		Запись.ДатаВремяНачалаUTC = СтрокаИзменения.НовоеВремяUTC;
		Запись.ДатаВремяОкончанияUTC = СтрокаИзменения.НовоеВремяUTC + Запись.ДлительностьМинут * 60;
	КонецЦикла;
	
	НаборЗаписей.Записать(Истина);
	
	Возврат Истина;
	
КонецФункции

// Переносит новое время в документ события маршрута и пересчитывает
// его локальное время по часовой зоне объекта.
//
// Параметры:
//  СобытиеСсылка - ДокументСсылка.СобытиеМаршрута - корректируемое событие.
//  ВремяUTC - Дата - новое время события в UTC; пустое время пропускается.
//
Процедура УстановитьВремяСобытия(СобытиеСсылка, ВремяUTC)
	
	Если Не ЗначениеЗаполнено(СобытиеСсылка) Или Не ЗначениеЗаполнено(ВремяUTC) Тогда
		Возврат;
	КонецЕсли;
	
	Событие = СобытиеСсылка.ПолучитьОбъект();
	Событие.ДатаВремяUTC = ВремяUTC;
	
	Если ЗначениеЗаполнено(Событие.Объект) Тогда
		Локальное = РаботаСДатамиИЧасовымиЗонами.ПеревестиВЛокальноеВремя(
			ВремяUTC, Событие.Объект.ЧасоваяЗона);
		Если Локальное <> Неопределено Тогда
			Событие.ЛокальноеВремя = Локальное;
		КонецЕсли;
	КонецЕсли;
	
	Событие.Записать(РежимЗаписиДокумента.Запись);
	
КонецПроцедуры

// Пересчитывает буферы между событиями маршрутного листа: сдвиг одного
// события меняет запас времени до следующего у всей цепочки, поэтому
// буферы пересчитываются по всем событиям листа в хронологическом порядке.
// Буфер последнего события не определён и не трогается.
//
Процедура ПересчитатьБуферыСобытий()
	
	Если Не ЗначениеЗаполнено(ЭтотОбъект.МаршрутныйЛист) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	События.Ссылка КАК Ссылка,
		|	События.ДатаВремяUTC КАК ДатаВремяUTC,
		|	События.ДлительностьМинут КАК ДлительностьМинут,
		|	События.БуферДоСледующегоМинут КАК БуферДоСледующегоМинут
		|ИЗ
		|	Документ.СобытиеМаршрута КАК События
		|ГДЕ
		|	События.МаршрутныйЛист = &МаршрутныйЛист
		|	И События.ПометкаУдаления = ЛОЖЬ
		|УПОРЯДОЧИТЬ ПО
		|	События.ДатаВремяUTC";
	Запрос.УстановитьПараметр("МаршрутныйЛист", ЭтотОбъект.МаршрутныйЛист);
	
	События = Запрос.Выполнить().Выгрузить();
	
	Для Индекс = 0 По События.Количество() - 2 Цикл
		Текущее = События[Индекс];
		Следующее = События[Индекс + 1];
		
		Окончание = Текущее.ДатаВремяUTC + Текущее.ДлительностьМинут * 60;
		Буфер = РаботаСДатамиИЧасовымиЗонами.РазницаВМинутах(Окончание, Следующее.ДатаВремяUTC);
		
		Если Текущее.БуферДоСледующегоМинут <> Буфер Тогда
			Событие = Текущее.Ссылка.ПолучитьОбъект();
			Событие.БуферДоСледующегоМинут = Буфер;
			Событие.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
