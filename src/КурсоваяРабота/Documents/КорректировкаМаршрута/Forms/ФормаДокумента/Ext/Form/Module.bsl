#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ОбновитьДоступностьКоманд();

КонецПроцедуры

&НаКлиенте
Процедура ОбновлениеОтображения()

	ОбновитьДоступностьКоманд();

КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, РежимЗаписи)
	
	Если НЕ ПроверитьЗаполнение() Тогда
		Отказ = Истина;
	КонецЕсли;
	
	Для Каждого Текст Из ПроверитьПравила() Цикл
		Сообщить(Текст);
		Отказ = Истина;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура МаршрутныйЛистПриИзменении(Элемент)

	ОбновитьДоступностьКоманд();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОткрытьМаршрутныйЛист(Команда)

	Если ЗначениеЗаполнено(Объект.МаршрутныйЛист) Тогда
		ОткрытьФорму("Документ.МаршрутныйЛист.Форма.ФормаДокумента", Новый Структура("Ключ", Объект.МаршрутныйЛист));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПрименитьКорректировку(Команда)
	
	Если НЕ Объект.Согласовано Тогда
		Сообщить("Корректировка не согласована. Применение невозможно.");
		Возврат;
	КонецЕсли;
	
	Если Объект.Изменения.Количество() = 0 Тогда
		Сообщить("В табличной части ""Изменения"" нет строк.");
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ПослеВопросаКорректировки", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, "Применить корректировку к " + Объект.Изменения.Количество()
		+ " событиям?", РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаКорректировки(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Сведения = ПрименитьКорректировкуНаСервере();
	Сообщить("Изменено событий: " + Сведения.Изменено + ".");
	Если Сведения.Проведенных > 0 Тогда
		Сообщить("Требуется перепроведение: " + Сведения.Проведенных + ".");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиОповещений

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПрименитьКорректировкуНаСервере()
	
	Сведения = Новый Структура("Изменено, Проведенных", 0, 0);
	
	Для Каждого Строка Из Объект.Изменения Цикл
		Если НЕ ЗначениеЗаполнено(Строка.СобытиеМаршрута) Или НЕ ЗначениеЗаполнено(Строка.НовоеВремяUTC) Тогда
			Продолжить;
		КонецЕсли;
		
		Событие = Строка.СобытиеМаршрута.ПолучитьОбъект();
		Событие.ДатаВремяUTC = Строка.НовоеВремяUTC;
		
		Если ЗначениеЗаполнено(Событие.Объект) Тогда
			Локальное = РаботаСДатамиИЧасовымиЗонами.ПеревестиВЛокальноеВремя(
				Событие.ДатаВремяUTC, Событие.Объект.ЧасоваяЗона);
			Если Локальное <> Неопределено Тогда
				Событие.ЛокальноеВремя = Локальное;
			КонецЕсли;
		КонецЕсли;
		
		Если Событие.Проведен Тогда
			Сведения.Проведенных = Сведения.Проведенных + 1;
		КонецЕсли;
		
		Событие.Записать(РежимЗаписиДокумента.Запись);
		Сведения.Изменено = Сведения.Изменено + 1;
	КонецЦикла;
	
	Возврат Сведения;
	
КонецФункции

&НаСервере
Процедура ОбновитьДоступностьКоманд()

	Элементы.ОткрытьМаршрутныйЛист.Доступность = ЗначениеЗаполнено(Объект.МаршрутныйЛист);
КонецПроцедуры

&НаСервере
Функция ПроверитьПравила()
	
	Возврат Объект.ПравилаЗаписи(Объект);
	
КонецФункции

#КонецОбласти