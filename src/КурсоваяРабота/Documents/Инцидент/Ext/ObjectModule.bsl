#Область ПрограммныйИнтерфейс

// Возвращает перечень нарушений, мешающих записи инцидента.
//
// Параметры:
//  Объект - ДокументОбъект.Инцидент - записываемый документ.
//
// Возвращаемое значение:
//  Массив - тексты нарушений; пустой массив, если нарушений нет.
//
Функция ПравилаЗаписи(Объект) Экспорт
	
	Нарушения = Новый Массив;
	
	Если НЕ ЗначениеЗаполнено(Объект.ЗаявкаНаТур) Тогда
		Нарушения.Добавить("Не заполнена заявка на тур.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Турист) Тогда
		Нарушения.Добавить("Не заполнен турист.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.ТипИнцидента) Тогда
		Нарушения.Добавить("Не заполнен тип инцидента.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Объект) Тогда
		Нарушения.Добавить("Не заполнен объект, на котором произошёл инцидент.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Поставщик) Тогда
		Нарушения.Добавить("Не заполнен поставщик.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Описание) Тогда
		Нарушения.Добавить("Не заполнено описание инцидента.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.УровеньТяжести) Тогда
		Нарушения.Добавить("Не заполнен уровень тяжести.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.ДатаИнцидента) Тогда
		Нарушения.Добавить("Не заполнена дата инцидента.");
	ИначеЕсли Объект.ДатаИнцидента > ТекущаяДатаСеанса() Тогда
		Нарушения.Добавить("Дата инцидента не может быть позже текущей даты.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.АвторРегистрации) Тогда
		Нарушения.Добавить("Не заполнен автор регистрации.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Ответственный) Тогда
		Нарушения.Добавить("Не заполнен ответственный за урегулирование.");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Объект) И ЗначениеЗаполнено(Объект.Поставщик) Тогда
		Если Объект.Объект.Владелец <> Объект.Поставщик Тогда
			Нарушения.Добавить("Объект " + Объект.Объект + " принадлежит другому поставщику ("
				+ Объект.Объект.Владелец + ").");
		КонецЕсли;
	КонецЕсли;
	
	Возврат Нарушения;
	
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

// Публикует нарушения правил записи и отклоняет запись документа.
//
// Параметры:
//  Отказ - Булево - устанавливается в Истина при найденных нарушениях.
//  ПроверяемыеРеквизиты - Массив - реквизиты, проверяемые платформой.
//
Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Для Каждого Текст Из ПравилаЗаписи(ЭтотОбъект) Цикл
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = Текст;
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
