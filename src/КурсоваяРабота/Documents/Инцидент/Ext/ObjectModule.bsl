#Область ПрограммныйИнтерфейс

// Возвращает перечень нарушений, мешающих записи инцидента.
//
// Параметры:
//  Объект - ДокументОбъект.Инцидент - записываемый документ.
//
// Возвращаемое значение:
//  Массив - тексты нарушений; пустой массив, если нарушений нет.
//
Функция ПравилаЗаписи(Объект) Экспорт
	
	Нарушения = Новый Массив;
	
	Если НЕ ЗначениеЗаполнено(Объект.ЗаявкаНаТур) Тогда
		Нарушения.Добавить("Не заполнена заявка на тур.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Турист) Тогда
		Нарушения.Добавить("Не заполнен турист.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.ТипИнцидента) Тогда
		Нарушения.Добавить("Не заполнен тип инцидента.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Объект) Тогда
		Нарушения.Добавить("Не заполнен объект, на котором произошёл инцидент.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Поставщик) Тогда
		Нарушения.Добавить("Не заполнен поставщик.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Описание) Тогда
		Нарушения.Добавить("Не заполнено описание инцидента.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.УровеньТяжести) Тогда
		Нарушения.Добавить("Не заполнен уровень тяжести.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.ДатаИнцидента) Тогда
		Нарушения.Добавить("Не заполнена дата инцидента.");
	ИначеЕсли Объект.ДатаИнцидента > ТекущаяДатаСеанса() Тогда
		Нарушения.Добавить("Дата инцидента не может быть позже текущей даты.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.АвторРегистрации) Тогда
		Нарушения.Добавить("Не заполнен автор регистрации.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Ответственный) Тогда
		Нарушения.Добавить("Не заполнен ответственный за урегулирование.");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Объект) И ЗначениеЗаполнено(Объект.Поставщик) Тогда
		Если Объект.Объект.Владелец <> Объект.Поставщик Тогда
			Нарушения.Добавить("Объект " + Объект.Объект + " принадлежит другому поставщику ("
				+ Объект.Объект.Владелец + ").");
		КонецЕсли;
	КонецЕсли;
	
	Возврат Нарушения;
	
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

// Публикует нарушения правил записи и отклоняет запись документа.
//
// Вызывается платформой при любой записи, включая программную.
//
// Параметры:
//  Отказ - Булево - устанавливается в Истина при найденных нарушениях.
//  РежимЗаписи - РежимЗаписиДокумента - режим записи.
//  РежимПроведения - РежимПроведенияДокумента - режим проведения.
//
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Текст Из ПравилаЗаписи(ЭтотОбъект) Цикл
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = Текст;
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЦикла;
	
КонецПроцедуры

// Формирует движения документа при проведении.
//
// Проведение открывает инцидент: в регистр СтатусыИнцидентов пишется одна
// запись со статусом «Открыт», ответственным за урегулирование из документа
// и датой документа. Записи прежнего проведения удаляются, чтобы повторное
// проведение не накапливало дубли.
//
// Параметры:
//  Отказ - Булево - признак отказа от проведения.
//  РежимПроведения - РежимПроведенияДокумента - режим проведения.
//
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеДокументов.ЗаблокироватьРегистры(РегистрыБлокировки());
	УдалитьДвижения();
	
	НаборЗаписей = РегистрыСведений.СтатусыИнцидентов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(ЭтотОбъект.Ссылка);
	
	Запись = НаборЗаписей.Добавить();
	Запись.Период = НачалоДня(ЭтотОбъект.Дата);
	Запись.Инцидент = ЭтотОбъект.Ссылка;
	Запись.Статус = Перечисления.СтатусыИнцидента.Открыт;
	Запись.Ответственный = ЭтотОбъект.Ответственный;
	
	НаборЗаписей.Записать(Истина);
	
КонецПроцедуры

// Удаляет движения отменяемого проведения.
//
// Запись статуса, открытая проведением, снимается: инцидент больше
// не считается открытым этим документом.
//
// Параметры:
//  Отказ - Булево - признак отказа от отмены проведения.
//
Процедура ОбработкаУдаленияПроведения(Отказ)
	
	УдалитьДвижения();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Удаляет движения документа в регистре статусов инцидентов.
//
// Регистр сведений не очищается платформой при повторном проведении, поэтому
// прежний набор записей снимается вручную: набор с отбором по регистратору,
// записанный в режиме замещения, удаляет все строки этого документа.
//
Процедура УдалитьДвижения()
	
	НаборЗаписей = РегистрыСведений.СтатусыИнцидентов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(ЭтотОбъект.Ссылка);
	НаборЗаписей.Записать(Истина);
	
КонецПроцедуры

// Возвращает области блокировки, которые захватывает проведение.
//
// Возвращаемое значение:
//  Массив - имена областей блокировки.
//
Функция РегистрыБлокировки()
	
	МассивРегистров = Новый Массив;
	МассивРегистров.Добавить("РегистрСведений.СтатусыИнцидентов");
	
	Возврат МассивРегистров;
	
КонецФункции

#КонецОбласти
