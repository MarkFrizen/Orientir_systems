#Область ПрограммныйИнтерфейс

// Возвращает перечень нарушений, мешающих записи маршрутного листа.
//
// Параметры:
//  Объект - ДокументОбъект.МаршрутныйЛист - записываемый документ.
//
// Возвращаемое значение:
//  Массив - тексты нарушений; пустой массив, если нарушений нет.
//
Функция ПравилаЗаписи(Объект) Экспорт
	
	Нарушения = Новый Массив;
	
	Если НЕ ЗначениеЗаполнено(Объект.ЗаявкаНаТур) Тогда
		Нарушения.Добавить("Не заполнена заявка на тур. Маршрутный лист должен опираться на проданный тур.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Турист) Тогда
		Нарушения.Добавить("Не заполнен турист. Укажите, для кого строится маршрут.");
	КонецЕсли;
	
	Возврат Нарушения;
	
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

// Публикует нарушения правил записи и отклоняет запись документа.
//
// Вызывается платформой при любой записи, включая программную.
//
// Параметры:
//  Отказ - Булево - устанавливается в Истина при найденных нарушениях.
//  РежимЗаписи - РежимЗаписиДокумента - режим записи.
//  РежимПроведения - РежимПроведенияДокумента - режим проведения.
//
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Текст Из ПравилаЗаписи(ЭтотОбъект) Цикл
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = Текст;
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
