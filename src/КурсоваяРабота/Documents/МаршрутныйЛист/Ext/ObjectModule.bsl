#Область ПрограммныйИнтерфейс

// Возвращает перечень нарушений, мешающих записи маршрутного листа.
//
// Параметры:
//  Объект - ДокументОбъект.МаршрутныйЛист - записываемый документ.
//
// Возвращаемое значение:
//  Массив - тексты нарушений; пустой массив, если нарушений нет.
//
Функция ПравилаЗаписи(Объект) Экспорт
	
	Нарушения = Новый Массив;
	
	Если НЕ ЗначениеЗаполнено(Объект.ЗаявкаНаТур) Тогда
		Нарушения.Добавить("Не заполнена заявка на тур. Маршрутный лист должен опираться на проданный тур.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Турист) Тогда
		Нарушения.Добавить("Не заполнен турист. Укажите, для кого строится маршрут.");
	КонецЕсли;
	
	Возврат Нарушения;
	
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

// Публикует нарушения правил записи и отклоняет запись документа.
//
// Вызывается платформой при любой записи, включая программную.
//
// Параметры:
//  Отказ - Булево - устанавливается в Истина при найденных нарушениях.
//  РежимЗаписи - РежимЗаписиДокумента - режим записи.
//  РежимПроведения - РежимПроведенияДокумента - режим проведения.
//
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Текст Из ПравилаЗаписи(ЭтотОбъект) Цикл
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = Текст;
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЦикла;
	
КонецПроцедуры

// Формирует движения документа при проведении.
//
// Маршрутный лист строит график перемещений туриста: в регистр сведений
// ГрафикПеремещений пишется по одной записи на каждое событие маршрута.
// Табличной части у документа нет, поэтому события берутся запросом по
// документам СобытиеМаршрута со ссылкой на этот маршрутный лист. Сами
// события движений не пишут (решение D3) - график целиком принадлежит
// маршрутному листу, он же его регистратор.
//
// Параметры:
//  Отказ - Булево - признак отказа от проведения.
//  РежимПроведения - РежимПроведенияДокумента - режим проведения.
//
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеДокументов.ЗаблокироватьРегистры(РегистрыБлокировки());
	УдалитьДвижения();
	ЗаписатьДвижения();
	
КонецПроцедуры

// Удаляет движения отменяемого проведения.
//
// Параметры:
//  Отказ - Булево - признак отказа от отмены проведения.
//
Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеДокументов.ЗаблокироватьРегистры(РегистрыБлокировки());
	УдалитьДвижения();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает области блокировки, которые захватывает проведение.
//
// График перемещений общий для маршрутных листов и их корректировок,
// поэтому блокируется всегда: иначе одновременная корректировка маршрута
// прочитает неполный набор записей графика.
//
// Возвращаемое значение:
//  Массив - имена областей блокировки.
//
Функция РегистрыБлокировки()
	
	МассивРегистров = Новый Массив;
	МассивРегистров.Добавить("РегистрСведений.ГрафикПеремещений");
	
	Возврат МассивРегистров;
	
КонецФункции

// Удаляет движения документа в графике перемещений.
//
// Регистр сведений не очищается платформой при повторном проведении, поэтому
// прежний набор записей снимается вручную: набор с отбором по регистратору,
// записанный в режиме замещения, удаляет все строки этого документа.
//
Процедура УдалитьДвижения()
	
	НаборЗаписей = РегистрыСведений.ГрафикПеремещений.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(ЭтотОбъект.Ссылка);
	НаборЗаписей.Записать(Истина);
	
КонецПроцедуры

// Записывает движения документа: по записи графика на каждое событие маршрута.
//
// В график попадают все непомеченные на удаление события маршрутного листа,
// независимо от их проведённости: событие - плановая строка графика, а его
// проведение движений не формирует. Период записи - начало дня даты
// маршрутного листа: регистр периодический (день), и без явного периода
// платформа отнесла бы запись к произвольному моменту.
//
Процедура ЗаписатьДвижения()
	
	НаборЗаписей = РегистрыСведений.ГрафикПеремещений.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(ЭтотОбъект.Ссылка);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	События.Ссылка КАК Ссылка,
		|	События.ДатаВремяUTC КАК ДатаВремяUTC,
		|	События.ТипСобытия КАК ТипСобытия,
		|	События.Объект КАК Объект,
		|	События.ДлительностьМинут КАК ДлительностьМинут
		|ИЗ
		|	Документ.СобытиеМаршрута КАК События
		|ГДЕ
		|	События.МаршрутныйЛист = &МаршрутныйЛист
		|	И События.ПометкаУдаления = ЛОЖЬ
		|УПОРЯДОЧИТЬ ПО
		|	События.ДатаВремяUTC";
	Запрос.УстановитьПараметр("МаршрутныйЛист", ЭтотОбъект.Ссылка);
	
	Для Каждого СтрокаСобытия Из Запрос.Выполнить().Выгрузить() Цикл
		Запись = НаборЗаписей.Добавить();
		Запись.Период = НачалоДня(ЭтотОбъект.Дата);
		Запись.МаршрутныйЛист = ЭтотОбъект.Ссылка;
		Запись.СобытиеМаршрута = СтрокаСобытия.Ссылка;
		Запись.Турист = ЭтотОбъект.Турист;
		Запись.Объект = СтрокаСобытия.Объект;
		Запись.ТипСобытия = СтрокаСобытия.ТипСобытия;
		Запись.ДатаВремяНачалаUTC = СтрокаСобытия.ДатаВремяUTC;
		Запись.ДатаВремяОкончанияUTC = СтрокаСобытия.ДатаВремяUTC + СтрокаСобытия.ДлительностьМинут * 60;
		Запись.ДлительностьМинут = СтрокаСобытия.ДлительностьМинут;
	КонецЦикла;
	
	НаборЗаписей.Записать(Истина);
	
КонецПроцедуры

#КонецОбласти
