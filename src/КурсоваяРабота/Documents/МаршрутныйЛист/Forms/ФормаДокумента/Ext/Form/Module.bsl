#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ОбновитьДоступностьКоманд();

КонецПроцедуры

&НаКлиенте
Процедура ОбновлениеОтображения()

	ОбновитьДоступностьКоманд();

КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, РежимЗаписи)
	
	Если НЕ ПроверитьЗаполнение() Тогда
		Отказ = Истина;
	КонецЕсли;
	
	Для Каждого Текст Из ПроверитьПравила() Цикл
		Сообщить(Текст);
		Отказ = Истина;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ЗаявкаНаТурПриИзменении(Элемент)

	ОбновитьДоступностьКоманд();

КонецПроцедуры

&НаКлиенте
Процедура ТуристПриИзменении(Элемент)

	ОбновитьДоступностьКоманд();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОткрытьЗаявку(Команда)

	Если ЗначениеЗаполнено(Объект.ЗаявкаНаТур) Тогда
		ОткрытьФорму("Справочник.ЗаявкиНаТур.Форма.ФормаЭлемента", Новый Структура("Ключ", Объект.ЗаявкаНаТур));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьТуриста(Команда)

	Если ЗначениеЗаполнено(Объект.Турист) Тогда
		ОткрытьФорму("Справочник.Туристы.Форма.ФормаЭлемента", Новый Структура("Ключ", Объект.Турист));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьТайминги(Команда)
	
	Сведения = ПересчитатьТаймингиНаСервере(Ложь);
	Если Сведения.Всего = 0 Тогда
		Сообщить("У маршрутного листа нет событий - пересчитывать нечего.");
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ПослеВопросаТаймингов", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, "Пересчитать тайминги для " + Сведения.Всего + " событий?",
		РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаТаймингов(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Сведения = ПересчитатьТаймингиНаСервере(Истина);
	Сообщить("Обработано событий: " + Сведения.Всего + ", с накладкой: " + Сведения.Накладок
		+ ", проведённых: " + Сведения.Проведенных + ".");
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиОповещений

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПересчитатьТаймингиНаСервере(Записывать)
	
	Сведения = Новый Структура("Всего, Накладок, Проведенных", 0, 0, 0);
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат Сведения;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	События.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.СобытиеМаршрута КАК События
		|ГДЕ
		|	События.МаршрутныйЛист = &МаршрутныйЛист
		|УПОРЯДОЧИТЬ ПО
		|	События.ДатаВремяUTC";
	Запрос.УстановитьПараметр("МаршрутныйЛист", Объект.Ссылка);
	
	События = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		События.Добавить(Выборка.Ссылка.ПолучитьОбъект());
	КонецЦикла;
	
	Сведения.Всего = События.Количество();
	
	Для Индекс = 0 По События.Количество() - 1 Цикл
		Текущее = События[Индекс];
		
		Если ЗначениеЗаполнено(Текущее.Объект) Тогда
			Локальное = РаботаСДатамиИЧасовымиЗонами.ПеревестиВЛокальноеВремя(
				Текущее.ДатаВремяUTC, Текущее.Объект.ЧасоваяЗона);
			Если Локальное <> Неопределено Тогда
				Текущее.ЛокальноеВремя = Локальное;
			КонецЕсли;
		КонецЕсли;
		
		Если Индекс < События.Количество() - 1 Тогда
			Следующее = События[Индекс + 1];
			Окончание = Текущее.ДатаВремяUTC + Текущее.ДлительностьМинут * 60;
			Буфер = РаботаСДатамиИЧасовымиЗонами.РазницаВМинутах(Окончание, Следующее.ДатаВремяUTC);
			Текущее.БуферДоСледующегоМинут = Буфер;
			Если Буфер < 0 Тогда
				Сведения.Накладок = Сведения.Накладок + 1;
			КонецЕсли;
		КонецЕсли;
		
		Если Текущее.Проведен Тогда
			Сведения.Проведенных = Сведения.Проведенных + 1;
		КонецЕсли;
		
		Если Записывать Тогда
			Текущее.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Сведения;
	
КонецФункции

&НаСервере
Процедура ОбновитьДоступностьКоманд()

	Элементы.ОткрытьЗаявку.Доступность = ЗначениеЗаполнено(Объект.ЗаявкаНаТур);
	Элементы.ОткрытьТуриста.Доступность = ЗначениеЗаполнено(Объект.Турист);
КонецПроцедуры

&НаСервере
Функция ПроверитьПравила()
	
	Возврат Объект.ПравилаЗаписи(Объект);
	
КонецФункции

#КонецОбласти