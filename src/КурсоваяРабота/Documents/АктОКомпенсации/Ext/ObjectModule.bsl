#Область ПрограммныйИнтерфейс

// Возвращает перечень нарушений, мешающих записи акта о компенсации.
//
// Параметры:
//  Объект - ДокументОбъект.АктОКомпенсации - записываемый документ.
//
// Возвращаемое значение:
//  Массив - тексты нарушений; пустой массив, если нарушений нет.
//
Функция ПравилаЗаписи(Объект) Экспорт
	
	Нарушения = Новый Массив;
	
	Если НЕ ЗначениеЗаполнено(Объект.Претензия) Тогда
		Нарушения.Добавить("Не заполнена претензия. Выберите претензию, по которой оформляется акт.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Инцидент) Тогда
		Нарушения.Добавить("Не заполнен инцидент.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Валюта) Тогда
		Нарушения.Добавить("Не заполнена валюта акта.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.ДатаАкта) Тогда
		Нарушения.Добавить("Не заполнена дата акта.");
	КонецЕсли;
	
	Если Объект.СуммаКомпенсацииТуристу < 0 Тогда
		Нарушения.Добавить("Сумма компенсации туристу не может быть отрицательной.");
	КонецЕсли;
	Если Объект.СуммаВзысканияСПоставщика < 0 Тогда
		Нарушения.Добавить("Сумма взыскания с поставщика не может быть отрицательной.");
	КонецЕсли;
	
	Если Объект.СтруктураКомпенсации.Количество() = 0 Тогда
		Нарушения.Добавить("Табличная часть ""Структура компенсации"" пуста. Добавьте хотя бы одну строку.");
	КонецЕсли;
	
	НомерСтроки = 0;
	Для Каждого Строка Из Объект.СтруктураКомпенсации Цикл
		НомерСтроки = НомерСтроки + 1;
		Если Строка.Сумма < 0 Тогда
			Нарушения.Добавить("Строка " + НомерСтроки + ": сумма не может быть отрицательной.");
		КонецЕсли;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(Объект.Претензия) Тогда
		Если Объект.СуммаВзысканияСПоставщика > Объект.Претензия.СуммаТребования Тогда
			Нарушения.Добавить("Сумма взыскания с поставщика (" + Формат(Объект.СуммаВзысканияСПоставщика, "ЧДЦ=2")
				+ ") превышает сумму требования по претензии (" + Формат(Объект.Претензия.СуммаТребования, "ЧДЦ=2") + ").");
		КонецЕсли;
	КонецЕсли;
	
	Если Объект.СтруктураКомпенсации.Количество() > 0 Тогда
		СуммаСтрок = РасчётКомпенсаций.СуммаТабличнойЧасти(Объект.СтруктураКомпенсации);
		Если СуммаСтрок <> Объект.СуммаКомпенсацииТуристу Тогда
			Нарушения.Добавить("Сумма строк структуры (" + Формат(СуммаСтрок, "ЧДЦ=2")
				+ ") не равна сумме компенсации туристу (" + Формат(Объект.СуммаКомпенсацииТуристу, "ЧДЦ=2")
				+ "). Пересчитайте структуру.");
		КонецЕсли;
	КонецЕсли;
	
	Возврат Нарушения;
	
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

// Публикует нарушения правил записи и отклоняет запись документа.
//
// Вызывается платформой при любой записи, включая программную.
//
// Параметры:
//  Отказ - Булево - устанавливается в Истина при найденных нарушениях.
//  РежимЗаписи - РежимЗаписиДокумента - режим записи.
//  РежимПроведения - РежимПроведенияДокумента - режим проведения.
//
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Текст Из ПравилаЗаписи(ЭтотОбъект) Цикл
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = Текст;
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
