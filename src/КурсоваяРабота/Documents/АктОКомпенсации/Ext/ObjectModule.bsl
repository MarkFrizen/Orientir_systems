#Область ПрограммныйИнтерфейс

// Возвращает перечень нарушений, мешающих записи акта о компенсации.
//
// Параметры:
//  Объект - ДокументОбъект.АктОКомпенсации - записываемый документ.
//
// Возвращаемое значение:
//  Массив - тексты нарушений; пустой массив, если нарушений нет.
//
Функция ПравилаЗаписи(Объект) Экспорт
	
	Нарушения = Новый Массив;
	
	Если НЕ ЗначениеЗаполнено(Объект.Претензия) Тогда
		Нарушения.Добавить("Не заполнена претензия. Выберите претензию, по которой оформляется акт.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Инцидент) Тогда
		Нарушения.Добавить("Не заполнен инцидент.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Валюта) Тогда
		Нарушения.Добавить("Не заполнена валюта акта.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.ДатаАкта) Тогда
		Нарушения.Добавить("Не заполнена дата акта.");
	КонецЕсли;
	
	Если Объект.СуммаКомпенсацииТуристу < 0 Тогда
		Нарушения.Добавить("Сумма компенсации туристу не может быть отрицательной.");
	КонецЕсли;
	Если Объект.СуммаВзысканияСПоставщика < 0 Тогда
		Нарушения.Добавить("Сумма взыскания с поставщика не может быть отрицательной.");
	КонецЕсли;
	
	Если Объект.СтруктураКомпенсации.Количество() = 0 Тогда
		Нарушения.Добавить("Табличная часть ""Структура компенсации"" пуста. Добавьте хотя бы одну строку.");
	КонецЕсли;
	
	НомерСтроки = 0;
	Для Каждого Строка Из Объект.СтруктураКомпенсации Цикл
		НомерСтроки = НомерСтроки + 1;
		Если Строка.Сумма < 0 Тогда
			Нарушения.Добавить("Строка " + НомерСтроки + ": сумма не может быть отрицательной.");
		КонецЕсли;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(Объект.Претензия) Тогда
		Если Объект.СуммаВзысканияСПоставщика > Объект.Претензия.СуммаТребования Тогда
			Нарушения.Добавить("Сумма взыскания с поставщика (" + Формат(Объект.СуммаВзысканияСПоставщика, "ЧДЦ=2")
				+ ") превышает сумму требования по претензии (" + Формат(Объект.Претензия.СуммаТребования, "ЧДЦ=2") + ").");
		КонецЕсли;
	КонецЕсли;
	
	Если Объект.СтруктураКомпенсации.Количество() > 0 Тогда
		СуммаСтрок = РасчётКомпенсаций.СуммаТабличнойЧасти(Объект.СтруктураКомпенсации);
		Если СуммаСтрок <> Объект.СуммаКомпенсацииТуристу Тогда
			Нарушения.Добавить("Сумма строк структуры (" + Формат(СуммаСтрок, "ЧДЦ=2")
				+ ") не равна сумме компенсации туристу (" + Формат(Объект.СуммаКомпенсацииТуристу, "ЧДЦ=2")
				+ "). Пересчитайте структуру.");
		КонецЕсли;
	КонецЕсли;
	
	Возврат Нарушения;
	
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

// Публикует нарушения правил записи и отклоняет запись документа.
//
// Вызывается платформой при любой записи, включая программную.
//
// Параметры:
//  Отказ - Булево - устанавливается в Истина при найденных нарушениях.
//  РежимЗаписи - РежимЗаписиДокумента - режим записи.
//  РежимПроведения - РежимПроведенияДокумента - режим проведения.
//
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Текст Из ПравилаЗаписи(ЭтотОбъект) Цикл
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = Текст;
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЦикла;
	
КонецПроцедуры

// Формирует движения документа при проведении.
//
// Проведение акта урегулирует претензию и инцидент:
//  - в регистр ВзаиморасчётыПоПретензиям пишется движение
//    удовлетворения требования (сумма взыскания с поставщика);
//  - по каждой строке структуры компенсации пишется движение
//    регистра ШтрафыИКомпенсации: компенсация туристу в сумме строки и
//    взыскание с поставщика, распределённое пропорционально суммам строк;
//  - регистрируется KPI ответственного за урегулирование инцидента:
//    операция «УрегулированИнцидент» с датой акта и временем обработки -
//    разницей между датой акта и датой инцидента в минутах;
//  - связанный инцидент переводится в статус «Урегулирован».
// Движения прежнего проведения удаляются, чтобы повторное проведение
// не накапливало дубли.
//
// Параметры:
//  Отказ - Булево - признак отказа от проведения.
//  РежимПроведения - РежимПроведенияДокумента - режим проведения.
//
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеДокументов.ЗаблокироватьРегистры(РегистрыБлокировки());
	УдалитьДвижения();
	
	ЗаписатьУдовлетворениеПретензии();
	ЗаписатьКомпенсации();
	ЗаписатьKPI();
	
	УстановитьСтатусИнцидента(ЭтотОбъект.Инцидент, Перечисления.СтатусыИнцидента.Урегулирован);
	
КонецПроцедуры

// Удаляет движения отменяемого проведения и возвращает инцидент в работу.
//
// Движения удовлетворения, компенсаций и KPI этого документа снимаются.
// Инцидент возвращается в статус «В работе»: урегулированным он перестал
// быть вместе с отменой акта. Статус снимается только если инцидент ещё
// урегулирован - значение, выставленное другими документами, не меняется.
//
// Параметры:
//  Отказ - Булево - признак отказа от отмены проведения.
//
Процедура ОбработкаУдаленияПроведения(Отказ)
	
	УдалитьДвижения();
	
	Если ЭтотОбъект.Инцидент.Статус = Перечисления.СтатусыИнцидента.Урегулирован Тогда
		УстановитьСтатусИнцидента(ЭтотОбъект.Инцидент, Перечисления.СтатусыИнцидента.ВРаботе);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Удаляет движения документа в регистрах взаиморасчётов, компенсаций и KPI.
//
// Прежние наборы движений снимаются вручную: набор с отбором по
// регистратору, записанный в режиме замещения, удаляет все движения
// этого документа, включая оборот KPI, записанный собственным набором
// при проведении.
//
Процедура УдалитьДвижения()
	
	НаборВзаиморасчётов = РегистрыНакопления.ВзаиморасчётыПоПретензиям.СоздатьНаборЗаписей();
	НаборВзаиморасчётов.Отбор.Регистратор.Установить(ЭтотОбъект.Ссылка);
	НаборВзаиморасчётов.Записать(Истина);
	
	НаборКомпенсаций = РегистрыНакопления.ШтрафыИКомпенсации.СоздатьНаборЗаписей();
	НаборКомпенсаций.Отбор.Регистратор.Установить(ЭтотОбъект.Ссылка);
	НаборКомпенсаций.Записать(Истина);
	
	НаборKPI = РегистрыНакопления.KPIОператоров.СоздатьНаборЗаписей();
	НаборKPI.Отбор.Регистратор.Установить(ЭтотОбъект.Ссылка);
	НаборKPI.Записать(Истина);
	
КонецПроцедуры

// Возвращает области блокировки, которые захватывает проведение.
//
// Регистр СтатусыИнцидентов блокируется дополнительно к регистрам
// движений: проведение меняет статус связанного инцидента, а история
// статусов принадлежит документам инцидентного контура.
//
// Возвращаемое значение:
//  Массив - имена областей блокировки.
//
Функция РегистрыБлокировки()
	
	МассивРегистров = Новый Массив;
	МассивРегистров.Добавить("РегистрНакопления.ВзаиморасчётыПоПретензиям");
	МассивРегистров.Добавить("РегистрНакопления.ШтрафыИКомпенсации");
	МассивРегистров.Добавить("РегистрНакопления.KPIОператоров");
	МассивРегистров.Добавить("РегистрСведений.СтатусыИнцидентов");
	
	Возврат МассивРегистров;
	
КонецФункции

// Пишет движение удовлетворения требования по претензии.
//
// Движение (сумма удовлетворения = сумма взыскания с поставщика)
// уменьшает сальдо претензии в регистре ВзаиморасчётыПоПретензиям.
//
Процедура ЗаписатьУдовлетворениеПретензии()
	
	НаборЗаписей = РегистрыНакопления.ВзаиморасчётыПоПретензиям.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(ЭтотОбъект.Ссылка);
	
	Движение = НаборЗаписей.Добавить();
	Движение.Период = ЭтотОбъект.ДатаАкта;
	Движение.Претензия = ЭтотОбъект.Претензия;
	Движение.Поставщик = ЭтотОбъект.Претензия.Поставщик;
	Движение.Договор = ЭтотОбъект.Претензия.Договор;
	Движение.Валюта = ЭтотОбъект.Валюта;
	Движение.СуммаТребования = 0;
	Движение.СуммаУдовлетворения = ЭтотОбъект.СуммаВзысканияСПоставщика;
	
	НаборЗаписей.Записать(Истина);
	
КонецПроцедуры

// Пишет приходные движения компенсаций по строкам структуры компенсации.
//
// На каждую строку табличной части - одно движение в разрезе вида
// компенсации: сумма компенсации туристу равна сумме строки, сумма
// взыскания с поставщика распределяется между строками пропорционально
// их суммам (с округлением до копеек).
//
Процедура ЗаписатьКомпенсации()
	
	НаборЗаписей = РегистрыНакопления.ШтрафыИКомпенсации.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(ЭтотОбъект.Ссылка);
	
	Для Каждого СтрокаКомпенсации Из ЭтотОбъект.СтруктураКомпенсации Цикл
		
		Движение = НаборЗаписей.Добавить();
		Движение.Период = ЭтотОбъект.ДатаАкта;
		Движение.Инцидент = ЭтотОбъект.Инцидент;
		Движение.Поставщик = ЭтотОбъект.Претензия.Поставщик;
		Движение.ВидКомпенсации = СтрокаКомпенсации.ВидКомпенсации;
		Движение.Валюта = ЭтотОбъект.Валюта;
		Движение.СуммаКомпенсацииТуристу = СтрокаКомпенсации.Сумма;
		Движение.СуммаВзысканияСПоставщика = ВзысканиеСтроки(СтрокаКомпенсации);
		
	КонецЦикла;
	
	НаборЗаписей.Записать(Истина);
	
КонецПроцедуры

// Пишет оборот KPI ответственного за урегулирование инцидента.
//
// Операция «УрегулированИнцидент» регистрируется датой акта, время
// обработки - разница между датой акта и датой инцидента в минутах.
// Оборот пишется собственным набором записей с отбором по регистратору:
// повторное проведение замещает прежний оборот, а отмена проведения
// снимает его вместе с остальными движениями документа.
//
Процедура ЗаписатьKPI()
	
	НаборЗаписей = РегистрыНакопления.KPIОператоров.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(ЭтотОбъект.Ссылка);
	
	Движение = НаборЗаписей.Добавить();
	Движение.Период = ЭтотОбъект.ДатаАкта;
	Движение.Сотрудник = ЭтотОбъект.Инцидент.Ответственный;
	Движение.ВидОперации = Перечисления.ВидыОперацийKPI.УрегулированИнцидент;
	Движение.Количество = 1;
	Движение.ВремяОбработкиМинут = ВремяОбработкиМинут();
	
	НаборЗаписей.Записать(Истина);
	
КонецПроцедуры

// Возвращает долю взыскания с поставщика, приходящуюся на строку
// структуры компенсации.
//
// Взыскание распределяется пропорционально суммам строк; при нулевой
// сумме компенсации туристу распределять нечего.
//
// Параметры:
//  СтрокаКомпенсации - СтрокаТабличнойЧасти - строка табличной части
//       «Структура компенсации».
//
// Возвращаемое значение:
//  Число - сумма взыскания с поставщика по строке.
//
Функция ВзысканиеСтроки(СтрокаКомпенсации)
	
	Если ЭтотОбъект.СуммаКомпенсацииТуристу <= 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат Окр(СтрокаКомпенсации.Сумма * ЭтотОбъект.СуммаВзысканияСПоставщика
		/ ЭтотОбъект.СуммаКомпенсацииТуристу, 2);
	
КонецФункции

// Возвращает время обработки инцидента в минутах: разница между датой
// акта и датой инцидента, не отрицательная.
//
// Возвращаемое значение:
//  Число - время обработки в минутах.
//
Функция ВремяОбработкиМинут()
	
	РазницаСекунд = ЭтотОбъект.ДатаАкта - ЭтотОбъект.Инцидент.ДатаИнцидента;
	Если РазницаСекунд <= 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат Цел(РазницаСекунд / 60);
	
КонецФункции

// Записывает инциденту новый статус, если он отличается от текущего.
//
// Запись выполняется только при реальном изменении: лишняя запись
// документа переводила бы инцидент в изменённое состояние без
// необходимости.
//
// Параметры:
//  Инцидент - ДокументСсылка.Инцидент - изменяемый инцидент.
//  Статус - ПеречислениеСсылка.СтатусыИнцидента - устанавливаемый статус.
//
Процедура УстановитьСтатусИнцидента(Инцидент, Статус)
	
	Если Не ЗначениеЗаполнено(Инцидент) Тогда
		Возврат;
	КонецЕсли;
	
	Если Инцидент.Статус = Статус Тогда
		Возврат;
	КонецЕсли;
	
	ОбъектИнцидента = Инцидент.ПолучитьОбъект();
	ОбъектИнцидента.Статус = Статус;
	ОбъектИнцидента.Записать();
	
КонецПроцедуры

#КонецОбласти
