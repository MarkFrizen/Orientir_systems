#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("Основание")
		И ТипЗнч(Параметры.Основание) = Тип("ДокументСсылка.ПретензияПоставщику")
		И НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ЗаполнитьПоОснованию(Параметры.Основание);
	КонецЕсли;

	ОбновитьДоступностьКоманд();

КонецПроцедуры

&НаКлиенте
Процедура ОбновлениеОтображения()

	ОбновитьДоступностьКоманд();

КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, РежимЗаписи)
	
	Если НЕ ПроверитьЗаполнение() Тогда
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ИнцидентПриИзменении(Элемент)

	ОбновитьДоступностьКоманд();

КонецПроцедуры

&НаКлиенте
Процедура ПретензияПриИзменении(Элемент)

	ОбновитьДоступностьКоманд();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОткрытьПретензию(Команда)

	Если ЗначениеЗаполнено(Объект.Претензия) Тогда
		ОткрытьФорму("Документ.ПретензияПоставщику.Форма.ФормаДокумента", Новый Структура("Ключ", Объект.Претензия));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьИнцидент(Команда)

	Если ЗначениеЗаполнено(Объект.Инцидент) Тогда
		ОткрытьФорму("Документ.Инцидент.Форма.ФормаДокумента", Новый Структура("Ключ", Объект.Инцидент));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСтруктуру(Команда)
	
	Сведения = ПересчитатьСтруктуруНаСервере();
	Если Сведения.Разница = 0 Тогда
		Сообщить("Структура сходится с итогом: " + Формат(Сведения.СуммаСтрок, "ЧДЦ=2") + ".");
	Иначе
		Сообщить("Строки дают " + Формат(Сведения.СуммаСтрок, "ЧДЦ=2")
			+ ", итог акта " + Формат(Объект.СуммаКомпенсацииТуристу, "ЧДЦ=2")
			+ ", разница " + Формат(Сведения.Разница, "ЧДЦ=2") + ".");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиОповещений

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПересчитатьСтруктуруНаСервере()
	
	СуммаСтрок = РасчётКомпенсаций.СуммаТабличнойЧасти(Объект.СтруктураКомпенсации);
	Сведения = Новый Структура("СуммаСтрок, Разница", СуммаСтрок,
		Объект.СуммаКомпенсацииТуристу - СуммаСтрок);
	
	Возврат Сведения;
	
КонецФункции

&НаСервере
Процедура ОбновитьДоступностьКоманд()

	Элементы.ОткрытьПретензию.Доступность = ЗначениеЗаполнено(Объект.Претензия);
	Элементы.ОткрытьИнцидент.Доступность = ЗначениеЗаполнено(Объект.Инцидент);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоОснованию(Основание)

	ПретензияОбъект = Основание.ПолучитьОбъект();
	Объект.Претензия = Основание;
	Объект.Инцидент = ПретензияОбъект.Инцидент;
	Объект.СуммаВзысканияСПоставщика = ПретензияОбъект.СуммаТребования;
	Объект.Валюта = ПретензияОбъект.Валюта;
	Объект.ДатаАкта = ТекущаяДатаСеанса();

КонецПроцедуры


#КонецОбласти