#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ОбновитьДоступностьКоманд();

КонецПроцедуры

&НаКлиенте
Процедура ОбновлениеОтображения()

	ОбновитьДоступностьКоманд();

КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, РежимЗаписи)
	
	Если НЕ ПроверитьЗаполнение() Тогда
		Отказ = Истина;
	КонецЕсли;
	
	Для Каждого Текст Из ПроверитьПравила() Цикл
		Сообщить(Текст);
		Отказ = Истина;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура МаршрутныйЛистПриИзменении(Элемент)

	ОбновитьДоступностьКоманд();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОткрытьМаршрутныйЛист(Команда)

	Если ЗначениеЗаполнено(Объект.МаршрутныйЛист) Тогда
		ОткрытьФорму("Документ.МаршрутныйЛист.Форма.ФормаДокумента", Новый Структура("Ключ", Объект.МаршрутныйЛист));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьЛокальноеВремя(Команда)
	
	Результат = ПересчитатьВремяНаСервере();
	
	Если Результат.Ошибка <> "" Тогда
		Сообщить(Результат.Ошибка);
		Возврат;
	КонецЕсли;
	
	Сообщить("Локальное время: " + Формат(Объект.ЛокальноеВремя, "ДЛФ=DT") + ".");
	
	Если Результат.Буфер <> Неопределено И Результат.Буфер < 0 Тогда
		Сообщить("Накладка: буфер " + Результат.Буфер + " мин до события "
			+ Формат(Результат.НачалоСледующего, "ДЛФ=DT") + ".");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьВремяПриИзменении(Элемент)
	
	ПересчитатьВремяНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиОповещений

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПересчитатьВремяНаСервере()
	
	Результат = Новый Структура;
	Результат.Вставить("Ошибка", "");
	Результат.Вставить("Буфер", Неопределено);
	Результат.Вставить("НачалоСледующего", Неопределено);
	
	Если НЕ ЗначениеЗаполнено(Объект.ДатаВремяUTC) Тогда
		Результат.Ошибка = "Не заполнена дата-время события в UTC.";
		Возврат Результат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.Объект) Тогда
		Результат.Ошибка = "Не выбран объект - часовую зону взять не из чего.";
		Возврат Результат;
	КонецЕсли;
	
	Зона = Объект.Объект.ЧасоваяЗона;
	Локальное = РаботаСДатамиИЧасовымиЗонами.ПеревестиВЛокальноеВремя(Объект.ДатаВремяUTC, Зона);
	Если Локальное = Неопределено Тогда
		Результат.Ошибка = "Часовая зона """ + Зона + """ объекта " + Объект.Объект + " не распознана.";
		Возврат Результат;
	КонецЕсли;
	Объект.ЛокальноеВремя = Локальное;
	
	Если НЕ ЗначениеЗаполнено(Объект.МаршрутныйЛист) Или Объект.Ссылка.Пустая() Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	События.Ссылка КАК Ссылка,
		|	События.ДатаВремяUTC КАК ДатаВремяUTC
		|ИЗ
		|	Документ.СобытиеМаршрута КАК События
		|ГДЕ
		|	События.МаршрутныйЛист = &МаршрутныйЛист
		|УПОРЯДОЧИТЬ ПО
		|	События.ДатаВремяUTC";
	Запрос.УстановитьПараметр("МаршрутныйЛист", Объект.МаршрутныйЛист);
	
	События = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		События.Добавить(Новый Структура("Ссылка, ДатаВремяUTC", Выборка.Ссылка, Выборка.ДатаВремяUTC));
	КонецЦикла;
	
	ТекущийИндекс = -1;
	Для Индекс = 0 По События.Количество() - 1 Цикл
		Если События[Индекс].Ссылка = Объект.Ссылка Тогда
			ТекущийИндекс = Индекс;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ТекущийИндекс < 0 Или ТекущийИндекс >= События.Количество() - 1 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Следующее = События[ТекущийИндекс + 1];
	Окончание = Объект.ДатаВремяUTC + Объект.ДлительностьМинут * 60;
	Буфер = РаботаСДатамиИЧасовымиЗонами.РазницаВМинутах(Окончание, Следующее.ДатаВремяUTC);
	Объект.БуферДоСледующегоМинут = Буфер;
	Результат.Буфер = Буфер;
	Результат.НачалоСледующего = Следующее.ДатаВремяUTC;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ОбновитьДоступностьКоманд()

	Элементы.ОткрытьМаршрутныйЛист.Доступность = ЗначениеЗаполнено(Объект.МаршрутныйЛист);
КонецПроцедуры

&НаСервере
Функция ПроверитьПравила()
	
	Возврат Объект.ПравилаЗаписи(Объект);
	
КонецФункции

#КонецОбласти