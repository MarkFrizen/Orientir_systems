#Область ПрограммныйИнтерфейс

// Возвращает перечень нарушений, мешающих записи события маршрута.
//
// Параметры:
//  Объект - ДокументОбъект.СобытиеМаршрута - записываемый документ.
//
// Возвращаемое значение:
//  Массив - тексты нарушений; пустой массив, если нарушений нет.
//
Функция ПравилаЗаписи(Объект) Экспорт
	
	Нарушения = Новый Массив;
	
	Если НЕ ЗначениеЗаполнено(Объект.МаршрутныйЛист) Тогда
		Нарушения.Добавить("Не заполнен маршрутный лист.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.ТипСобытия) Тогда
		Нарушения.Добавить("Не заполнен тип события.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Объект) Тогда
		Нарушения.Добавить("Не заполнен объект, в котором проходит событие.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Поставщик) Тогда
		Нарушения.Добавить("Не заполнен поставщик события.");
	КонецЕсли;
	Если Объект.ДлительностьМинут <= 0 Тогда
		Нарушения.Добавить("Длительность события должна быть больше нуля.");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Объект) И ЗначениеЗаполнено(Объект.Поставщик) Тогда
		Если Объект.Объект.Владелец <> Объект.Поставщик Тогда
			Нарушения.Добавить("Объект " + Объект.Объект + " принадлежит другому поставщику ("
				+ Объект.Объект.Владелец + ").");
		КонецЕсли;
	КонецЕсли;
	
	Возврат Нарушения;
	
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

// Публикует нарушения правил записи и отклоняет запись документа.
//
// Вызывается платформой при любой записи, включая программную.
//
// Параметры:
//  Отказ - Булево - устанавливается в Истина при найденных нарушениях.
//  РежимЗаписи - РежимЗаписиДокумента - режим записи.
//  РежимПроведения - РежимПроведенияДокумента - режим проведения.
//
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Текст Из ПравилаЗаписи(ЭтотОбъект) Цикл
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = Текст;
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЦикла;
	
КонецПроцедуры

