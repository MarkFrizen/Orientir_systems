#Область ПрограммныйИнтерфейс

// Возвращает перечень нарушений, мешающих записи заказа поставщику.
//
// Параметры:
//  Объект - ДокументОбъект.ЗаказПоставщику - записываемый документ.
//
// Возвращаемое значение:
//  Массив - тексты нарушений; пустой массив, если нарушений нет.
//
Функция ПравилаЗаписи(Объект) Экспорт
	
	Нарушения = Новый Массив;
	
	Если НЕ ЗначениеЗаполнено(Объект.ЗаявкаНаТур) Тогда
		Нарушения.Добавить("Не заполнена заявка на тур. Выберите заявку, по которой оформляется заказ.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Поставщик) Тогда
		Нарушения.Добавить("Не заполнен поставщик заказа. Выберите поставщика из справочника.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Договор) Тогда
		Нарушения.Добавить("Не заполнен договор с поставщиком. Выберите действующий договор.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.ДатаОжиданияПодтверждения) Тогда
		Нарушения.Добавить("Не заполнена дата ожидания подтверждения. Укажите крайний срок ответа поставщика.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Ответственный) Тогда
		Нарушения.Добавить("Не заполнен ответственный. Выберите сотрудника, отвечающего за заказ.");
	КонецЕсли;
	
	Если Объект.Услуги.Количество() = 0 Тогда
		Нарушения.Добавить("Табличная часть ""Услуги"" пуста. Добавьте хотя бы одну услугу.");
	КонецЕсли;
	
	НомерСтроки = 0;
	МинимальнаяДата = Неопределено;
	Для Каждого Строка Из Объект.Услуги Цикл
		НомерСтроки = НомерСтроки + 1;
		
		Если НЕ ЗначениеЗаполнено(Строка.Услуга) Тогда
			Нарушения.Добавить("Строка " + НомерСтроки + ": не выбрана услуга.");
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Строка.Объект) Тогда
			Нарушения.Добавить("Строка " + НомерСтроки + ": не выбран объект оказания услуги.");
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Строка.ДатаНачала) Тогда
			Нарушения.Добавить("Строка " + НомерСтроки + ": не заполнена дата начала услуги.");
		Иначе
			Если МинимальнаяДата = Неопределено Или Строка.ДатаНачала < МинимальнаяДата Тогда
				МинимальнаяДата = Строка.ДатаНачала;
			КонецЕсли;
		КонецЕсли;
		Если Строка.Количество <= 0 Тогда
			Нарушения.Добавить("Строка " + НомерСтроки + ": количество должно быть больше нуля.");
		КонецЕсли;
		Если Строка.Цена < 0 Тогда
			Нарушения.Добавить("Строка " + НомерСтроки + ": цена не может быть отрицательной.");
		КонецЕсли;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(Объект.ДатаОжиданияПодтверждения) И МинимальнаяДата <> Неопределено Тогда
		Если Объект.ДатаОжиданияПодтверждения > МинимальнаяДата Тогда
			Нарушения.Добавить("Дата ожидания подтверждения (" + Формат(Объект.ДатаОжиданияПодтверждения, "ДЛФ=D")
				+ ") позже начала первой услуги (" + Формат(МинимальнаяДата, "ДЛФ=D") + ").");
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Договор) И ЗначениеЗаполнено(Объект.Поставщик) Тогда
		Если Объект.Договор.Владелец <> Объект.Поставщик Тогда
			Нарушения.Добавить("Договор " + Объект.Договор + " принадлежит другому поставщику. Выберите договор поставщика "
				+ Объект.Поставщик + ".");
		КонецЕсли;
	КонецЕсли;
	
	НомерСтроки = 0;
	Для Каждого Строка Из Объект.Услуги Цикл
		НомерСтроки = НомерСтроки + 1;
		Если ЗначениеЗаполнено(Строка.Объект) И ЗначениеЗаполнено(Объект.Поставщик) Тогда
			Если Строка.Объект.Владелец <> Объект.Поставщик Тогда
				Нарушения.Добавить("Строка " + НомерСтроки + ": объект " + Строка.Объект
					+ " принадлежит другому поставщику.");
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если Объект.Услуги.Количество() > 0 И Объект.СуммаДокумента <> Неопределено Тогда
		СуммаСтрок = РасчётКомпенсаций.СуммаТабличнойЧасти(Объект.Услуги);
		Если Объект.СуммаДокумента <> СуммаСтрок Тогда
			Нарушения.Добавить("Сумма документа (" + Формат(Объект.СуммаДокумента, "ЧДЦ=2")
				+ ") не равна сумме строк (" + Формат(СуммаСтрок, "ЧДЦ=2") + "). Пересчитайте суммы.");
		КонецЕсли;
	КонецЕсли;
	
	Возврат Нарушения;
	
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

// Публикует нарушения правил записи и отклоняет запись документа.
//
// Вызывается платформой при любой записи, включая программную.
//
// Параметры:
//  Отказ - Булево - устанавливается в Истина при найденных нарушениях.
//  РежимЗаписи - РежимЗаписиДокумента - режим записи.
//  РежимПроведения - РежимПроведенияДокумента - режим проведения.
//
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Текст Из ПравилаЗаписи(ЭтотОбъект) Цикл
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = Текст;
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЦикла;
	
КонецПроцедуры

// Формирует движения документа при проведении.
//
// По каждой строке услуг заказа записывается статус «Отправлен»: заказ
// передан поставщику и ожидает ответа, поэтому дата подтверждения остаётся
// пустой. Движения предыдущего проведения удаляются, чтобы повторное
// проведение не накапливало дубли, а удалённые из документа строки не
// оставляли «висящих» записей.
//
// Параметры:
//  Отказ - Булево - признак отказа от проведения.
//  РежимПроведения - РежимПроведенияДокумента - режим проведения.
//
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеДокументов.ЗаблокироватьРегистры(РегистрыБлокировки());
	УдалитьДвижения();
	ЗаписатьДвижения();
	
КонецПроцедуры

// Удаляет движения отменяемого проведения.
//
// Параметры:
//  Отказ - Булево - признак отказа от отмены проведения.
//
Процедура ОбработкаУдаленияПроведения(Отказ)
	
	УдалитьДвижения();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Удаляет движения документа в регистре статусов.
//
// Регистр сведений не очищается платформой при повторном проведении, поэтому
// прежний набор записей снимается вручную: набор с отбором по регистратору,
// записанный в режиме замещения, удаляет все строки этого документа.
//
Процедура УдалитьДвижения()
	
	НаборЗаписей = РегистрыСведений.СтатусыПодтверждений.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(ЭтотОбъект.Ссылка);
	НаборЗаписей.Записать(Истина);
	
КонецПроцедуры

// Возвращает области блокировки, которые захватывает проведение.
//
// Регистр статусов общий для заказов и подтверждений, поэтому блокируется
// всегда: иначе одновременное подтверждение услуги прочитает неполный
// набор статусов заказа и неверно решит вопрос о полноте подтверждения.
//
// Возвращаемое значение:
//  Массив - имена областей блокировки.
//
Функция РегистрыБлокировки()
	
	МассивРегистров = Новый Массив;
	МассивРегистров.Добавить("РегистрСведений.СтатусыПодтверждений");
	
	Возврат МассивРегистров;
	
КонецФункции

// Записывает движения документа: по строке статуса «Отправлен» на каждую
// услугу заказа.
//
// Записи регистра уникальны по периоду и измерениям, поэтому повторяющиеся
// строки услуг с одинаковой услугой дают одну запись. Период берётся из даты
// документа: регистр периодический, и без явного периода платформа отнесла бы
// запись к произвольному моменту.
//
Процедура ЗаписатьДвижения()
	
	НаборЗаписей = РегистрыСведений.СтатусыПодтверждений.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(ЭтотОбъект.Ссылка);
	
	ОбработанныеУслуги = Новый Соответствие;
	Для Каждого СтрокаУслуги Из ЭтотОбъект.Услуги Цикл
		Если ОбработанныеУслуги.Получить(СтрокаУслуги.Услуга) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ОбработанныеУслуги.Вставить(СтрокаУслуги.Услуга, Истина);
		
		Запись = НаборЗаписей.Добавить();
		Запись.Период = НачалоДня(ЭтотОбъект.Дата);
		Запись.ЗаказПоставщику = ЭтотОбъект.Ссылка;
		Запись.Услуга = СтрокаУслуги.Услуга;
		Запись.Статус = Перечисления.СтатусыЗаказа.Отправлен;
		Запись.ДатаПодтверждения = Дата(1, 1, 1);
	КонецЦикла;
	
	НаборЗаписей.Записать(Истина);
	
КонецПроцедуры

#КонецОбласти
