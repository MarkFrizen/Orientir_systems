#Область ОбработчикиСобытийЭлементовФормы

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПоказатьПросроченные(Команда)

	УстановитьОтборПросроченных();

КонецПроцедуры

&НаКлиенте
Процедура СброситьОтбор(Команда)

	ОчиститьОтбор();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиОповещений

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьОтборПросроченных()

	Отбор = Список.Отбор;
	Отбор.Элементы.Очистить();

	Элемент = Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Элемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДатаОжиданияПодтверждения");
	Элемент.ВидСравнения = ВидСравненияКомпоновкиДанных.Меньше;
	Элемент.ПравоеЗначение = ТекущаяДатаСеанса();

	Элемент = Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Элемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Статус");
	Элемент.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
	Массив = Новый Массив;
	Массив.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыЗаказа.Отправлен"));
	Массив.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыЗаказа.ЧастичноПодтверждён"));
	Элемент.ПравоеЗначение = Массив;

КонецПроцедуры

&НаСервере
Процедура ОчиститьОтбор()

	Список.Отбор.Элементы.Очистить();

КонецПроцедуры

#КонецОбласти
