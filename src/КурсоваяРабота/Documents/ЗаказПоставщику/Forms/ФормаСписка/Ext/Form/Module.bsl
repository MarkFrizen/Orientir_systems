#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПоказатьПросроченные(Команда)

	УстановитьОтборПросроченных();

КонецПроцедуры

&НаКлиенте
Процедура СброситьОтбор(Команда)

	ОчиститьОтбор();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиОповещений

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьОтборПросроченных()

	Отбор = Элементы.Список.Отбор;
	Отбор.Элементы.Очистить();

	Элемент = Отбор.Элементы.Добавить(Тип("ЭлементОтбораДинамическогоСписка"));
	Элемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДатаОжиданияПодтверждения");
	Элемент.ВидСравнения = ВидСравненияКомпоновкиДанных.Меньше;
	Элемент.ПравоеЗначение = ТекущаяДатаСеанса();

	Элемент = Отбор.Элементы.Добавить(Тип("ЭлементОтбораДинамическогоСписка"));
	Элемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Статус");
	Элемент.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
	Массив = Новый Массив;
	Массив.Добавить(Перечисления.СтатусыЗаказа.Отправлен);
	Массив.Добавить(Перечисления.СтатусыЗаказа.ЧастичноПодтверждён);
	Элемент.ПравоеЗначение = Массив;

КонецПроцедуры

&НаСервере
Процедура ОчиститьОтбор()

	Элементы.Список.Отбор.Элементы.Очистить();

КонецПроцедуры

#КонецОбласти
