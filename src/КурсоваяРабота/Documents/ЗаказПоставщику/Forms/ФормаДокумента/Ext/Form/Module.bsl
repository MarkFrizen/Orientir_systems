#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ОбновитьДоступностьКоманд();

КонецПроцедуры

&НаКлиенте
Процедура ОбновлениеОтображения()

	ОбновитьДоступностьКоманд();

КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, РежимЗаписи)

	Если НЕ ПроверитьЗаполнение() Тогда
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОткрытьЗаявку(Команда)

	Если ЗначениеЗаполнено(Объект.ЗаявкаНаТур) Тогда
		ОткрытьЗначение(Объект.ЗаявкаНаТур);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПоставщика(Команда)

	Если ЗначениеЗаполнено(Объект.Поставщик) Тогда
		ОткрытьЗначение(Объект.Поставщик);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьДоговор(Команда)

	Если ЗначениеЗаполнено(Объект.Договор) Тогда
		ОткрытьЗначение(Объект.Договор);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СоздатьПодтверждение(Команда)

	ПараметрыФормы = Новый Структура("Основание", Объект.Ссылка);
	ОткрытьФорму("Документ.ПодтверждениеУслуги.Форма.ФормаДокумента", ПараметрыФормы);

КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСуммы(Команда)

	// TODO этап 4
	Сообщить("Расчёт сумм будет реализован на этапе 4.");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиОповещений

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбновитьДоступностьКоманд()

	Элементы.ОткрытьЗаявку.Доступность = ЗначениеЗаполнено(Объект.ЗаявкаНаТур);
	Элементы.ОткрытьПоставщика.Доступность = ЗначениеЗаполнено(Объект.Поставщик);
	Элементы.ОткрытьДоговор.Доступность = ЗначениеЗаполнено(Объект.Договор);
	Элементы.СоздатьПодтверждение.Доступность = ПравоДоступа("Добавление", Метаданные.Документы.ПодтверждениеУслуги) И ЗначениеЗаполнено(Объект.Ссылка);
КонецПроцедуры

#КонецОбласти