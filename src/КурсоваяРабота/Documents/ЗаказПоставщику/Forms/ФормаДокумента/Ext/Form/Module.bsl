#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ОбновитьДоступностьКоманд();

КонецПроцедуры

&НаКлиенте
Процедура ОбновлениеОтображения()

	ОбновитьДоступностьКоманд();

КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, РежимЗаписи)
	
	Если НЕ ПроверитьЗаполнение() Тогда
		Отказ = Истина;
	КонецЕсли;
	
	ПересчитатьВсеСтроки();
	
	Для Каждого Текст Из ПроверитьПравила() Цикл
		Сообщить(Текст);
		Отказ = Истина;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ДоговорПриИзменении(Элемент)

	ОбновитьДоступностьКоманд();

КонецПроцедуры

&НаКлиенте
Процедура ЗаявкаНаТурПриИзменении(Элемент)

	ОбновитьДоступностьКоманд();

КонецПроцедуры

&НаКлиенте
Процедура ПоставщикПриИзменении(Элемент)

	ОбновитьДоступностьКоманд();

КонецПроцедуры

&НаКлиенте
Процедура СсылкаПриИзменении(Элемент)

	ОбновитьДоступностьКоманд();

КонецПроцедуры

&НаКлиенте
Процедура УслугиУслугаПриИзменении(Элемент)
	
	Если Элементы.Услуги.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НомерСтроки = Элементы.Услуги.ТекущиеДанные.НомерСтроки;
	ПодставитьЦенуИзНоменклатуры(НомерСтроки);
	ПересчитатьСтроку(НомерСтроки);
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиКоличествоПриИзменении(Элемент)
	
	Если Элементы.Услуги.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПересчитатьСтроку(Элементы.Услуги.ТекущиеДанные.НомерСтроки);
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиЦенаПриИзменении(Элемент)
	
	Если Элементы.Услуги.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПересчитатьСтроку(Элементы.Услуги.ТекущиеДанные.НомерСтроки);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОткрытьЗаявку(Команда)

	Если ЗначениеЗаполнено(Объект.ЗаявкаНаТур) Тогда
		ОткрытьФорму("Справочник.ЗаявкиНаТур.Форма.ФормаЭлемента", Новый Структура("Ключ", Объект.ЗаявкаНаТур));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПоставщика(Команда)

	Если ЗначениеЗаполнено(Объект.Поставщик) Тогда
		ОткрытьФорму("Справочник.Поставщики.Форма.ФормаЭлемента", Новый Структура("Ключ", Объект.Поставщик));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьДоговор(Команда)

	Если ЗначениеЗаполнено(Объект.Договор) Тогда
		ОткрытьФорму("Справочник.ДоговорыСПоставщиками.Форма.ФормаЭлемента", Новый Структура("Ключ", Объект.Договор));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СоздатьПодтверждение(Команда)

	ПараметрыФормы = Новый Структура("Основание", Объект.Ссылка);
	ОткрытьФорму("Документ.ПодтверждениеУслуги.Форма.ФормаДокумента", ПараметрыФормы);

КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСуммы(Команда)
	
	КоличествоСтрок = ПересчитатьВсеСтроки();
	Сообщить("Пересчитано строк: " + КоличествоСтрок + ", сумма документа: "
		+ Формат(Объект.СуммаДокумента, "ЧДЦ=2"));
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиОповещений

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбновитьДоступностьКоманд()

	Элементы.ОткрытьЗаявку.Доступность = ЗначениеЗаполнено(Объект.ЗаявкаНаТур);
	Элементы.ОткрытьПоставщика.Доступность = ЗначениеЗаполнено(Объект.Поставщик);
	Элементы.ОткрытьДоговор.Доступность = ЗначениеЗаполнено(Объект.Договор);
	Элементы.СоздатьПодтверждение.Доступность = ПравоДоступа("Добавление", Метаданные.Документы.ПодтверждениеУслуги) И ЗначениеЗаполнено(Объект.Ссылка);
КонецПроцедуры

&НаСервере
Процедура ПересчитатьСтроку(НомерСтроки)
	
	Если НомерСтроки < 1 Или НомерСтроки > Объект.Услуги.Количество() Тогда
		Возврат;
	КонецЕсли;
	
	Строка = Объект.Услуги[НомерСтроки - 1];
	Строка.Сумма = РасчётКомпенсаций.РассчитатьСуммуСтроки(Строка.Количество, Строка.Цена);
	ПересчитатьИтог();
	
КонецПроцедуры

&НаСервере
Процедура ПодставитьЦенуИзНоменклатуры(НомерСтроки)
	
	Если НомерСтроки < 1 Или НомерСтроки > Объект.Услуги.Количество() Тогда
		Возврат;
	КонецЕсли;
	
	Строка = Объект.Услуги[НомерСтроки - 1];
	Если ЗначениеЗаполнено(Строка.Услуга) И Строка.Цена = 0 Тогда
		Строка.Цена = Строка.Услуга.БазоваяЦена;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьИтог()
	
	Объект.СуммаДокумента = РасчётКомпенсаций.СуммаТабличнойЧасти(Объект.Услуги);
	
КонецПроцедуры

&НаСервере
Функция ПересчитатьВсеСтроки()
	
	Для НомерСтроки = 1 По Объект.Услуги.Количество() Цикл
		Строка = Объект.Услуги[НомерСтроки - 1];
		Строка.Сумма = РасчётКомпенсаций.РассчитатьСуммуСтроки(Строка.Количество, Строка.Цена);
	КонецЦикла;
	
	ПересчитатьИтог();
	Возврат Объект.Услуги.Количество();
	
КонецФункции

&НаСервере
Функция ПроверитьПравила()
	
	Возврат Объект.ПравилаЗаписи(Объект);
	
КонецФункции

#КонецОбласти