#Область ПрограммныйИнтерфейс

// Возвращает перечень нарушений, мешающих записи заявки туриста на маршруте.
//
// Параметры:
//  Объект - ДокументОбъект.ЗаявкаТуристаНаМаршруте - записываемый документ.
//
// Возвращаемое значение:
//  Массив - тексты нарушений; пустой массив, если нарушений нет.
//
Функция ПравилаЗаписи(Объект) Экспорт
	
	Нарушения = Новый Массив;
	
	Если НЕ ЗначениеЗаполнено(Объект.МаршрутныйЛист) Тогда
		Нарушения.Добавить("Не заполнен маршрутный лист.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Турист) Тогда
		Нарушения.Добавить("Не заполнен турист.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.ТипЗапроса) Тогда
		Нарушения.Добавить("Не заполнен тип запроса. От него зависит срок SLA.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.ТекстЗапроса) Тогда
		Нарушения.Добавить("Не заполнен текст запроса туриста.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Инициатор) Тогда
		Нарушения.Добавить("Не заполнен инициатор запроса.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Ответственный) Тогда
		Нарушения.Добавить("Не заполнен ответственный за обработку.");
	КонецЕсли;
	
	Если Объект.Ссылка.Пустая() И ЗначениеЗаполнено(Объект.СрокSLA) Тогда
		Если Объект.СрокSLA <= ТекущаяДатаСеанса() Тогда
			Нарушения.Добавить("Срок SLA должен быть в будущем. Пересчитайте срок по типу запроса.");
		КонецЕсли;
	КонецЕсли;
	
	Возврат Нарушения;
	
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

// Публикует нарушения правил записи и отклоняет запись документа.
//
// Вызывается платформой при любой записи, включая программную.
//
// Параметры:
//  Отказ - Булево - устанавливается в Истина при найденных нарушениях.
//  РежимЗаписи - РежимЗаписиДокумента - режим записи.
//  РежимПроведения - РежимПроведенияДокумента - режим проведения.
//
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Текст Из ПравилаЗаписи(ЭтотОбъект) Цикл
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = Текст;
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
