#Область ПрограммныйИнтерфейс

// Возвращает перечень нарушений, мешающих записи заявки туриста на маршруте.
//
// Параметры:
//  Объект - ДокументОбъект.ЗаявкаТуристаНаМаршруте - записываемый документ.
//
// Возвращаемое значение:
//  Массив - тексты нарушений; пустой массив, если нарушений нет.
//
Функция ПравилаЗаписи(Объект) Экспорт
	
	Нарушения = Новый Массив;
	
	Если НЕ ЗначениеЗаполнено(Объект.МаршрутныйЛист) Тогда
		Нарушения.Добавить("Не заполнен маршрутный лист.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Турист) Тогда
		Нарушения.Добавить("Не заполнен турист.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.ТипЗапроса) Тогда
		Нарушения.Добавить("Не заполнен тип запроса. От него зависит срок SLA.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.ТекстЗапроса) Тогда
		Нарушения.Добавить("Не заполнен текст запроса туриста.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Инициатор) Тогда
		Нарушения.Добавить("Не заполнен инициатор запроса.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Ответственный) Тогда
		Нарушения.Добавить("Не заполнен ответственный за обработку.");
	КонецЕсли;
	
	Если Объект.Ссылка.Пустая() И ЗначениеЗаполнено(Объект.СрокSLA) Тогда
		Если Объект.СрокSLA <= ТекущаяДатаСеанса() Тогда
			Нарушения.Добавить("Срок SLA должен быть в будущем. Пересчитайте срок по типу запроса.");
		КонецЕсли;
	КонецЕсли;
	
	Возврат Нарушения;
	
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

// Публикует нарушения правил записи и отклоняет запись документа.
//
// Вызывается платформой при любой записи, включая программную.
//
// Параметры:
//  Отказ - Булево - устанавливается в Истина при найденных нарушениях.
//  РежимЗаписи - РежимЗаписиДокумента - режим записи.
//  РежимПроведения - РежимПроведенияДокумента - режим проведения.
//
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Текст Из ПравилаЗаписи(ЭтотОбъект) Цикл
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = Текст;
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЦикла;
	
КонецПроцедуры

// Формирует движения документа при проведении.
//
// Проведение регистрирует заявку в истории обработок запросов: одна запись
// с действием «Регистрация», инициатором запроса и датой документа. Записи
// прежнего проведения удаляются, чтобы повторное проведение не накапливало
// дубли.
//
// Если тип запроса имеет критический уровень критичности, ответственному
// за обработку (или руководителю, когда ответственный не заполнен) создаётся
// задача эскалации. Прежняя невыполненная задача эскалации этого документа
// помечается на удаление, поэтому повторное проведение задачу не дублирует.
//
// Параметры:
//  Отказ - Булево - признак отказа от проведения.
//  РежимПроведения - РежимПроведенияДокумента - режим проведения.
//
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеДокументов.ЗаблокироватьРегистры(РегистрыБлокировки());
	УдалитьДвижения();
	
	НаборЗаписей = РегистрыСведений.ИсторияОбработокЗапросов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(ЭтотОбъект.Ссылка);
	
	Запись = НаборЗаписей.Добавить();
	Запись.Период = НачалоДня(ЭтотОбъект.Дата);
	Запись.ЗаявкаТуриста = ЭтотОбъект.Ссылка;
	Запись.Сотрудник = ЭтотОбъект.Инициатор;
	Запись.Действие = "Регистрация";
	Запись.Комментарий = "Заявка зарегистрирована при проведении документа.";
	
	НаборЗаписей.Записать(Истина);
	
	ЭскалироватьКритическийЗапрос();
	
КонецПроцедуры

// Удаляет движения отменяемого проведения и снимает задачу эскалации.
//
// Запись истории обработок удаляется, а созданная проведением задача
// эскалации помечается на удаление, если она ещё не выполнена: основание
// задачи исчезло, работать по ней больше не с чем.
//
// Параметры:
//  Отказ - Булево - признак отказа от отмены проведения.
//
Процедура ОбработкаУдаленияПроведения(Отказ)
	
	УдалитьДвижения();
	ПометитьЗадачиЭскалацииНаУдаление();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Удаляет движения документа в истории обработок запросов.
//
// Регистр сведений не очищается платформой при повторном проведении, поэтому
// прежний набор записей снимается вручную: набор с отбором по регистратору,
// записанный в режиме замещения, удаляет все строки этого документа.
//
Процедура УдалитьДвижения()
	
	НаборЗаписей = РегистрыСведений.ИсторияОбработокЗапросов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(ЭтотОбъект.Ссылка);
	НаборЗаписей.Записать(Истина);
	
КонецПроцедуры

// Возвращает области блокировки, которые захватывает проведение.
//
// Возвращаемое значение:
//  Массив - имена областей блокировки.
//
Функция РегистрыБлокировки()
	
	МассивРегистров = Новый Массив;
	МассивРегистров.Добавить("РегистрСведений.ИсторияОбработокЗапросов");
	
	Возврат МассивРегистров;
	
КонецФункции

// Создаёт задачу эскалации, если тип запроса критический.
//
// Перед созданием прежняя невыполненная задача эскалации этого документа
// помечается на удаление: повторное проведение не должно плодить задачи.
//
Процедура ЭскалироватьКритическийЗапрос()
	
	Если Не ЗначениеЗаполнено(ЭтотОбъект.ТипЗапроса) Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтотОбъект.ТипЗапроса.Критичность <> Перечисления.УровниКритичности.Критический Тогда
		Возврат;
	КонецЕсли;
	
	ПометитьЗадачиЭскалацииНаУдаление();
	
	Исполнитель = ИсполнительЭскалации();
	Если Не ЗначениеЗаполнено(Исполнитель) Тогда
		Возврат;
	КонецЕсли;
	
	ЗадачиИсполнителям.СоздатьЗадачу(
		"Срочно обработать критический запрос туриста",
		ЭтотОбъект.ТекстЗапроса,
		Исполнитель,
		ЭтотОбъект.Ссылка);
	
КонецПроцедуры

// Возвращает адресата задачи эскалации.
//
// Задача адресуется ответственному за обработку; если он не заполнен,
// адресатом становится руководитель, найденный по должности в справочнике
// сотрудников, а при отсутствии руководителя - инициатор запроса: критический
// запрос не должен остаться без адресата.
//
// Возвращаемое значение:
//  СправочникСсылка.Сотрудники - исполнитель задачи.
//
Функция ИсполнительЭскалации()
	
	Если ЗначениеЗаполнено(ЭтотОбъект.Ответственный) Тогда
		Возврат ЭтотОбъект.Ответственный;
	КонецЕсли;
	
	Для Каждого Сотрудник Из Справочники.Сотрудники.Выбрать() Цикл
		Если СтрНайти(ВРег(Строка(Сотрудник.Должность)), "РУКОВОД") > 0 Тогда
			Возврат Сотрудник.Ссылка;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ЭтотОбъект.Инициатор;
	
КонецФункции

// Помечает на удаление невыполненные задачи эскалации этого документа.
//
// Задачи эскалации не хранят ссылку на основание отдельным реквизитом:
// общий модуль дописывает представление основания в наименование задачи,
// поэтому задачи ищутся по маркеру основания. Выполненная задача не трогается -
// работа по ней уже сделана.
//
Процедура ПометитьЗадачиЭскалацииНаУдаление()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Задачи.Ссылка КАК Ссылка
		|ИЗ
		|	Задача.ЗадачаИсполнителя КАК Задачи
		|ГДЕ
		|	Задачи.ПометкаУдаления = ЛОЖЬ
		|	И Задачи.Выполнена = ЛОЖЬ
		|	И Задачи.Наименование ПОДОБНО &Маска";
	Запрос.УстановитьПараметр("Маска", "%" + МаркерОснованияЗадачи() + "%");
	
	Для Каждого Запись Из Запрос.Выполнить().Выгрузить() Цикл
		ЗадачаОбъект = Запись.Ссылка.ПолучитьОбъект();
		ЗадачаОбъект.ПометкаУдаления = Истина;
		ЗадачаОбъект.Записать();
	КонецЦикла;
	
КонецПроцедуры

// Возвращает маркер основания задачи, который общий модуль ЗадачиИсполнителям
// дописывает в наименование созданной задачи.
//
// Возвращаемое значение:
//  Строка - текст маркера «(основание: <представление документа>)».
//
Функция МаркерОснованияЗадачи()
	
	Попытка
		ПредставлениеОснования = ЭтотОбъект.Ссылка.Представление;
	Исключение
		ПредставлениеОснования = Строка(ЭтотОбъект.Ссылка);
	КонецПопытки;
	
	Возврат "(основание: " + ПредставлениеОснования + ")";
	
КонецФункции

#КонецОбласти
