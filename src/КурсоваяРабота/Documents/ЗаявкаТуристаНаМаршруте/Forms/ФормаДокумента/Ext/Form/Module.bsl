#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ОбновитьДоступностьКоманд();

КонецПроцедуры

&НаКлиенте
Процедура ОбновлениеОтображения()

	ОбновитьДоступностьКоманд();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОткрытьМаршрутныйЛист(Команда)

	Если ЗначениеЗаполнено(Объект.МаршрутныйЛист) Тогда
		ОткрытьЗначение(Объект.МаршрутныйЛист);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьТуриста(Команда)

	Если ЗначениеЗаполнено(Объект.Турист) Тогда
		ОткрытьЗначение(Объект.Турист);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСрокSLA(Команда)

	// TODO этап 4
	Сообщить("Расчёт срока SLA будет реализован на этапе 4.");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиОповещений

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбновитьДоступностьКоманд()

	Элементы.ОткрытьМаршрутныйЛист.Доступность = ЗначениеЗаполнено(Объект.МаршрутныйЛист);
	Элементы.ОткрытьТуриста.Доступность = ЗначениеЗаполнено(Объект.Турист);
КонецПроцедуры

#КонецОбласти