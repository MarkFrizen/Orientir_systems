#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ДатаСравнения = ТекущаяДатаСеанса();

	ОбновитьДоступностьКоманд();

КонецПроцедуры

&НаКлиенте
Процедура ОбновлениеОтображения()

	ОбновитьДоступностьКоманд();

КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, РежимЗаписи)
	
	Если НЕ ПроверитьЗаполнение() Тогда
		Отказ = Истина;
	КонецЕсли;
	
	Для Каждого Текст Из ПроверитьПравила() Цикл
		Сообщить(Текст);
		Отказ = Истина;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура МаршрутныйЛистПриИзменении(Элемент)

	ОбновитьДоступностьКоманд();

КонецПроцедуры

&НаКлиенте
Процедура ТуристПриИзменении(Элемент)

	ОбновитьДоступностьКоманд();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОткрытьМаршрутныйЛист(Команда)

	Если ЗначениеЗаполнено(Объект.МаршрутныйЛист) Тогда
		ОткрытьФорму("Документ.МаршрутныйЛист.Форма.ФормаДокумента", Новый Структура("Ключ", Объект.МаршрутныйЛист));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьТуриста(Команда)

	Если ЗначениеЗаполнено(Объект.Турист) Тогда
		ОткрытьФорму("Справочник.Туристы.Форма.ФормаЭлемента", Новый Структура("Ключ", Объект.Турист));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСрокSLA(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.ТипЗапроса) Тогда
		Сообщить("Сначала выберите тип запроса - от него зависит норматив SLA.");
		Возврат;
	КонецЕсли;
	
	РассчитатьСрокSLAНаСервере();
	Сообщить("Срок SLA: " + Формат(Объект.СрокSLA, "ДЛФ=DT") + ".");
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиОповещений

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура РассчитатьСрокSLAНаСервере()
	
	Объект.СрокSLA = ТекущаяДатаСеанса() + Объект.ТипЗапроса.SLAЧасов * 3600;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДоступностьКоманд()

	Элементы.ОткрытьМаршрутныйЛист.Доступность = ЗначениеЗаполнено(Объект.МаршрутныйЛист);
	Элементы.ОткрытьТуриста.Доступность = ЗначениеЗаполнено(Объект.Турист);
КонецПроцедуры

&НаСервере
Функция ПроверитьПравила()
	
	Возврат Объект.ПравилаЗаписи(Объект);
	
КонецФункции

#КонецОбласти