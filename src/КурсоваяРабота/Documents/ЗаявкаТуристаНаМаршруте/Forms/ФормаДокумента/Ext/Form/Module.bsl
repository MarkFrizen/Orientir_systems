#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ДатаСравнения = ТекущаяДатаСеанса();

	ОбновитьДоступностьКоманд();

КонецПроцедуры

&НаКлиенте
Процедура ОбновлениеОтображения()

	ОбновитьДоступностьКоманд();

КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, РежимЗаписи)

	Если НЕ ПроверитьЗаполнение() Тогда
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура МаршрутныйЛистПриИзменении(Элемент)

	ОбновитьДоступностьКоманд();

КонецПроцедуры

&НаКлиенте
Процедура ТуристПриИзменении(Элемент)

	ОбновитьДоступностьКоманд();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОткрытьМаршрутныйЛист(Команда)

	Если ЗначениеЗаполнено(Объект.МаршрутныйЛист) Тогда
		ПоказатьЗначение(ЭтотОбъект, Объект.МаршрутныйЛист);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьТуриста(Команда)

	Если ЗначениеЗаполнено(Объект.Турист) Тогда
		ПоказатьЗначение(ЭтотОбъект, Объект.Турист);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСрокSLA(Команда)

	// TODO этап 4
	Сообщить("Расчёт срока SLA будет реализован на этапе 4.");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиОповещений

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбновитьДоступностьКоманд()

	Элементы.ОткрытьМаршрутныйЛист.Доступность = ЗначениеЗаполнено(Объект.МаршрутныйЛист);
	Элементы.ОткрытьТуриста.Доступность = ЗначениеЗаполнено(Объект.Турист);
КонецПроцедуры

#КонецОбласти