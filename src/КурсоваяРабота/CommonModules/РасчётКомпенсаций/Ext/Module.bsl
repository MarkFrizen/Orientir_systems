#Область ПрограммныйИнтерфейс

// Округляет денежную величину до двух знаков по единому правилу проекта.
//
// Параметры:
//  Значение - Число - исходная величина.
//
// Возвращаемое значение:
//  Число - округлённая величина.
//
Функция ОкруглитьСумму(Значение) Экспорт
	
	Возврат Окр(Значение, 2, РежимОкругления.Окр15как20);
	
КонецФункции

// Рассчитывает сумму строки табличной части как количество, умноженное на цену.
//
// Параметры:
//  Количество - Число - количество в строке.
//  Цена - Число - цена за единицу.
//
// Возвращаемое значение:
//  Число - сумма строки, округлённая до двух знаков.
//
Функция РассчитатьСуммуСтроки(Количество, Цена) Экспорт
	
	Возврат ОкруглитьСумму(Количество * Цена);
	
КонецФункции

// Считает сумму колонки табличной части.
//
// Параметры:
//  Таблица - ТабличнаяЧасть, ДанныеФормыКоллекция - строки документа.
//  ИмяКолонки - Строка - имя колонки с суммой.
//
// Возвращаемое значение:
//  Число - сумма по колонке, округлённая до двух знаков.
//
Функция СуммаТабличнойЧасти(Таблица, ИмяКолонки = "Сумма") Экспорт
	
	Итог = 0;
	Для Каждого Строка Из Таблица Цикл
		Итог = Итог + Строка[ИмяКолонки];
	КонецЦикла;
	
	Возврат ОкруглитьСумму(Итог);
	
КонецФункции

// Определяет, требуется ли согласование крупной суммы руководителем.
//
// Параметры:
//  Сумма - Число - проверяемая сумма.
//
// Возвращаемое значение:
//  Булево - Истина, если сумма строго больше порога и порог задан.
//
Функция ТребуетсяСогласованиеРуководителем(Сумма) Экспорт
	
	Порог = Константы.ПорогСогласованияРуководителем.Получить();
	Если Порог = Неопределено Или Порог = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Сумма > Порог;
	
КонецФункции

// Рассчитывает компенсацию по условиям договора с поставщиком.
//
// Параметры:
//  Договор - СправочникСсылка.ДоговорыСПоставщиками - договор с процентом штрафа.
//  БазоваяСтоимость - Число - стоимость услуги по заказу поставщику.
//  КоличествоДней - Число - количество дней или фактов нарушения.
//
// Возвращаемое значение:
//  Структура - результат расчёта, см. РассчитатьКомпенсациюПоУсловиям.
//
Функция РассчитатьКомпенсацию(Договор, БазоваяСтоимость, КоличествоДней) Экспорт
	
	Если Договор = Неопределено Или НЕ ЗначениеЗаполнено(Договор) Тогда
		Возврат РезультатРасчёта(0, 0, Ложь, "Договор не выбран");
	КонецЕсли;
	
	Возврат РассчитатьКомпенсациюПоУсловиям(
		БазоваяСтоимость,
		Договор.ПроцентШтрафа,
		Договор.МаксимальнаяКомпенсация,
		КоличествоДней);
	
КонецФункции

// Рассчитывает компенсацию по явно заданным условиям, без обращения к справочникам.
//
// Параметры:
//  БазоваяСтоимость - Число - стоимость услуги.
//  ПроцентШтрафа - Число - процент штрафа по договору.
//  МаксимальнаяКомпенсация - Число - лимит по договору, 0 или Неопределено если лимита нет.
//  КоличествоДней - Число - количество дней или фактов нарушения.
//
// Возвращаемое значение:
//  Структура:
//   * Сумма - Число - итоговая компенсация после ограничения;
//   * ИсходнаяСумма - Число - расчёт до ограничения;
//   * ОграниченаМаксимумом - Булево - сработал ли лимит договора;
//   * ТребуетсяСогласование - Булево - превышен ли порог согласования;
//   * ПричинаОтказа - Строка - почему расчёт невозможен, пусто если расчёт состоялся.
//
Функция РассчитатьКомпенсациюПоУсловиям(БазоваяСтоимость, ПроцентШтрафа,
	МаксимальнаяКомпенсация, КоличествоДней) Экспорт
	
	Если ПроцентШтрафа = Неопределено Или ПроцентШтрафа = 0 Тогда
		Возврат РезультатРасчёта(0, 0, Ложь, "Процент штрафа не задан");
	КонецЕсли;
	
	ИсходнаяСумма = ОкруглитьСумму(БазоваяСтоимость * ПроцентШтрафа / 100 * КоличествоДней);
	Сумма = ИсходнаяСумма;
	Ограничена = Ложь;
	
	Если МаксимальнаяКомпенсация <> Неопределено И МаксимальнаяКомпенсация > 0 Тогда
		Если Сумма > МаксимальнаяКомпенсация Тогда
			Сумма = ОкруглитьСумму(МаксимальнаяКомпенсация);
			Ограничена = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат РезультатРасчёта(Сумма, ИсходнаяСумма, Ограничена, "");
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Собирает структуру результата расчёта компенсации.
//
Функция РезультатРасчёта(Сумма, ИсходнаяСумма, ОграниченаМаксимумом, ПричинаОтказа)
	
	Результат = Новый Структура;
	Результат.Вставить("Сумма", Сумма);
	Результат.Вставить("ИсходнаяСумма", ИсходнаяСумма);
	Результат.Вставить("ОграниченаМаксимумом", ОграниченаМаксимумом);
	Результат.Вставить("ТребуетсяСогласование", ТребуетсяСогласованиеРуководителем(Сумма));
	Результат.Вставить("ПричинаОтказа", ПричинаОтказа);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти
