#Область ПрограммныйИнтерфейс

// Разбирает одну строку CSV на массив значений полей.
// Разбор выполняется конечным автоматом по символам: разделитель внутри кавычек
// не режет поле, удвоенная кавычка внутри кавычек даёт один символ кавычки.
//
// Параметры:
//  Значение    - Строка - строка CSV без завершающего перевода строки.
//  Разделитель - Строка - разделитель полей, по умолчанию ";".
//
// Возвращаемое значение:
//  Массив - значения полей в порядке следования. Пустая строка даёт массив из одного пустого элемента.
//
Функция РазобратьСтроку(Значение, Разделитель = ";") Экспорт
	
	Результат = Новый Массив;
	
	Текст = Строка(Значение);
	ДлинаСтроки = СтрДлина(Текст);
	ДлинаРазделителя = СтрДлина(Разделитель);
	
	ТекущееПоле = "";
	ВКавычках = Ложь;
	Индекс = 1;
	
	Пока Индекс <= ДлинаСтроки Цикл
		
		Символ = Сред(Текст, Индекс, 1);
		
		Если ВКавычках Тогда
			
			Если Символ = """" Тогда
				СледующийСимвол = ?(Индекс < ДлинаСтроки, Сред(Текст, Индекс + 1, 1), "");
				Если СледующийСимвол = """" Тогда
					ТекущееПоле = ТекущееПоле + """";
					Индекс = Индекс + 1;
				Иначе
					ВКавычках = Ложь;
				КонецЕсли;
			Иначе
				ТекущееПоле = ТекущееПоле + Символ;
			КонецЕсли;
			
			Индекс = Индекс + 1;
			Продолжить;
			
		КонецЕсли;
		
		// Открывающая кавычка распознаётся только в начале поля.
		Если Символ = """" И ТекущееПоле = "" Тогда
			ВКавычках = Истина;
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;
		
		Если ДлинаРазделителя > 0 И Сред(Текст, Индекс, ДлинаРазделителя) = Разделитель Тогда
			Результат.Добавить(ТекущееПоле);
			ТекущееПоле = "";
			Индекс = Индекс + ДлинаРазделителя;
			Продолжить;
		КонецЕсли;
		
		ТекущееПоле = ТекущееПоле + Символ;
		Индекс = Индекс + 1;
		
	КонецЦикла;
	
	Результат.Добавить(ТекущееПоле);
	
	Возврат Результат;
	
КонецФункции

// Собирает массив значений полей в одну строку CSV.
// Поле заключается в двойные кавычки, если содержит разделитель, двойную кавычку,
// перевод строки или возврат каретки; внутренняя кавычка удваивается.
//
// Параметры:
//  Поля        - Массив - значения полей в порядке следования.
//  Разделитель - Строка - разделитель полей, по умолчанию ";".
//
// Возвращаемое значение:
//  Строка - строка CSV без завершающего перевода строки.
//
Функция СобратьСтроку(Поля, Разделитель = ";") Экспорт
	
	Части = Новый Массив;
	
	Для Каждого Поле Из Поля Цикл
		
		ТекстПоля = Строка(Поле);
		
		Если ТребуетКавычек(ТекстПоля, Разделитель) Тогда
			ТекстПоля = """" + СтрЗаменить(ТекстПоля, """", """""") + """";
		КонецЕсли;
		
		Части.Добавить(ТекстПоля);
		
	КонецЦикла;
	
	Возврат СтрСоединить(Части, Разделитель);
	
КонецФункции

// Записывает таблицу в CSV-файл в кодировке UTF-8 с BOM.
// Поля, требующие кавычек, экранируются так же, как в СобратьСтроку.
//
// Параметры:
//  ПутьФайла - Строка - полный путь к файлу.
//  Заголовок - Массив - значения полей заголовка; пишется первой строкой.
//  Строки    - Массив - массив массивов значений полей; каждый элемент - строка файла.
//
Процедура ЗаписатьФайл(ПутьФайла, Заголовок, Строки) Экспорт
	
	Попытка
		// Третий параметр конструктора - разделитель строк; BOM этим флагом
		// на практике не управляется (Истина третьим аргументом превращается
		// в строку "Да" и пишется как разделитель). Поэтому BOM пишем сами.
		Файл = Новый ЗаписьТекста(ПутьФайла, "UTF-8", Символы.ПС);
	Исключение
		ВызватьИсключение "Не удалось записать файл " + ПутьФайла + ". Закройте его в Excel и повторите.";
	КонецПопытки;
	
	Файл.Записать(Символ(65279));
	Файл.ЗаписатьСтроку(СобратьСтроку(Заголовок));
	
	Для Каждого СтрокаТаблицы Из Строки Цикл
		Файл.ЗаписатьСтроку(СобратьСтроку(СтрокаТаблицы));
	КонецЦикла;
	
	Файл.Закрыть();
	
КонецПроцедуры

// Читает CSV-файл в кодировке UTF-8.
// Ведущий BOM в первой строке отбрасывается, пустые строки пропускаются.
//
// Параметры:
//  ПутьФайла - Строка - полный путь к файлу.
//
// Возвращаемое значение:
//  Структура - поля Заголовок (Массив) и Строки (Массив из Массив).
//
Функция ПрочитатьФайл(ПутьФайла) Экспорт
	
	Заголовок = Новый Массив;
	Строки = Новый Массив;
	
	Файл = Новый ЧтениеТекста(ПутьФайла, "UTF-8");
	
	ЗаголовокПрочитан = Ложь;
	НомерСтроки = 0;
	
	Пока Истина Цикл
		
		ТекстСтроки = Файл.ПрочитатьСтроку();
		
		Если ТекстСтроки = Неопределено Тогда
			Прервать;
		КонецЕсли;
		
		Если НомерСтроки = 0 Тогда
			ТекстСтроки = СнятьBOM(ТекстСтроки);
		КонецЕсли;
		
		НомерСтроки = НомерСтроки + 1;
		
		Если ПустаяСтрока(ТекстСтроки) Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ЗаголовокПрочитан Тогда
			Заголовок = РазобратьСтроку(ТекстСтроки);
			ЗаголовокПрочитан = Истина;
		Иначе
			Строки.Добавить(РазобратьСтроку(ТекстСтроки));
		КонецЕсли;
		
	КонецЦикла;
	
	Файл.Закрыть();
	
	Результат = Новый Структура;
	Результат.Вставить("Заголовок", Заголовок);
	Результат.Вставить("Строки", Строки);
	
	Возврат Результат;
	
КонецФункции

// Приводит текстовое значение из CSV к числу.
// Запятая трактуется как десятичный разделитель: файлы приходят из локали,
// где разделитель целой и дробной части - запятая.
//
// Параметры:
//  Значение - Строка - исходное значение поля.
//
// Возвращаемое значение:
//  Структура - поля Успех (Булево), Значение (Число), ТекстОшибки (Строка).
//
Функция ПривестиКЧислу(Значение) Экспорт
	
	ТекстЗначения = СокрЛП(Строка(Значение));
	ТекстЗначения = СтрЗаменить(ТекстЗначения, ",", ".");
	
	Попытка
		Результат = Число(ТекстЗначения);
	Исключение
		Возврат Новый Структура("Успех, Значение, ТекстОшибки", Ложь, 0, "Не удалось привести к числу: " + Строка(Значение));
	КонецПопытки;
	
	Возврат Новый Структура("Успех, Значение, ТекстОшибки", Истина, Результат, "");
	
КонецФункции

// Приводит текстовое значение из CSV к дате в формате ГГГГ-ММ-ДД.
// Дополнительно проверяется, что дата существует: 31 февраля не превращается
// в 3 марта, а признаётся ошибочным значением.
//
// Параметры:
//  Значение - Строка - исходное значение поля.
//
// Возвращаемое значение:
//  Структура - поля Успех (Булево), Значение (Дата), ТекстОшибки (Строка).
//
Функция ПривестиКДате(Значение) Экспорт
	
	ТекстЗначения = СокрЛП(Строка(Значение));
	Части = СтрРазделить(ТекстЗначения, "-", Ложь);
	
	Если Части.Количество() <> 3 Тогда
		Возврат Новый Структура("Успех, Значение, ТекстОшибки", Ложь, '00010101', "Не удалось привести к дате: " + Строка(Значение));
	КонецЕсли;
	
	// Имена Год, Месяц, День не используем: они совпадают с именами глобальных
	// функций и переменная перекрыла бы вызов Месяц(Результат).
	Попытка
		ГодЗначения   = Число(Части[0]);
		МесяцЗначения = Число(Части[1]);
		ДеньЗначения  = Число(Части[2]);
	Исключение
		Возврат Новый Структура("Успех, Значение, ТекстОшибки", Ложь, '00010101', "Не удалось привести к дате: " + Строка(Значение));
	КонецПопытки;
	
	Если ГодЗначения < 1 Или ГодЗначения > 9999 Или МесяцЗначения < 1 Или МесяцЗначения > 12 Или ДеньЗначения < 1 Или ДеньЗначения > 31 Тогда
		Возврат Новый Структура("Успех, Значение, ТекстОшибки", Ложь, '00010101', "Не удалось привести к дате: " + Строка(Значение));
	КонецЕсли;
	
	Попытка
		Результат = Дата(ГодЗначения, МесяцЗначения, ДеньЗначения);
	Исключение
		Возврат Новый Структура("Успех, Значение, ТекстОшибки", Ложь, '00010101', "Не удалось привести к дате: " + Строка(Значение));
	КонецПопытки;
	
	// Дата(Год, Месяц, День) нормализует несуществующую дату, поэтому сверяем обратно.
	Если Месяц(Результат) <> МесяцЗначения Или День(Результат) <> ДеньЗначения Тогда
		Возврат Новый Структура("Успех, Значение, ТекстОшибки", Ложь, '00010101', "Не удалось привести к дате: " + Строка(Значение));
	КонецЕсли;
	
	Возврат Новый Структура("Успех, Значение, ТекстОшибки", Истина, Результат, "");
	
КонецФункции

// Приводит текстовое значение из CSV к булеву.
// Распознаются только значения "Истина" и "Ложь"; всё прочее - ошибка.
//
// Параметры:
//  Значение - Строка - исходное значение поля.
//
// Возвращаемое значение:
//  Структура - поля Успех (Булево), Значение (Булево), ТекстОшибки (Строка).
//
Функция ПривестиКБулеву(Значение) Экспорт
	
	ТекстЗначения = СокрЛП(Строка(Значение));
	
	Если ТекстЗначения = "Истина" Тогда
		Возврат Новый Структура("Успех, Значение, ТекстОшибки", Истина, Истина, "");
	КонецЕсли;
	
	Если ТекстЗначения = "Ложь" Тогда
		Возврат Новый Структура("Успех, Значение, ТекстОшибки", Истина, Ложь, "");
	КонецЕсли;
	
	Возврат Новый Структура("Успех, Значение, ТекстОшибки", Ложь, Ложь, "Не удалось привести к булеву: " + Строка(Значение));
	
КонецФункции

// Формирует текстовое представление числа для записи в CSV:
// два знака после запятой, десятичный разделитель - запятая.
//
// Параметры:
//  Значение - Число - число для записи.
//
// Возвращаемое значение:
//  Строка - представление числа.
//
Функция СформироватьЧисло(Значение) Экспорт
	
	ТекстЗначения = Формат(Значение, "ЧДЦ=2;ЧН=0,00");
	
	// В локали с точкой Формат вернёт точку - приводим к запятой единообразно.
	Если Найти(ТекстЗначения, ".") > 0 Тогда
		ТекстЗначения = СтрЗаменить(ТекстЗначения, ".", ",");
	КонецЕсли;
	
	Возврат ТекстЗначения;
	
КонецФункции

// Формирует текстовое представление даты для записи в CSV в формате ГГГГ-ММ-ДД.
//
// Параметры:
//  Значение - Дата - дата для записи.
//
// Возвращаемое значение:
//  Строка - представление даты.
//
Функция СформироватьДату(Значение) Экспорт
	
	Возврат Формат(Значение, "ДФ=yyyy-MM-dd");
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Определяет, требуется ли заключать значение поля в двойные кавычки.
//
// Параметры:
//  ТекстПоля   - Строка - значение поля.
//  Разделитель - Строка - разделитель полей.
//
// Возвращаемое значение:
//  Булево - Истина, если поле требует заключения в кавычки.
//
Функция ТребуетКавычек(ТекстПоля, Разделитель)
	
	Если Найти(ТекстПоля, """") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если Найти(ТекстПоля, Символы.ПС) > 0 Или Найти(ТекстПоля, Символы.ВК) > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если Не ПустаяСтрока(Разделитель) И Найти(ТекстПоля, Разделитель) > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

// Отбрасывает ведущий BOM (символ с кодом 65279) в прочитанной строке.
//
// Параметры:
//  ТекстСтроки - Строка - прочитанная строка файла.
//
// Возвращаемое значение:
//  Строка - строка без ведущего BOM.
//
Функция СнятьBOM(ТекстСтроки)
	
	Если СтрДлина(ТекстСтроки) > 0 И Лев(ТекстСтроки, 1) = Символ(65279) Тогда
		Возврат Сред(ТекстСтроки, 2);
	КонецЕсли;
	
	Возврат ТекстСтроки;
	
КонецФункции

#КонецОбласти
