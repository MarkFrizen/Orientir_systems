#Область ПрограммныйИнтерфейс

// Возвращает контрольный срок до даты оказания услуги по её виду.
//
// Параметры:
//  ВидУслуги - ПеречислениеСсылка.ВидыУслуг - вид услуги.
//
// Возвращаемое значение:
//  Число, Неопределено - срок в днях; Неопределено, если норматив не настроен.
//
Функция КонтрольныйСрок(ВидУслуги) Экспорт
	
	Если ВидУслуги = Неопределено Или НЕ ЗначениеЗаполнено(ВидУслуги) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	СрокиКонтроля.КонтрольныйСрокДней КАК КонтрольныйСрокДней
		|ИЗ
		|	РегистрСведений.СрокиКонтроля КАК СрокиКонтроля
		|ГДЕ
		|	СрокиКонтроля.ВидУслуги = &ВидУслуги";
	Запрос.УстановитьПараметр("ВидУслуги", ВидУслуги);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.КонтрольныйСрокДней;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

// Вычисляет крайнюю дату, до которой услуга должна быть подтверждена.
//
// Параметры:
//  ВидУслуги - ПеречислениеСсылка.ВидыУслуг - вид услуги.
//  ДатаОказания - Дата - дата начала оказания услуги.
//
// Возвращаемое значение:
//  Дата, Неопределено - контрольная дата; Неопределено, если норматив не настроен.
//
Функция КонтрольнаяДата(ВидУслуги, ДатаОказания) Экспорт
	
	Срок = КонтрольныйСрок(ВидУслуги);
	Если Срок = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ДатаОказания = Неопределено Или НЕ ЗначениеЗаполнено(ДатаОказания) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ДатаОказания - Срок * 86400;
	
КонецФункции

// Определяет, просрочен ли контрольный срок услуги.
//
// Параметры:
//  ВидУслуги - ПеречислениеСсылка.ВидыУслуг - вид услуги.
//  ДатаОказания - Дата - дата начала оказания услуги.
//  ДатаОтсчёта - Дата - момент проверки; по умолчанию текущая дата сеанса.
//
// Возвращаемое значение:
//  Булево - Истина, если контрольная дата уже прошла.
//
Функция Просрочено(ВидУслуги, ДатаОказания, ДатаОтсчёта = Неопределено) Экспорт
	
	Контрольная = КонтрольнаяДата(ВидУслуги, ДатаОказания);
	Если Контрольная = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ДатаОтсчёта = Неопределено Тогда
		ДатаОтсчёта = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Возврат Контрольная < ДатаОтсчёта;
	
КонецФункции

#КонецОбласти
