#Область ПрограммныйИнтерфейс

// ЗаблокироватьРегистры
// Устанавливает исключительную блокировку данных для перечисленных регистров:
// проведение эти регистры изменяет, а разделяемая блокировка в файловой базе
// приводит к ожиданию собственной транзакцией запроса на запись.
// Порядок элементов массива задаёт порядок установки блокировок вызывающим.
//
// Параметры:
//   МассивРегистров - Массив - массив строк областей блокировки,
//       например "РегистрНакопления.ВзаиморасчётыПоПретензиям",
//       "РегистрСведений.СтатусыПодтверждений".
//
Процедура ЗаблокироватьРегистры(МассивРегистров) Экспорт

	Блокировка = Новый БлокировкаДанных;

	Для Каждого ОбластьБлокировки Из МассивРегистров Цикл
		ЭлементБлокировки = Блокировка.Добавить();
		ЭлементБлокировки.Область = ОбластьБлокировки;
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	КонецЦикла;

	Блокировка.Заблокировать();

КонецПроцедуры

#КонецОбласти

