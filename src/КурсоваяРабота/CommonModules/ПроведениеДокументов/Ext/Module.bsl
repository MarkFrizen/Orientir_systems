#Область ПрограммныйИнтерфейс

// ЗаблокироватьРегистры
// Устанавливает разделяемую блокировку данных для перечисленных регистров.
// Порядок элементов массива задаёт порядок установки блокировок вызывающим.
//
// Параметры:
//   МассивРегистров - Массив - массив строк областей блокировки,
//       например "РегистрНакопления.ВзаиморасчётыПоПретензиям",
//       "РегистрСведений.СтатусыПодтверждений".
//
Процедура ЗаблокироватьРегистры(МассивРегистров) Экспорт

	Блокировка = Новый БлокировкаДанных;

	Для Каждого ОбластьБлокировки Из МассивРегистров Цикл
		ЭлементБлокировки = Блокировка.Добавить();
		ЭлементБлокировки.Область = ОбластьБлокировки;
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Разделяемый;
	КонецЦикла;

	Блокировка.Заблокировать();

КонецПроцедуры

// УдалитьДвиженияРегистратора
// Удаляет движения документа во всех регистрах, подчинённых регистратору.
// Список регистров определяется из метаданных без жёсткого перечисления:
// все регистры накопления (они всегда подчинены регистратору) и регистры
// сведений с режимом записи "Подчинение регистратору". Платформа удаляет
// только строки с Регистратор = ДокументСсылка.
//
// Параметры:
//   ДокументСсылка - ДокументСсылка - ссылка на документ, движения которого
//       необходимо удалить.
//
Процедура УдалитьДвиженияРегистратора(ДокументСсылка) Экспорт

	ПодчинениеРегистратору = Метаданные.СвойстваОбъектов.РежимЗаписиРегистраСведений.ПодчинениеРегистратору;

	Для Каждого РегистрИзМетаданных Из Метаданные.РегистрыНакопления Цикл
		НаборЗаписей = РегистрыНакопления[РегистрИзМетаданных.Имя].СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(ДокументСсылка);
		НаборЗаписей.Записать(Истина);
	КонецЦикла;

	Для Каждого РегистрИзМетаданных Из Метаданные.РегистрыСведений Цикл
		Если РегистрИзМетаданных.РежимЗаписи <> ПодчинениеРегистратору Тогда
			Продолжить;
		КонецЕсли;

		НаборЗаписей = РегистрыСведений[РегистрИзМетаданных.Имя].СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(ДокументСсылка);
		НаборЗаписей.Записать(Истина);
	КонецЦикла;

КонецПроцедуры

// ЗаписатьСтатус
// Записывает строку регистра сведений: измерения устанавливаются из структуры
// Отбор, реквизиты - из структуры ПоляЗаписи. Существующие строки в границах
// отбора замещаются.
//
// Параметры:
//   ИмяРегистра - Строка - имя регистра сведений, например "СтатусыПодтверждений".
//   Отбор - Структура - измерения регистра: Ключ - имя измерения, Значение - значение.
//   ПоляЗаписи - Структура - реквизиты записи: Ключ - имя реквизита, Значение - значение.
//
Процедура ЗаписатьСтатус(ИмяРегистра, Отбор, ПоляЗаписи) Экспорт

	НаборЗаписей = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();

	Для Каждого ЭлементОтбора Из Отбор Цикл
		НаборЗаписей.Отбор[ЭлементОтбора.Ключ].Установить(ЭлементОтбора.Значение);
	КонецЦикла;

	Запись = НаборЗаписей.Добавить();

	Для Каждого ЭлементОтбора Из Отбор Цикл
		Запись[ЭлементОтбора.Ключ] = ЭлементОтбора.Значение;
	КонецЦикла;

	Для Каждого ПолеЗаписи Из ПоляЗаписи Цикл
		Запись[ПолеЗаписи.Ключ] = ПолеЗаписи.Значение;
	КонецЦикла;

	НаборЗаписей.Записать(Истина);

КонецПроцедуры

// ЗарегистрироватьKPI
// Регистрирует оборот в регистре накопления KPIОператоров: одна операция
// (Количество = 1) с переданным временем обработки в минутах.
//
// Параметры:
//   Сотрудник - СправочникСсылка.Сотрудники - сотрудник, выполнивший операцию.
//   ВидОперации - ПеречислениеСсылка.ВидыОперацийKPI - вид выполненной операции.
//   Минут - Число - время обработки операции в минутах.
//
Процедура ЗарегистрироватьKPI(Сотрудник, ВидОперации, Минут) Экспорт

	Движение = РегистрыНакопления.KPIОператоров.СоздатьМенеджерЗаписи();
	Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
	Движение.Сотрудник = Сотрудник;
	Движение.ВидОперации = ВидОперации;
	Движение.Количество = 1;
	Движение.ВремяОбработкиМинут = Минут;
	Движение.Записать();

КонецПроцедуры

#КонецОбласти
