#Область ПрограммныйИнтерфейс

// Создание задачи исполнителю.
// Задача адресуется стандартным реквизитом «Исполнитель». Регистр адресации
// АдресацияЗадач платформа сама не ведёт: модуль создаёт в нём маркер
// исполнителя, иначе задача не попадает в список адресованных.
// У задачи в этой конфигурации доступно только «Наименование»: параметры
// «Описание» и «ОбъектОснования» дописываются в него, чтобы данные не терялись.
//
// Параметры:
//   Наименование - Строка - краткий текст задачи.
//   Описание - Строка - подробное описание задачи; дописывается к наименованию.
//   Исполнитель - СправочникСсылка.Сотрудники - адресат задачи. Пустое
//       значение недопустимо.
//   ОбъектОснования - ЛюбаяСсылка, Неопределено - объект-основание задачи;
//       его представление дописывается к наименованию.
//
// Возвращаемое значение:
//   ЗадачаСсылка.ЗадачаИсполнителя - ссылка созданной задачи.
//
Функция СоздатьЗадачу(Наименование, Описание, Исполнитель, ОбъектОснования = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(Исполнитель) Тогда
		ВызватьИсключение "Исполнитель обязателен";
	КонецЕсли;
	
	ТекстЗадачи = Наименование;
	Если ЗначениеЗаполнено(Описание) Тогда
		ТекстЗадачи = ТекстЗадачи + " — " + Описание;
	КонецЕсли;
	Если ЗначениеЗаполнено(ОбъектОснования) Тогда
		ТекстЗадачи = ТекстЗадачи + " (основание: " + ПредставлениеОбъекта(ОбъектОснования) + ")";
	КонецЕсли;
	
	Задача = Задачи.ЗадачаИсполнителя.СоздатьЗадачу();
	Задача.Наименование = ТекстЗадачи;
	Задача.Исполнитель = Исполнитель;
	Задача.Дата = ТекущаяДатаСеанса();
	Задача.Записать();
	
	ОбеспечитьЗаписьАдресации(Исполнитель);
	
	Возврат Задача.Ссылка;
	
КонецФункции

// Закрытие задачи.
// Проверяет, что задача ещё не выполнена, отмечает её выполненной
// и дописывает комментарий в описание.
//
// Параметры:
//   ЗадачаСсылка - ЗадачаСсылка.ЗадачаИсполнителя - закрываемая задача.
//   Комментарий - Строка - комментарий к закрытию.
//
Процедура ЗакрытьЗадачу(ЗадачаСсылка, Комментарий = "") Экспорт
	
	Если Не ЗначениеЗаполнено(ЗадачаСсылка) Тогда
		ВызватьИсключение "Не указана закрываемая задача";
	КонецЕсли;
	
	Задача = ЗадачаСсылка.ПолучитьОбъект();
	Если Задача.Выполнена Тогда
		ВызватьИсключение "Задача уже выполнена: " + Строка(ЗадачаСсылка);
	КонецЕсли;
	
	Задача.Выполнена = Истина;
	
	Если ЗначениеЗаполнено(Комментарий) Тогда
		Задача.Наименование = Задача.Наименование + " — " + Комментарий;
	КонецЕсли;
	
	Задача.Записать();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Регистр АдресацияЗадач независимый и имеет единственное измерение
// «Исполнитель»: запись в нём означает, что исполнителю можно адресовать
// задачу. Платформа её сама не создаёт, поэтому создаём при необходимости.
Процедура ОбеспечитьЗаписьАдресации(Исполнитель)
	
	МенеджерЗаписи = РегистрыСведений.АдресацияЗадач.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Исполнитель = Исполнитель;
	МенеджерЗаписи.Записать();
	
КонецПроцедуры

// Читаемое представление объекта-основания для текста задачи.
Функция ПредставлениеОбъекта(Объект)
	
	Попытка
		Возврат Объект.Представление;
	Исключение
		Возврат Строка(Объект);
	КонецПопытки;
	
КонецФункции

#КонецОбласти
