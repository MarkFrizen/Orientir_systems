#Область ПрограммныйИнтерфейс

// Разбирает часовую зону и возвращает смещение от UTC в часах.
//
// Поддерживаются значения "+3", "-5", "UTC+3", "UTC-5", "UTC+05:30".
//
// Параметры:
//  Значение - Строка - часовая зона объекта или поставщика.
//
// Возвращаемое значение:
//  Число, Неопределено - смещение в часах; Неопределено, если формат не распознан.
//
Функция СмещениеЧасовойЗоны(Значение) Экспорт
	
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Текст = ВРег(СокрЛП(Строка(Значение)));
	Если Лев(Текст, 3) = "UTC" Тогда
		Текст = СокрЛП(Сред(Текст, 4));
	КонецЕсли;
	
	Если Текст = "" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Знак = 1;
	ПервыйСимвол = Лев(Текст, 1);
	Если ПервыйСимвол = "-" Тогда
		Знак = -1;
		Текст = СокрЛП(Сред(Текст, 2));
	ИначеЕсли ПервыйСимвол = "+" Тогда
		Текст = СокрЛП(Сред(Текст, 2));
	КонецЕсли;
	
	ПозицияДвоеточия = СтрНайти(Текст, ":");
	Если ПозицияДвоеточия > 0 Тогда
		ЧасыТекст = Лев(Текст, ПозицияДвоеточия - 1);
		МинутыТекст = Сред(Текст, ПозицияДвоеточия + 1);
	Иначе
		ЧасыТекст = Текст;
		МинутыТекст = "0";
	КонецЕсли;
	
	Если НЕ ЭтоНеотрицательноеЦелое(ЧасыТекст) Или НЕ ЭтоНеотрицательноеЦелое(МинутыТекст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Знак * (Число(ЧасыТекст) + Число(МинутыТекст) / 60);
	
КонецФункции

// Переводит время из UTC в локальное время объекта.
//
// Параметры:
//  ДатаUTC - Дата - время в UTC.
//  ЗначениеЗоны - Строка - часовая зона объекта.
//
// Возвращаемое значение:
//  Дата, Неопределено - локальное время; Неопределено, если зона не распознана.
//
Функция ПеревестиВЛокальноеВремя(ДатаUTC, ЗначениеЗоны) Экспорт
	
	Смещение = СмещениеЧасовойЗоны(ЗначениеЗоны);
	Если Смещение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ДатаUTC = Неопределено Или НЕ ЗначениеЗаполнено(ДатаUTC) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ДатаUTC + Смещение * 3600;
	
КонецФункции

// Считает разницу между двумя моментами в минутах.
//
// Параметры:
//  Начало - Дата - начало интервала.
//  Окончание - Дата - окончание интервала.
//
// Возвращаемое значение:
//  Число - разница в минутах; отрицательная, если интервалы перекрываются.
//
Функция РазницаВМинутах(Начало, Окончание) Экспорт
	
	Если Начало = Неопределено Или Окончание = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат (Окончание - Начало) / 60;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Проверяет, что строка состоит только из цифр и не пуста.
//
Функция ЭтоНеотрицательноеЦелое(Значение)
	
	Текст = СокрЛП(Значение);
	Если Текст = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Код = КодСимвола(Текст, Позиция);
		Если Код < 48 Или Код > 57 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

#КонецОбласти
