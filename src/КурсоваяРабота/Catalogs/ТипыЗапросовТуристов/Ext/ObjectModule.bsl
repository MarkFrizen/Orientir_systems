#Область ПрограммныйИнтерфейс

// Возвращает перечень нарушений, мешающих записи типа запроса туриста.
//
// Параметры:
//  Объект - СправочникОбъект.ТипыЗапросовТуристов - записываемый элемент.
//
// Возвращаемое значение:
//  Массив - тексты нарушений; пустой массив, если нарушений нет.
//
Функция ПравилаЗаписи(Объект) Экспорт
	
	Нарушения = Новый Массив;
	
	Если Объект.SLAЧасов <= 0 Тогда
		Нарушения.Добавить("Норматив SLA должен быть больше нуля. Укажите, за сколько часов запрос должен быть обработан.");
	КонецЕсли;
	
	Возврат Нарушения;
	
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

// Публикует нарушения правил записи и отклоняет запись элемента.
//
// Вызывается платформой при любой записи, включая программную.
//
// Параметры:
//  Отказ - Булево - устанавливается в Истина при найденных нарушениях.
//
Процедура ПередЗаписью(Отказ)
	
	Для Каждого Текст Из ПравилаЗаписи(ЭтотОбъект) Цикл
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = Текст;
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
