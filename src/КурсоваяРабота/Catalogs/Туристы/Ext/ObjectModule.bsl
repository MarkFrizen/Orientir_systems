#Область ПрограммныйИнтерфейс

// Возвращает перечень нарушений, мешающих записи туриста.
//
// Параметры:
//  Объект - СправочникОбъект.Туристы - записываемый элемент.
//
// Возвращаемое значение:
//  Массив - тексты нарушений; пустой массив, если нарушений нет.
//
Функция ПравилаЗаписи(Объект) Экспорт
	
	Нарушения = Новый Массив;
	
	Если НЕ ЗначениеЗаполнено(Объект.Наименование) Тогда
		Нарушения.Добавить("Не заполнено ФИО туриста.");
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.ДатаРождения) Тогда
		Нарушения.Добавить("Не заполнена дата рождения туриста.");
	ИначеЕсли Объект.ДатаРождения > ТекущаяДатаСеанса() Тогда
		Нарушения.Добавить("Дата рождения не может быть позже текущей даты.");
	КонецЕсли;
	
	Возврат Нарушения;
	
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

// Публикует нарушения правил записи и отклоняет запись элемента.
//
// Вызывается платформой при любой записи, включая программную.
//
// Параметры:
//  Отказ - Булево - устанавливается в Истина при найденных нарушениях.
//
Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Текст Из ПравилаЗаписи(ЭтотОбъект) Цикл
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = Текст;
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
