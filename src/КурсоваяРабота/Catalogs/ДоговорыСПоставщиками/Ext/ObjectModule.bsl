#Область ПрограммныйИнтерфейс

// Возвращает перечень нарушений, мешающих записи договора с поставщиком.
//
// Параметры:
//  Объект - СправочникОбъект.ДоговорыСПоставщиками - записываемый элемент.
//
// Возвращаемое значение:
//  Массив - тексты нарушений; пустой массив, если нарушений нет.
//
Функция ПравилаЗаписи(Объект) Экспорт
	
	Нарушения = Новый Массив;
	
	Если ЗначениеЗаполнено(Объект.ДатаНачала) И ЗначениеЗаполнено(Объект.ДатаОкончания) Тогда
		Если Объект.ДатаОкончания < Объект.ДатаНачала Тогда
			Нарушения.Добавить("Дата окончания договора раньше даты начала.");
		КонецЕсли;
	КонецЕсли;
	
	Если Объект.ПроцентШтрафа < 0 Или Объект.ПроцентШтрафа > 100 Тогда
		Нарушения.Добавить("Процент штрафа должен быть в диапазоне от 0 до 100.");
	КонецЕсли;
	
	Если Объект.МаксимальнаяКомпенсация < 0 Тогда
		Нарушения.Добавить("Максимальная компенсация не может быть отрицательной.");
	КонецЕсли;
	
	Возврат Нарушения;
	
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

// Публикует нарушения правил записи и отклоняет запись элемента.
//
// Вызывается платформой при любой записи, включая программную.
//
// Параметры:
//  Отказ - Булево - устанавливается в Истина при найденных нарушениях.
//
Процедура ПередЗаписью(Отказ)
	
	Для Каждого Текст Из ПравилаЗаписи(ЭтотОбъект) Цикл
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = Текст;
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
