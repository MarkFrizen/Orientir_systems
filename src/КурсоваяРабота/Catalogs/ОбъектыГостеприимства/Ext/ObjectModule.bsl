#Область ПрограммныйИнтерфейс

// Возвращает перечень нарушений, мешающих записи объекта гостеприимства.
//
// Параметры:
//  Объект - СправочникОбъект.ОбъектыГостеприимства - записываемый элемент.
//
// Возвращаемое значение:
//  Массив - тексты нарушений; пустой массив, если нарушений нет.
//
Функция ПравилаЗаписи(Объект) Экспорт
	
	Нарушения = Новый Массив;
	
	Зона = СокрЛП(Строка(Объект.ЧасоваяЗона));
	Если Зона = "" Тогда
		Нарушения.Добавить("Не заполнена часовая зона объекта. Укажите значение вида UTC+3.");
	ИначеЕсли РаботаСДатамиИЧасовымиЗонами.СмещениеЧасовойЗоны(Зона) = Неопределено Тогда
		Нарушения.Добавить("Часовая зона """ + Зона + """ не распознана. Поддерживается формат UTC+3, UTC-5, UTC+05:30.");
	КонецЕсли;
	
	Возврат Нарушения;
	
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

// Публикует нарушения правил записи и отклоняет запись элемента.
//
// Вызывается платформой при любой записи, включая программную.
//
// Параметры:
//  Отказ - Булево - устанавливается в Истина при найденных нарушениях.
//
Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Текст Из ПравилаЗаписи(ЭтотОбъект) Цикл
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = Текст;
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
